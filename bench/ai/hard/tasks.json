 {
  "id": "h12_vars",
  "fn": "run_vars",
  "params": [
   [
    "lines",
    "List[Str]"
   ]
  ],
  "ret": "Result[Map[Str, Int], Str]",
  "statement": "Run assignments and return the final variables. A line is `name = term` or `name = term + term - term ...`, with the parts separated by spaces. A name is lowercase letters a-z; a term is a whole number (possibly with a minus sign in front) or a name. Fail with \"syntax error\" for a line that does not have this form, and with \"undefined NAME\" when a term uses a variable that has no value yet (a line's syntax is checked before it runs).",
  "tests": [
   [
    [
     [
      "x = 1",
      "y = x + 2"
     ]
    ],
    {
     "ok": {
      "x": 1,
      "y": 3
     }
    }
   ],
   [
    [
     [
      "x = y"
     ]
    ],
    {
     "err": "undefined y"
    }
   ],
   [
    [
     []
    ],
    {
     "ok": {}
    }
   ],
   [
    [
     [
      "x = 5",
      "x = x - 1 - 1"
     ]
    ],
    {
     "ok": {
      "x": 3
     }
    }
   ],
   [
    [
     [
      "x ="
     ]
    ],
    {
     "err": "syntax error"
    }
   ],
   [
    [
     [
      "X = 1"
     ]
    ],
    {
     "err": "syntax error"
    }
   ],
   [
    [
     [
      "x = -3 + 4"
     ]
    ],
    {
     "ok": {
      "x": 1
     }
    }
   ],
   [
    [
     [
      "x = 1 * 2"
     ]
    ],
    {
     "err": "syntax error"
    }
   ]
  ]
 },
