[
 {
  "id": "h01_calc",
  "fn": "calc",
  "params": [
   [
    "expr",
    "Str"
   ]
  ],
  "ret": "Result[Int, Str]",
  "statement": "Evaluate an integer expression with `+`, `-`, `*`, `/`, unary minus, parentheses and spaces. `*` and `/` bind tighter than `+` and `-`, operators of one level go left to right, and `/` truncates toward zero. Fail with \"division by zero\" when a divisor is 0, and with \"syntax error\" for anything that is not a complete expression (including any other character).",
  "tests": [
   [
    [
     "1 + 2 * 3"
    ],
    {
     "ok": 7
    }
   ],
   [
    [
     "(1 + 2) * 3"
    ],
    {
     "ok": 9
    }
   ],
   [
    [
     "-7 / 2"
    ],
    {
     "ok": -3
    }
   ],
   [
    [
     "2 - -3"
    ],
    {
     "ok": 5
    }
   ],
   [
    [
     "10 / (5 - 5)"
    ],
    {
     "err": "division by zero"
    }
   ],
   [
    [
     "1 +"
    ],
    {
     "err": "syntax error"
    }
   ],
   [
    [
     "(1"
    ],
    {
     "err": "syntax error"
    }
   ],
   [
    [
     "2 $ 3"
    ],
    {
     "err": "syntax error"
    }
   ]
  ]
 },
 {
  "id": "h02_topo",
  "fn": "topo",
  "params": [
   [
    "deps",
    "Map[Str, List[Str]]"
   ]
  ],
  "ret": "Result[List[Str], Str]",
  "statement": "`deps` maps a task to the tasks that must come before it; a task named only in a list has no dependencies. Return all tasks in an order that respects the dependencies; when several are ready, the alphabetically smallest comes first. Fail with \"cycle\" if there is no such order.",
  "tests": [
   [
    [
     {
      "b": [
       "a"
      ],
      "c": [
       "a",
       "b"
      ]
     }
    ],
    {
     "ok": [
      "a",
      "b",
      "c"
     ]
    }
   ],
   [
    [
     {
      "x": [
       "y"
      ],
      "y": [
       "x"
      ]
     }
    ],
    {
     "err": "cycle"
    }
   ],
   [
    [
     {}
    ],
    {
     "ok": []
    }
   ],
   [
    [
     {
      "a": []
     }
    ],
    {
     "ok": [
      "a"
     ]
    }
   ],
   [
    [
     {
      "d": [
       "b",
       "c"
      ],
      "b": [
       "a"
      ],
      "c": [
       "a"
      ]
     }
    ],
    {
     "ok": [
      "a",
      "b",
      "c",
      "d"
     ]
    }
   ],
   [
    [
     {
      "z": [],
      "a": []
     }
    ],
    {
     "ok": [
      "a",
      "z"
     ]
    }
   ],
   [
    [
     {
      "a": [
       "a"
      ]
     }
    ],
    {
     "err": "cycle"
    }
   ],
   [
    [
     {
      "c": [
       "b"
      ],
      "b": [
       "a"
      ],
      "e": [
       "d"
      ]
     }
    ],
    {
     "ok": [
      "a",
      "b",
      "c",
      "d",
      "e"
     ]
    }
   ]
  ]
 },
 {
  "id": "h03_lru",
  "fn": "lru",
  "params": [
   [
    "capacity",
    "Int"
   ],
   [
    "ops",
    "List[Str]"
   ]
  ],
  "ret": "List[Str]",
  "statement": "Simulate a least-recently-used cache. `ops` are \"put K V\" and \"get K\"; both make K the most recently used. A put of a new key into a full cache first removes the least recently used key; with capacity 0 nothing is ever stored. Return the results of the gets in order, with \"-\" for a key that is not in the cache.",
  "tests": [
   [
    [
     2,
     [
      "put a 1",
      "put b 2",
      "get a",
      "put c 3",
      "get b",
      "get c"
     ]
    ],
    [
     "1",
     "-",
     "3"
    ]
   ],
   [
    [
     1,
     [
      "put a 1",
      "put b 2",
      "get a",
      "get b"
     ]
    ],
    [
     "-",
     "2"
    ]
   ],
   [
    [
     0,
     [
      "put a 1",
      "get a"
     ]
    ],
    [
     "-"
    ]
   ],
   [
    [
     2,
     [
      "get x"
     ]
    ],
    [
     "-"
    ]
   ],
   [
    [
     2,
     [
      "put a 1",
      "put a 2",
      "get a"
     ]
    ],
    [
     "2"
    ]
   ],
   [
    [
     2,
     [
      "put a 1",
      "put b 2",
      "put a 3",
      "put c 4",
      "get b",
      "get a"
     ]
    ],
    [
     "-",
     "3"
    ]
   ],
   [
    [
     3,
     []
    ],
    []
   ],
   [
    [
     2,
     [
      "put a 1",
      "put b 2",
      "get a",
      "get b",
      "put c 3",
      "get a",
      "get b",
      "get c"
     ]
    ],
    [
     "1",
     "2",
     "-",
     "2",
     "3"
    ]
   ]
  ]
 },
