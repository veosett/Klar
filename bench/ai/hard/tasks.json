 {
  "id": "h09_ledger",
  "fn": "ledger",
  "params": [
   [
    "ops",
    "List[Str]"
   ]
  ],
  "ret": "Result[Map[Str, Int], Str]",
  "statement": "Apply operations to accounts and return the final balances: \"open A\" (a new account with balance 0), \"dep A N\", \"wd A N\", \"move A B N\" (from A to B). N is a positive whole number. Fail with the first error: \"bad op\" for a malformed operation or amount, \"exists A\" when opening an existing account, \"unknown A\" for an account that was not opened (in a move, A is checked before B), \"insufficient A\" when A has less than N. The amount is checked before the accounts.",
  "tests": [
   [
    [
     [
      "open a",
      "dep a 5",
      "open b",
      "move a b 2"
     ]
    ],
    {
     "ok": {
      "a": 3,
      "b": 2
     }
    }
   ],
   [
    [
     [
      "open a",
      "open a"
     ]
    ],
    {
     "err": "exists a"
    }
   ],
   [
    [
     []
    ],
    {
     "ok": {}
    }
   ],
   [
    [
     [
      "dep a 1"
     ]
    ],
    {
     "err": "unknown a"
    }
   ],
   [
    [
     [
      "open a",
      "wd a 1"
     ]
    ],
    {
     "err": "insufficient a"
    }
   ],
   [
    [
     [
      "open a",
      "dep a 0"
     ]
    ],
    {
     "err": "bad op"
    }
   ],
   [
    [
     [
      "open a",
      "move a b 1"
     ]
    ],
    {
     "err": "unknown b"
    }
   ],
   [
    [
     [
      "close a"
     ]
    ],
    {
     "err": "bad op"
    }
   ]
  ]
 },
