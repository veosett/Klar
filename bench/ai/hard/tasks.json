 {
  "id": "h05_wrap",
  "fn": "wrap",
  "params": [
   [
    "text",
    "Str"
   ],
   [
    "width",
    "Int"
   ]
  ],
  "ret": "List[Str]",
  "statement": "Wrap `text` into lines of at most `width` characters (width >= 1). Words are separated by one or more spaces; lines hold as many words as fit, separated by one space. A word longer than `width` is first cut into pieces of exactly `width` characters (the last may be shorter), which then count as words.",
  "tests": [
   [
    [
     "the quick brown fox",
     9
    ],
    [
     "the quick",
     "brown fox"
    ]
   ],
   [
    [
     "abcdefgh",
     3
    ],
    [
     "abc",
     "def",
     "gh"
    ]
   ],
   [
    [
     "",
     5
    ],
    []
   ],
   [
    [
     "   ",
     5
    ],
    []
   ],
   [
    [
     "a b c",
     1
    ],
    [
     "a",
     "b",
     "c"
    ]
   ],
   [
    [
     "hi abcdefg yo",
     4
    ],
    [
     "hi",
     "abcd",
     "efg",
     "yo"
    ]
   ],
   [
    [
     "one  two",
     7
    ],
    [
     "one two"
    ]
   ]
  ]
 },
 {
