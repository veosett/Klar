 {
  "id": "h20_inventory",
  "fn": "inventory",
  "params": [
   [
    "orders",
    "List[Str]"
   ],
   [
    "stock",
    "Map[Str, Int]"
   ]
  ],
  "ret": "Result[List[Str], Str]",
  "statement": "Process orders in sequence against the stock and return the ids of the orders that were filled. An order is \"ID item:qty,item:qty\" with one space, a non-empty id, a non-empty item name and a positive whole quantity. An order is filled whole, if the remaining stock covers all its items (an item may be listed twice), and takes them from the stock; otherwise it is skipped and takes nothing. A malformed order, or one that names an item that is not in `stock`, fails with the message \"bad order \" followed by its id: for \"o7 x\" that is \"bad order o7\".",
  "tests": [
   [
    [
     [
      "o1 a:2,b:1",
      "o2 a:2",
      "o3 b:1"
     ],
     {
      "a": 3,
      "b": 2
     }
    ],
    {
     "ok": [
      "o1",
      "o3"
     ]
    }
   ],
   [
    [
     [
      "o1 z:1"
     ],
     {
      "a": 1
     }
    ],
    {
     "err": "bad order o1"
    }
   ],
   [
    [
     [],
     {
      "a": 1
     }
    ],
    {
     "ok": []
    }
   ],
   [
    [
     [
      "o1 a:0"
     ],
     {
      "a": 1
     }
    ],
    {
     "err": "bad order o1"
    }
   ],
   [
    [
     [
      "o1 a:1,a:1"
     ],
     {
      "a": 1
     }
    ],
    {
     "ok": []
    }
   ],
   [
    [
     [
      "o1"
     ],
     {
      "a": 1
     }
    ],
    {
     "err": "bad order o1"
    }
   ],
   [
    [
     [
      "o1 a:1",
      "o2 a:1"
     ],
     {
      "a": 1
     }
    ],
    {
     "ok": [
      "o1"
     ]
    }
   ],
   [
    [
     [
      "o1 a:x"
     ],
     {
      "a": 1
     }
    ],
    {
     "err": "bad order o1"
    }
   ]
  ]
 }
