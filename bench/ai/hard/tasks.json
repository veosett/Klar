 {
  "id": "h18_tokens",
  "fn": "tokens",
  "params": [
   [
    "src",
    "Str"
   ]
  ],
  "ret": "Result[List[Str], Str]",
  "statement": "Split source text into tokens, skipping spaces, tabs and line breaks. Tokens: identifiers (a letter or `_`, then letters, digits or `_`), numbers (digits), strings (from `\"` to the next `\"` that is not escaped by a backslash, both quotes included, the text kept as written), the two-character operators `==`, `!=`, `<=`, `>=`, `->`, and the single characters `+ - * / < > = ( ) { } , ;`. Fail with \"unterminated string\" for a string with no end and with \"unexpected C\" for any other character C.",
  "tests": [
   [
    [
     "x = 1 + y2;"
    ],
    {
     "ok": [
      "x",
      "=",
      "1",
      "+",
      "y2",
      ";"
     ]
    }
   ],
   [
    [
     "a->b <= 3"
    ],
    {
     "ok": [
      "a",
      "->",
      "b",
      "<=",
      "3"
     ]
    }
   ],
   [
    [
     ""
    ],
    {
     "ok": []
    }
   ],
   [
    [
     "\"hi \\\" there\" z"
    ],
    {
     "ok": [
      "\"hi \\\" there\"",
      "z"
     ]
    }
   ],
   [
    [
     "\"open"
    ],
    {
     "err": "unterminated string"
    }
   ],
   [
    [
     "a ! b"
    ],
    {
     "err": "unexpected !"
    }
   ],
   [
    [
     "_a1 == 42"
    ],
    {
     "ok": [
      "_a1",
      "==",
      "42"
     ]
    }
   ],
   [
    [
     "{ f(x, y) }\n"
    ],
    {
     "ok": [
      "{",
      "f",
      "(",
      "x",
      ",",
      "y",
      ")",
      "}"
     ]
    }
   ]
  ]
 },
