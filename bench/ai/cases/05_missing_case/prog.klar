enum Shape {
  Circle(radius: Float),
  Square(side: Float),
  Triangle(base: Float, height: Float),
}

fn area(s: Shape) -> Float {
  return match s { // BUG: Triangle is not handled
    Shape.Circle(r) => 3.14159 * r * r,
    Shape.Square(a) => a * a,
  }
}

fn main() uses io {
  print(area(Shape.Triangle(base: 4.0, height: 3.0)))
}
