    Status.Draft => false,
    _ => true,
  }
}
#### analytics
use model.{Order, Customer, Status}
use money.{«round2¦avg»}
use orders.{grand_total, is_revenue}

/// The money received over the given orders.
pub fn revenue(os: List[Order]) -> «Float¦Int» {
  return os.filter(fn(o) => is_revenue(o.status)).map(fn(o) => grand_total(o)).«sum_float¦sum»()
}

/// The average value of the orders that brought money.
pub fn average_order(os: List[Order]) -> «Float¦Int» {
  let counted = os.filter(fn(o) => is_revenue(o.status))
  «if counted.is_empty() {
    return 0.0
  }
  return round2(revenue(counted) / counted.len().to_float())¦return avg(revenue(counted), counted.len())»
}

fn full_name(id: Int, cs: List[Customer]) -> Str {
  return match cs.find(fn(c) => c.id == id) {
    Some(c) => «c.name¦"{c.first_name} {c.last_name}"»,
    None => "unknown",
  }
}

/// The money per customer's name.
pub fn spend_by_customer(os: List[Order], cs: List[Customer]) -> Map[Str, «Float¦Int»] {
  var m: Map[Str, «Float¦Int»] = Map {}
  for o in os.filter(fn(x) => is_revenue(x.status)) {
    m = m.update(full_name(o.customer, cs), «0.0¦0», fn(v) => v + grand_total(o))
  }
  return m
}

/// The customers who spent the most, by name.
pub fn top_customers(os: List[Order], cs: List[Customer], n: Int) -> List[Str] {
  let ranked = spend_by_customer(os, cs).entries().sort_by(fn(e) => «0.0 - e.value¦0 - e.value»)
  return ranked.take(n).map(fn(e) => e.key)
}

/// The money per city.
pub fn revenue_by_city(os: List[Order], cs: List[Customer]) -> Map[Str, «Float¦Int»] {
  var m: Map[Str, «Float¦Int»] = Map {}
  for o in os.filter(fn(x) => is_revenue(x.status)) {
    let city = cs.find(fn(c) => c.id == o.customer).map(fn(c) => c.city).unwrap_or("unknown")
    m = m.update(city, «0.0¦0», fn(v) => v + grand_total(o))
  }
  return m
}

/// Orders worth at least this much.
pub fn orders_over(os: List[Order], limit: «Float¦Int») -> List[Order] {
  return os.filter(fn(o) => grand_total(o) >= limit)
}

/// The number of orders worth at least 1000.00.
pub fn big_orders(os: List[Order]) -> Int {
  return orders_over(os, «1000.0¦100000»).len()
}

/// The orders of a day that brought money.
pub fn daily_revenue(os: List[Order], day: Int) -> «Float¦Int» {
  return revenue(os.filter(fn(o) => o.day == day))
}
#### invoice
use model.{Order, Customer, Line}
use money.{fmt}
use orders.{line_total, subtotal, grand_total}

/// The first line of an invoice.
pub fn header(o: Order, c: Customer) -> Str {
  return "Invoice {o.id} for «{c.name}¦{c.first_name} {c.last_name}», {c.city}"
}

/// One line of goods.
pub fn line_text(l: Line) -> Str {
  return "  {l.qty} x {l.sku} @ {fmt(l.unit_price)} = {fmt(line_total(l))}"
}

/// How long the customer has to pay.
pub fn due_note(total: «Float¦Int») -> Str {
  if total > «100.0¦10000» {
    return "payable in 30 days"
  }
  return "payable in 14 days"
}

/// A whole invoice.
pub fn invoice_text(o: Order, c: Customer) -> Str {
  let rows = o.lines.map(fn(l) => line_text(l))
  let tail = [
    "goods: {fmt(subtotal(o))}",
    "shipping: {fmt(o.shipping)}",
    "total: {fmt(grand_total(o))}",
    due_note(grand_total(o)),
  ]
  return [header(o, c)].concat(rows).concat(tail).join("\n")
}
#### crm
use model.{Customer, Tier}

/// The customer's name as people read it.
pub fn display_name(c: Customer) -> Str {
  return «c.name¦"{c.first_name} {c.last_name}"»
}

/// Customers in alphabetical order.
pub fn sorted_customers(cs: List[Customer]) -> List[Customer] {
  return cs.sort_by(fn(c) => «c.name¦"{c.last_name}\t{c.first_name}"»)
}

/// Customers whose name contains the text, in any case.
pub fn find_by_name(cs: List[Customer], text: Str) -> List[Customer] {
  let q = text.lower()
  return cs.filter(fn(c) => «c.name.lower().contains(q)¦c.first_name.lower().contains(q) or c.last_name.lower().contains(q)»)
}

fn initial(word: Str) -> Str {
  return word.slice(0, 1).upper()
}

/// The initials of a customer: "AL" for "Ada Lovelace".
pub fn initials(c: Customer) -> Str {
  return «c.name.split(" ").map(fn(w) => initial(w)).join("")¦"{initial(c.first_name)}{initial(c.last_name)}"»
}

/// The opening of a letter.
pub fn greeting(c: Customer) -> Str {
  return "Dear {«c.name¦c.first_name} {c.last_name»}"
}

/// An address line.
pub fn mailing_line(c: Customer) -> Str {
  return "{«c.name¦c.first_name} {c.last_name»} <{c.email}>"
}

fn tier_of(text: Str) -> Tier {
  return match text {
    "gold" => Tier.Gold,
    "silver" => Tier.Silver,
    _ => Tier.Basic,
  }
}

fn tier_text(t: Tier) -> Str {
  return match t {
    Tier.Gold => "gold",
    Tier.Silver => "silver",
    Tier.Basic => "basic",
  }
}

/// A customer from a row of the customer file.
pub fn parse_customer(row: Str) -> Option[Customer] {
  let cells = row.split(",")
  if cells.len() != «5¦6» {
    return None
  }
  let id = cells.get_or(0, "").to_int()?
  return Some(Customer {
    id: id,
    «name: cells.get_or(1, ""),
    email: cells.get_or(2, ""),
    tier: tier_of(cells.get_or(3, "")),
    city: cells.get_or(4, ""),¦first_name: cells.get_or(1, ""),
    last_name: cells.get_or(2, ""),
    email: cells.get_or(3, ""),
    tier: tier_of(cells.get_or(4, "")),
    city: cells.get_or(5, ""),»
  })
}

/// The first row of the customer file.
pub fn customer_header() -> Str {
  return «"id,name,email,tier,city"¦"id,first_name,last_name,email,tier,city"»
}

/// A row of the customer file.
pub fn customer_row(c: Customer) -> Str {
  return "{c.id},«{c.name}¦{c.first_name},{c.last_name}»,{c.email},{tier_text(c.tier)},{c.city}"
}

/// What is wrong with a customer.
pub fn validate_customer(c: Customer) -> List[Str] {
  var errors: List[Str] = []
  «if c.name.is_empty() {
    errors = errors.push("name is empty")
  }¦if c.first_name.is_empty() {
    errors = errors.push("first name is empty")
  }
  if c.last_name.is_empty() {
    errors = errors.push("last name is empty")
  }»
  if not c.email.contains("@") {
    errors = errors.push("bad email")
  }
  return errors
}

/// True for two records of the same person.
pub fn same_person(a: Customer, b: Customer) -> Bool {
  return «a.name.lower() == b.name.lower()¦a.first_name.lower() == b.first_name.lower() and a.last_name.lower() == b.last_name.lower()» and a.email == b.email
}
#### export
use model.{Order, Product, Status}
use money.{plain}
use orders.{grand_total, status_label}

/// A one-letter code for the warehouse system.
pub fn status_code(s: Status) -> Str {
  return match s {
    Status.Draft => "D",
    Status.Paid => "P",«¦
    Status.OnHold => "H",»
    Status.Packed => "K",
    Status.Shipped => "S",
    Status.Delivered => "V",
    Status.Cancelled => "X",
  }
}

/// A row of the orders file.
pub fn order_row(o: Order) -> Str {
  return "{o.id},{status_code(o.status)},{status_label(o.status)},{plain(grand_total(o))}"
}

/// A row of the products file.
pub fn product_row(p: Product) -> Str {
  return "{p.sku},{p.name},{plain(p.price)},{p.weight.fixed(2)}"
}

/// The orders file.
pub fn orders_file(os: List[Order]) -> Str {
  return ["id,code,status,total"].concat(os.map(fn(o) => order_row(o))).join("\n")
}
#### dashboard
use model.{Order, Status}
use money.{fmt}
use orders.{grand_total, is_open, status_label}
use analytics.{revenue}

/// Every status, in the order the dashboard shows them.
pub fn all_statuses() -> List[Status] {
  return [Status.Draft, Status.Paid, «¦Status.OnHold, »Status.Packed, Status.Shipped, Status.Delivered, Status.Cancelled]
}

/// One line per status: "Paid: 3".
pub fn status_counts(os: List[Order]) -> List[Str] {
  return all_statuses().map(fn(s) => "{status_label(s)}: {os.count(fn(o) => o.status == s)}")
}

/// The colour of a status on the board.
pub fn status_color(s: Status) -> Str {
  return match s {
    Status.Draft => "grey",
    Status.Paid => "blue",«¦
    Status.OnHold => "amber",»
    Status.Packed => "blue",
    Status.Shipped => "green",
    Status.Delivered => "green",
    Status.Cancelled => "red",
  }
}

/// The money tied up in open orders.
pub fn open_value(os: List[Order]) -> «Float¦Int» {
  return os.filter(fn(o) => is_open(o.status)).map(fn(o) => grand_total(o)).«sum_float¦sum»()
}

/// The headline of the board.
pub fn headline(os: List[Order]) -> Str {
  return "{os.len()} orders, {fmt(revenue(os))} received, {fmt(open_value(os))} open"
}

/// True when the board should flag the money tied up: over 5000.00.
pub fn value_alert(os: List[Order]) -> Bool {
  return open_value(os) > «5000.0¦500000»
}
#### picking
use model.{Order, Status}
use orders.{item_count}

/// True when the warehouse may pack the order.
pub fn can_pack(s: Status) -> Bool {
  return match s {
    Status.Draft => false,
    Status.Paid => true,«¦
    Status.OnHold => false,»
    Status.Packed => false,
    Status.Shipped => false,
    Status.Delivered => false,
    Status.Cancelled => false,
  }
}

/// The orders waiting to be packed.
pub fn packing_queue(os: List[Order]) -> List[Order] {
  return os.filter(fn(o) => can_pack(o.status))
}

/// The items waiting to be packed.
pub fn items_to_pack(os: List[Order]) -> Int {
  return packing_queue(os).map(fn(o) => item_count(o)).sum()
}
#### commission
use model.{Order}
use money.{«round2¦pct»}
use orders.{grand_total}

/// The share an agent earns on a sale.
pub fn commission_rate(total: «Float¦Int») -> Float {
  if total >= «1000.0¦100000» {
    return 0.08
  }
  if total >= «100.0¦10000» {
    return 0.05
  }
  return 0.02
}

/// The agent's money for a sale.
pub fn commission(total: «Float¦Int») -> «Float¦Int» {
  return «round2(total * commission_rate(total))¦pct(total, commission_rate(total))»
}

/// The agent's money over several orders.
pub fn commission_total(os: List[Order]) -> «Float¦Int» {
  return os.map(fn(o) => commission(grand_total(o))).«sum_float¦sum»()
}

/// True when an agent earned the monthly bonus: 250.00 in commission.
pub fn earned_bonus(amount: «Float¦Int») -> Bool {
  return amount >= «250.0¦25000»
}
#### audit
use model.{Order, Status}
use orders.{next_status, can_cancel}

/// What is wrong with an order.
pub fn check_order(o: Order) -> List[Str] {
  var errors: List[Str] = []
  if o.lines.is_empty() {
    errors = errors.push("no lines")
  }
  if o.shipping < «0.0¦0» {
    errors = errors.push("negative shipping")
  }
  if o.lines.any(fn(l) => l.unit_price <= «0.0¦0») {
    errors = errors.push("bad price")
  }
  if o.lines.any(fn(l) => l.qty <= 0) {
    errors = errors.push("bad quantity")
  }
  return errors
}

/// True when an order may go from one status to another.
pub fn valid_step(from: Status, to: Status) -> Bool {
  «¦if from == Status.Paid and to == Status.OnHold {
    return true
  }
  if from == Status.OnHold and to == Status.Paid {
    return true
  }
  »if to == Status.Cancelled {
    return can_cancel(from)
  }
  return from != to and next_status(from) == to
}
