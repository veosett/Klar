#### catalog
use model.{Product, Category}
use money.{fmt, «round2¦pct, avg»}

/// How a product is shelved.
pub fn price_band(p: Product) -> Str {
  if p.price < «10.0¦1000» {
    return "cheap"
  }
  if p.price < «100.0¦10000» {
    return "regular"
  }
  return "premium"
}

/// The price after taking off a share of it.
pub fn sale_price(p: Product, off: Float) -> «Float¦Int» {
  return «round2(p.price - p.price * off)¦p.price - pct(p.price, off)»
}

/// The value of the stock of a product.
pub fn stock_value(p: Product) -> «Float¦Int» {
  return p.price * «p.stock.to_float()¦p.stock»
}

/// The value of all the stock.
pub fn catalog_value(ps: List[Product]) -> «Float¦Int» {
  return ps.map(fn(p) => stock_value(p)).«sum_float¦sum»()
}

/// The average price, or nothing for no products.
pub fn average_price(ps: List[Product]) -> «Float¦Int» {
  «if ps.is_empty() {
    return 0.0
  }
  return round2(ps.map(fn(p) => p.price).sum_float() / ps.len().to_float())¦return avg(ps.map(fn(p) => p.price).sum(), ps.len())»
}

/// The dearest product.
pub fn most_expensive(ps: List[Product]) -> Option[Product] {
  return ps.max_by(fn(p) => p.price)
}

/// Products one can buy with a budget.
pub fn within_budget(ps: List[Product], budget: «Float¦Int») -> List[Product] {
  return ps.filter(fn(p) => p.price <= budget)
}

/// A shelf label.
pub fn price_label(p: Product) -> Str {
  return "{p.name}: {fmt(p.price)}"
}

/// True when a product counts as a gift: not food, and under 25.00.
pub fn is_gift(p: Product) -> Bool {
  return p.category != Category.Food and p.price < «25.0¦2500»
}

/// Products of one category, dearest first.
pub fn in_category(ps: List[Product], c: Category) -> List[Product] {
  return ps.filter(fn(p) => p.category == c).sort_by(fn(p) => «0.0 - p.price¦0 - p.price»)
}
#### tax
use model.{Order, Line, Product, Category, Status}
use money.{fmt, «round2¦pct»}
use orders.{line_total}

/// The tax rate of a category.
pub fn rate_for(c: Category) -> Float {
  return match c {
    Category.Book => 0.0,
    Category.Food => 0.05,
    Category.Toy => 0.2,
    Category.Tool => 0.2,
    Category.Garden => 0.1,
  }
}

fn category_of(sku: Str, ps: List[Product]) -> Category {
  return match ps.find(fn(p) => p.sku == sku) {
    Some(p) => p.category,
    None => Category.Book,
  }
}

/// The tax of one line.
pub fn line_tax(l: Line, ps: List[Product]) -> «Float¦Int» {
  let rate = rate_for(category_of(l.sku, ps))
  return «round2(line_total(l) * rate)¦pct(line_total(l), rate)»
}

/// The tax of an order: nothing until it is paid, nothing when cancelled.
pub fn order_tax(o: Order, ps: List[Product]) -> «Float¦Int» {
  return match taxable(o.status) {
    true => o.lines.map(fn(l) => line_tax(l, ps)).«sum_float¦sum»(),
    false => «0.0¦0»,
  }
}

/// True when the order owes tax.
pub fn taxable(s: Status) -> Bool {
  return match s {
    Status.Draft => false,
    Status.Paid => true,«¦
    Status.OnHold => true,»
    Status.Packed => true,
    Status.Shipped => true,
    Status.Delivered => true,
    Status.Cancelled => false,
  }
}

/// The tax line of a receipt.
pub fn tax_note(t: «Float¦Int») -> Str {
  if t == «0.0¦0» {
    return "tax free"
  }
  return "tax {fmt(t)}"
}
#### discount
use model.{Tier}
use money.{«round2¦pct»}

/// The share a tier takes off.
pub fn tier_rate(t: Tier) -> Float {
  return match t {
    Tier.Basic => 0.0,
    Tier.Silver => 0.05,
    Tier.Gold => 0.1,
  }
}

/// The share a large basket takes off.
pub fn volume_rate(amount: «Float¦Int») -> Float {
  if amount >= «500.0¦50000» {
    return 0.1
  }
  if amount >= «200.0¦20000» {
    return 0.05
  }
  return 0.0
}

/// The discount: the better of the tier and the basket.
pub fn discount_for(amount: «Float¦Int», t: Tier) -> «Float¦Int» {
  let rate = tier_rate(t).max(volume_rate(amount))
  return «round2(amount * rate)¦pct(amount, rate)»
}

/// What a coupon takes off, never more than the basket.
pub fn coupon_value(code: Str, amount: «Float¦Int») -> «Float¦Int» {
  let off = match code {
    "FIVE" => «5.0¦500»,
    "TEN" => «10.0¦1000»,
    _ => «0.0¦0»,
  }
  return off.min(amount)
}

/// The basket after the discount and the coupon.
pub fn net_amount(amount: «Float¦Int», t: Tier, code: Str) -> «Float¦Int» {
  return amount - discount_for(amount, t) - coupon_value(code, amount)
}
#### shipping
use model.{Tier}
use money.{fmt, «round2¦pct»}

/// Baskets from this amount ship free.
pub const FREE_OVER: «Float¦Int» = «50.0¦5000»

/// The cost of sending a parcel.
pub fn shipping_cost(amount: «Float¦Int», weight: Float) -> «Float¦Int» {
  if amount >= FREE_OVER {
    return «0.0¦0»
  }
  return «round2(4.99 + weight * 1.5)¦499 + pct(150, weight)»
}

/// The cost for a member: gold members pay half.
pub fn member_cost(cost: «Float¦Int», t: Tier) -> «Float¦Int» {
  return match t {
    Tier.Gold => «round2(cost * 0.5)¦pct(cost, 0.5)»,
    _ => cost,
  }
}

/// A surcharge for hard to reach places.
pub fn surcharge(city: Str) -> «Float¦Int» {
  return match city {
    "Harbour" => «7.5¦750»,
    "Summit" => «12.0¦1200»,
    _ => «0.0¦0»,
  }
}

/// The shipping line of a receipt.
pub fn shipping_label(cost: «Float¦Int») -> Str {
  if cost == «0.0¦0» {
    return "free shipping"
  }
  return "shipping {fmt(cost)}"
}
#### loyalty
use model.{Tier}

/// One point for every whole 10.00.
pub fn points_for(total: «Float¦Int») -> Int {
  return «(total / 10.0).floor()¦total / 1000»
}

/// The tier that a year of spending earns.
pub fn tier_after(spent: «Float¦Int») -> Tier {
  if spent >= «1000.0¦100000» {
    return Tier.Gold
  }
  if spent >= «300.0¦30000» {
    return Tier.Silver
  }
  return Tier.Basic
}

/// The money that points are worth: 0.10 each.
pub fn redeem_value(points: Int) -> «Float¦Int» {
  return «points.to_float() * 0.1¦points * 10»
}

/// Points still missing for the next whole 10.00.
pub fn to_next_point(total: «Float¦Int») -> «Float¦Int» {
  return «10.0 - (total - (total / 10.0).floor().to_float() * 10.0)¦1000 - total % 1000»
}
#### fraud
use model.{Order, Customer, Status, Tier}
use orders.{grand_total, item_count}

/// How suspicious an order looks.
pub fn risk_score(o: Order, c: Customer) -> Int {
  var score = 0
  if grand_total(o) >= «1000.0¦100000» {
    score = score + 3
  } else if grand_total(o) >= «300.0¦30000» {
    score = score + 1
  }
  if item_count(o) > 20 {
    score = score + 1
  }
  if c.tier == Tier.Basic {
    score = score + 1
  }
  return score
}

/// True when fraud review should look at the order.
pub fn needs_review(o: Order, c: Customer) -> Bool {
  return is_reviewable(o.status) and risk_score(o, c) >= 3
}

/// True when the order can still be stopped by a review.
pub fn is_reviewable(s: Status) -> Bool {
  return match s {
    Status.Draft => false,
    Status.Paid => true,«¦
    Status.OnHold => true,»
    Status.Packed => true,
    Status.Shipped => false,
    Status.Delivered => false,
    Status.Cancelled => false,
  }
}
#### refunds
use model.{Order, Status}
use money.{fmt, «round2¦pct»}
use orders.{grand_total}

/// The share of the money that comes back.
pub fn refund_share(s: Status) -> Float {
  return match s {
    Status.Draft => 0.0,
    Status.Paid => 1.0,«¦
    Status.OnHold => 1.0,»
    Status.Packed => 1.0,
    Status.Shipped => 0.95,
    Status.Delivered => 0.9,
    Status.Cancelled => 0.0,
  }
}

/// The money that comes back for an order.
pub fn refund_amount(o: Order) -> «Float¦Int» {
  return «round2(grand_total(o) * refund_share(o.status))¦pct(grand_total(o), refund_share(o.status))»
}

/// A line for the customer.
pub fn refund_note(o: Order) -> Str {
  return "Refund {fmt(refund_amount(o))} for order {o.id}"
}

/// The fee for sending goods back: 3.50 below 20.00, otherwise free.
pub fn return_fee(amount: «Float¦Int») -> «Float¦Int» {
  if amount < «20.0¦2000» {
    return «3.5¦350»
  }
  return «0.0¦0»
}
