from analytics import revenue
from model import Order, Status
from money import fmt
from orders import grand_total, is_open, status_label


def all_statuses() -> list[Status]:
    """Every status, in the order the dashboard shows them."""
    return [Status.DRAFT, Status.PAID, «¦Status.ON_HOLD, »Status.PACKED, Status.SHIPPED, Status.DELIVERED, Status.CANCELLED]


def status_counts(os: list[Order]) -> list[str]:
    """One line per status: "Paid: 3"."""
    return [f"{status_label(s)}: {sum(1 for o in os if o.status == s)}" for s in all_statuses()]


def status_color(s: Status) -> str:
    """The colour of a status on the board."""
    if s == Status.DRAFT:
        return "grey"
    if s in (Status.PAID, Status.PACKED):
        return "blue"«¦
    if s == Status.ON_HOLD:
        return "amber"»
    if s in (Status.SHIPPED, Status.DELIVERED):
        return "green"
    return "red"


def open_value(os: list[Order]) -> «float¦int»:
    """The money tied up in open orders."""
    return sum(grand_total(o) for o in os if is_open(o.status))


def headline(os: list[Order]) -> str:
    """The headline of the board."""
    return f"{len(os)} orders, {fmt(revenue(os))} received, {fmt(open_value(os))} open"


def value_alert(os: list[Order]) -> bool:
    """True when the board should flag the money tied up: over 5000.00."""
    return open_value(os) > «5000.0¦500000»
#### picking
from model import Order, Status
from orders import item_count


def can_pack(s: Status) -> bool:
    """True when the warehouse may pack the order."""
    return s == Status.PAID


def packing_queue(os: list[Order]) -> list[Order]:
    """The orders waiting to be packed."""
    return [o for o in os if can_pack(o.status)]


def items_to_pack(os: list[Order]) -> int:
    """The items waiting to be packed."""
    return sum(item_count(o) for o in packing_queue(os))
#### commission
from model import Order
from money import «round2¦pct»
from orders import grand_total


def commission_rate(total: «float¦int») -> float:
    """The share an agent earns on a sale."""
    if total >= «1000.0¦100000»:
        return 0.08
    if total >= «100.0¦10000»:
        return 0.05
    return 0.02


def commission(total: «float¦int») -> «float¦int»:
    """The agent's money for a sale."""
    return «round2(total * commission_rate(total))¦pct(total, commission_rate(total))»


def commission_total(os: list[Order]) -> «float¦int»:
    """The agent's money over several orders."""
    return sum(commission(grand_total(o)) for o in os)


def earned_bonus(amount: «float¦int») -> bool:
    """True when an agent earned the monthly bonus: 250.00 in commission."""
    return amount >= «250.0¦25000»
#### audit
from model import Order, Status
from orders import can_cancel, next_status


def check_order(o: Order) -> list[str]:
    """What is wrong with an order."""
    errors = []
    if not o.lines:
        errors.append("no lines")
    if o.shipping < 0:
        errors.append("negative shipping")
    if any(l.unit_price <= 0 for l in o.lines):
        errors.append("bad price")
    if any(l.qty <= 0 for l in o.lines):
        errors.append("bad quantity")
    return errors


def valid_step(start: Status, to: Status) -> bool:
    """True when an order may go from one status to another."""
    «¦if start == Status.PAID and to == Status.ON_HOLD:
        return True
    if start == Status.ON_HOLD and to == Status.PAID:
        return True
    »if to == Status.CANCELLED:
        return can_cancel(start)
    return start != to and next_status(start) == to
