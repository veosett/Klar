from model import Customer, Order, Status
from money import fmt
from orders import grand_total


def message_for(o: Order, c: Customer) -> str:
    """What the customer is told about an order."""
    who = «c.name¦f"{c.first_name} {c.last_name}"»
    if o.status == Status.DRAFT:
        return f"{who}, your order {o.id} is not paid yet"
    if o.status == Status.PAID:
        return f"{who}, we received {fmt(grand_total(o))} for order {o.id}"«¦
    if o.status == Status.ON_HOLD:
        return f"{who}, your order {o.id} is on hold"»
    if o.status == Status.PACKED:
        return f"{who}, your order {o.id} is packed"
    if o.status == Status.SHIPPED:
        return f"{who}, your order {o.id} is on its way"
    if o.status == Status.DELIVERED:
        return f"{who}, your order {o.id} arrived"
    return f"{who}, your order {o.id} was cancelled"


def reminder(c: Customer, amount: «float¦int») -> str:
    """A reminder to pay."""
    return f"{«c.name¦c.first_name} {c.last_name»}: please pay {fmt(amount)}"


def should_notify(s: Status) -> bool:
    """True when the customer should get a message."""
    return s != Status.DRAFT
#### analytics
from model import Customer, Order
from money import «round2¦avg»
from orders import grand_total, is_revenue


def revenue(os: list[Order]) -> «float¦int»:
    """The money received over the given orders."""
    return sum(grand_total(o) for o in os if is_revenue(o.status))


def average_order(os: list[Order]) -> «float¦int»:
    """The average value of the orders that brought money."""
    counted = [o for o in os if is_revenue(o.status)]
    «if not counted:
        return 0.0
    return round2(revenue(counted) / len(counted))¦return avg(revenue(counted), len(counted))»


def full_name(id: int, cs: list[Customer]) -> str:
    for c in cs:
        if c.id == id:
            return «c.name¦f"{c.first_name} {c.last_name}"»
    return "unknown"


def spend_by_customer(os: list[Order], cs: list[Customer]) -> dict[str, «float¦int»]:
    """The money per customer's name."""
    m: dict[str, «float¦int»] = {}
    for o in os:
        if is_revenue(o.status):
            who = full_name(o.customer, cs)
            m[who] = m.get(who, «0.0¦0») + grand_total(o)
    return m


def top_customers(os: list[Order], cs: list[Customer], n: int) -> list[str]:
    """The customers who spent the most, by name."""
    ranked = sorted(spend_by_customer(os, cs).items(), key=lambda e: -e[1])
    return [e[0] for e in ranked[:n]]


def revenue_by_city(os: list[Order], cs: list[Customer]) -> dict[str, «float¦int»]:
    """The money per city."""
    cities = {c.id: c.city for c in cs}
    m: dict[str, «float¦int»] = {}
    for o in os:
        if is_revenue(o.status):
            city = cities.get(o.customer, "unknown")
            m[city] = m.get(city, «0.0¦0») + grand_total(o)
    return m


def orders_over(os: list[Order], limit: «float¦int») -> list[Order]:
    """Orders worth at least this much."""
    return [o for o in os if grand_total(o) >= limit]


def big_orders(os: list[Order]) -> int:
    """The number of orders worth at least 1000.00."""
    return len(orders_over(os, «1000.0¦100000»))


def daily_revenue(os: list[Order], day: int) -> «float¦int»:
    """The orders of a day that brought money."""
    return revenue([o for o in os if o.day == day])
#### invoice
from model import Customer, Line, Order
from money import fmt
from orders import grand_total, line_total, subtotal


def header(o: Order, c: Customer) -> str:
    """The first line of an invoice."""
    return f"Invoice {o.id} for «{c.name}¦{c.first_name} {c.last_name}», {c.city}"


def line_text(l: Line) -> str:
    """One line of goods."""
    return f"  {l.qty} x {l.sku} @ {fmt(l.unit_price)} = {fmt(line_total(l))}"


def due_note(total: «float¦int») -> str:
    """How long the customer has to pay."""
    if total > «100.0¦10000»:
        return "payable in 30 days"
    return "payable in 14 days"


def invoice_text(o: Order, c: Customer) -> str:
    """A whole invoice."""
    rows = [line_text(l) for l in o.lines]
    tail = [
        f"goods: {fmt(subtotal(o))}",
        f"shipping: {fmt(o.shipping)}",
        f"total: {fmt(grand_total(o))}",
        due_note(grand_total(o)),
    ]
    return "\n".join([header(o, c), *rows, *tail])
#### crm
from model import Customer, Tier


def display_name(c: Customer) -> str:
    """The customer's name as people read it."""
    return «c.name¦f"{c.first_name} {c.last_name}"»


def sorted_customers(cs: list[Customer]) -> list[Customer]:
    """Customers in alphabetical order."""
    return sorted(cs, key=lambda c: «c.name¦(c.last_name, c.first_name)»)


def find_by_name(cs: list[Customer], text: str) -> list[Customer]:
    """Customers whose name contains the text, in any case."""
    q = text.lower()
    return [c for c in cs if «q in c.name.lower()¦q in c.first_name.lower() or q in c.last_name.lower()»]


def initials(c: Customer) -> str:
    """The initials of a customer: "AL" for "Ada Lovelace"."""
    return «"".join(w[:1].upper() for w in c.name.split(" "))¦(c.first_name[:1] + c.last_name[:1]).upper()»


def greeting(c: Customer) -> str:
    """The opening of a letter."""
    return f"Dear {«c.name¦c.first_name} {c.last_name»}"


def mailing_line(c: Customer) -> str:
    """An address line."""
    return f"{«c.name¦c.first_name} {c.last_name»} <{c.email}>"


TIERS = {"gold": Tier.GOLD, "silver": Tier.SILVER}


def tier_text(t: Tier) -> str:
    return t.value


def parse_customer(row: str) -> Customer | None:
    """A customer from a row of the customer file."""
    cells = row.split(",")
    if len(cells) != «5¦6» or not cells[0].isdigit():
        return None
    «return Customer(int(cells[0]), cells[1], cells[2], TIERS.get(cells[3], Tier.BASIC), cells[4])¦return Customer(int(cells[0]), cells[1], cells[2], cells[3], TIERS.get(cells[4], Tier.BASIC), cells[5])»


def customer_header() -> str:
    """The first row of the customer file."""
    return «"id,name,email,tier,city"¦"id,first_name,last_name,email,tier,city"»


def customer_row(c: Customer) -> str:
    """A row of the customer file."""
    return f"{c.id},«{c.name}¦{c.first_name},{c.last_name}»,{c.email},{tier_text(c.tier)},{c.city}"


def validate_customer(c: Customer) -> list[str]:
    """What is wrong with a customer."""
    errors = []
    «if not c.name:
        errors.append("name is empty")¦if not c.first_name:
        errors.append("first name is empty")
    if not c.last_name:
        errors.append("last name is empty")»
    if "@" not in c.email:
        errors.append("bad email")
    return errors


def same_person(a: Customer, b: Customer) -> bool:
    """True for two records of the same person."""
    return «a.name.lower() == b.name.lower()¦a.first_name.lower() == b.first_name.lower() and a.last_name.lower() == b.last_name.lower()» and a.email == b.email
#### export
from model import Order, Product, Status
from money import plain
from orders import grand_total, status_label

STATUS_CODES = {
    Status.DRAFT: "D",
    Status.PAID: "P",«¦
    Status.ON_HOLD: "H",»
    Status.PACKED: "K",
    Status.SHIPPED: "S",
    Status.DELIVERED: "V",
    Status.CANCELLED: "X",
}


def status_code(s: Status) -> str:
    """A one-letter code for the warehouse system."""
    return STATUS_CODES[s]


def order_row(o: Order) -> str:
    """A row of the orders file."""
    return f"{o.id},{status_code(o.status)},{status_label(o.status)},{plain(grand_total(o))}"


def product_row(p: Product) -> str:
    """A row of the products file."""
    return f"{p.sku},{p.name},{plain(p.price)},{p.weight:.2f}"


def orders_file(os: list[Order]) -> str:
    """The orders file."""
    return "\n".join(["id,code,status,total", *(order_row(o) for o in os)])
