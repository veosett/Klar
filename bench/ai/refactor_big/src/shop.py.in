#### money
«¦import math


»def plain(«amount: float¦cents: int») -> str:
    """Money as digits: "12.50"."""
    «return f"{amount:.2f}"¦a = abs(cents)
    sign = "-" if cents < 0 else ""
    return f"{sign}{a // 100}.{a % 100:02d}"»


def fmt(«amount: float¦cents: int») -> str:
    """Money as text: "$12.50"."""
    return «"$" + plain(amount)¦"$" + plain(cents)»


«def round2(amount: float) -> float:
    """An amount rounded to the cent."""
    return round(amount, 2)
¦def pct(cents: int, rate: float) -> int:
    """A share of an amount, rounded half up to the cent."""
    return math.floor(cents * rate + 0.5)


def avg(total: int, n: int) -> int:
    """The average of `n` amounts, rounded half up."""
    if n <= 0:
        return 0
    return (2 * total + n) // (2 * n)
»
#### model
from dataclasses import dataclass
from enum import Enum


class Status(Enum):
    """Where an order is in its life."""
    DRAFT = "draft"
    PAID = "paid"«¦
    ON_HOLD = "on_hold"»
    PACKED = "packed"
    SHIPPED = "shipped"
    DELIVERED = "delivered"
    CANCELLED = "cancelled"


class Tier(Enum):
    BASIC = "basic"
    SILVER = "silver"
    GOLD = "gold"


class Category(Enum):
    BOOK = "book"
    TOY = "toy"
    FOOD = "food"
    TOOL = "tool"
    GARDEN = "garden"


@dataclass(frozen=True)
class Product:
    sku: str
    name: str
    price: «float¦int»
    weight: float
    category: Category
    stock: int
    supplier: int


@dataclass(frozen=True)
class Customer:
    id: int
    «name: str¦first_name: str
    last_name: str»
    email: str
    tier: Tier
    city: str


@dataclass(frozen=True)
class Line:
    sku: str
    qty: int
    unit_price: «float¦int»


@dataclass(frozen=True)
class Order:
    id: int
    customer: int
    lines: list[Line]
    status: Status
    shipping: «float¦int»
    day: int
#### orders
from dataclasses import replace

from model import Line, Order, Status


def line_total(l: Line) -> «float¦int»:
    """The price of one line."""
    return l.unit_price * l.qty


def subtotal(o: Order) -> «float¦int»:
    """The goods of an order, without shipping."""
    return sum(line_total(l) for l in o.lines)


def grand_total(o: Order) -> «float¦int»:
    """What the customer pays."""
    return subtotal(o) + o.shipping


def item_count(o: Order) -> int:
    """The number of items in an order."""
    return sum(l.qty for l in o.lines)


STATUS_LABELS = {
    Status.DRAFT: "Draft",
    Status.PAID: "Paid",«¦
    Status.ON_HOLD: "On hold",»
    Status.PACKED: "Packed",
    Status.SHIPPED: "Shipped",
    Status.DELIVERED: "Delivered",
    Status.CANCELLED: "Cancelled",
}


def status_label(s: Status) -> str:
    """The status as people read it."""
    return STATUS_LABELS[s]


def is_open(s: Status) -> bool:
    """True while there is still work to do on the order."""
    return s in (Status.DRAFT, Status.PAID, «¦Status.ON_HOLD, »Status.PACKED, Status.SHIPPED)


def next_status(s: Status) -> Status:
    """The next step of an order."""
    match s:
        case Status.DRAFT:
            return Status.PAID
        case Status.PAID:
            return Status.PACKED«¦
        case Status.ON_HOLD:
            return Status.ON_HOLD»
        case Status.PACKED:
            return Status.SHIPPED
        case Status.SHIPPED:
            return Status.DELIVERED
        case Status.DELIVERED:
            return Status.DELIVERED
        case Status.CANCELLED:
            return Status.CANCELLED


def can_cancel(s: Status) -> bool:
    """True while the customer can still cancel."""
    return s in (Status.DRAFT, Status.PAID«¦, Status.ON_HOLD»)


def is_revenue(s: Status) -> bool:
    """True when money was received for the order."""
    return s not in (Status.DRAFT, Status.CANCELLED)


def advance(o: Order) -> Order:
    """The order one step further."""
    return replace(o, status=next_status(o.status))


def cancel(o: Order) -> Order:
    """The order cancelled, if that is still possible."""
    return replace(o, status=Status.CANCELLED) if can_cancel(o.status) else o
«¦

def hold(o: Order) -> Order:
    """Fraud review freezes a paid order."""
    return replace(o, status=Status.ON_HOLD) if o.status == Status.PAID else o


def release(o: Order) -> Order:
    """Fraud review lets a frozen order go."""
    return replace(o, status=Status.PAID) if o.status == Status.ON_HOLD else o
»
#### catalog
from model import Category, Product
from money import fmt, «round2¦avg, pct»


def price_band(p: Product) -> str:
    """How a product is shelved."""
    if p.price < «10.0¦1000»:
        return "cheap"
    if p.price < «100.0¦10000»:
        return "regular"
    return "premium"


def sale_price(p: Product, off: float) -> «float¦int»:
    """The price after taking off a share of it."""
    return «round2(p.price - p.price * off)¦p.price - pct(p.price, off)»


def stock_value(p: Product) -> «float¦int»:
    """The value of the stock of a product."""
    return p.price * p.stock


def catalog_value(ps: list[Product]) -> «float¦int»:
    """The value of all the stock."""
    return sum(stock_value(p) for p in ps)


def average_price(ps: list[Product]) -> «float¦int»:
    """The average price, or nothing for no products."""
    «if not ps:
        return 0.0
    return round2(sum(p.price for p in ps) / len(ps))¦return avg(sum(p.price for p in ps), len(ps))»


def most_expensive(ps: list[Product]) -> Product | None:
    """The dearest product."""
    return max(ps, key=lambda p: p.price, default=None)


def within_budget(ps: list[Product], budget: «float¦int») -> list[Product]:
    """Products one can buy with a budget."""
    return [p for p in ps if p.price <= budget]


def price_label(p: Product) -> str:
    """A shelf label."""
    return f"{p.name}: {fmt(p.price)}"


def is_gift(p: Product) -> bool:
    """True when a product counts as a gift: not food, and under 25.00."""
    return p.category != Category.FOOD and p.price < «25.0¦2500»


def in_category(ps: list[Product], c: Category) -> list[Product]:
    """Products of one category, dearest first."""
    return sorted((p for p in ps if p.category == c), key=lambda p: -p.price)
#### tax
from model import Category, Line, Order, Product, Status
from money import fmt, «round2¦pct»
from orders import line_total


def rate_for(c: Category) -> float:
    """The tax rate of a category."""
    match c:
        case Category.BOOK:
            return 0.0
        case Category.FOOD:
            return 0.05
        case Category.TOY | Category.TOOL:
            return 0.2
        case Category.GARDEN:
            return 0.1


def category_of(sku: str, ps: list[Product]) -> Category:
    for p in ps:
        if p.sku == sku:
            return p.category
    return Category.BOOK


def line_tax(l: Line, ps: list[Product]) -> «float¦int»:
    """The tax of one line."""
    rate = rate_for(category_of(l.sku, ps))
    return «round2(line_total(l) * rate)¦pct(line_total(l), rate)»


def order_tax(o: Order, ps: list[Product]) -> «float¦int»:
    """The tax of an order: nothing until it is paid, nothing when cancelled."""
    if not taxable(o.status):
        return «0.0¦0»
    return sum(line_tax(l, ps) for l in o.lines)


def taxable(s: Status) -> bool:
    """True when the order owes tax."""
    return s not in (Status.DRAFT, Status.CANCELLED)


def tax_note(t: «float¦int») -> str:
    """The tax line of a receipt."""
    if t == 0:
        return "tax free"
    return f"tax {fmt(t)}"
#### discount
from model import Tier
from money import «round2¦pct»


def tier_rate(t: Tier) -> float:
    """The share a tier takes off."""
    match t:
        case Tier.BASIC:
            return 0.0
        case Tier.SILVER:
            return 0.05
        case Tier.GOLD:
            return 0.1


def volume_rate(amount: «float¦int») -> float:
    """The share a large basket takes off."""
    if amount >= «500.0¦50000»:
        return 0.1
    if amount >= «200.0¦20000»:
        return 0.05
    return 0.0


def discount_for(amount: «float¦int», t: Tier) -> «float¦int»:
    """The discount: the better of the tier and the basket."""
    rate = max(tier_rate(t), volume_rate(amount))
    return «round2(amount * rate)¦pct(amount, rate)»


COUPONS = {"FIVE": «5.0¦500», "TEN": «10.0¦1000»}


def coupon_value(code: str, amount: «float¦int») -> «float¦int»:
    """What a coupon takes off, never more than the basket."""
    return min(COUPONS.get(code, «0.0¦0»), amount)


def net_amount(amount: «float¦int», t: Tier, code: str) -> «float¦int»:
    """The basket after the discount and the coupon."""
    return amount - discount_for(amount, t) - coupon_value(code, amount)
#### shipping
from model import Tier
from money import fmt, «round2¦pct»

FREE_OVER = «50.0¦5000»  # baskets from this amount ship free


def shipping_cost(amount: «float¦int», weight: float) -> «float¦int»:
    """The cost of sending a parcel."""
    if amount >= FREE_OVER:
        return «0.0¦0»
    return «round2(4.99 + weight * 1.5)¦499 + pct(150, weight)»


def member_cost(cost: «float¦int», t: Tier) -> «float¦int»:
    """The cost for a member: gold members pay half."""
    if t == Tier.GOLD:
        return «round2(cost * 0.5)¦pct(cost, 0.5)»
    return cost


SURCHARGES = {"Harbour": «7.5¦750», "Summit": «12.0¦1200»}


def surcharge(city: str) -> «float¦int»:
    """A surcharge for hard to reach places."""
    return SURCHARGES.get(city, «0.0¦0»)


def shipping_label(cost: «float¦int») -> str:
    """The shipping line of a receipt."""
    if cost == 0:
        return "free shipping"
    return f"shipping {fmt(cost)}"
#### loyalty
from model import Tier


def points_for(total: «float¦int») -> int:
    """One point for every whole 10.00."""
    return «int(total // 10)¦total // 1000»


def tier_after(spent: «float¦int») -> Tier:
    """The tier that a year of spending earns."""
    if spent >= «1000.0¦100000»:
        return Tier.GOLD
    if spent >= «300.0¦30000»:
        return Tier.SILVER
    return Tier.BASIC


def redeem_value(points: int) -> «float¦int»:
    """The money that points are worth: 0.10 each."""
    return points * «0.1¦10»


def to_next_point(total: «float¦int») -> «float¦int»:
    """Points still missing for the next whole 10.00."""
    return «10.0 - total % 10¦1000 - total % 1000»
#### fraud
from model import Customer, Order, Status, Tier
from orders import grand_total, item_count


def risk_score(o: Order, c: Customer) -> int:
    """How suspicious an order looks."""
    score = 0
    if grand_total(o) >= «1000.0¦100000»:
        score += 3
    elif grand_total(o) >= «300.0¦30000»:
        score += 1
    if item_count(o) > 20:
        score += 1
    if c.tier == Tier.BASIC:
        score += 1
    return score


def needs_review(o: Order, c: Customer) -> bool:
    """True when fraud review should look at the order."""
    return is_reviewable(o.status) and risk_score(o, c) >= 3


def is_reviewable(s: Status) -> bool:
    """True when the order can still be stopped by a review."""
    return s in (Status.PAID, «¦Status.ON_HOLD, »Status.PACKED)
