+def desugar(p):
+    """The call that the pipe `value |> f(args)` means: `f(value, args)` (the same nodes, one new Call and Arg)."""
+    d = getattr(p, "desugared", None)
+    if d is None:
+        first = Arg(span=p.value.span, name=None, value=p.value)
+        d = p.desugared = Call(span=p.span, callee=p.call.callee, args=[first] + list(p.call.args))
+        d.piped = True          # its first argument is the piped value, not written in the call
+        d.pipe = p
+    return d
+
+
+def lower_pipes(root):
+    """Replaces every pipe below `root` (and `root` itself, if it is one; the result is returned) by its call."""
+    if isinstance(root, Pipe):
+        root = desugar(root)
+    stack = [root]
+    while stack:
+        n = stack.pop()
+        if isinstance(n, list):
+            for i, x in enumerate(n):
+                if isinstance(x, Pipe):
+                    x = n[i] = desugar(x)
+                if isinstance(x, (Node, list)):
+                    stack.append(x)
+            continue
+        for f in fields(n):
+            v = getattr(n, f.name)
+            if isinstance(v, Pipe):
+                v = desugar(v)
+                setattr(n, f.name, v)
+            if isinstance(v, (Node, list)):
+                stack.append(v)
+    return root
+
