fn rotate(code: Int, base: Int, shift: Int) -> Str {
  return (((code - base + shift) % 26 + 26) % 26 + base).to_char().unwrap_or("?")
}

pub fn caesar(text: Str, shift: Int) -> Str {
  var out = ""
  for c in text.chars() {
    let code = c.codes().get_or(0, 0)
    if code >= 97 and code <= 122 {
      out = out + rotate(code: code, base: 97, shift: shift)
    } else if code >= 65 and code <= 90 {
      out = out + rotate(code: code, base: 65, shift: shift)
    } else {
      out = out + c
    }
  }
  return out
}
