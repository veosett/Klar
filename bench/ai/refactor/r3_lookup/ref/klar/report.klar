use users.{User, find_user}

/// The report line of one user id: "2: bob <bob@example.com>".
pub fn user_line(directory: List[User], user_id: Int) -> Str {
  return match find_user(directory, user_id) {
    Some(u) => "{u.id}: {u.name} <{u.email}>",
    None => "{user_id}: (unknown)",
  }
}

/// The report lines of the listed ids, in the order given (unknown ids are listed too).
pub fn report_lines(directory: List[User], ids: List[Int]) -> List[Str] {
  return ids.map(fn(i) => user_line(directory, i))
}

/// How many ids the report lists and how many of them are unknown.
pub fn summary(directory: List[User], ids: List[Int]) -> Str {
  let unknown = ids.count(fn(i) => find_user(directory, i).is_none())
  return "{ids.len()} listed, {unknown} unknown"
}

/// The summary, then one line per listed id.
pub fn full_report(directory: List[User], ids: List[Int]) -> Str {
  return [summary(directory, ids)].concat(report_lines(directory, ids)).join("\n")
}
