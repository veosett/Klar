/// A person in the directory.
pub type User {
  id: Int
  name: Str
  email: Str
}

/// The user with this id. Unknown ids give a placeholder user with id -1 and an empty name.
pub fn find_user(directory: List[User], user_id: Int) -> User {
  return match directory.find(fn(u) => u.id == user_id) {
    Some(u) => u,
    None => User { id: -1, name: "", email: "" },
  }
}

/// The directory with one more user at the end.
pub fn add_user(directory: List[User], user: User) -> List[User] {
  return directory.push(user)
}

/// The email domain of a user ("" when the address has no @).
pub fn email_domain(user: User) -> Str {
  let parts = user.email.split("@")
  if parts.len() != 2 {
    return ""
  }
  return parts.get_or(1, "")
}
