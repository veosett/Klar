/// A person in the contact book.
pub type Contact {
  first: Str
  last: Str
  phone: Str
  city: Str
}

const DIGITS: Str = "0123456789"

fn all_digits(s: Str) -> Bool {
  return not s.is_empty() and s.chars().all(fn(ch) => DIGITS.contains(ch))
}

/// Builds a contact. The Err holds the message of the first rule that fails.
pub fn make_contact(first: Str, last: Str, phone: Str, city: Str) -> Result[Contact, Str] {
  if first.is_empty() {
    return Err("first name must not be empty")
  }
  if last.is_empty() {
    return Err("last name must not be empty")
  }
  if not all_digits(phone) {
    return Err("phone must be digits only")
  }
  return Ok(Contact { first: first, last: last, phone: phone, city: city })
}

/// The same contact with another phone number (validated like in `make_contact`).
pub fn with_phone(c: Contact, phone: Str) -> Result[Contact, Str] {
  return make_contact(first: c.first, last: c.last, phone: phone, city: c.city)
}

/// The same contact, moved to another city.
pub fn with_city(c: Contact, city: Str) -> Contact {
  return c with { city: city }
}

/// The upper-case initials, e.g. "A.L." for Ada Lovelace.
pub fn initials(c: Contact) -> Str {
  return c.first.slice(0, 1).upper() + "." + c.last.slice(0, 1).upper() + "."
}
