use txn.{Txn, amount_of, validate, is_credit}
use ledger.{apply, apply_all, history}
use fees.{fee_for, total_fees}
use report.{describe, summarize, summary_text, sorted_by_kind, largest, net_change, describe_all}

fn refund(order: Str, amount: Int) -> Txn {
  return Txn.Refund(order: order, amount: amount)
}

fn dep(amount: Int) -> Txn {
  return Txn.Deposit(amount: amount)
}

fn wd(amount: Int) -> Txn {
  return Txn.Withdraw(amount: amount)
}

fn tr(to: Str, amount: Int) -> Txn {
  return Txn.Transfer(to: to, amount: amount)
}

fn verdict(r: Result[Unit, Str]) -> Str {
  return match r {
    Ok(_) => "ok",
    Err(e) => e,
  }
}

test "txn: amount_of and is_credit" {
  assert amount_of(refund("A-17", 30)) == 30
  assert is_credit(refund("A-17", 30)) == true
  assert is_credit(dep(1)) == true
  assert is_credit(wd(1)) == false
  assert is_credit(tr("bob", 1)) == false
}

test "txn: validate refunds" {
  assert verdict(validate(refund("A-17", 30))) == "ok"
  assert verdict(validate(refund("", 30))) == "refund needs an order id"
  assert verdict(validate(refund("A-1", 0))) == "amount must be positive"
  assert verdict(validate(refund("A-1", -5))) == "amount must be positive"
  assert verdict(validate(refund("", 0))) == "refund needs an order id"
}

test "txn: validate other kinds still works" {
  assert verdict(validate(dep(0))) == "amount must be positive"
  assert verdict(validate(tr("", 5))) == "transfer needs a destination"
  assert verdict(validate(tr("bob", 5))) == "ok"
}

test "ledger: apply" {
  assert apply(50, refund("A-17", 30)) == Ok(80)
  assert apply(0, refund("X", 7)) == Ok(7)
  assert apply(10, wd(40)) == Err("insufficient funds: balance 10, need 40")
  assert apply(10, tr("bob", 11)) == Err("insufficient funds: balance 10, need 11")
  assert apply(10, dep(5)) == Ok(15)
}

test "ledger: apply_all and history" {
  assert apply_all(100, [dep(100), refund("A-17", 30), wd(40)]) == Ok(190)
  assert apply_all(0, [refund("", 5)]) == Err("txn 1: refund needs an order id")
  assert apply_all(10, [refund("A-17", 30), wd(100)]) == Err("txn 2: insufficient funds: balance 40, need 100")
  assert apply_all(0, [dep(1), refund("A", 0)]) == Err("txn 2: amount must be positive")
  assert history(10, [refund("A-17", 30), wd(40), refund("B", 5)]) == Ok([40, 0, 5])
}

test "fees: fee_for" {
  assert fee_for(refund("A-17", 30)) == 0
  assert fee_for(refund("B", 5000)) == 0
  assert fee_for(dep(10)) == 0
  assert fee_for(wd(10)) == 2
  assert fee_for(tr("bob", 2500)) == 7
}

test "fees: total_fees" {
  assert total_fees([dep(100), wd(40), tr("bob", 25), refund("A-17", 30)]) == 7
  assert total_fees([refund("A-17", 30), refund("B", 5000)]) == 0
}

test "report: describe" {
  assert describe(refund("A-17", 30)) == "refund of 30 for order A-17"
  assert describe(tr("bob", 25)) == "transfer of 25 to bob"
  assert describe(wd(40)) == "withdrawal of 40"
  assert describe(dep(100)) == "deposit of 100"
}

test "report: summarize counts" {
  let s = summarize([dep(100), refund("A-17", 30), wd(40), tr("bob", 25), refund("B-2", 20)])
  assert s.deposits == 1
  assert s.withdrawals == 1
  assert s.transfers == 1
  assert s.refunds == 2
  assert s.money_in == 150
  assert s.money_out == 65
}

test "report: summarize without refunds" {
  let s = summarize([dep(10), dep(5), wd(3)])
  assert s.refunds == 0
  assert s.money_in == 15
  assert s.money_out == 3
  assert summarize([]).refunds == 0
}

test "report: summary_text" {
  let s = summarize([dep(100), refund("A-17", 30), wd(40), tr("bob", 25), refund("B-2", 20)])
  assert summary_text(s) == "deposits: 1\nwithdrawals: 1\ntransfers: 1\nrefunds: 2\nin: 150\nout: 65"
  assert summary_text(summarize([])) == "deposits: 0\nwithdrawals: 0\ntransfers: 0\nrefunds: 0\nin: 0\nout: 0"
}

test "report: sorted_by_kind puts refunds last" {
  let sorted = sorted_by_kind([refund("A-17", 30), tr("bob", 25), refund("Z", 1), wd(40), dep(100), dep(5)])
  assert describe_all(sorted) == [
    "1. deposit of 100",
    "2. deposit of 5",
    "3. withdrawal of 40",
    "4. transfer of 25 to bob",
    "5. refund of 30 for order A-17",
    "6. refund of 1 for order Z",
  ]
}

test "report: net_change, largest" {
  assert net_change([dep(100), refund("A-17", 30), wd(40), tr("bob", 25)]) == 65
  assert net_change([refund("A-17", 30)]) == 30
  assert largest([dep(100), refund("A-17", 30), refund("Big", 500), wd(40)]).map(fn(t) => describe(t)) == Some("refund of 500 for order Big")
  assert largest([]).is_none()
}
