use money.{format_amount, parse_amount}
use catalog.{Item, make_item, default_catalog, find_item, sorted_by_price, cheapest, catalog_text}
use cart.{Cart, Line, FREE_SHIPPING_MIN, new_cart, add_line, apply_code, discount_percent, item_count, line_total, largest_line, subtotal, discount, tax, total, free_shipping_gap}
use receipt.{line_text, render, summary}

fn it(name: Str, cents: Int) -> Item {
  return Item { name: name, price_cents: cents }
}

fn ln(item: Item, qty: Int) -> Line {
  return Line { item: item, qty: qty }
}

fn cart_of(parts: List[Line], code_text: Str) -> Cart {
  let c = match code_text.is_empty() {
    true => None,
    false => Some(code_text),
  }
  return Cart { lines: parts, code: c }
}

fn one(cents: Int, code_text: Str) -> Cart {
  return cart_of([ln(it("X", cents), 1)], code_text)
}

fn cart_a(code_text: Str) -> Cart {
  return cart_of([ln(it("Widget", 350), 2), ln(it("Gadget", 1250), 1)], code_text)
}

fn cat() -> List[Item] {
  return default_catalog()
}

fn pa(text: Str) -> Str {
  return match parse_amount(text) {
    Ok(v) => v.to_str(),
    Err(e) => e,
  }
}

fn item_msg(name: Str, cents: Int) -> Str {
  return match make_item(name, cents) {
    Ok(i) => "ok {i.name} {i.price_cents}",
    Err(e) => e,
  }
}

fn add_msg(c: Cart, item: Item, qty: Int) -> Str {
  return match add_line(c, item, qty) {
    Ok(n) => "ok {n.lines.len()}",
    Err(e) => e,
  }
}

fn code_msg(c: Cart, code_text: Str) -> Str {
  return match apply_code(c, code_text) {
    Ok(_) => "ok",
    Err(e) => e,
  }
}

fn name_of_line(l: Option[Line]) -> Str {
  return match l {
    Some(x) => x.item.name,
    None => "none",
  }
}

fn largest_line_or_zero(c: Cart) -> Line {
  return largest_line(c).unwrap_or(ln(it("none", 0), 0))
}

fn name_of_item(i: Option[Item]) -> Str {
  return match i {
    Some(x) => x.name,
    None => "none",
  }
}

fn price_of(i: Option[Item]) -> Int {
  return match i {
    Some(x) => x.price_cents,
    None => -1,
  }
}

fn names(items: List[Item]) -> Str {
  return items.map(fn(i) => i.name).join(",")
}

fn pct(code_text: Str) -> Int {
  return discount_percent(code_text).unwrap_or(-1)
}

test "01 format_amount(0)" {
  assert format_amount(0) == "$0.00"
}

test "02 format_amount(5)" {
  assert format_amount(5) == "$0.05"
}

test "03 format_amount(100)" {
  assert format_amount(100) == "$1.00"
}

test "04 format_amount(1250)" {
  assert format_amount(1250) == "$12.50"
}

test "05 format_amount(123456)" {
  assert format_amount(123456) == "$1234.56"
}

test "06 format_amount(-250)" {
  assert format_amount(-250) == "-$2.50"
}

test "07 format_amount(-5)" {
  assert format_amount(-5) == "-$0.05"
}

test "08 format_amount(4999)" {
  assert format_amount(4999) == "$49.99"
}

test "09 pa('12.5')" {
  assert pa("12.5") == "1250"
