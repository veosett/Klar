}

test "32 names(sorted_by_price(cat()))" {
  assert names(sorted_by_price(cat())) == "Widget,Cable,Gadget,Case,Gizmo"
}

test "33 names(sorted_by_price([it('A', 999), it('B', 1000), it('C', 98)]))" {
  assert names(sorted_by_price([it("A", 999), it("B", 1000), it("C", 98)])) == "C,A,B"
}

test "34 name_of_item(cheapest(cat()))" {
  assert name_of_item(cheapest(cat())) == "Widget"
}

test "35 name_of_item(cheapest([it('A', 999), it('B', 1000), it('C', 98)]))" {
  assert name_of_item(cheapest([it("A", 999), it("B", 1000), it("C", 98)])) == "C"
}

test "36 catalog_text(cat())" {
  assert catalog_text(cat()) == "Widget - $3.50\nGadget - $12.50\nGizmo - $49.99\nCable - $7.25\nCase - $24.00"
}

test "37 FREE_SHIPPING_MIN" {
