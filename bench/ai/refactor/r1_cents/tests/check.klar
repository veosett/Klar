}

test "28 price_of(find_item(cat(), 'Gizmo'))" {
  assert price_of(find_item(cat(), "Gizmo")) == 4999
}

test "29 price_of(find_item(cat(), 'Cable'))" {
  assert price_of(find_item(cat(), "Cable")) == 725
}

test "30 price_of(find_item(cat(), 'Case'))" {
  assert price_of(find_item(cat(), "Case")) == 2400
}

test "31 name_of_item(find_item(cat(), 'Nope'))" {
