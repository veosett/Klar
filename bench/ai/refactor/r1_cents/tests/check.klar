test "81 render(cart_a('SAVE10'), 825)" {
  assert render(cart_a("SAVE10"), 825) == "2 x Widget @ $3.50 = $7.00\n1 x Gadget @ $12.50 = $12.50\nSubtotal: $19.50\nDiscount (SAVE10): -$1.95\nTax: $1.45\nTotal: $19.00\nAdd $32.45 more for free shipping"
}

test "82 render(cart_a(''), 0)" {
  assert render(cart_a(""), 0) == "2 x Widget @ $3.50 = $7.00\n1 x Gadget @ $12.50 = $12.50\nSubtotal: $19.50\nTax: $0.00\nTotal: $19.50\nAdd $30.50 more for free shipping"
}

