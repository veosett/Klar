use money.{format_amount}

pub type Item { name: Str, price_cents: Int }

/// Builds a validated item: the name must not be blank and the price must be positive.
pub fn make_item(name: Str, price_cents: Int) -> Result[Item, Str] {
  if name.trim().is_empty() {
    return Err("empty name")
  }
  if price_cents <= 0 {
    return Err("invalid price for {name}")
  }
  return Ok(Item { name: name, price_cents: price_cents })
}

pub fn default_catalog() -> List[Item] {
  return [
    Item { name: "Widget", price_cents: 350 },
    Item { name: "Gadget", price_cents: 1250 },
    Item { name: "Gizmo", price_cents: 4999 },
    Item { name: "Cable", price_cents: 725 },
    Item { name: "Case", price_cents: 2400 },
  ]
}

pub fn find_item(items: List[Item], name: Str) -> Option[Item] {
  return items.find(fn(i) => i.name == name)
}

/// Cheapest first.
pub fn sorted_by_price(items: List[Item]) -> List[Item] {
  return items.sort_by(fn(i) => i.price_cents)
}

pub fn cheapest(items: List[Item]) -> Option[Item] {
  return items.min_by(fn(i) => i.price_cents)
}

/// One line per item: "Widget - $3.50".
pub fn catalog_text(items: List[Item]) -> Str {
  return items.map(fn(i) => "{i.name} - {format_amount(i.price_cents)}").join("\n")
}
