{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Klar",
  "scopeName": "source.klar",
  "patterns": [
    { "include": "#doctest" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "doctest": {
      "match": "^(\\s*///\\s*)(>>>)(.*)$",
      "captures": {
        "1": { "name": "comment.line.documentation.klar" },
        "2": { "name": "keyword.other.doctest.klar" },
        "3": { "patterns": [{ "include": "$self" }] }
      }
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.klar", "match": "///.*$" },
        { "name": "comment.line.double-slash.klar", "match": "//.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.klar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.klar", "match": "\\\\[ntr0\\\\\"{}]" },
        {
          "name": "meta.interpolation.klar",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.klar" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.klar" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.function.klar" }, "2": { "name": "entity.name.function.klar" } }
        },
        {
          "match": "\\b(type|enum|trait)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.type.klar" }, "2": { "name": "entity.name.type.klar" } }
        },
        {
          "match": "\\b(impl)(?:\\[[^\\]]*\\])?\\s*([A-Z][A-Za-z0-9_]*)\\s+(for)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.impl.klar" }, "2": { "name": "entity.name.type.trait.klar" },
                        "3": { "name": "keyword.declaration.impl.klar" }, "4": { "name": "entity.name.type.klar" } }
        },
        {
          "match": "\\b(const)\\s+([A-Z][A-Z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.klar" }, "2": { "name": "variable.other.constant.klar" } }
        },
        {
          "match": "\\b(test|property)\\b",
          "name": "keyword.other.test.klar"
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.klar", "match": "\\b(if|else|while|for|in|break|continue|return|match)\\b" },
        { "name": "keyword.other.contract.klar", "match": "\\b(requires|ensures|assert|uses)\\b" },
        { "name": "keyword.other.klar", "match": "\\b(module|use|let|var|with|fn)\\b" },
        { "name": "keyword.operator.logical.klar", "match": "\\b(and|or|not)\\b" },
        { "name": "constant.language.klar", "match": "\\b(true|false|None|Some|Ok|Err|result)\\b" },
        { "name": "variable.language.self.klar", "match": "\\b(self|Self)\\b" },
        { "name": "support.function.builtin.klar", "match": "\\b(print|read_line|fail|todo|dbg|range|now_ms|now_ns|random_int|read_file|write_file|file_exists|cli_args|read_bytes|write_bytes|bytes_of|env_var|exit)\\b(?=\\()" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.integer.klar", "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b|\\b0[bB][01][01_]*\\b|\\b0[oO][0-7][0-7_]*\\b" },
        { "name": "constant.numeric.float.klar", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?[eE][+-]?[0-9]+\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b" },
        { "name": "constant.numeric.integer.klar", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "types": {
      "name": "entity.name.type.klar",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.klar" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.klar", "match": "->|=>" },
        { "name": "keyword.operator.comparison.klar", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.klar", "match": "[-+*/%=?]" }
      ]
    }
  }
}
