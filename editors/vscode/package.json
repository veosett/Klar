{
  "name": "klar-lang",
  "displayName": "Klar",
  "description": "Syntax highlighting, snippets and commands for the Klar programming language",
  "version": "0.4.0",
  "publisher": "veosett",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/veosett/Klar" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Snippets"],
  "contributes": {
    "languages": [{
      "id": "klar",
      "aliases": ["Klar", "klar"],
      "extensions": [".klar"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "klar",
      "scopeName": "source.klar",
      "path": "./syntaxes/klar.tmLanguage.json"
    }],
    "snippets": [{ "language": "klar", "path": "./snippets/klar.json" }],
    "taskDefinitions": [],
    "problemMatchers": [{
      "name": "klar",
      "owner": "klar",
      "fileLocation": ["relative", "${fileDirname}"],
      "pattern": [
        { "regexp": "^(error|warning)\\[(\\w+)\\]: (.*)$", "severity": 1, "code": 2, "message": 3 },
        { "regexp": "^\\s+--> (.+):(\\d+):(\\d+)$", "file": 1, "line": 2, "column": 3 }
      ]
    }]
  }
}
