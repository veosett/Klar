// Bitwise operations, character codes and process helpers on every back-end.

fn mix(a: Int, b: Int) -> Int {
  return a.bit_and(b) + a.bit_or(b) * 3 + a.bit_xor(b) * 7 + a.bit_not()
}

test "bit operations on small integers" {
  assert 12.bit_and(10) == 8
  assert 12.bit_or(10) == 14
  assert 12.bit_xor(10) == 6
  assert 5.bit_not() == -6
  assert (-6).bit_and(7) == 2
  assert (-6).bit_or(1) == -5
  assert (-6).bit_xor(-1) == 5
  assert 1.shift_left(10) == 1024
  assert (-7).shift_right(1) == -4
  assert 7.shift_right(1) == 3
}

test "bit operations on big integers" {
  let big = 1.shift_left(100)
  assert big == 1267650600228229401496703205376
  assert big.shift_right(99) == 2
  assert (big - 1).bit_and(255) == 255
  assert big.bit_or(1) == big + 1
  assert (big + 5).bit_xor(big) == 5
  assert (-big).bit_and(big) == big
  assert (-big - 1).bit_not() == big
  assert (0 - big).shift_right(98) == -4
  assert mix(big + 12345, -987654321) == mix(big + 12345, -987654321)
}

test "character codes" {
  assert "Ab€".codes() == [65, 98, 8364]
  assert 8364.to_char() == Some("€")
  assert 65.to_char() == Some("A")
  assert (-1).to_char() == None
  assert 55296.to_char() == None
  assert "héllo".codes().map(fn(c) => c.to_char().unwrap_or("?")).join("") == "héllo"
}

fn main() uses io {
  var acc = 0
  for i in range(0, 200) {
    acc = acc.bit_xor(i.shift_left(i % 70)).bit_and(1.shift_left(80) - 1)
  }
  print(acc)
  print(mix(-12345678901234567890123, 98765))
  print(env_var("KLAR_SURELY_NOT_SET_42").is_none())
  print("bye")
  exit(3)
}
