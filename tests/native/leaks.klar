// Memory that native code once leaked: each loop below allocates temporaries that must be freed on every
// iteration. tests/test_klar.py (NativeMemory) runs it for 20 000 and 200 000 rounds: the peak memory of the
// process must not grow with the rounds.
//
// - `out.concat(temp)`: List.concat / Bytes.concat on a temporary argument (`*_owned` functions consume it now);
// - `m.update(k, d, f)`: the function value passed to Map.update;
// - `return` inside a `match` arm: the matched value (`match m.get(k) { Some(v) => { return ... } }`);
// - `return` inside a `for` loop: the list being walked.

type St { names: Map[Str, Str], n: Int }

fn cached(w: St, key: Str) -> Pair[St, Str] {
  match w.names.get(key) {
    Some(v) => {
      return Pair { first: w, second: v }
    },
    None => {},
  }
  let name = "v{w.names.len()}"
  return Pair { first: w with { names: w.names.set(key, name) }, second: name }
}

fn first_long(xs: List[Str], k: Int) -> Int {
  for x in xs {
    if x.len() > k {
      return x.len()
    }
  }
  return 0
}

fn main() uses io {
  var total = 0
  let base = [[1, 2], [3, 4], [5, 6], [7, 8]]
  let rounds = cli_args().get(0).map(fn(a) => a.to_int().unwrap_or(200000)).unwrap_or(200000)
  var i = 0
  while i < rounds {
    var out: List[List[Int]] = []
    out = out.concat(base.slice(1, 3)).concat(base.drop(2))
    var bytes = bytes_of([1, 2, 3])
    bytes = bytes.concat(bytes_of([i % 256, 9]))
    var counts: Map[Str, Int] = Map {}
    let i_now = i
    counts = counts.update("k", 0, fn(c) => c + i_now)
    var w = St { names: Map {}, n: 0 }
    var j = 0
    while j < 4 {
      let r = cached(w, "s{j % 2}")
      w = r.first
      total = total + r.second.len()
      j = j + 1
    }
    let words = ["a", "bb{i}", "ccc"]
    total = total + out.len() + bytes.len() + counts.get("k").unwrap_or(0) % 7 + first_long(words, 1)
    i = i + 1
  }
  print("{total}")
}
