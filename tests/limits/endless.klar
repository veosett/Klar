// A program that never ends by itself, for `--timeout` (klar/rt/limit.klar, TimeLimit in tests/test_klar.py):
//
//   klar run tests/limits/endless.klar --timeout 1            stops at the `while` loop with R0018
//   klar run tests/limits/endless.klar --timeout 1 -- fib     stops in `fib` with R0018
//   klar test tests/limits/endless.klar --timeout 1           both tests fail with R0018; the run goes on

fn spin(n: Int) -> Int {
  var i = n
  while i >= 0 {
    i = i + 1
  }
  return i
}

fn fib(n: Int) -> Int {
  if n < 2 {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

fn main() uses io {
  print("start")
  if cli_args().contains("fib") {
    print(fib(90))
  } else {
    print(spin(0))
  }
}

test "an endless loop" {
  assert spin(0) > 0
}

test "an exponential recursion" {
  assert fib(90) > 0
}

property "an endless loop in a property" (n: Int) {
  assert spin(n.abs()) > 0
}
