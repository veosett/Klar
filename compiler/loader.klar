// The module loader, written in Klar (self-hosting, stage 4): loads the prelude, the main file and every module
// it `use`s, in dependency order, and checks each one (the checker, then the safety analysis on modules without
// errors). Mirrors klar/loader.py.
//
// Modules are files: `use geometry.{Point}` in `dir/main.klar` loads `dir/geometry.klar`, `use std.json.{...}`
// loads `<lib>/std/json.klar` (`lib` is the directory of the Python package `klar/`, which holds the prelude, the
// standard library and the runtime). In a project (a directory with `klar.toml`) the first part of a `use` may name
// a dependency: `use geo.{Point}` loads `<geo>/lib.klar`, `use geo.shapes.{Circle}` `<geo>/shapes.klar`.
use ast.{Decl, Program, Span}
use builtin_sigs.{rt_files}
use checker.{Builtins, Ck, Diag, Export, Universe, check_module, empty_universe, exports, fix_at, load_builtins, new_checker}
use checker.{DiagFix, FixEdit, private_decl}
use parser.{ParseError, parse_program}
use safety.{analyze}
use similar.{closest}
use manifest.{Dep, Manifest, describe, parse_manifest}

pub type Module {
  name: Str,
  path: Str,
  display: Str,
  failed: Bool,
  is_sys: Bool,
  checker: Option[Ck],
  exports: Map[Str, Export],
  /// imported name -> (the module it comes from, "fn" | "const" | "type")
  import_from: Map[Str, Pair[Str, Str]],
  /// the root directory of the package the module belongs to (None: not in a project)
  pkg: Option[Str],
}

/// A dependency as first registered: where it is, its declaration, and the root of the manifest that names it.
pub type PkgReg { root: Str, dep: Dep, owner: Str }

/// What is known about the manifest of a package root.
pub enum ManState {
  NoManifest,
  Broken,
  Good(m: Manifest),
}

/// The loader state.
pub type Ld {
  root: Str,
  lib: Str,
  b: Builtins,
  uni: Universe,
  by_path: Map[Str, Module],
  stack: List[Str],
  diags: List[Diag],
  prelude: Option[Str],
  /// the modules in dependency order (paths), prelude first, main last
  order: List[Str],
  /// source text by display name (for messages that quote the program)
  sources: Map[Str, Str],
  /// all runtime files as one module (`load_runtime`)
  runtime: Option[Module],
  /// the directory of the project's klar.toml (None: no project)
  project: Option[Str],
  /// package root -> its manifest
  manifests: Map[Str, ManState],
  /// dependency name -> its registration (a name means one package in the whole program)
  packages: Map[Str, PkgReg],
  /// dependency root -> its name (module names inside it start with it)
  dep_names: Map[Str, Str],
}

/// The result of loading a module: the loader state and the path of the module (None: not loaded).
pub type Loaded { ld: Ld, path: Option[Str] }

fn dirname(path: Str) -> Str {
  let parts = path.split("/")
  if parts.len() <= 1 {
    return "."
  }
  let d = parts.take(parts.len() - 1).join("/")
  return match d.is_empty() {
    true => "/",
    false => d,
  }
}

fn basename(path: Str) -> Str {
  return path.split("/").last().unwrap_or(path)
}

/// `a/./b/../c` -> `a/c`
fn normalize(path: Str) -> Str {
  var out: List[Str] = []
  for part in path.split("/") {
    if part == ".." {
      if not out.is_empty() and out.last() != Some("") and out.last() != Some("..") {
        out = out.take(out.len() - 1)
      } else {
        out = out.push(part)
      }
    } else if part != "." and not (part.is_empty() and not out.is_empty()) {
      out = out.push(part)
    }
  }
  let joined = out.join("/")
  return match joined.is_empty() {
    true => "/",
    false => joined,
  }
}

fn join(dir: Str, parts: List[Str]) -> Str {
  return normalize(dir + "/" + parts.join("/"))
}

/// `path` relative to `base` (both absolute), like Python's `os.path.relpath`.
fn relpath(path: Str, base: Str) -> Str {
  let p = path.split("/").filter(fn(x) => not x.is_empty())
  let b = base.split("/").filter(fn(x) => not x.is_empty())
  var k = 0
  while k < p.len() and k < b.len() and p.get_or(k, "") == b.get_or(k, "") {
    k = k + 1
  }
  var out: List[Str] = []
  var i = k
  while i < b.len() {
    out = out.push("..")
    i = i + 1
  }
  out = out.concat(p.drop(k))
  return match out.is_empty() {
    true => ".",
    false => out.join("/"),
  }
}

fn rt_dir(ld: Ld) -> Str {
  return ld.lib + "/rt"
}

fn std_dir(ld: Ld) -> Str {
  return ld.lib + "/std"
}

fn display_of(ld: Ld, path: Str) -> Str {
  if path.starts_with(rt_dir(ld) + "/") {
    return "rt/" + relpath(path, rt_dir(ld))
  }
  if path.starts_with(std_dir(ld) + "/") {
    return "std/" + relpath(path, std_dir(ld))
  }
  return relpath(path, ld.root)
}

fn add_error(ld: Ld, file: Str, d: Diag) -> Ld {
  return ld with { diags: ld.diags.push(d with { file: file }) }
}

/// A syntax error as a diagnostic (with its fix, if it has one).
fn parse_diag(e: ParseError) -> Diag {
  let sp = Span { line: e.line, col: e.col, end_line: e.end_line, end_col: e.end_col }
  return diag(code: e.code, msg: e.message, span: sp, hint: e.hint) with { fix: e.fix.map(fn(f) => DiagFix { edits: [
    FixEdit { span: f.span, text: f.text, file: "" }], safe: true }) }
}

fn diag(code: Str, msg: Str, span: Span, hint: Option[Str]) -> Diag {
  return Diag { code: code, severity: "error", message: msg, file: "", span: span, hint: hint, notes: [], fix: None }
}

fn zero_span() -> Span {
  return Span { line: 0, col: 0, end_line: 0, end_col: 0 }
}

/// Where a module was imported from: the importing file and the `use` declaration.
pub type Importer { file: Str, span: Span }

fn module_name_of(ld: Ld, path: Str) -> Str {
  return match ld.by_path.get(path) {
    Some(m) => m.name,
    None => basename(path),
  }
}

fn export_kind(e: Export) -> Str {
  return match e {
    Export.FnE(_) => "fn",
    Export.ConstE(_) => "const",
    Export.TypeE(_) => "type",
  }
}

fn prelude_module(ld: Ld) -> Option[Module] {
  return match ld.prelude {
    Some(pp) => ld.by_path.get(pp),
    None => None,
  }
}

fn failed_module(name: Str, path: Str, display: Str, is_sys: Bool) -> Module {
  return Module { name: name, path: path, display: display, failed: true, is_sys: is_sys, checker: None, exports: Map {},
    import_from: Map {}, pkg: None }
}

// ---- packages -----------------------------------------------------------------------------------------------

/// The nearest directory at or above `start` with a klar.toml.
pub fn find_root(start: Str) -> Option[Str] uses fs {
  var d = normalize(start)
  while true {
    if file_exists(d + "/klar.toml") {
      return Some(d)
    }
    let parent = dirname(d)
    if parent == d or d == "/" {
      return None
    }
    d = parent
  }
  return None
}

fn dep_root(project: Str, owner: Str, d: Dep) -> Str {
  return match d.path {
    Some(p) => match p.starts_with("/") {
      true => normalize(p),
      false => normalize(owner + "/" + p),
    },
    None => project + "/.klar/deps/" + d.name,
  }
}

fn same_source(a: PkgReg, root: Str, d: Dep) -> Bool {
  return a.root == root and a.dep.git == d.git and a.dep.ref == d.ref
}

/// The manifest of the package at `root`. Reading it registers its dependencies; a name that another manifest gives
/// a different source is reported (E0608).
fn manifest(ld0: Ld, root: Str) -> Pair[Ld, ManState] uses fs {
  var ld = ld0
  match ld.manifests.get(root) {
    Some(st) => {
      return Pair { first: ld, second: st }
    },
    None => {},
  }
  ld = ld with { manifests: ld.manifests.set(root, ManState.NoManifest) }
  let path = root + "/klar.toml"
  let shown = display_of(ld, path)
  let text = match read_file(path) {
    Ok(t) => t,
    Err(_) => {
      return Pair { first: ld, second: ManState.NoManifest }
    },
  }
  ld = ld with { sources: ld.sources.set(shown, text) }
  let man = match parse_manifest(text, root) {
    Ok(m) => m,
    Err(e) => {
      let line = e.line.max(1)
      ld = add_error(ld: ld, file: shown, d: diag(code: "E0610", msg: "invalid klar.toml: {e.message}", span: Span {
        line: line, col: 1, end_line: line, end_col: 1 }, hint: Some("see `klar explain E0610` for the format")))
      return Pair { first: ld with { manifests: ld.manifests.set(root, ManState.Broken) }, second: ManState.Broken }
    },
  }
  ld = ld with { manifests: ld.manifests.set(root, ManState.Good(m: man)) }
  for d in man.deps {
    let droot = dep_root(project: ld.project.unwrap_or(root), owner: root, d: d)
    match ld.packages.get(d.name) {
      None => {
        ld = ld with { packages: ld.packages.set(d.name, PkgReg { root: droot, dep: d, owner: root }) }
        if not ld.dep_names.has(droot) {
          ld = ld with { dep_names: ld.dep_names.set(droot, d.name) }
        }
      },
      Some(prev) => {
        if not same_source(a: prev, root: droot, d: d) {
          let there = display_of(ld, prev.owner + "/klar.toml")
          ld = add_error(ld: ld, file: shown, d: diag(code: "E0608", msg: "dependency `{d.name}` is {describe(d)} here " +
              "but {describe(prev.dep)} in {there}", span: Span { line: d.line, col: 1, end_line: d.line, end_col: 1 },
            hint: Some("a dependency name means one package in the whole program: make the manifests agree")))
        }
      },
    }
  }
  return Pair { first: ld, second: ManState.Good(m: man) }
}

/// How a `use` resolves its first name in the package at `pkg`.
enum DepUse {
  NotDep,
  Unusable,
  Root(dir: Str),
}

fn dependency(ld0: Ld, pkg: Option[Str], name: Str, file: Str, span: Span) -> Pair[Ld, DepUse] uses fs {
  var ld = ld0
  let root = match pkg {
    Some(r) => r,
    None => {
      return Pair { first: ld, second: DepUse.NotDep }
    },
  }
  let r = manifest(ld0: ld, root: root)
  ld = r.first
  let man = match r.second {
    ManState.Good(m) => m,
    ManState.Broken => {
      return Pair { first: ld, second: DepUse.Unusable }
    },
    ManState.NoManifest => {
      return Pair { first: ld, second: DepUse.NotDep }
    },
  }
  let dep = match man.deps.filter(fn(d) => d.name == name).get(0) {
    Some(d) => d,
    None => {
      return Pair { first: ld, second: DepUse.NotDep }
    },
  }
  let droot = match ld.packages.get(name) {
    Some(reg) => reg.root,
    None => dep_root(project: ld.project.unwrap_or(root), owner: root, d: dep),
  }
  if not file_exists(droot + "/klar.toml") {
    let where = display_of(ld, droot + "/klar.toml")
    match dep.git {
      Some(_) => {
        ld = add_error(ld: ld, file: file, d: diag(code: "E0609", msg: "dependency `{name}` is not fetched (no `{where}`)",
          span: span, hint: Some("run `klar fetch` in the project directory")))
      },
      None => {
        let owner_toml = display_of(ld, root + "/klar.toml")
        ld = add_error(ld: ld, file: file, d: diag(code: "E0609", msg: "dependency `{name}` is not a package: `{where}` " +
            "does not exist", span: span, hint: Some("a package is a directory with a klar.toml; check `path` of " +
              "`{name}` in {owner_toml}")))
      },
    }
    return Pair { first: ld, second: DepUse.Unusable }
  }
  ld = manifest(ld0: ld, root: droot).first    // (its dependencies are registered, and conflicts reported, on first use)
  return Pair { first: ld, second: DepUse.Root(dir: droot) }
}

/// A module of a dependency is named after it (`geo`, `geo.shapes`); the project's modules as written.
fn module_name(ld: Ld, path: Str, pkg: Option[Str], written: Str) -> Str {
  let root = pkg.unwrap_or("")
  return match ld.dep_names.get(root) {
    Some(dep) => {
      let rel = relpath(path, root)
      let stem = rel.slice(0, rel.len() - 5).replace("/", ".")
      return match stem == "lib" {
        true => dep,
        false => dep + "." + stem,
      }
    },
    None => written,
  }
}

/// Loads (and checks) the module at `path`, after the modules it imports.
pub fn load(ld0: Ld, path: Str, name: Str, display: Str, importer: Option[Importer], pkg: Option[Str]) -> Loaded uses fs {
  var ld = ld0
  if ld.by_path.has(path) and not ld.stack.contains(path) {
    return Loaded { ld: ld, path: Some(path) }
  }
  if ld.stack.contains(path) {
    let from = ld.stack.index_of(path).unwrap_or(0)
    let snap = ld
    let chain = ld.stack.drop(from).map(fn(p) => module_name_of(snap, p)).join(" -> ") + " -> " + name
    match importer {
      Some(imp) => {
        ld = add_error(ld: ld, file: imp.file, d: diag(code: "E0602", msg: "circular import: {chain}", span: imp.span,
          hint: Some("move the shared declarations into a third module that both import")))
      },
      None => {},
    }
    return Loaded { ld: ld, path: None }
  }
  let is_sys = path.starts_with(rt_dir(ld) + "/")
  let source = match read_file(path) {
    Ok(text) => text,
    Err(e) => {
      let at = match importer {
        Some(imp) => imp,
        None => Importer { file: display, span: zero_span() },
      }
      ld = add_error(ld: ld, file: at.file, d: diag(code: "E0601", msg: "cannot read module `{name}`: {e}", span: at.span,
        hint: None))
      return Loaded { ld: ld with { by_path: ld.by_path.set(path, failed_module(name: name, path: path, display: display,
        is_sys: is_sys)) }, path: Some(path) }
    },
  }
  ld = ld with { sources: ld.sources.set(display, source) }
  let prog = match parse_program(source) {
    Ok(p) => p,
    Err(e) => {
      ld = add_error(ld: ld, file: display, d: parse_diag(e))
      return Loaded { ld: ld with { by_path: ld.by_path.set(path, failed_module(name: name, path: path, display: display,
        is_sys: is_sys)) }, path: Some(path) }
    },
  }
  ld = ld with {
    by_path: ld.by_path.set(path, failed_module(name: name, path: path, display: display, is_sys: is_sys) with {
      failed: false,
    }),
    stack: ld.stack.push(path),
  }
  var imports: Map[Str, Export] = Map {}
  var from_prelude: Map[Str, Bool] = Map {}
  var import_from: Map[Str, Pair[Str, Str]] = Map {}
  match prelude_module(ld) {
    Some(pm) => {
      for entry in pm.exports.entries() {
        imports = imports.set(entry.key, entry.value)
        from_prelude = from_prelude.set(entry.key, true)
        import_from = import_from.set(entry.key, Pair { first: pm.name, second: export_kind(entry.value) })
      }
    },
    None => {},
  }
  let here = dirname(path)
  for d in prog.decls {
    match d {
      Decl.Use(span, dpath, items, item_spans) => {
        let dep_name = dpath.join(".")
        let first = dpath.get_or(0, "")
        var dep_path = match first == "std" {
          true => join(std_dir(ld), dpath.drop(1)) + ".klar",
          false => match first == "rt" and is_sys {
            true => join(rt_dir(ld), dpath.drop(1)) + ".klar",
            false => join(here, dpath) + ".klar",
          },
        }
        var dep_pkg = pkg
        var skip = false
        if first != "std" and not (first == "rt" and is_sys) {
          let r = dependency(ld0: ld, pkg: pkg, name: first, file: display, span: span)
          ld = r.first
          match r.second {
            DepUse.Unusable => {
              skip = not file_exists(dep_path)
            },
            DepUse.NotDep => {},
            DepUse.Root(droot) => {
              if file_exists(dep_path) {
                ld = add_error(ld: ld, file: display, d: diag(code: "E0607", msg: "`{dep_name}` is both the dependency " +
                    "`{first}` and the file `{display_of(ld, dep_path)}`", span: span,
                  hint: Some("rename the file or the dependency in klar.toml")))
                skip = true
              } else {
                dep_pkg = Some(droot)
                let rest = match dpath.len() > 1 {
                  true => dpath.drop(1),
                  false => ["lib"],
                }
                dep_path = join(droot, rest) + ".klar"
                if not file_exists(dep_path) {
                  ld = add_error(ld: ld, file: display, d: diag(code: "E0601", msg: "module `{dep_name}` not found " +
                      "(looked for `{display_of(ld, dep_path)}`)", span: span, hint: Some("the package `{first}` has no " +
                        "such file: `use {first}.\{...\}` loads its lib.klar, `use {first}.name.\{...\}` its name.klar")))
                  skip = true
                }
              }
            },
          }
        }
        if skip {
          // (reported above)
        } else if not file_exists(dep_path) {
          ld = add_error(ld: ld, file: display, d: diag(code: "E0601", msg: "module `{dep_name}` not found (looked for " +
              "`{display_of(ld, dep_path)}`)", span: span, hint: Some("create the file `{display_of(ld, dep_path)}` " +
                "(modules are files next to the importing file)")))
        } else {
          let r = load(ld0: ld, path: dep_path, name: module_name(ld: ld, path: dep_path, pkg: dep_pkg, written: dep_name),
            display: display_of(ld, dep_path), importer: Some(Importer { file: display, span: span }), pkg: dep_pkg)
          ld = r.ld
          match r.path.map(fn(p) => r.ld.by_path.get(p)) {
            Some(Some(dep)) => {
              if dep.failed {
                ld = add_error(ld: ld, file: display, d: diag(code: "E0601", msg: "module `{dep_name}` could not be loaded",
                  span: span, hint: Some("fix the errors reported for that file first")))
              } else {
                var k = 0
                for item in items {
                  let sp = item_spans.get_or(k, span)
                  k = k + 1
                  match dep.exports.get(item) {
                    Some(ex) => {
                      if imports.has(item) and not from_prelude.has(item) {
                        ld = add_error(ld: ld, file: display, d: diag(code: "E0101", msg: "`{item}` is imported twice",
                          span: sp, hint: None))
                      } else {
                        imports = imports.set(item, ex)
                        from_prelude = from_prelude.remove(item)
                        import_from = import_from.set(item, Pair { first: dep.name, second: export_kind(ex) })
                      }
                    },
                    None => {
                      let private = match dep.checker {
                        Some(dc) => private_decl(dc, item),
                        None => None,
                      }
                      match private {
                        Some(p) => {
                          let at = p.second
                          let pd = diag(code: "E0606", msg: "`{item}` is private to module `{dep_name}`", span: sp,
                            hint: Some("mark it public in {dep.display}: `pub {p.first} {item}`"))
                          ld = add_error(ld: ld, file: display, d: pd with { fix: Some(DiagFix { edits: [FixEdit {
                            span: Span { line: at.line, col: at.col, end_line: at.line, end_col: at.col }, text: "pub ",
                            file: dep.display }], safe: true }) })
                        },
                        None => {
                          let names = dep.exports.keys()
                          let declares = match names.is_empty() {
                            true => "(nothing)",
                            false => names.sort().join(", "),
                          }
                          let hint = match closest(item, names) {
                            Some(cm) => "did you mean `{cm}`?",
                            None => "`{dep_name}` declares: {declares}",
                          }
                          ld = add_error(ld: ld, file: display, d: diag(code: "E0603", msg: "module `{dep_name}` has no item " +
                              "`{item}`", span: sp, hint: Some(hint)))
                        },
                      }
                    },
                  }
                }
              }
            },
            _ => {},
          }
        }
      },
      _ => {},
    }
  }
  ld = ld with { stack: ld.stack.take(ld.stack.len() - 1) }
  let ck = check_module(new_checker(b: ld.b, universe: ld.uni, prog: prog, file: display, mod_name: name, sys: is_sys,
    imports: imports))
  let m = Module { name: name, path: path, display: display, failed: false, is_sys: is_sys, checker: Some(ck),
    exports: exports(ck), import_from: import_from, pkg: pkg }
  var diags = ck.diags
  if not is_sys and not diags.any(fn(x) => x.severity == "error") {
    diags = diags.concat(analyze(ck))
  }
  ld = ld with { uni: ck.uni, diags: ld.diags.concat(diags), by_path: ld.by_path.set(path, m), order: ld.order.push(path) }
  return Loaded { ld: ld, path: Some(path) }
}

/// Loads and checks a program (its main file is `path`, absolute); `lib` is the directory of `klar/`.
pub fn load_program(path: Str, lib: Str) -> Ld uses fs {
  let root = dirname(path)
  var ld = Ld { root: root, lib: lib, b: load_builtins(), uni: empty_universe(), by_path: Map {}, stack: [], diags: [],
    prelude: None, order: [], sources: Map {}, runtime: None, project: find_root(root), manifests: Map {}, packages: Map {},
    dep_names: Map {} }
  let prelude_path = lib + "/prelude.klar"
  ld = load(ld0: ld, path: prelude_path, name: "prelude", display: "prelude.klar", importer: None, pkg: None).ld
  ld = ld with { prelude: Some(prelude_path) }
  let file = basename(path)
  let name = match file.ends_with(".klar") {
    true => file.slice(0, file.len() - 5),
    false => file,
  }
  return load(ld0: ld, path: path, name: name, display: file, importer: None, pkg: ld.project).ld
}

/// Loads all runtime files (system Klar) as ONE module `klar_rt`, so they can call each other freely.
pub fn load_runtime(ld0: Ld) -> Ld uses fs {
  var ld = ld0
  var decls: List[Decl] = []
  var files: List[Str] = []
  var first: Option[Program] = None
  var failed = false
  for fname in rt_files() {
    let display = "rt/" + fname
    let read = read_file(rt_dir(ld) + "/" + fname)
    match read {
      Err(e) => {
        ld = add_error(ld: ld, file: display, d: diag(code: "E0601", msg: "cannot read module `rt`: {e}", span: zero_span(),
          hint: None))
        failed = true
      },
      Ok(_) => {},
    }
    let src = read.unwrap_or("")
    ld = ld with { sources: ld.sources.set(display, src) }
    match parse_program(src) {
      Ok(prog) => {
        if first == None {
          first = Some(prog)
        }
        for d in prog.decls {
          decls = decls.push(d)
          files = files.push(display)
        }
      },
      Err(e) => {
        ld = add_error(ld: ld, file: display, d: parse_diag(e))
        failed = true
      },
    }
  }
  let base = Module { name: "klar_rt", path: rt_dir(ld) + "/<all>", display: "rt", failed: true, is_sys: true, checker: None,
    exports: Map {}, import_from: Map {}, pkg: None }
  let head = match first {
    Some(p) => p,
    None => {
      return ld with { runtime: Some(base) }
    },
  }
  if failed {
    return ld with { runtime: Some(base) }
  }
  let prog = Program { span: head.span, module_name: Some("klar_rt"), decls: decls }
  var imports: Map[Str, Export] = Map {}
  var import_from: Map[Str, Pair[Str, Str]] = Map {}
  match prelude_module(ld) {
    Some(pm) => {
      for entry in pm.exports.entries() {
        imports = imports.set(entry.key, entry.value)
        import_from = import_from.set(entry.key, Pair { first: pm.name, second: export_kind(entry.value) })
      }
    },
    None => {},
  }
  let ck = check_module(new_checker(b: ld.b, universe: ld.uni, prog: prog, file: "rt", mod_name: "klar_rt", sys: true,
    imports: imports) with { decl_files: files })
  let m = base with { failed: false, checker: Some(ck), import_from: import_from }
  return ld with { uni: ck.uni, diags: ld.diags.concat(ck.diags), runtime: Some(m) }
}
