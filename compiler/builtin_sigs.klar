pub fn foreign_notes() -> List[Pair[Str, Str]] {
  return [
    Pair { first: "forEach", second: "Klar has no forEach: use `for x in xs \{ ... \}`" },
    Pair { first: "for_each", second: "Klar has no for_each: use `for x in xs \{ ... \}`" },
    Pair { first: "each", second: "use `for x in xs \{ ... \}`" },
    Pair { first: "unwrap", second: "Klar has no `unwrap`: use `?`, `match`, or `.unwrap_or(default)`" },
    Pair { first: "expect", second: "Klar has no `expect`: use `?`, `match`, or `.unwrap_or(default)`" },
    Pair { first: "pop", second: "lists are immutable: use `.last()` and `.take(xs.len() - 1)`" },
  ]
}

/// The error catalog of `klar explain`: (code, title, explanation).
pub fn diag_codes() -> List[List[Str]] {
  return [
    ["E0001", "unexpected character", "The character is not part of Klar. Many come from other languages: use `and`/`or`/`not` instead of `&&`/`||`/`!`, no `;` at line ends, strings use double quotes."],
    ["E0002", "unterminated string", "Strings must close on the same line. Use `\\n` for line breaks."],
    ["E0003", "unexpected token", "The parser expected something else here. Read the `expected ...` part of the message."],
    ["E0004", "invalid escape sequence", "Valid escapes: \\n \\t \\\\ \\\" \\\{ \\\} \\0. Use `\\\{` for a literal brace in a string."],
    ["E0101", "duplicate declaration", "Each name may be declared only once in its scope."],
    ["E0102", "shadowing is forbidden", "Klar never lets a new variable hide an existing one. Pick a new descriptive name, or use `var` and reassign."],
    ["E0103", "naming convention", "Types and variants are PascalCase (`BankAccount`), constants UPPER_SNAKE_CASE (`MAX_USERS`)."],
    ["E0104", "unknown type", "The type is not defined. Built-ins: Int Float Bool Str Unit Never List Map Option Result."],
    ["E0105", "wrong number of type arguments", "List[T], Option[T] take 1; Map[K, V], Result[T, E] take 2."],
    ["E0201", "unknown name", "The name is not defined in this scope (check spelling and declaration order inside blocks)."],
    ["E0202", "type mismatch", "The value has a different type than required. Klar has no implicit conversions."],
    ["E0203", "unknown field", "The record has no such field."],
    ["E0204", "unknown method", "The type has no such method. `klar spec` lists every built-in method."],
    ["E0205", "missing return", "A function with a non-Unit result must `return` on every path."],
    ["E0206", "wrong number of arguments", "Pass exactly the declared parameters."],
    ["E0207", "assignment to immutable variable", "Declare the variable with `var` to reassign it. Record fields are never assigned: use `rec with \{ field: v \}`."],
    ["E0208", "named arguments required", "Functions with 3 or more parameters must be called with named arguments: `f(a: 1, b: 2, c: 3)`."],
    ["E0209", "bad argument or field list", "Unknown, duplicate or missing named argument / record field."],
    ["E0210", "not callable", "Only functions can be called."],
    ["E0211", "invalid operands", "The operator is not defined for these types."],
    ["E0212", "invalid use of `?`", "`?` unwraps Option/Result and returns early on None/Err. The enclosing function must return a compatible Option/Result (with the same error type)."],
    ["E0213", "break/continue outside loop", "`break` and `continue` only work inside `while`/`for`."],
    ["E0214", "cannot infer type", "Add a type annotation, e.g. `let xs: List[Int] = []`."],
    ["E0216", "lambda captures a `var`", "Lambdas may capture `let` values, parameters and loop variables, but not a `var`: whether the lambda would see later changes (and whether it could change the variable) is a classic source of bugs. Take a snapshot (`let n_now = n`) or accumulate with `fold` / a `for` loop."],
    ["E0215", "values are not ordered", "`sort`, `min`, `max` (and the keys of `sort_by`/`min_by`/`max_by`) need Int, Float or Str. Sort records by a field: `xs.sort_by(fn(p) => p.age)`."],
    ["E0217", "newtype built without its constructor", "A newtype (`type Meters = new Float`) is built only by its constructor `Meters(x)`, which checks the type's `requires`; a record literal or `with` would skip that check. Read the value with `.value`."],
    ["E0220", "trait not implemented", "A generic function with a bound (`fn f[T: Shape](x: T)`) can only be called with a type that has `impl Shape for ThatType`, or with a type parameter that carries the same bound."],
    ["E0221", "impl does not match its trait", "An `impl Trait for Type` must define every trait method without a default, only methods of the trait, with the trait's parameter names and types (`Self` = the type), the same return type and no extra effects. `klar fix` inserts `todo(...)` stubs for missing methods."],
    ["E0222", "impl in the wrong place or twice", "There is at most one `impl Trait for Type` per program, written in the trait's module or in the type's module (impls for Int/Float/Bool/Str live with the trait). Every module then sees the same methods."],
    ["E0223", "cannot infer the type of a bounded parameter", "The type must be known to choose the implementation: annotate the value (`let xs: List[Circle] = []`)."],
    ["E0224", "a trait is not a type", "Klar has no trait objects: write a generic function `fn f[T: Shape](x: T)` for one kind of value at a time; for a list of different kinds, declare an `enum` with one variant per kind and implement the trait for the enum (each method is one `match`)."],
    ["E0301", "non-exhaustive match", "Cover every variant or add a catch-all `_ => ...` arm."],
    ["E0302", "invalid pattern", "The pattern does not fit the matched type, or the variant does not exist."],
    ["W0303", "unreachable match arm", "An earlier catch-all arm already matches everything."],
    ["E0401", "missing effect", "Functions must declare effects they use: `fn f() uses io \{ ... \}`, also those of the function values they call (`f: fn(Int) -> Unit uses io`). Contracts are pure; tests use `io` and the fakes they declare (`test \"t\" uses fs, time, rand`)."],
    ["E0402", "unhandled Result", "A `Result` may carry an error and must be handled with `?`, `match`, or discarded explicitly with `let _ = ...`."],
    ["E0403", "unknown effect", "Known effects: io, time, rand, fs, net, proc."],
    ["E0406", "par_map needs a pure function", "`xs.par_map(f)` runs `f` in worker processes: `f` must be a lambda without effects or a function whose type has no `uses`, and its results must not contain functions."],
    ["E0405", "discarded immutable update", "Values are immutable. Methods like `push`, `set`, `concat`, `with` return a NEW value; assign it: `xs = xs.push(1)` (requires `var xs`)."],
    ["W0401", "unused value", "The expression's value is thrown away. Use `let _ = ...` if intended."],
    ["W0402", "unused variable", "Remove it or prefix its name with `_`."],
    ["W0104", "value names should be snake_case", "Write `total_count`, not `totalCount`."],
    ["E0501", "no main function", "`klar run` needs `fn main()` (optionally `-> Result[Unit, E]`) — use `uses io` to print."],
    ["E0502", "invalid main signature", "`main` takes no parameters and returns Unit or Result[Unit, E]."],
    ["W0404", "unfinished code", "`todo(...)` marks code that still has to be written; it fails at runtime with R0012."],
    ["E0601", "module not found", "`use a.b.\{x\}` loads the file `a/b.klar` next to the importing file."],
    ["E0602", "circular import", "Modules may not import each other in a cycle. Move shared code into a third module."],
    ["W0406", "unused function", "A private function that nothing calls (tests count as callers) is dead code. Remove it, or mark it `pub` when it is meant for other modules."],
    ["E0606", "private item", "Only declarations marked `pub` can be imported: `pub fn`, `pub type`, `pub enum`, `pub const`, `pub trait`. Everything else is private to its module, so a module's API is exactly its `pub` lines (`klar outline` shows them). `klar fix` adds the `pub`."],
    ["E0607", "module name is ambiguous", "The first part of the `use` is both a dependency in klar.toml and a file next to the importing file. Rename the file or the dependency."],
    ["E0608", "conflicting dependencies", "Two manifests give the same dependency name different sources (another path, URL, tag, rev or branch). A dependency name means one package in the whole program; make the manifests agree."],
    ["E0609", "dependency not available", "A git dependency is not fetched yet (run `klar fetch`), or a path dependency points to a directory without klar.toml. A package is a directory with a klar.toml; `use name.\{x\}` loads its lib.klar."],
    ["E0610", "invalid klar.toml", "klar.toml has [package] (name, version, description, authors, license) and [dependencies]: `name = \{ path = \"../dir\" \}` or `name = \{ git = \"URL\", tag = \"v1\" \}` (or rev/branch). Values are strings, integers, true/false, inline tables and arrays of strings; `#` starts a comment."],
    ["E0603", "unknown import", "The module does not declare that name. Imports are explicit: `use m.\{name\}`."],
    ["E0604", "constant used before declaration", "A constant may only use constants declared above it."],
    ["E0605", "property input not generatable", "Property inputs must be data types (no functions or generic parameters)."],
    ["E0701", "divisor may be zero", "Int `/` and `%` are only allowed when the compiler can see the divisor is not zero: a non-zero literal or constant, a value checked by `if b != 0`, `while b > 0`, `assert b != 0`, an early `if b == 0 \{ return ... \}`, `match b \{ 0 => ..., _ => a / b \}`, `requires b != 0`, `if xs.is_empty() \{ return ... \}` (then `xs.len()` > 0), a callee's `ensures result > 0`, or a `var` that starts positive and only grows. Float division is rejected only for a literal 0.0."],
    ["E0702", "unconditional recursion", "Every path through the function calls itself before it can return, so it would recurse until the stack overflows. Add a base case that returns without the recursive call."],
    ["E0703", "precondition violated at compile time", "The call passes constant arguments for which a `requires` clause of the callee is false, or a simple `requires` (`n > 0`, `x != 0.0`, `not xs.is_empty()`) contradicts what the conditions before the call prove about the argument (`if n <= 0 \{ f(n) \}`)."],
    ["E0704", "invalid constant argument to built-in", "The argument is outside the built-in's domain (negative `Int.pow` exponent, `sqrt` of a negative number, `ln` of a non-positive number, `chunks(0)`, ...), so the call could only fail."],
    ["E0705", "index always out of bounds", "Indexes go from 0 to `len() - 1`: `xs.get(xs.len())` and negative indexes never find an element. Use `xs.last()` for the last element."],
    ["E0706", "postcondition violated at compile time", "A `return` gives a value that certainly breaks a simple `ensures` of its function (`ensures result >= 0` and `return -1`, or `ensures not result.is_empty()` and returning an empty list)."],
    ["R0001", "division by zero", "Only possible for Float division by a value computed at run time (Int division by zero is rejected at compile time: E0701). Check the divisor before dividing."],
    ["R0002", "precondition violated", "A `requires` clause was false on entry. The caller passed invalid arguments."],
    ["R0003", "postcondition violated", "An `ensures` clause was false on return. The function body is wrong."],
    ["R0004", "fail() called", "The program called `fail(message)`."],
    ["R0005", "assertion failed", "An `assert` was false; for comparisons both sides are shown."],
    ["R0006", "stack overflow", "Recursion went deeper than 10000 calls (recursion without any base case is already rejected at compile time: E0702). Use a loop or reduce the depth."],
    ["R0007", "main returned Err", "`main` returned `Err(...)`."],
    ["R0008", "`?` failed inside a test", "A `?` in a test hit Err/None, which fails the test."],
    ["R0009", "invalid argument to built-in", "A built-in received a value outside its domain (e.g. negative sqrt)."],
    ["R0010", "property falsified", "A `property` failed for some generated input. The report shows the minimal (shrunk) counterexample and the seed to reproduce it."],
    ["R0011", "index out of bounds", "`List.set`/`insert`/`remove_at` got an index outside the list."],
    ["R0012", "reached todo()", "The program executed a `todo(...)` placeholder."],
    ["R0013", "exit() in a test", "A test called `exit(code)`, which would end the whole test run. Tests should check return values instead."],
    ["R0015", "out of memory", "A value (a string, a list, a number) would need more memory than a computer has — usually a count that is far too large, such as `\"x\".repeat(1_000_000_000_000_000)`. Check the size before building the value."],
    ["R0016", "effect not allowed", "The program runs with `--allow` rights (`klar run --allow fs:./data,proc:git`) and called something outside them: a file outside the allowed directories, another program, the clock or random numbers. Add the right, or change the program."],
    ["R0014", "par_map worker lost", "A worker process of `par_map` stopped without sending its results (it was killed, e.g. by the system running out of memory)."],
  ]
}

/// The templates of `klar new` (Python str.format fields: {name}, {pkg}).
pub fn main_template() -> Str {
  return "/// \{name\}: entry point.\nfn main() uses io \{\{\n  print(greeting(\"world\"))\n\}\}\n\n/// Builds a greeting.\n/// >>> assert greeting(\"Klar\") == \"Hello, Klar!\"\nfn greeting(who: Str) -> Str \{\{\n  return \"Hello, \{\{who\}\}!\"\n\}\}\n\ntest \"greeting mentions the name\" \{\{\n  assert greeting(\"AI\").contains(\"AI\")\n\}\}\n"
}

pub fn lib_template() -> Str {
  return "// \{name\}: a Klar package. Other projects use it with `klar add \{pkg\} --git <url>` and `use \{pkg\}.\{\{greet\}\}`;\n// its other files are imported as `use \{pkg\}.<file>.\{\{...\}\}`.\n\n/// Says hello.\n/// >>> assert greet(\"Ada\") == \"Hello, Ada!\"\npub fn greet(name: Str) -> Str \{\{\n  return \"Hello, \{\{name\}\}!\"\n\}\}\n\ntest \"greets\" \{\{\n  assert greet(\"x\").starts_with(\"Hello\")\n\}\}\n"
}

pub fn agents_template() -> Str {
  return "# Working on \{name\} (instructions for AI assistants)\n\nThis project is written in **Klar**. Get the full language reference (≈2k tokens) with `klar spec`.\n\n## Loop\n1. Edit `.klar` files; keep tests next to the code (`test`, doc-tests `/// >>>`, `property`).\n2. `klar dev main.klar --json` — check + all tests + run in one step; follow the `next` field.\n3. `klar fix main.klar` applies safe fixes; `klar fmt .` normalizes the layout.\n4. Look things up instead of guessing: `klar doc split` (built-ins, std, this project), `klar outline main.klar`,\n   `klar refs name`, `klar context main.klar name` (one function with its types, tests and callers),\n   `klar eval '\"a,b\".split(\",\")'`, `klar explain E0701`.\n5. Before finishing: `klar coverage main.klar` (untested statements), `klar build main.klar` (native executable).\n6. Packages: dependencies are in `klar.toml`; `klar add name --git URL --tag v1` / `--path ../dir`, then\n   `use name.\{\{item\}\}`; `klar fetch` after cloning, `klar deps` shows the tree.\n\n## Rules that the compiler enforces\nNo null/exceptions/indexing; handle `Option`/`Result`; values are immutable (`xs = xs.push(x)`);\nno shadowing; named arguments for 3+ parameters; `uses io` etc. for effects; Int division needs a\nprovably non-zero divisor.\n"
}

/// The version of Klar.
pub fn klar_version() -> Str {
  return "1.0.0"
}

/// The files of the runtime (klar/rt), which form one module.
pub fn rt_files() -> List[Str] {
  return [
    "bytes.klar",
    "core.klar",
    "cov.klar",
    "fake.klar",
    "float.klar",
    "globals.klar",
    "int.klar",
    "list.klar",
    "map.klar",
    "misc.klar",
    "par.klar",
    "profile.klar",
    "prop.klar",
    "sandbox.klar",
    "show.klar",
    "softmath.klar",
    "str.klar",
  ]
}
