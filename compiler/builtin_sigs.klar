pub fn foreign_notes() -> List[Pair[Str, Str]] {
  return [
    Pair { first: "forEach", second: "Klar has no forEach: use `for x in xs \{ ... \}`" },
    Pair { first: "for_each", second: "Klar has no for_each: use `for x in xs \{ ... \}`" },
    Pair { first: "each", second: "use `for x in xs \{ ... \}`" },
    Pair { first: "unwrap", second: "Klar has no `unwrap`: use `?`, `match`, or `.unwrap_or(default)`" },
    Pair { first: "expect", second: "Klar has no `expect`: use `?`, `match`, or `.unwrap_or(default)`" },
    Pair { first: "pop", second: "lists are immutable: use `.last()` and `.take(xs.len() - 1)`" },
  ]
}

/// The files of the runtime (klar/rt), which form one module.
pub fn rt_files() -> List[Str] {
  return [
    "bytes.klar",
    "core.klar",
    "float.klar",
    "globals.klar",
    "int.klar",
    "list.klar",
    "map.klar",
    "misc.klar",
    "show.klar",
    "str.klar",
  ]
}
