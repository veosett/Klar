/// Signatures of the built-in functions.
pub fn global_sigs() -> List[Str] {
  return [
    "fn print[T](value: T) -> Unit uses io",
    "fn read_line() -> Option[Str] uses io",
    "fn fail(message: Str) -> Never",
    "fn range(start: Int, end: Int) -> List[Int]",
    "fn now_ms() -> Int uses time",
    "fn now_ns() -> Int uses time",
    "fn random_int(min: Int, max: Int) -> Int uses rand",
    "fn dbg[T](value: T) -> T uses io",
    "fn todo(what: Str) -> Never",
    "fn read_file(path: Str) -> Result[Str, Str] uses fs",
    "fn write_file(path: Str, content: Str) -> Result[Unit, Str] uses fs",
    "fn file_exists(path: Str) -> Bool uses fs",
    "fn exit(code: Int) -> Never uses io",
    "fn run_command(args: List[Str]) -> Result[Int, Str] uses proc",
    "fn set_executable(path: Str) -> Result[Unit, Str] uses fs",
    "fn env_var(name: Str) -> Option[Str] uses io",
    "fn cli_args() -> List[Str] uses io",
    "fn Some[T](value: T) -> Option[T]",
    "fn Ok[T, E](value: T) -> Result[T, E]",
    "fn Err[T, E](error: E) -> Result[T, E]",
    "fn float_from_bits(bits: Int) -> Float",
    "fn bytes_of(xs: List[Int]) -> Bytes",
    "fn read_bytes(path: Str) -> Result[Bytes, Str] uses fs",
    "fn write_bytes(path: Str, data: Bytes) -> Result[Unit, Str] uses fs",
  ]
}

