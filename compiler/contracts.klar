// Property tests from contracts, as klar/contracts.py: `klarc test` runs every pure function with `ensures` on random
// inputs that satisfy its `requires`. The properties are generated as Klar source after the main file and checked
// like any other code.
use ast.{Decl, Span, TypeExpr, expr_span}
use checker.{contract_candidates}
use loader.{Ld, load_program_with, load_runtime}

/// The source of a span, on one line.
fn span_text(lines: List[Str], sp: Span) -> Str {
  if sp.line == sp.end_line {
    return lines.get_or(sp.line - 1, "").slice(sp.col - 1, sp.end_col - 1)
  }
  let first = lines.get_or(sp.line - 1, "")
  var parts = [first.slice(sp.col - 1, first.len())]
  var k = sp.line
  while k < sp.end_line - 1 {
    parts = parts.push(lines.get_or(k, ""))
    k = k + 1
  }
  parts = parts.push(lines.get_or(sp.end_line - 1, "").slice(0, sp.end_col - 1))
  return parts.map(fn(x) => x.trim()).join(" ")
}

fn type_span(t: TypeExpr) -> Span {
  return match t {
    TypeExpr.Named(s, _, _) => s,
    TypeExpr.FnType(s, _, _, _) => s,
  }
}

/// The generated properties of the main module `path` ("" when there are none).
pub fn contract_text(ld: Ld, path: Str) -> Str {
  let m = match ld.by_path.get(path) {
    Some(x) => x,
    None => {
      return ""
    },
  }
  let ck = match m.checker {
    Some(c) => c,
    None => {
      return ""
    },
  }
  let src = ld.sources.get(m.display).unwrap_or("")
  let lines = src.split("\n")
  var taken: List[Str] = []
  for d in ck.decls {
    match d {
      Decl.Test(_, n, _, _) => {
        taken = taken.push(n)
      },
      Decl.Property(_, n, _, _, _) => {
        taken = taken.push(n)
      },
      _ => {},
    }
  }
  var out: List[Str] = []
  for f in contract_candidates(ck) {
    let name = "contract: " + f.name
    if not taken.contains(name) {
      let params = f.params.map(fn(p) => p.name + ": " + match p.ty {
        Some(t) => span_text(lines, type_span(t)),
        None => "?",
      }).join(", ")
      let many = f.params.len() >= 3
      let args = f.params.map(fn(p) => match many {
        true => p.name + ": " + p.name,
        false => p.name,
      }).join(", ")
      let call = "let _ = " + f.name + "(" + args + ")"
      out = out.push("property \"" + name + "\" (" + params + ") \{")
      if f.pre.is_empty() {
        out = out.push("  " + call)
      } else {
        out = out.push("  if " + f.pre.map(fn(r) => "(" + span_text(lines, expr_span(r)) + ")").join(" and ") + " \{")
        out = out.push("    " + call)
        out = out.push("  \}")
      }
      out = out.push("\}")
    }
  }
  if out.is_empty() {
    return ""
  }
  let head = match src.ends_with("\n") {
    true => "",
    false => "\n",
  }
  return head + "\n// the contracts of the functions above, as properties (generated by `klar test`)\n" + out.join("\n") +
    "\n"
}

/// The program with the contract properties of its main file (`ld` itself when there are none, or when it has
/// errors).
pub fn with_contracts(ld: Ld, path: Str, lib: Str) -> Ld uses fs {
  if ld.diags.any(fn(d) => d.severity == "error") {
    return ld
  }
  let extra = contract_text(ld, path)
  if extra == "" {
    return ld
  }
  let display = match ld.by_path.get(path) {
    Some(m) => m.display,
    None => "",
  }
  let src = ld.sources.get(display).unwrap_or("")
  let full = load_runtime(load_program_with(path: path, lib: lib, overlay: Map { path: src + extra }))
  if full.diags.any(fn(d) => d.severity == "error") {
    return ld
  }
  return full
}
