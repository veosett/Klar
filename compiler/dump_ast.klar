// Prints the syntax tree of each file given on the command line as one JSON line, in the form of
// klar/nodes.py `to_json` (used by tests/selfhost.py to compare the Klar parser with klar/parser.py).
use astjson.{error_json, field, program_json, text}
use parser.{parse_program}
use std.json.{json_object, json_text}

fn main() uses io, fs {
  for path in cli_args() {
    print(json_text(json_object([field(name: "file", value: text(path))])))
    match read_file(path) {
      Ok(src) => match parse_program(src) {
        Ok(prog) => print(json_text(program_json(prog))),
        Err(e) => print(json_text(error_json(e))),
      },
      Err(e) => print(json_text(json_object([field(name: "error", value: text(e))]))),
    }
  }
}
