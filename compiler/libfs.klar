// The library files klarc reads (prelude, runtime, standard library, `klarc spec`, `klarc view`): from the library
// directory on disk, else — for a file of the default directory `klar/` that is not there — from the copies built
// into klarc (compiler/libsrc.klar, generated by `python tests/selfhost.py --update`). So the klarc binary alone
// builds, tests and checks programs in any directory.
use libsrc.{embedded_lines, embedded_paths}

/// The path of a library file under the default directory `klar/` (None: another path).
fn embedded_name(path: Str) -> Option[Str] {
  if not path.starts_with("klar/") {
    return None
  }
  let name = path.slice(5, path.len())
  return match embedded_paths().contains(name) {
    true => Some(name),
    false => None,
  }
}

/// The text of `path` (as `read_file`), with the built-in copy of a library file that is not on disk.
pub fn read_source(path: Str) -> Result[Str, Str] uses fs {
  let disk = read_file(path)
  if disk.is_ok() {
    return disk
  }
  return match embedded_name(path) {
    Some(name) => Ok(embedded_lines(name).join("\n")),
    None => disk,
  }
}

/// Whether `path` exists (as `file_exists`), or is a library file built into klarc.
pub fn source_exists(path: Str) -> Bool uses fs {
  return file_exists(path) or embedded_name(path) != None
}

/// The names in directory `dir` (as `list_dir`); the built-in library files when it is a library directory that
/// is not on disk.
pub fn list_source_dir(dir: Str) -> Result[List[Str], Str] uses fs {
  let disk = list_dir(dir)
  if disk.is_ok() or not dir.starts_with("klar/") {
    return disk
  }
  let prefix = dir.slice(5, dir.len()) + "/"
  let names = embedded_paths().filter(fn(p) => p.starts_with(prefix)).map(fn(p) => p.slice(prefix.len(), p.len()))
  return match names.is_empty() {
    true => disk,
    false => Ok(names.filter(fn(n) => not n.contains("/"))),
  }
}

test "the built-in library" {
  assert embedded_paths().contains("rt/core.klar")
  assert embedded_paths().contains("prelude.klar")
  assert embedded_name("klar/std/json.klar") == Some("std/json.klar")
  assert embedded_name("lib/std/json.klar") == None
  assert embedded_name("klar/nothing.klar") == None
  assert embedded_lines("std/json.klar").len() > 10
}
