// Types of the checker, written in Klar (self-hosting, stage 4). Mirrors klar/types.py, but without mutation:
// type variables are bound in a substitution (`Subst`), and `unify` returns the extended substitution or
// `None` — a failed unification leaves nothing behind, which is what the Python trail undoes by hand.

/// A static type. `Var` is an inference variable (bound in a `Subst`), `Param` a rigid generic parameter
/// inside a generic function, `Any` the error-recovery type that unifies with everything, `Never` the type of
/// `fail(...)`. `eff` of a function type is one of (see `Eff` in klar/types.py):
/// `Con("uses", [Con(e), ...])` — exactly these effects (a written type);
/// `Con("uses?", [Var(id), Con(e), ...])` — at least these, decided by unification (`id` is bound to the effects
/// it grows to);
/// `Con("uses*", [])` — a function parameter of a built-in: every call gets a fresh `uses?`.
pub enum Type {
  Con(name: Str, args: List[Type]),
  Fun(params: List[Type], ret: Type, eff: Type),
  Var(id: Int),
  Param(name: Str),
  Any,
  Never,
}

/// Bindings of the type variables.
pub type Subst = Map[Int, Type]

pub fn con(name: Str) -> Type {
  return Type.Con(name: name, args: [])
}

pub fn list_of(t: Type) -> Type {
  return Type.Con(name: "List", args: [t])
}

pub fn option_of(t: Type) -> Type {
  return Type.Con(name: "Option", args: [t])
}

pub fn result_of(t: Type, e: Type) -> Type {
  return Type.Con(name: "Result", args: [t, e])
}

pub fn map_of(k: Type, v: Type) -> Type {
  return Type.Con(name: "Map", args: [k, v])
}

/// Exactly the effects `names` (sorted, without duplicates).
pub fn eff_fixed(names: List[Str]) -> Type {
  return Type.Con(name: "uses", args: names.unique().sort().map(fn(n) => con(n)))
}

/// At least the effects `names`; `id` is a fresh variable.
pub fn eff_flex(id: Int, names: List[Str]) -> Type {
  return Type.Con(name: "uses?", args: [Type.Var(id: id)].concat(names.unique().sort().map(fn(n) => con(n))))
}

pub fn pure_eff() -> Type {
  return Type.Con(name: "uses", args: [])
}

pub fn poly_eff() -> Type {
  return Type.Con(name: "uses*", args: [])
}

/// The effects `eff` stands for now (following the variables of flexible ones).
pub fn eff_root(s: Subst, eff: Type) -> Type {
  var cur = eff
  while true {
    let next = match cur {
      Type.Con(kind, args) => match kind == "uses?" {
        true => match args.get(0) {
          Some(Type.Var(id)) => s.get(id),
          _ => None,
        },
        false => None,
      },
      _ => None,
    }
    match next {
      Some(v) => {
        cur = v
      },
      None => {
        return cur
      },
    }
  }
  return cur
}

fn eff_kind(eff: Type) -> Str {
  return match eff {
    Type.Con(kind, _) => kind,
    _ => "uses",
  }
}

/// The effect names of `eff` (sorted).
pub fn eff_list(s: Subst, eff: Type) -> List[Str] {
  let root = eff_root(s, eff)
  return match root {
    Type.Con(kind, args) => args.drop(match kind == "uses?" {
      true => 1,
      false => 0,
    }).flat_map(fn(a) => match a {
      Type.Con(n, _) => [n],
      _ => [],
    }),
    _ => [],
  }
}

/// The effects of calling a value of type `t` (none for anything that is not a function).
pub fn eff_names(s: Subst, t: Type) -> List[Str] {
  return match prune(s, t) {
    Type.Fun(_, _, eff) => eff_list(s, eff),
    _ => [],
  }
}

/// Whether `eff` is flexible (and not decided yet).
pub fn eff_is_flex(s: Subst, eff: Type) -> Bool {
  return eff_kind(eff_root(s, eff)) == "uses?"
}

pub fn eff_is_poly(eff: Type) -> Bool {
  return eff_kind(eff) == "uses*"
}

fn subset(a: List[Str], b: List[Str]) -> Bool {
  return a.all(fn(x) => b.contains(x))
}

fn eff_var(eff: Type) -> Int {
  return match eff {
    Type.Con(_, args) => match args.get(0) {
      Some(Type.Var(id)) => id,
      _ => -1,
    },
    _ => -1,
  }
}

fn unify_eff(s: Subst, a: Type, b: Type) -> Option[Subst] {
  let x = eff_root(s, a)
  let y = eff_root(s, b)
  if x == y {
    return Some(s)
  }
  let lx = eff_list(s, x)
  let ly = eff_list(s, y)
  let fx = eff_kind(x) == "uses?"
  let fy = eff_kind(y) == "uses?"
  if not fx and not fy {
    return match lx == ly {
      true => Some(s),
      false => None,
    }
  }
  if not fx {
    return unify_eff(s: s, a: y, b: x)
  }
  // x is flexible: it may grow up to y, or the smaller of two flexible ones takes the larger
  if subset(lx, ly) {
    return Some(s.set(eff_var(x), y))
  }
  if fy and subset(ly, lx) {
    return Some(s.set(eff_var(y), x))
  }
  return None
}

/// Follows the bindings of a type variable to its current value.
pub fn prune(s: Subst, t: Type) -> Type {
  var cur = t
  while true {
    let next = match cur {
      Type.Var(id) => s.get(id),
      _ => None,
    }
    match next {
      Some(v) => {
        cur = v
      },
      None => {
        return cur
      },
    }
  }
  return cur
}

fn occurs(s: Subst, id: Int, t: Type) -> Bool {
  return match prune(s, t) {
    Type.Var(other) => other == id,
    Type.Con(_, args) => args.any(fn(a) => occurs(s: s, id: id, t: a)),
    Type.Fun(ps, ret, _) => ps.any(fn(p) => occurs(s: s, id: id, t: p)) or occurs(s: s, id: id, t: ret),
    _ => false,
  }
}

fn unify_all(s: Subst, xs: List[Type], ys: List[Type]) -> Option[Subst] {
  var cur = s
  var i = 0
  while i < xs.len() {
    match unify(s: cur, a: xs.get_or(i, Type.Any), b: ys.get_or(i, Type.Any)) {
      Some(next) => {
        cur = next
      },
      None => {
        return None
      },
    }
    i = i + 1
  }
  return Some(cur)
}

fn bind(s: Subst, id: Int, t: Type) -> Option[Subst] {
  if occurs(s: s, id: id, t: t) {
    return None
  }
  return Some(s.set(id, t))
}

/// Unifies `a` and `b`: the substitution that makes them equal, or `None` (nothing is bound then).
pub fn unify(s: Subst, a: Type, b: Type) -> Option[Subst] {
  let x = prune(s, a)
  let y = prune(s, b)
  return match x {
    Type.Any => Some(s),
    Type.Never => Some(s),
    Type.Var(i) => match y {
      Type.Var(j) => match i == j {
        true => Some(s),
        false => bind(s: s, id: i, t: y),
      },
      Type.Any => Some(s),
      Type.Never => Some(s),
      _ => bind(s: s, id: i, t: y),
    },
    _ => match y {
      Type.Any => Some(s),
      Type.Never => Some(s),
      Type.Var(j) => bind(s: s, id: j, t: x),
      _ => unify_rigid(s: s, x: x, y: y),
    },
  }
}

fn unify_rigid(s: Subst, x: Type, y: Type) -> Option[Subst] {
  return match x {
    Type.Con(n1, a1) => match y {
      Type.Con(n2, a2) => match n1 == n2 and a1.len() == a2.len() {
        true => unify_all(s: s, xs: a1, ys: a2),
        false => None,
      },
      _ => None,
    },
    Type.Fun(p1, r1, e1) => match y {
      Type.Fun(p2, r2, e2) => match p1.len() == p2.len() {
        true => match unify_all(s: s, xs: p1.push(r1), ys: p2.push(r2)) {
          Some(s2) => unify_eff(s: s2, a: e1, b: e2),
          None => None,
        },
        false => None,
      },
      _ => None,
    },
    Type.Param(n1) => match y {
      Type.Param(n2) => match n1 == n2 {
        true => Some(s),
        false => None,
      },
      _ => None,
    },
    _ => None,
  }
}

/// Replaces the generic parameters named in `mapping`.
pub fn subst(s: Subst, t: Type, mapping: Map[Str, Type]) -> Type {
  return match prune(s, t) {
    Type.Param(name) => mapping.get(name).unwrap_or(Type.Param(name: name)),
    Type.Con(name, args) => Type.Con(name: name, args: args.map(fn(a) => subst(s: s, t: a, mapping: mapping))),
    Type.Fun(ps, ret, eff) => Type.Fun(params: ps.map(fn(p) => subst(s: s, t: p, mapping: mapping)),
      ret: subst(s: s, t: ret, mapping: mapping), eff: eff),
    other => other,
  }
}

/// The type as Klar source (`_` for a variable not inferred yet).
pub fn show(s: Subst, t: Type) -> Str {
  return match prune(s, t) {
    Type.Con(name, args) => match args.is_empty() {
      true => name,
      false => name + "[" + args.map(fn(a) => show(s, a)).join(", ") + "]",
    },
    Type.Fun(ps, ret, eff) => show_fn(s: s, ps: ps, ret: ret, eff: eff),
    Type.Var(_) => "_",
    Type.Param(name) => name,
    Type.Any => "?",
    Type.Never => "Never",
  }
}

fn show_fn(s: Subst, ps: List[Type], ret: Type, eff: Type) -> Str {
  let names = eff_list(s, eff)
  let start = "fn(" + ps.map(fn(p) => show(s, p)).join(", ") + ") -> "
  if names.is_empty() {
    return start + show(s, ret)
  }
  let r = match prune(s, ret) {
    Type.Fun(_, _, _) => "(" + show(s, ret) + ")",
    _ => show(s, ret),
  }
  return start + r + " uses " + names.join(", ")
}

/// The name of a constructed type (`List` for `List[Int]`), after following variables.
pub fn head(s: Subst, t: Type) -> Option[Str] {
  return match prune(s, t) {
    Type.Con(name, _) => Some(name),
    _ => None,
  }
}

pub fn head_is(s: Subst, t: Type, name: Str) -> Bool {
  return head(s, t) == Some(name)
}

pub fn is_unit(s: Subst, t: Type) -> Bool {
  return head(s, t) == Some("Unit")
}

/// The type arguments of a constructed type (empty for anything else).
pub fn args_of(s: Subst, t: Type) -> List[Type] {
  return match prune(s, t) {
    Type.Con(_, args) => args,
    _ => [],
  }
}

/// Replaces every bound variable by its value (for types that outlive their substitution).
pub fn resolved(s: Subst, t: Type) -> Type {
  return match prune(s, t) {
    Type.Con(name, args) => Type.Con(name: name, args: args.map(fn(a) => resolved(s, a))),
    Type.Fun(ps, ret, eff) => Type.Fun(params: ps.map(fn(p) => resolved(s, p)), ret: resolved(s, ret),
      eff: eff_fixed(eff_list(s, eff))),
    other => other,
  }
}

test "unify binds variables and fails without side effects" {
  let s: Subst = Map {}
  let a = Type.Var(id: 1)
  let s2 = unify(s: s, a: list_of(a), b: list_of(con("Int"))).unwrap_or(s)
  assert show(s2, a) == "Int"
  assert unify(s: s2, a: a, b: con("Str")) == None
  assert unify(s: s, a: Type.Var(id: 1), b: list_of(Type.Var(id: 1))) == None
  assert show(s, Type.Fun(params: [a, con("Bool")], ret: Type.Var(id: 2), eff: pure_eff())) == "fn(_, Bool) -> _"
  let m = Map { "T": con("Int") }
  assert show(s, subst(s: s, t: map_of(Type.Param(name: "T"), Type.Param(name: "U")), mapping: m)) == "Map[Int, U]"
}

test "effects of function types" {
  let s: Subst = Map {}
  let pure = Type.Fun(params: [], ret: con("Unit"), eff: pure_eff())
  let io = Type.Fun(params: [], ret: con("Unit"), eff: eff_fixed(["io"]))
  let lam = Type.Fun(params: [], ret: con("Unit"), eff: eff_flex(id: 7, names: ["io"]))
  assert show(s, io) == "fn() -> Unit uses io"
  assert unify(s: s, a: pure, b: io) == None
  assert unify(s: s, a: lam, b: pure) == None
  let s2 = unify(s: s, a: lam, b: Type.Fun(params: [], ret: con("Unit"), eff: eff_fixed(["fs", "io"]))).unwrap_or(s)
  assert eff_names(s2, lam) == ["fs", "io"]
  let wide = Type.Fun(params: [], ret: io, eff: eff_fixed(["time"]))
  assert show(s, wide) == "fn() -> (fn() -> Unit uses io) uses time"
}
