// klarc — the Klar compiler written in Klar (self-hosting, stage 5). It checks a program and builds a standalone
// executable for Linux (ELF, x86-64 or arm64) or Windows (PE, x86-64) with no Python involved:
//
//     klarc build app.klar [-o app] [--target linux|windows|linux-arm64|macos] [--lib <dir of klar/>] [--time]
//     klarc run app.klar [--lib <dir>] [-- args...]     build into a temporary file and run it
//     klarc test app.klar [--lib <dir>]                 build the `test` blocks and run each one
//     klarc check app.klar [--lib <dir of klar/>]
//
// The library directory holds the runtime (`rt/`) and the standard library (`std/`); it defaults to $KLAR_LIB, then
// `klar`. Bootstrap: `klar build compiler/klarc.klar` (the Python compiler) gives klarc1; klarc1 builds klarc2 from the
// same source and klarc2 builds klarc3 — tests/bootstrap.py checks that all three are the same bytes.
use ast.{Decl}
use builtin_sigs.{klar_version}
use commands.{context_command, doc_command, explain, fix_command, fmt_command, new_command, outline_command}
use commands.{refs_command}
use commands.{ast_command, rename_command, spec_command}
use patch.{patch_command}
use pkg.{pkg_command}
use evaluate.{eval_command}
use view.{view_command}
use lsp.{lsp_command}
use mcp.{mcp_command}
use repl.{repl_command}
use coverage.{coverage_command}
use profile.{profile_command}
use dev.{dev_command, host_target, show_failure, test_items}
use report.{check_json, render_report, user_diags}
use emit.{emit_program}
use emit_a64.{emit_a64}
use link.{write_elf, write_macho, write_pe}
use loader.{Ld, Module, load_program, load_runtime}
use lower.{fnv1a, lower_program, lower_program_allow}

const TARGETS: List[Str] = ["linux", "windows", "linux-arm64", "macos"]

type Options { cmd: Str, file: Str, out: Str, target: Str, lib: Str, time: Bool, json: Bool, quiet: Bool, filter: Str,
  runs: Int, seed: Int, args: List[Str], allow: Option[Str] }

/// The rights of an `--allow` value (klar/sandbox.py), or the problem with an unknown one.
fn parse_allow(spec: Str) -> Result[List[Str], Str] {
  var out: List[Str] = []
  for raw in spec.split(",") {
    let r = raw.trim()
    if r != "" {
      let kind = r.split(":").get_or(0, "")
      let has_colon = r.contains(":")
      let arg = match r.index_of(":") {
        Some(k) => r.slice(k + 1, r.len()),
        None => "",
      }
      let known = ["io", "time", "rand", "net", "fs", "proc"].contains(kind)
      if not known or (arg != "" and kind != "fs" and kind != "proc") or (has_colon and arg == "") {
        return Err("unknown right `{r}` (rights: io, time, rand, net, fs, fs:DIR, proc, proc:NAME)")
      }
      out = out.push(r)
    }
  }
  return Ok(out)
}

fn usage() -> Never uses io {
  print("usage: klarc build <file.klar> [-o <out>] [--target linux|windows|linux-arm64|macos] [--allow <rights>] [--lib <dir>]")
  print("                   [--time]")
  print("       klarc run <file.klar> [--allow <rights>] [--lib <dir>] [-- <program arguments>]")
  print("       klarc test <file.klar> [-k <text>] [-q] [--runs <n>] [--seed <n>] [--lib <dir>]")
  print("       klarc patch <file.klar> <patch.json | - | json> [--dry-run] [--force] [--json]")
  print("       klarc add <name> (--path <dir> | --git <url> [--tag|--rev|--branch <x>]) [--no-fetch] [--json]")
  print("       klarc remove <name> | fetch | update [names] | deps   [--dir <project>] [--json]")
  print("       klarc profile <file.klar> [args...] [--top <n>] [--show-output] [--json]")
  print("       klarc coverage <file.klar> [--main] [--runs <n>] [--min <percent>] [--json]")
  print("       klarc repl [--plain]                       an interactive session (--plain: no banner, no prompts)")
  print("       klarc lsp                                  the language server (LSP over stdin/stdout)")
  print("       klarc mcp [--klarc <path>]                 the MCP server with the Klar tools for AI agents (stdio)")
  print("       klarc view <file.klar> [-o <out.html>] [--run] [--stdin <text>] [--json]")
  print("       klarc eval [statements...] <expression> [--in <file.klar>] [--json]")
  print("       klarc dev <file.klar> [--json] [--no-run] [--stdin <text>] [--max-output <n>] [--max-warnings <n>]")
  print("       klarc check <file.klar> [--lib <dir>] [--json]")
  print("       klarc fmt [files or directories] [--check] [--json]")
  print("       klarc explain <code>")
  print("       klarc new <dir> [--lib]")
  print("       klarc outline <file.klar> [--all] [--json]")
  print("       klarc refs <file.klar> <name> [--json]")
  print("       klarc spec")
  print("       klarc ast <file.klar> [--pretty]")
  print("       klarc doc <query> [--in <file.klar>] [--limit <n>] [--json]")
  print("       klarc rename <file.klar> <old> <new> [--dry-run] [--json]")
  print("       klarc fix <file.klar> [--dry-run] [--all] [--warnings] [--json] [--lib <dir>]")
  return exit(2)
}

/// The library directory: `--lib`, else $KLAR_LIB, else `klar`.
fn lib_dir(args: List[Str]) -> Str uses io {
  return match args.index_of("--lib") {
    Some(k) => args.get_or(k + 1, "klar"),
    None => env_var("KLAR_LIB").unwrap_or("klar"),
  }
}

fn parse_args(args: List[Str]) -> Options uses io, proc {
  var o = Options { cmd: args.get_or(0, ""), file: "", out: "", target: "", lib: env_var("KLAR_LIB").unwrap_or(
    "klar"), time: false, json: false, quiet: false, filter: "", runs: 100,
    seed: 0, args: [], allow: None }
  var i = 1
  while i < args.len() {
    let a = args.get_or(i, "")
    let v = args.get_or(i + 1, "")
    if a == "-o" {
      o = o with { out: v }
      i = i + 2
    } else if a == "--target" {
      o = o with { target: v }
      i = i + 2
    } else if a == "--lib" {
      o = o with { lib: v }
      i = i + 2
    } else if a == "--" {
      o = o with { args: args.drop(i + 1) }
      i = args.len()
    } else if a == "--time" {
      o = o with { time: true }
      i = i + 1
    } else if a == "--json" {
      o = o with { json: true }
      i = i + 1
    } else if a == "-q" or a == "--quiet" {
      o = o with { quiet: true }
      i = i + 1
    } else if a == "-k" or a == "--filter" {
      o = o with { filter: v }
      i = i + 2
    } else if a == "--runs" {
      o = o with { runs: v.to_int().unwrap_or(100) }
      i = i + 2
    } else if a == "--seed" {
      o = o with { seed: v.to_int().unwrap_or(0) }
      i = i + 2
    } else if a == "--allow" {
      o = o with { allow: Some(v) }
      i = i + 2
    } else if o.file == "" and not a.starts_with("-") {
      o = o with { file: a }
      i = i + 1
    } else {
      return usage()
    }
  }
  if o.target == "" {
    o = o with { target: host_target() }
  }
  if not ["build", "run", "test", "check"].contains(o.cmd) or o.file == "" or not TARGETS.contains(o.target) {
    return usage()
  }
  return o
}

/// Prints a report of `render_report` (it ends with a newline, which `print` adds).
fn show_report(text: Str, to_stderr: Bool) uses io {
  if text == "" {
    return
  }
  let body = text.slice(0, text.len() - 1)
  if to_stderr {
    eprint(body)
  } else {
    print(body)
  }
}

/// The output path: `-o`, else the source path without `.klar` (+ `.exe` for Windows).
fn out_path(o: Options) -> Str {
  if o.out != "" {
    return o.out
  }
  var stem = o.file
  if stem.ends_with(".klar") {
    stem = stem.slice(0, stem.len() - 5)
  }
  if o.target == "windows" {
    return stem + ".exe"
  }
  return stem
}

/// With --time: how long a phase took.
fn lap(o: Options, phase: Str, start: Int) -> Int uses io, time {
  let t = now_ms()
  if o.time {
    print("{phase}: {t - start} ms")
  }
  return t
}

/// A file for a temporary executable: in %TEMP% on Windows, $TMPDIR or /tmp elsewhere.
fn temp_exe(o: Options, what: Str) -> Str uses io {
  let tag = fnv1a(o.file + "|" + what)
  let name = "klarc-{what}-{tag}"
  let win = env_var("TEMP").unwrap_or("")
  if win.contains("\\") {
    return "{win}\\{name}.exe"
  }
  let dir = env_var("TMPDIR").unwrap_or("/tmp")
  return "{dir}/{name}"
}

/// The names of the `test` blocks of the main module, in order.
fn write_exe(path: Str, image: Bytes) uses io, fs {
  match write_bytes(path, image) {
    Ok(_) => {},
    Err(e) => {
      print("klarc: {e}")
      exit(1)
    },
  }
  match set_executable(path) {
    Ok(_) => {},
    Err(e) => {
      print("klarc: {e}")
      exit(1)
    },
  }
}

fn run_or_fail(cmd: List[Str]) -> Int uses io, proc {
  return match run_command(cmd) {
    Ok(code) => code,
    Err(e) => {
      print("klarc: {e}")
      return exit(1)
    },
  }
}

fn main() uses io, fs, time, proc {
  let argv = cli_args()
  if argv.get_or(0, "") == "fmt" {
    exit(fmt_command(argv.drop(1)))
  }
  if argv.get_or(0, "") == "explain" and argv.len() == 2 {
    print(explain(argv.get_or(1, "")))
    return
  }
  if argv.get_or(0, "") == "--version" {
    print("klarc {klar_version()}")
    return
  }
  let tool = argv.get_or(0, "")
  if tool == "outline" {
    exit(outline_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "ast" {
    exit(ast_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "spec" {
    exit(spec_command(lib_dir(argv)))
  }
  if tool == "doc" {
    exit(doc_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "refs" {
    exit(refs_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "context" {
    exit(context_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if ["add", "remove", "fetch", "update", "deps"].contains(tool) {
    exit(pkg_command(tool: tool, args: argv.drop(1)))
  }
  if tool == "profile" {
    exit(profile_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "coverage" {
    exit(coverage_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "repl" {
    exit(repl_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "mcp" {
    exit(mcp_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "lsp" {
    exit(lsp_command(lib_dir(argv)))
  }
  if tool == "view" {
    exit(view_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "eval" {
    exit(eval_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "dev" {
    exit(dev_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "patch" {
    exit(patch_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if tool == "rename" {
    exit(rename_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  if argv.get_or(0, "") == "new" {
    exit(new_command(argv.drop(1)))
  }
  if argv.get_or(0, "") == "fix" {
    exit(fix_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  let o = parse_args(argv)
  let rights = match o.allow {
    Some(spec) => match parse_allow(spec) {
      Ok(r) => Some(r),
      Err(e) => {
        eprint("error: " + e)
        return exit(2)
      },
    },
    None => None,
  }
  let t0 = now_ms()
  if not file_exists(o.file) {
    print("klarc: cannot read {o.file}")
    exit(1)
  }
  let shown = o.file.replace("\\", "/").split("/").last().unwrap_or(o.file)
  if o.cmd == "check" {
    let checked = load_program(o.file, o.lib)
    let diags = user_diags(checked, shown)
    if o.json {
      print(check_json(checked, diags))
    } else {
      show_report(text: render_report(checked, diags), to_stderr: false)
      if diags.is_empty() {
        print("ok: no problems found")
      }
    }
    if diags.any(fn(d) => d.severity == "error") {
      exit(1)
    }
    return
  }
  let ld = load_runtime(load_program(o.file, o.lib))
  let t1 = lap(o: o, phase: "parse + check", start: t0)
  let diags = user_diags(ld, shown)
  if ld.diags.any(fn(d) => d.severity == "error") {
    show_report(text: render_report(ld, diags), to_stderr: true)
    exit(1)
  }
  if o.cmd == "run" {
    let warnings = diags.filter(fn(d) => d.severity == "warning")
    show_report(text: render_report(ld, warnings), to_stderr: true)
  }
  let tests = o.cmd == "test"
  let all_tests = test_items(ld, o.file)
  let items = all_tests.filter(fn(t) => t.name.contains(o.filter))
  if tests {
    let warnings = diags.filter(fn(d) => d.severity == "warning")
    if not o.quiet {
      show_report(text: render_report(ld, warnings), to_stderr: true)
    }
  }
  if tests and items.is_empty() {
    print("no tests found")
    print("\n0 passed, 0 failed")
    return
  }
  let w = lower_program_allow(ld: ld, main_path: o.file, tests: tests, allow: rights)
  let t2 = lap(o: o, phase: "lower", start: t1)
  var x = emit_program(w, "linux")
  if o.target == "linux-arm64" {
    x = emit_a64(w)
  } else if o.target == "windows" {
    x = emit_program(w, "windows")
  } else if o.target == "macos" {
    x = emit_program(w, "macos")
  }
  let t3 = lap(o: o, phase: "optimize + allocate + emit", start: t2)
  var image = bytes_of([])
  if o.target == "windows" {
    image = write_pe(x)
  } else if o.target == "macos" {
    image = write_macho(x)
  } else {
    image = write_elf(x)
  }
  let _ = lap(o: o, phase: "link", start: t3)
  if o.cmd == "run" {
    let exe = temp_exe(o, "run")
    write_exe(exe, image)
    exit(run_or_fail([exe].concat(o.args)))
  }
  if tests {
    let exe = temp_exe(o, "test")
    write_exe(exe, image)
    var passed = 0
    var failed = 0
    for t in items {
      var label = ""
      if t.is_property {
        label = " [property x{o.runs}]"
      }
      // the test executable takes `runs seed index` (properties use the first two)
      let targs = [exe, o.runs.to_str(), o.seed.to_str(), t.index.to_str()]
      match run_capture(args: targs, dir: "", input: "") {
        Ok(res) => {
          if res.get_or(0, "") == "0" {
            print("  PASS  {t.name}{label}")
            passed = passed + 1
          } else {
            print("  FAIL  {t.name}{label}")
            show_failure(out: res.get_or(1, ""), err: res.get_or(2, ""))
            failed = failed + 1
          }
        },
        Err(_) => {
          // no captured output here (Windows): the test prints its own failure
          if run_or_fail(targs) == 0 {
            print("  PASS  {t.name}{label}")
            passed = passed + 1
          } else {
            print("  FAIL  {t.name}{label}")
            failed = failed + 1
          }
        },
      }
    }
    print("\n{passed} passed, {failed} failed")
    if failed > 0 {
      exit(1)
    }
    return
  }
  let out = out_path(o)
  write_exe(out, image)
  print("built {out} ({o.target}, {image.len() / 1024} KB, no runtime dependencies)")
}
