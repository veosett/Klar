// klarc — the Klar compiler written in Klar (self-hosting, stage 5). It checks a program and builds a standalone
// executable for Linux (ELF, x86-64 or arm64) or Windows (PE, x86-64) with no Python involved:
//
//     klarc build app.klar [-o app] [--target linux|windows|linux-arm64] [--lib <dir of klar/>] [--time]
//     klarc run app.klar [--lib <dir>] [-- args...]     build into a temporary file and run it
//     klarc test app.klar [--lib <dir>]                 build the `test` blocks and run each one
//     klarc check app.klar [--lib <dir of klar/>]
//
// The library directory holds the runtime (`rt/`) and the standard library (`std/`); it defaults to $KLAR_LIB, then
// `klar`. Bootstrap: `klar build compiler/klarc.klar` (the Python compiler) gives klarc1; klarc1 builds klarc2 from the
// same source and klarc2 builds klarc3 — tests/bootstrap.py checks that all three are the same bytes.
use ast.{Decl}
use builtin_sigs.{klar_version}
use commands.{explain, fix_command, fmt_command}
use report.{check_json, render_report, user_diags}
use emit.{emit_program}
use emit_a64.{emit_a64}
use link.{write_elf, write_pe}
use loader.{Ld, Module, load_program, load_runtime}
use lower.{fnv1a, lower_program}

const TARGETS: List[Str] = ["linux", "windows", "linux-arm64"]

type Options { cmd: Str, file: Str, out: Str, target: Str, lib: Str, time: Bool, json: Bool, args: List[Str] }

fn usage() -> Never uses io {
  print("usage: klarc build <file.klar> [-o <out>] [--target linux|windows|linux-arm64] [--lib <dir>] [--time]")
  print("       klarc run <file.klar> [--lib <dir>] [-- <program arguments>]")
  print("       klarc test <file.klar> [--lib <dir>]")
  print("       klarc check <file.klar> [--lib <dir>] [--json]")
  print("       klarc fmt [files or directories] [--check] [--json]")
  print("       klarc explain <code>")
  print("       klarc fix <file.klar> [--dry-run] [--all] [--warnings] [--json] [--lib <dir>]")
  return exit(2)
}

/// The library directory: `--lib`, else $KLAR_LIB, else `klar`.
fn lib_dir(args: List[Str]) -> Str uses io {
  return match args.index_of("--lib") {
    Some(k) => args.get_or(k + 1, "klar"),
    None => env_var("KLAR_LIB").unwrap_or("klar"),
  }
}

fn parse_args(args: List[Str]) -> Options uses io {
  var o = Options { cmd: args.get_or(0, ""), file: "", out: "", target: "linux", lib: env_var("KLAR_LIB").unwrap_or(
    "klar"), time: false, json: false, args: [] }
  var i = 1
  while i < args.len() {
    let a = args.get_or(i, "")
    let v = args.get_or(i + 1, "")
    if a == "-o" {
      o = o with { out: v }
      i = i + 2
    } else if a == "--target" {
      o = o with { target: v }
      i = i + 2
    } else if a == "--lib" {
      o = o with { lib: v }
      i = i + 2
    } else if a == "--" {
      o = o with { args: args.drop(i + 1) }
      i = args.len()
    } else if a == "--time" {
      o = o with { time: true }
      i = i + 1
    } else if a == "--json" {
      o = o with { json: true }
      i = i + 1
    } else if o.file == "" and not a.starts_with("-") {
      o = o with { file: a }
      i = i + 1
    } else {
      return usage()
    }
  }
  if not ["build", "run", "test", "check"].contains(o.cmd) or o.file == "" or not TARGETS.contains(o.target) {
    return usage()
  }
  return o
}

/// Prints a report of `render_report` (it ends with a newline, which `print` adds).
fn show_report(text: Str, to_stderr: Bool) uses io {
  if text == "" {
    return
  }
  let body = text.slice(0, text.len() - 1)
  if to_stderr {
    eprint(body)
  } else {
    print(body)
  }
}

/// The output path: `-o`, else the source path without `.klar` (+ `.exe` for Windows).
fn out_path(o: Options) -> Str {
  if o.out != "" {
    return o.out
  }
  var stem = o.file
  if stem.ends_with(".klar") {
    stem = stem.slice(0, stem.len() - 5)
  }
  if o.target == "windows" {
    return stem + ".exe"
  }
  return stem
}

/// With --time: how long a phase took.
fn lap(o: Options, phase: Str, start: Int) -> Int uses io, time {
  let t = now_ms()
  if o.time {
    print("{phase}: {t - start} ms")
  }
  return t
}

/// A file for a temporary executable: in %TEMP% on Windows, $TMPDIR or /tmp elsewhere.
fn temp_exe(o: Options, what: Str) -> Str uses io {
  let tag = fnv1a(o.file + "|" + what)
  let name = "klarc-{what}-{tag}"
  let win = env_var("TEMP").unwrap_or("")
  if win.contains("\\") {
    return "{win}\\{name}.exe"
  }
  let dir = env_var("TMPDIR").unwrap_or("/tmp")
  return "{dir}/{name}"
}

/// The names of the `test` blocks of the main module, in order.
fn test_names(ld: Ld, file: Str) -> List[Str] {
  var out: List[Str] = []
  let decls = match ld.by_path.get(file) {
    Some(m) => match m.checker {
      Some(c) => c.decls,
      None => [],
    },
    None => [],
  }
  for d in decls {
    match d {
      Decl.Test(_, name, _) => {
        out = out.push(name)
      },
      _ => {},
    }
  }
  return out
}

fn write_exe(path: Str, image: Bytes) uses io, fs {
  match write_bytes(path, image) {
    Ok(_) => {},
    Err(e) => {
      print("klarc: {e}")
      exit(1)
    },
  }
  match set_executable(path) {
    Ok(_) => {},
    Err(e) => {
      print("klarc: {e}")
      exit(1)
    },
  }
}

fn run_or_fail(cmd: List[Str]) -> Int uses io, proc {
  return match run_command(cmd) {
    Ok(code) => code,
    Err(e) => {
      print("klarc: {e}")
      return exit(1)
    },
  }
}

fn main() uses io, fs, time, proc {
  let argv = cli_args()
  if argv.get_or(0, "") == "fmt" {
    exit(fmt_command(argv.drop(1)))
  }
  if argv.get_or(0, "") == "explain" and argv.len() == 2 {
    print(explain(argv.get_or(1, "")))
    return
  }
  if argv.get_or(0, "") == "--version" {
    print("klarc {klar_version()}")
    return
  }
  if argv.get_or(0, "") == "fix" {
    exit(fix_command(args: argv.drop(1), lib: lib_dir(argv)))
  }
  let o = parse_args(argv)
  let t0 = now_ms()
  if not file_exists(o.file) {
    print("klarc: cannot read {o.file}")
    exit(1)
  }
  let shown = o.file.replace("\\", "/").split("/").last().unwrap_or(o.file)
  if o.cmd == "check" {
    let checked = load_program(o.file, o.lib)
    let diags = user_diags(checked, shown)
    if o.json {
      print(check_json(checked, diags))
    } else {
      show_report(text: render_report(checked, diags), to_stderr: false)
      if diags.is_empty() {
        print("ok: no problems found")
      }
    }
    if diags.any(fn(d) => d.severity == "error") {
      exit(1)
    }
    return
  }
  let ld = load_runtime(load_program(o.file, o.lib))
  let t1 = lap(o: o, phase: "parse + check", start: t0)
  let diags = user_diags(ld, shown)
  if ld.diags.any(fn(d) => d.severity == "error") {
    show_report(text: render_report(ld, diags), to_stderr: true)
    exit(1)
  }
  if o.cmd == "run" {
    let warnings = diags.filter(fn(d) => d.severity == "warning")
    show_report(text: render_report(ld, warnings), to_stderr: true)
  }
  let tests = o.cmd == "test"
  let names = test_names(ld, o.file)
  if tests and names.is_empty() {
    print("no tests found")
    print("\n0 passed, 0 failed")
    return
  }
  let w = lower_program(ld: ld, main_path: o.file, tests: tests)
  let t2 = lap(o: o, phase: "lower", start: t1)
  var x = emit_program(w, "linux")
  if o.target == "linux-arm64" {
    x = emit_a64(w)
  } else if o.target == "windows" {
    x = emit_program(w, "windows")
  }
  let t3 = lap(o: o, phase: "optimize + allocate + emit", start: t2)
  var image = bytes_of([])
  if o.target == "windows" {
    image = write_pe(x)
  } else {
    image = write_elf(x)
  }
  let _ = lap(o: o, phase: "link", start: t3)
  if o.cmd == "run" {
    let exe = temp_exe(o, "run")
    write_exe(exe, image)
    exit(run_or_fail([exe].concat(o.args)))
  }
  if tests {
    let exe = temp_exe(o, "test")
    write_exe(exe, image)
    var passed = 0
    var failed = 0
    var i = 0
    for name in names {
      if run_or_fail([exe, i.to_str()]) == 0 {
        print("  PASS  {name}")
        passed = passed + 1
      } else {
        print("  FAIL  {name}")
        failed = failed + 1
      }
      i = i + 1
    }
    print("\n{passed} passed, {failed} failed")
    if failed > 0 {
      exit(1)
    }
    return
  }
  let out = out_path(o)
  write_exe(out, image)
  print("built {out} ({o.target}, {image.len() / 1024} KB, no runtime dependencies)")
}
