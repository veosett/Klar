// Generated by `python tests/selfhost.py --update` from klar/prelude.klar, klar/rt, klar/std,
// klar/ai_reference.md and klar/tools/view_template.html: do not edit by hand (tests/selfhost.py fails when
// this file is out of date). klarc reads these copies when the library directory is not on disk
// (compiler/libfs.klar).

/// The files built into klarc, by path under the library directory.
pub fn embedded_paths() -> List[Str] {
  return [
    "ai_reference.md",
    "prelude.klar",
    "rt/bytes.klar",
    "rt/core.klar",
    "rt/cov.klar",
    "rt/fake.klar",
    "rt/float.klar",
    "rt/globals.klar",
    "rt/int.klar",
    "rt/limit.klar",
    "rt/list.klar",
    "rt/map.klar",
    "rt/misc.klar",
    "rt/par.klar",
    "rt/profile.klar",
    "rt/prop.klar",
    "rt/sandbox.klar",
    "rt/show.klar",
    "rt/softmath.klar",
    "rt/str.klar",
    "rt/trace.klar",
    "std/csv.klar",
    "std/hash.klar",
    "std/json.klar",
    "std/list.klar",
    "std/math.klar",
    "std/numfmt.klar",
    "std/path.klar",
    "std/regex.klar",
    "std/result.klar",
    "std/set.klar",
    "std/text.klar",
    "std/time.klar",
    "tools/view_template.html",
  ]
}

/// The lines of a library file built into klarc ([]: it is not one).
pub fn embedded_lines(path: Str) -> List[Str] {
  return match path {
    "ai_reference.md" => [
      "# Klar 1.0 — compact reference for AI authors",
      "",
      "Klar is a small, strict, statically typed language compiled to native code. Follow these rules",
      "exactly; the compiler rejects everything else with a coded error (`klar explain CODE`).",
      "",
      "## Workflow",
      "0. With an MCP client, use the `klar mcp` server: tools `klar_dev`, `klar_check`, `klar_patch`, `klar_eval`, `klar_doc`, ….",
      "1. Write code (with `test` blocks / doc-tests next to it).",
      "2. `klar dev file.klar --json` — ONE step: check + all tests + run `main`; compact JSON with a `next` field.",
      "   Or separately: `klar check --json`, `klar test --json`, `klar run`.",
      "3. `klar fix file.klar` applies every safe machine fix (`;`, `&&`, missing named args, effects, ...);",
      "   `klar fmt file.klar` normalizes the layout.",
      "   Look things up instead of guessing: `klar doc split` / `klar doc List.sort` (signature + tested examples),",
      "   `klar eval '\"a,b\".split(\",\")'` (value : type), `klar outline file.klar` (API of a file),",
      "   `klar refs file.klar name`, `klar rename file.klar old new`, `klar coverage file.klar` (untested statements),",
      "   `klar context file.klar name [--max-tokens 2000]` (one function/type/constant: its source and docs, the",
      "   signatures it uses, its tests and callers — enough to change it without reading files).",
      "   Edit by name, not by rewriting files: `klar patch file.klar '\{\"edits\": [\{\"replace\": \"fname\", \"with\": \"fn ...\"\}]\}' --test --json`",
      "   (also `Type.method`, `test:name`, `insert`+`after`/`before`, `delete`, `find`+`replace`+`in`, `rename`+`to`,",
      "   `id` from `klar ast`); it writes only if there are no new errors and the tests pass.",
      "   Packages: `klar add name --git URL --tag v1` (or `--path ../dir`) edits klar.toml and fetches; `klar fetch` after a",
      "   clone; `klar deps --json` shows the tree.",
      "4. Failures show values, both sides of `assert`, the Klar call stack, minimal property counterexamples.",
      "5. `klar run --allow fs:./data,proc:git,time file.klar` runs with only these rights (`io` always; R0016 outside;",
      "   `fs`/`proc` alone allow everything of that kind; without `env`/`env:NAME`, `env_var` returns None);",
      "   `klar build --allow ...` builds them into the executable.",
      "   `klar run --record t.json file.klar` records input, clock, random numbers, files read and results of writes;",
      "   `klar replay t.json` reruns it byte for byte without them (R0017 if the program changed).",
      "   `--timeout N` (run, build, test, dev; default 10 s per test and for main in test, dev, eval) stops an endless loop",
      "   or recursion with R0018 at the `while` or the function that was running.",
      "   `klar run` compiles to a native executable (cached); `klar build file.klar` writes a standalone",
      "   `.exe`/ELF (`--target windows|linux|linux-arm64`, experimental `macos`); `klar profile file.klar` shows where time goes.",
      "",
      "## Lexical",
      "- One statement per line. NO semicolons. Blocks use `\{ \}`. Comments: `// ...`, doc comments: `/// ...`.",
      "- Inside `( )` and `[ ]` newlines are ignored. A line starting with `.` continues a method chain.",
      "  To break a long expression elsewhere, end the line with the operator (`a +` newline `b`), or wrap it in `( )`.",
      "- Logic: `and`, `or`, `not` (never `&&`, `||`, `!`). No `++`, `+=`.",
      "- Strings: double quotes, interpolation `\"sum = \{a + b\}\"`, literal brace `\\\{`. No string literals inside `\{...\}`.",
      "- Names: types/variants `PascalCase`; functions/variables `snake_case`; `_x` silences unused warnings.",
      "",
      "## Declarations (top level only)",
      "```klar",
      "type Point \{ x: Int, y: Int \}                       // record (all fields required)",
      "enum Shape \{ Circle(radius: Float), Square(side: Float), Empty \}   // variant fields are named",
      "fn area(s: Shape) -> Float \{ ... \}                  // param types + return type required",
      "fn first[T](xs: List[T]) -> Option[T] \{ ... \}       // generics in [ ]",
      "fn save(p: Point) -> Result[Unit, Str] uses io \{ ... \}   // effects: io time rand fs net proc",
      "fn div(a: Int, b: Int) -> Int",
      "  requires b != 0                                   // precondition (pure Bool)",
      "  ensures result * b <= a                           // postcondition; `result` = return value",
      "\{ return a / b \}",
      "test \"div works\" \{ assert div(7, 2) == 3 \}          // tests sit next to code",
      "```",
      "```klar",
      "use geometry.\{Point, area\}                          // first lines of a file; loads geometry.klar next to it",
      "pub fn area(p: Point) -> Float \{ ... \}              // only `pub` fn/type/enum/const/trait can be imported (E0606)",
      "use std.math.\{gcd, mean\}                            // standard modules: std.math std.text std.list std.result std.set std.json std.time std.path std.csv std.regex std.hash std.numfmt",
      "use geometry.shapes.\{Circle\}                        // a dependency from klar.toml: <geometry>/shapes.klar (`use geometry.\{x\}`: lib.klar)",
      "type Pair2[A, B] \{ left: A, right: B \}              // generic record (prelude already has Pair/Entry/Indexed)",
      "enum Tree[T] \{ Leaf, Node(left: Tree[T], value: T, right: Tree[T]) \}   // generic, recursive enum",
      "type UserId = Int                                   // alias (transparent)",
      "type Meters = new Float                             // newtype: a distinct type; build `Meters(2.5)`, read `m.value`",
      "type Percent = new Int                              // its `requires` lines are the invariant, checked by `Percent(x)`",
      "  requires value >= 0 and value <= 100              // (no `Percent \{ value: 5 \}` / `with` on newtypes: E0217)",
      "const MAX_USERS: Int = 100                          // constant: UPPER_SNAKE_CASE, typed, pure",
      "/// Doc comment. Lines starting with >>> are doc-tests run by `klar test`:",
      "/// >>> assert double(2) == 4",
      "fn double(x: Int) -> Int \{ return x * 2 \}",
      "property \"reverse twice\" (xs: List[Int]) \{          // runs 100 random inputs, shrinks failures",
      "  assert xs.reverse().reverse() == xs",
      "\}",
      "```",
      "No top-level variables (use `const`). No nested named functions (use lambdas). Imports are explicit (no `*`);",
      "type names are unique across the program.",
      "Entry point: `fn main() uses io \{ ... \}` or `fn main() -> Result[Unit, E] uses io`.",
      "",
      "## Statements",
      "```klar",
      "let x = 5                 // immutable; shadowing ANY existing name is an error",
      "var n: Int = 0            // reassignable",
      "n = n + 1",
      "let _ = may_fail()        // explicitly discard a value",
      "if a > b \{ ... \} else if a == b \{ ... \} else \{ ... \}      // statement, not expression",
      "while cond \{ ... \}        // break / continue allowed",
      "for item in list \{ ... \}  // only List; use range(0, n), m.keys(), s.chars()",
      "return value              // REQUIRED: no implicit return of the last expression",
      "assert x > 0, \"message\"",
      "```",
      "",
      "## Expressions",
      "- Literals: `1`, `1_000`, `0xFF`, `0b101`, `2.5`, `1e-9`, `true`, `\"s\"` (escapes `\\n \\t \\r \\0 \\\\ \\\" \\\{ \\\}`), `()` (Unit),",
      "  `[1, 2]`, `Map \{ \"a\": 1 \}` (or `\{\"a\": 1\}`), `Map \{\}`. A `\{` before `\"`, `\\` or `\}` in a string is a literal brace:",
      "  `\"\{\"`, `\"\{\}\"`, `\"\{\\\"a\\\": \{n\}\}\"`; `\{name\}` interpolates.",
      "- Arithmetic `+ - * / %` only on same types: Int with Int, Float with Float (`/` on Int truncates towards zero and",
      "  `%` has the sign of the left side; Python's `//` and `%` are `floor_div`/`floor_mod` in std.math). `+` joins Str.",
      "- IEEE-754 bits of a Float: `x.to_bits()` (signed 64-bit Int), back with `float_from_bits(n)`.",
      "  No implicit conversions: `n.to_float()`, `f.round()`, `x.to_str()`.",
      "- No bit operators: `a.bit_and(b)`, `bit_or`, `bit_xor`, `a.bit_not()`, `a.shift_left(n)`, `a.shift_right(n)`",
      "  (two's complement on arbitrary-precision Int, shift_right floors). Characters: `s.codes()` → `List[Int]`,",
      "  `n.to_char()` → `Option[Str]`.",
      "- Bytes: `bytes_of([1, 2])`, `s.to_bytes()`, `b.push(255)`, `b.push_le(value, 4)` (little-endian, size 1/2/4/8),",
      "  `b.get(i)`, `b.slice(a, z)`, `b.decode()` → `Result[Str, Str]`, `b.hex()`; files: `read_bytes`/`write_bytes` (fs).",
      "- Comparison `== != < > <= >=` (no chaining). `==` is structural; values that contain functions cannot be compared (E0211).",
      "- Records: `Point \{ x: 1, y: 2 \}`, field `p.x`, copy-with-changes `p with \{ x: 3 \}`. Fields are never assigned.",
      "- Enum values: `Shape.Circle(radius: 1.0)`, `Shape.Empty` — always qualified.",
      "- Option: `Some(v)`, `None`. Result: `Ok(v)`, `Err(e)`. No null, no exceptions.",
      "- `expr?` unwraps Some/Ok, otherwise returns None/Err from the current function (same error type).",
      "- Lambdas: `fn(x) => x * 2`, `fn(x: Int) -> Int \{ return x * 2 \}` (a block may follow `=>` too). Param types may be",
      "  inferred. Lambdas may capture `let` values but not a `var` (E0216): snapshot it (`let n_now = n`) or use `fold`.",
      "- Calls: `f(a, b)`. With 3+ parameters, name the arguments (`f(a: 1, b: 2, c: 3)`) unless they cannot be swapped:",
      "  parameters of different types, or same-typed arguments named like their parameters (`cell(grid, r, c)`,",
      "  `cell(grid, nr, c - 1)`); `cell(grid, 0, 1)` and `cell(grid, i, j)` must be named (E0208).",
      "- Method syntax works for any function on its first parameter: `acc.deposit(10)` == `deposit(acc, 10)`.",
      "- `match` is an expression and must be exhaustive:",
      "```klar",
      "let label = match shape \{",
      "  Shape.Circle(r) => \"circle \{r\}\",",
      "  Shape.Square(_) => \"square\",",
      "  Shape.Empty => \"empty\",",
      "\}",
      "match result \{",
      "  Ok(v) => print(v),",
      "  Err(e) => \{ return Err(e) \},      // block arm; type Unit unless it returns",
      "\}",
      "let sign = match n > 0 \{ true => 1, false => -1 \}      // instead of ternary / if-expression",
      "```",
      "Patterns: `_`, `name`, literals (`1`, `\"a\"`, `true`), `Some(p)`, `None`, `Ok(p)`, `Err(p)`, `Enum.Variant(p1, p2)`.",
      "Guards: `x if x > 0 => ...` (guarded arms never count for exhaustiveness).",
      "Negative literal receivers need parentheses: `(-5).abs()`.",
      "",
      "## Immutability (most common mistake)",
      "All values are immutable. Methods return NEW values:",
      "```klar",
      "var xs: List[Int] = []",
      "xs = xs.push(1)            // correct",
      "xs.push(1)                 // ERROR E0405: result discarded, xs unchanged",
      "var m: Map[Str, Int] = Map \{\}",
      "m = m.set(\"k\", 1)",
      "```",
      "No indexing `xs[i]`: use `xs.get(i)` → `Option[T]` or `xs.get_or(i, default)`. No `unwrap`: use `?`, `match`, `.unwrap_or(d)`.",
      "",
      "## Traits (shared methods of different types)",
      "```klar",
      "trait Shape \{",
      "  fn area(self) -> Float                 // required: every impl defines it",
      "  fn label(self) -> Str \{                // default: an impl may override it",
      "    return \"area \{self.area()\}\"",
      "  \}",
      "\}",
      "impl Shape for Circle \{                  // for Int/Float/Bool/Str/Bytes or your own type/enum",
      "  fn area(self) -> Float \{",
      "    return 3.14 * self.r * self.r",
      "  \}",
      "\}",
      "fn total[T: Shape](xs: List[T]) -> Float \{     // bound; several: [T: Shape + Show]",
      "  return xs.map(fn(s) => s.area()).sum_float()",
      "\}",
      "```",
      "Methods take `self` first; `Self` is the implementing type. Call them with a dot: `c.area()` (never `area(c)`).",
      "An impl lives in the trait's or the type's module; import the trait to use its methods. A trait is not a type:",
      "for a list of different kinds use an `enum` and `impl Shape for ThatEnum` (one `match` per method).",
      "Generic types get generic impls that cover every instance: `impl[T: Show] Show for List[T]`, `impl[T] Show for Box[T]`,",
      "`impl[K, V] Show for Map[K, V]` (the target's arguments are exactly the impl's parameters; no `impl Show for List[Int]`).",
      "`klar fix` adds `todo(...)` stubs for missing impl methods.",
      "",
      "## Types",
      "`Int` (arbitrary precision), `Float`, `Bool`, `Str`, `Bytes`, `Unit`, `Never`, `List[T]`, `Map[K, V]` (K: any value without",
      "functions, insertion-ordered), `Option[T]`, `Result[T, E]`, `fn(A, B) -> R`, user `type`/`enum`. Annotate empty",
      "collections: `let xs: List[Int] = []`.",
      "",
      "## Effects",
      "A function without `uses` is pure. Calling something with an effect requires declaring it:",
      "`print`/`eprint` (stderr)/`read_line`/`read_exact(n)`/`cli_args`/`dbg` → `io`, `now_ms` (wall clock, ms since 1970 UTC)/`now_ns` (monotonic, for measuring) → `time`, `random_int` → `rand`,",
      "`read_file`/`write_file`/`file_exists`/`list_dir` (sorted names)/`is_dir`/`make_dir`/`remove_file`/`current_dir` → `fs` (they return `Result`, never crash), `env_var(name)` → `Option[Str]` and",
      "`exit(code)` (type `Never`, flushes output) → `io`; `run_command([\"prog\", \"arg\"])` → `Result[Int, Str]` (exit code;",
      "inherits stdin/stdout/stderr, searches `PATH`) → `proc`; `run_capture(args, dir, input)` → `Result[List[Str], Str]`",
      "(`[exit code, stdout, stderr]`) → `proc`; `set_executable(path)` → `fs`. Contracts and constants must be",
      "pure. Tests may use `io` and declare fakes: `test \"save\" uses fs, time, rand \{ ... \}` (also `property \"p\"",
      "(x: Int) uses fs \{ ... \}`) runs on an empty in-memory file system rooted at `/`, a clock at 0 (`set_clock(ms)` moves",
      "it) and fixed random numbers, fresh for every test; `proc`/`net` are not allowed in tests.",
      "Function types carry effects: `fn(Int) -> Unit uses io` may print when called; `fn(Int) -> Int` is pure, so",
      "passing a function with `uses` there is E0202 (add `uses` to the parameter type). Calling a function value needs",
      "its effects. A lambda may use the effects of the function type it is passed as, else those of the enclosing",
      "function. `map`/`filter`/`fold`/... need the effects of the function given to them. Returning an effectful",
      "function: `fn make() -> (fn(Str) -> Unit uses io)`.",
      "Parallel: `xs.par_map(f)` = `xs.map(f)` computed on all CPU cores. `f` must be a lambda without effects or a",
      "function value whose type has no `uses` (E0401/E0406); results must not contain functions. Do the",
      "effects (print, files) afterwards with the returned list.",
      "",
      "## Debugging helpers",
      "`dbg(expr)` prints `[dbg file:line] expr = value` to stderr and returns the value. `todo(\"what\")` has type `Never`:",
      "it type-checks anywhere, warns (W0404) and fails at runtime (R0012) — use it to sketch code first.",
      "",
      "## Compile-time safety (like Rust: rejected before the program runs)",
      "- Int `a / b` and `a % b` compile only if `b` is provably non-zero (E0701): a non-zero literal/constant,",
      "  `if b != 0 \{ ... \}`, early `if b == 0 \{ return ... \}`, `match b \{ 0 => ..., _ => a / b \}`, `requires b != 0`,",
      "  `assert b != 0`, `if xs.is_empty() \{ return ... \}` before dividing by `xs.len()`, `ensures result > 0` on the",
      "  function that produced `b`, or a `var` that starts positive and only grows (`var d = 3 ... d = d + 2`).",
      "- A function that calls itself on every path is an error (E0702) — write the base case first.",
      "- Calls with constant arguments are checked against `requires` (E0703) and built-in domains (E0704); simple contracts",
      "  (`n > 0`, `x != 0.0`, `not xs.is_empty()`) also against the signs the conditions prove (`if n <= 0 \{ f(n) \}` → E0703),",
      "  and `return`s against simple `ensures` (`ensures result >= 0` + `return -1` → E0706).",
      "- `klar test` also runs every pure, non-generic function with `ensures` on random inputs that satisfy its `requires`",
      "  (shown as `contract: name`, with a minimal counterexample): write `ensures` and the contract is tested.",
      "- `sort`/`min`/`max` need Int/Float/Str elements (E0215); for records use `sort_by(fn(p) => p.field)`.",
      "- No null, no exceptions, no indexing, no overflow, no shared mutation — those failures cannot be written.",
      "",
      "## Ignored values",
      "A discarded `Result` is an error (E0402). Other discarded non-Unit values warn (W0401). Use `let _ = ...`.",
      "",
    ],
    "prelude.klar" => [
      "// Klar prelude: written in Klar itself and visible in every module.",
      "",
      "/// Two values. Returned by `List.zip` and `List.partition`.",
      "type Pair[A, B] \{",
      "  first: A",
      "  second: B",
      "\}",
      "",
      "/// A key and its value. Returned by `Map.entries`.",
      "type Entry[K, V] \{",
      "  key: K",
      "  value: V",
      "\}",
      "",
      "/// An element together with its position. Returned by `List.enumerate`.",
      "type Indexed[T] \{",
      "  index: Int",
      "  value: T",
      "\}",
      "",
      "/// The ratio of a circle's circumference to its diameter.",
      "const PI: Float = 3.141592653589793",
      "",
      "/// Euler's number.",
      "const E: Float = 2.718281828459045",
      "",
    ],
    "rt/bytes.klar" => [
      "// Klar runtime: Bytes = [rc][td][len][cap][data] ; data = block of cap bytes.",
      "// Values are immutable; `*_owned` functions consume their first argument and write in place when it is",
      "// uniquely referenced (rc == 1), so `b = b.push(x)` in a loop appends in amortized O(1).",
      "",
      "fn bytes_with_cap(cap: Word) -> Word \{",
      "  let o = obj_new(40, static_addr(\"td_Bytes\"))",
      "  var c = cap",
      "  if c < 16 \{",
      "    c = 16",
      "  \}",
      "  poke(o + 16, 0)",
      "  poke(o + 24, c)",
      "  poke(o + 32, alloc(c))",
      "  return o",
      "\}",
      "",
      "fn bytes_from(p: Word, n: Word) -> Word \{",
      "  let o = bytes_with_cap(n)",
      "  copy_bytes(peek(o + 32), p, n)",
      "  poke(o + 16, n)",
      "  return o",
      "\}",
      "",
      "fn bytes_grow(o: Word, need: Word) \{",
      "  let cap = peek(o + 24)",
      "  if need <= cap \{",
      "    return",
      "  \}",
      "  var nc = cap * 2",
      "  while nc < need \{",
      "    nc = nc * 2",
      "  \}",
      "  let nd = alloc(nc)",
      "  copy_bytes(nd, peek(o + 32), peek(o + 16))",
      "  block_free(peek(o + 32))",
      "  poke(o + 32, nd)",
      "  poke(o + 24, nc)",
      "\}",
      "",
      "// an owned Bytes that may be written: the object itself when unique, else a copy (the original released)",
      "fn bytes_unique(o: Word, extra: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  if peek(o) == 1 \{",
      "    bytes_grow(o, n + extra)",
      "    return o",
      "  \}",
      "  let c = bytes_with_cap(n + extra)",
      "  copy_bytes(peek(c + 32), peek(o + 32), n)",
      "  poke(c + 16, n)",
      "  rc_dec(o)",
      "  return c",
      "\}",
      "",
      "fn byte_or_fail(v: Int, what: Str, sp: Word) -> Word \{",
      "  if is_small(v) \{",
      "    let k = untag(v)",
      "    if k >= 0 and k <= 255 \{",
      "      return k",
      "    \}",
      "  \}",
      "  let b = sb_new()",
      "  sb_add_str(b, bits(what))",
      "  sb_add_cstr(b, \": \")",
      "  int_show(b, bits(v))",
      "  sb_add_cstr(b, \" is not a byte (0..255)\")",
      "  return fail_simple(\"R0009\", sb_finish(b), sp)",
      "\}",
      "",
      "fn b_bytes_of(xs: Word, sp: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let o = bytes_with_cap(n)",
      "  let d = peek(o + 32)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke8(d + i, byte_or_fail(unbits(list_at(xs, i)), \"bytes_of\", sp))",
      "    i = i + 1",
      "  \}",
      "  poke(o + 16, n)",
      "  return o",
      "\}",
      "",
      "fn Str_to_bytes(s: Word) -> Word \{",
      "  return bytes_from(s + 32, peek(s + 16))",
      "\}",
      "",
      "fn Bytes_len(o: Word) -> Int \{",
      "  return tag(peek(o + 16))",
      "\}",
      "",
      "fn Bytes_is_empty(o: Word) -> Bool \{",
      "  return peek(o + 16) == 0",
      "\}",
      "",
      "fn Bytes_get(o: Word, i: Int, rtd: Word) -> Word \{",
      "  if is_small(i) \{",
      "    let k = untag(i)",
      "    if k >= 0 and k < peek(o + 16) \{",
      "      return some_new(rtd, w_or(w_shl(peek8(peek(o + 32) + k), 1), 1))",
      "    \}",
      "  \}",
      "  return none()",
      "\}",
      "",
      "fn Bytes_get_or(o: Word, i: Int, d: Int) -> Int \{",
      "  if is_small(i) \{",
      "    let k = untag(i)",
      "    if k >= 0 and k < peek(o + 16) \{",
      "      return tag(peek8(peek(o + 32) + k))",
      "    \}",
      "  \}",
      "  return d",
      "\}",
      "",
      "fn bytes_clamp(i: Int, n: Word) -> Word \{",
      "  let k = clamp_index(i)",
      "  if k > n \{",
      "    return n",
      "  \}",
      "  return k",
      "\}",
      "",
      "fn Bytes_slice(o: Word, start: Int, end: Int) -> Word \{",
      "  let n = peek(o + 16)",
      "  let a = bytes_clamp(start, n)",
      "  let b = bytes_clamp(end, n)",
      "  if b <= a \{",
      "    return bytes_with_cap(0)",
      "  \}",
      "  return bytes_from(peek(o + 32) + a, b - a)",
      "\}",
      "",
      "fn Bytes_concat(o: Word, other: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  let m = peek(other + 16)",
      "  let r = bytes_with_cap(n + m)",
      "  copy_bytes(peek(r + 32), peek(o + 32), n)",
      "  copy_bytes(peek(r + 32) + n, peek(other + 32), m)",
      "  poke(r + 16, n + m)",
      "  return r",
      "\}",
      "",
      "// consumes both (see List_concat_owned)",
      "fn Bytes_concat_owned(o: Word, other: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  let m = peek(other + 16)",
      "  let u = bytes_unique(o, m)",
      "  copy_bytes(peek(u + 32) + n, peek(other + 32), m)",
      "  poke(u + 16, n + m)",
      "  rc_dec(other)",
      "  return u",
      "\}",
      "",
      "fn bytes_push_raw(o: Word, k: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  if peek(o) == 1 and n < peek(o + 24) \{",
      "    poke8(peek(o + 32) + n, k)",
      "    poke(o + 16, n + 1)",
      "    return o",
      "  \}",
      "  let u = bytes_unique(o, 1)",
      "  poke8(peek(u + 32) + n, k)",
      "  poke(u + 16, n + 1)",
      "  return u",
      "\}",
      "",
      "fn Bytes_push(o: Word, v: Int, sp: Word) -> Word \{",
      "  let k = byte_or_fail(v, \"Bytes.push\", sp)",
      "  rc_inc(o)",
      "  return bytes_push_raw(o, k)",
      "\}",
      "",
      "fn Bytes_push_owned(o: Word, v: Int, sp: Word) -> Word \{",
      "  let k = byte_or_fail(v, \"Bytes.push\", sp)",
      "  return bytes_push_raw(o, k)",
      "\}",
      "",
      "fn le_fail(v: Int, size: Int, sp: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"Bytes.push_le: \")",
      "  int_show(b, bits(v))",
      "  sb_add_cstr(b, \" does not fit in \")",
      "  int_show(b, bits(size))",
      "  sb_add_cstr(b, \" byte(s)\")",
      "  return fail_simple(\"R0009\", sb_finish(b), sp)",
      "\}",
      "",
      "fn bytes_push_le_raw(o: Word, v: Int, size: Int, sp: Word) -> Word \{",
      "  if size != 1 and size != 2 and size != 4 and size != 8 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"Bytes.push_le: size must be 1, 2, 4 or 8, got \")",
      "    int_show(b, bits(size))",
      "    return fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  let hi = pow2(size * 8)",
      "  let lo = 0 - pow2(size * 8 - 1)",
      "  if v < lo or v >= hi \{",
      "    return le_fail(v, size, sp)",
      "  \}",
      "  var x = v",
      "  if x < 0 \{",
      "    x = x + hi            // two's complement",
      "  \}",
      "  let n = untag(size)",
      "  let u = bytes_unique(o, n)",
      "  let len = peek(u + 16)",
      "  let d = peek(u + 32) + len",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke8(d + i, untag(x % 256))",
      "    x = x / 256",
      "    i = i + 1",
      "  \}",
      "  poke(u + 16, len + n)",
      "  return u",
      "\}",
      "",
      "fn Bytes_push_le(o: Word, v: Int, size: Int, sp: Word) -> Word \{",
      "  rc_inc(o)",
      "  return bytes_push_le_raw(o, v, size, sp)",
      "\}",
      "",
      "fn Bytes_push_le_owned(o: Word, v: Int, size: Int, sp: Word) -> Word \{",
      "  return bytes_push_le_raw(o, v, size, sp)",
      "\}",
      "",
      "fn bytes_set_raw(o: Word, i: Int, v: Int, sp: Word) -> Word \{",
      "  let k = index_or_fail(i, peek(o + 16), \"Bytes.set\", sp, false)",
      "  let b = byte_or_fail(v, \"Bytes.set\", sp)",
      "  let u = bytes_unique(o, 0)",
      "  poke8(peek(u + 32) + k, b)",
      "  return u",
      "\}",
      "",
      "fn Bytes_set(o: Word, i: Int, v: Int, sp: Word) -> Word \{",
      "  rc_inc(o)",
      "  return bytes_set_raw(o, i, v, sp)",
      "\}",
      "",
      "fn Bytes_set_owned(o: Word, i: Int, v: Int, sp: Word) -> Word \{",
      "  return bytes_set_raw(o, i, v, sp)",
      "\}",
      "",
      "fn Bytes_to_list(o: Word, rtd: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  let out = list_with_cap(rtd, n)",
      "  let d = peek(o + 32)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(peek(out + 32) + i * 8, w_or(w_shl(peek8(d + i), 1), 1))",
      "    i = i + 1",
      "  \}",
      "  poke(out + 16, n)",
      "  return out",
      "\}",
      "",
      "// index of the first byte that breaks UTF-8, or -1",
      "fn utf8_error_at(p: Word, n: Word) -> Word \{",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = peek8(p + i)",
      "    var need: Word = 0",
      "    if c < 128 \{",
      "      need = 0",
      "    \} else if c >= 194 and c <= 223 \{",
      "      need = 1",
      "    \} else if c >= 224 and c <= 239 \{",
      "      need = 2",
      "    \} else if c >= 240 and c <= 244 \{",
      "      need = 3",
      "    \} else \{",
      "      return i",
      "    \}",
      "    var k: Word = 1",
      "    while k <= need \{",
      "      if i + k >= n \{",
      "        return i",
      "      \}",
      "      let cc = peek8(p + i + k)",
      "      if cc < 128 or cc > 191 \{",
      "        return i",
      "      \}",
      "      k = k + 1",
      "    \}",
      "    if need == 2 \{",
      "      let c1 = peek8(p + i + 1)",
      "      if (c == 224 and c1 < 160) or (c == 237 and c1 > 159) \{",
      "        return i",
      "      \}",
      "    \}",
      "    if need == 3 \{",
      "      let c1 = peek8(p + i + 1)",
      "      if (c == 240 and c1 < 144) or (c == 244 and c1 > 143) \{",
      "        return i",
      "      \}",
      "    \}",
      "    i = i + need + 1",
      "  \}",
      "  return -1",
      "\}",
      "",
      "fn Bytes_decode(o: Word, rtd: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  let p = peek(o + 32)",
      "  let bad = utf8_error_at(p, n)",
      "  if bad >= 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"not valid UTF-8 at byte \")",
      "    sb_add_word(b, bad)",
      "    return err_new(rtd, sb_finish(b))",
      "  \}",
      "  return ok_new(rtd, str_from(p, n))",
      "\}",
      "",
      "fn Bytes_hex(o: Word) -> Word \{",
      "  let n = peek(o + 16)",
      "  let d = peek(o + 32)",
      "  let b = sb_new()",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = peek8(d + i)",
      "    sb_add_byte(b, hex_char(w_shr(c, 4)))",
      "    sb_add_byte(b, hex_char(w_and(c, 15)))",
      "    i = i + 1",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn hex_char(v: Word) -> Word \{",
      "  if v < 10 \{",
      "    return 48 + v",
      "  \}",
      "  return 87 + v",
      "\}",
      "",
      "fn bytes_show(b: Word, o: Word) \{",
      "  sb_add_cstr(b, \"bytes_of([\")",
      "  let n = peek(o + 16)",
      "  let d = peek(o + 32)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    if i > 0 \{",
      "      sb_add_cstr(b, \", \")",
      "    \}",
      "    sb_add_word(b, peek8(d + i))",
      "    i = i + 1",
      "  \}",
      "  sb_add_cstr(b, \"])\")",
      "\}",
      "",
      "fn bytes_equal(a: Word, b: Word) -> Bool \{",
      "  let n = peek(a + 16)",
      "  if n != peek(b + 16) \{",
      "    return false",
      "  \}",
      "  return bytes_eq(peek(a + 32), peek(b + 32), n)",
      "\}",
      "",
      "fn real_read_bytes(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"read_bytes\", path, sp)",
      "  if fake_on() \{",
      "    return fake_read_bytes(path, rtd)",
      "  \}",
      "  let fd = os_open(path + 32, 0)",
      "  if fd < 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"cannot read '\")",
      "    sb_add_str(b, path)",
      "    sb_add_cstr(b, \"': \")",
      "    io_error_text(b, fd)",
      "    return err_new(rtd, sb_finish(b))",
      "  \}",
      "  let out = bytes_with_cap(65536)",
      "  var reading = true",
      "  while reading \{",
      "    let len = peek(out + 16)",
      "    bytes_grow(out, len + 65536)",
      "    let n = os_read(fd, peek(out + 32) + len, 65536)",
      "    if n <= 0 \{",
      "      reading = false",
      "    \} else \{",
      "      poke(out + 16, len + n)",
      "    \}",
      "  \}",
      "  os_close(fd)",
      "  return ok_new(rtd, out)",
      "\}",
      "",
      "fn real_write_bytes(path: Word, data: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"write_bytes\", path, sp)",
      "  if fake_on() \{",
      "    return fake_write_bytes(path, data, rtd)",
      "  \}",
      "  let fd = os_open(path + 32, 1)",
      "  if fd < 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"cannot write '\")",
      "    sb_add_str(b, path)",
      "    sb_add_cstr(b, \"': \")",
      "    io_error_text(b, fd)",
      "    return err_new(rtd, sb_finish(b))",
      "  \}",
      "  var done: Word = 0",
      "  let n = peek(data + 16)",
      "  let p = peek(data + 32)",
      "  while done < n \{",
      "    let w = os_write(fd, p + done, n - done)",
      "    if w <= 0 \{",
      "      done = n",
      "    \} else \{",
      "      done = done + w",
      "    \}",
      "  \}",
      "  os_close(fd)",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
    ],
    "rt/core.klar" => [
      "// Klar runtime: core (system Klar). Compiled into every native executable.",
      "// Values are 64-bit words. Heap objects: [rc][type descriptor][payload...]; rc < 0 = immortal.",
      "// Type descriptor: [kind][name][a][b][c][d] (see klar/native/lower.py).",
      "",
      "const K_UNIT: Word = 0",
      "const K_BOOL: Word = 1",
      "const K_INT: Word = 2",
      "const K_FLOAT: Word = 3",
      "const K_WORD: Word = 4",
      "const K_STR: Word = 10",
      "const K_LIST: Word = 11",
      "const K_MAP: Word = 12",
      "const K_RECORD: Word = 13",
      "const K_ENUM: Word = 14",
      "const K_FN: Word = 15",
      "const K_BIG: Word = 16",
      "const K_BUF: Word = 17",
      "const K_BYTES: Word = 18",
      "",
      "// global area (g_rt) offsets",
      "const G_HEAP: Word = 0",
      "const G_HEAP_END: Word = 8",
      "const G_SMALL: Word = 16",
      "const G_LARGE: Word = 536",
      "const G_OUTLEN: Word = 920",
      "const G_INPOS: Word = 928",
      "const G_INLEN: Word = 936",
      "const G_INEOF: Word = 944",
      "const G_RAND: Word = 952",
      "const G_DIVQ: Word = 960",
      "const G_DIVR: Word = 968",
      "const G_DECPT: Word = 976",
      "const G_CHUNK: Word = 984",
      "const G_WORKER: Word = 992",
      "const G_ERRFD: Word = 1000",
      "const G_WFD: Word = 1008",
      "const G_PROP: Word = 1016",
      "const G_PROF: Word = 1024",
      "const G_PROPJB: Word = 1032",
      "const G_NEST: Word = 1040",
      "",
      "const OUT_CAP: Word = 65536",
      "",
      "fn g() -> Word \{",
      "  return static_addr(\"g_rt\")",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// memory",
      "// ---------------------------------------------------------------------------",
      "fn fatal(msg: Word) -> Word \{",
      "  worker_failing()",
      "  flush_out()",
      "  err_str(msg)",
      "  err_byte(10)",
      "  os_exit(2)",
      "  return 0",
      "\}",
      "",
      "fn bump(bytes: Word, cls: Word) -> Word \{",
      "  let gp = g()",
      "  var p = peek(gp + G_HEAP)",
      "  if p == 0 or p + bytes > peek(gp + G_HEAP_END) \{",
      "    // heap chunks start at 1 MB and double up to 64 MB",
      "    var size = peek(gp + G_CHUNK)",
      "    if size == 0 \{",
      "      size = 1048576",
      "    \}",
      "    if size < 67108864 \{",
      "      poke(gp + G_CHUNK, size * 2)",
      "    \}",
      "    if bytes + 64 > size \{",
      "      size = bytes + 64",
      "    \}",
      "    p = os_alloc(size)",
      "    if p == 0 or (p < 0 and p > -4096) \{",
      "      fatal(bits(\"out of memory\"))",
      "    \}",
      "    poke(gp + G_HEAP_END, p + size)",
      "  \}",
      "  poke(gp + G_HEAP, p + bytes)",
      "  poke(p, cls)",
      "  return p + 8",
      "\}",
      "",
      "// the most memory one object may ask for (64 TB): larger sizes, and sizes that overflowed, are R0015",
      "const MAX_ALLOC: Word = 70368744177664",
      "",
      "fn out_of_memory() -> Word \{",
      "  return fail_msg(\"R0015\", \"out of memory: the program asked for more memory than a computer has\", current_span())",
      "\}",
      "",
      "// count * elem bytes (elem > 0), or R0015 when that is more than MAX_ALLOC (or the product overflows)",
      "fn mem_size(count: Word, elem: Word) -> Word \{",
      "  if count < 0 or count > w_udiv(MAX_ALLOC, elem) \{",
      "    out_of_memory()",
      "  \}",
      "  return count * elem",
      "\}",
      "",
      "fn alloc(size: Word) -> Word \{",
      "  if w_ult(MAX_ALLOC, size) \{",
      "    out_of_memory()",
      "  \}",
      "  let need = size + 8",
      "  let gp = g()",
      "  if need <= 1024 \{",
      "    let cls = (need + 15) / 16",
      "    let head = gp + G_SMALL + cls * 8",
      "    let p = peek(head)",
      "    if p != 0 \{",
      "      poke(head, peek(p))",
      "      return p",
      "    \}",
      "    return bump(cls * 16, cls)",
      "  \}",
      "  var big_cls: Word = 11",
      "  while w_shl(1, big_cls) < need \{",
      "    big_cls = big_cls + 1",
      "  \}",
      "  let lhead = gp + G_LARGE + (big_cls - 11) * 8",
      "  let lp = peek(lhead)",
      "  if lp != 0 \{",
      "    poke(lhead, peek(lp))",
      "    return lp",
      "  \}",
      "  return bump(w_shl(1, big_cls), big_cls + 1000)",
      "\}",
      "",
      "fn block_free(p: Word) \{",
      "  let cls = peek(p - 8)",
      "  let gp = g()",
      "  var head: Word = 0",
      "  if cls < 1000 \{",
      "    head = gp + G_SMALL + cls * 8",
      "  \} else \{",
      "    head = gp + G_LARGE + (cls - 1011) * 8",
      "  \}",
      "  poke(p, peek(head))",
      "  poke(head, p)",
      "\}",
      "",
      "fn block_size(p: Word) -> Word \{",
      "  let cls = peek(p - 8)",
      "  if cls < 1000 \{",
      "    return cls * 16 - 8",
      "  \}",
      "  return w_shl(1, cls - 1000) - 8",
      "\}",
      "",
      "fn copy_words(dst: Word, src: Word, n: Word) \{",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(dst + i * 8, peek(src + i * 8))",
      "    i = i + 1",
      "  \}",
      "\}",
      "",
      "// non-overlapping copy; short tails use overlapping word / dword moves",
      "fn copy_bytes(dst: Word, src: Word, n: Word) \{",
      "  if n >= 8 \{",
      "    var i: Word = 0",
      "    while i + 8 < n \{",
      "      poke(dst + i, peek(src + i))",
      "      i = i + 8",
      "    \}",
      "    poke(dst + n - 8, peek(src + n - 8))",
      "    return",
      "  \}",
      "  if n >= 4 \{",
      "    poke32(dst, peek32(src))",
      "    poke32(dst + n - 4, peek32(src + n - 4))",
      "    return",
      "  \}",
      "  var j: Word = 0",
      "  while j < n \{",
      "    poke8(dst + j, peek8(src + j))",
      "    j = j + 1",
      "  \}",
      "\}",
      "",
      "fn bytes_eq(a: Word, b: Word, n: Word) -> Bool \{",
      "  var i: Word = 0",
      "  while i + 8 <= n \{",
      "    if peek(a + i) != peek(b + i) \{",
      "      return false",
      "    \}",
      "    i = i + 8",
      "  \}",
      "  while i < n \{",
      "    if peek8(a + i) != peek8(b + i) \{",
      "      return false",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return true",
      "\}",
      "",
      "fn obj_new(size: Word, td: Word) -> Word \{",
      "  let o = alloc(size)",
      "  poke(o, 1)",
      "  poke(o + 8, td)",
      "  return o",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// reference counting (the compiler inlines the fast paths)",
      "// ---------------------------------------------------------------------------",
      "fn rc_inc(o: Word) \{",
      "  let r = peek(o)",
      "  if r >= 0 \{",
      "    poke(o, r + 1)",
      "  \}",
      "\}",
      "",
      "fn rc_dec(o: Word) \{",
      "  let r = peek(o)",
      "  if r > 1 \{",
      "    poke(o, r - 1)",
      "  \} else if r == 1 \{",
      "    poke(o, 0)",
      "    free(o)",
      "  \}",
      "\}",
      "",
      "fn is_rc_kind(td: Word) -> Bool \{",
      "  let k = peek(td)",
      "  return k == K_INT or k >= K_STR",
      "\}",
      "",
      "fn retain_v(v: Word, td: Word) \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    if w_and(v, 1) == 0 \{",
      "      rc_inc(v)",
      "    \}",
      "  \} else if k >= K_STR \{",
      "    rc_inc(v)",
      "  \}",
      "\}",
      "",
      "fn release_v(v: Word, td: Word) \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    if w_and(v, 1) == 0 \{",
      "      rc_dec(v)",
      "    \}",
      "  \} else if k >= K_STR \{",
      "    rc_dec(v)",
      "  \}",
      "\}",
      "",
      "fn release_words(base: Word, n: Word, td: Word) \{",
      "  let k = peek(td)",
      "  if k < K_STR and k != K_INT \{",
      "    return",
      "  \}",
      "  let ints = k == K_INT",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let o = peek(base + i * 8)",
      "    if not ints or w_and(o, 1) == 0 \{",
      "      let r = peek(o)",
      "      if r > 1 \{",
      "        poke(o, r - 1)",
      "      \} else if r == 1 \{",
      "        poke(o, 0)",
      "        free(o)",
      "      \}",
      "    \}",
      "    i = i + 1",
      "  \}",
      "\}",
      "",
      "// Called when an object's count reaches zero: release children (by descriptor), then the block.",
      "fn free(o: Word) \{",
      "  let td = peek(o + 8)",
      "  let k = peek(td)",
      "  if k == K_STR or k == K_BIG \{",
      "    block_free(o)",
      "    return",
      "  \}",
      "  if k == K_BYTES \{",
      "    block_free(peek(o + 32))",
      "    block_free(o)",
      "    return",
      "  \}",
      "  if k == K_LIST \{",
      "    let data = peek(o + 32)",
      "    release_words(data, peek(o + 16), peek(td + 16))",
      "    if data != 0 \{",
      "      block_free(data)",
      "    \}",
      "  \} else if k == K_MAP \{",
      "    let n = peek(o + 16)",
      "    release_words(peek(o + 32), n, peek(td + 16))",
      "    release_words(peek(o + 40), n, peek(td + 24))",
      "    if peek(o + 32) != 0 \{",
      "      block_free(peek(o + 32))",
      "      block_free(peek(o + 40))",
      "      block_free(peek(o + 48))",
      "    \}",
      "  \} else if k == K_RECORD \{",
      "    let nf = peek(td + 16)",
      "    let fts = peek(td + 24)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      release_v(peek(o + 16 + i * 8), peek(fts + i * 8))",
      "      i = i + 1",
      "    \}",
      "  \} else if k == K_ENUM \{",
      "    let row = peek(td + 24) + peek(o + 16) * 32",
      "    let vn = peek(row + 8)",
      "    let vts = peek(row + 16)",
      "    var j: Word = 0",
      "    while j < vn \{",
      "      release_v(peek(o + 24 + j * 8), peek(vts + j * 8))",
      "      j = j + 1",
      "    \}",
      "  \} else if k == K_FN \{",
      "    let nc = peek(td + 16)",
      "    let cts = peek(td + 24)",
      "    var c: Word = 0",
      "    while c < nc \{",
      "      release_v(peek(o + 24 + c * 8), peek(cts + c * 8))",
      "      c = c + 1",
      "    \}",
      "  \} else if k == K_BUF \{",
      "    if peek(o + 32) != 0 \{",
      "      block_free(peek(o + 32) - 32)",
      "    \}",
      "  \}",
      "  block_free(o)",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// strings: [rc][td_Str][nbytes][nchars or -1][utf-8 bytes...][0]",
      "// ---------------------------------------------------------------------------",
      "fn str_new(nbytes: Word) -> Word \{",
      "  let s = obj_new(33 + nbytes, static_addr(\"td_Str\"))",
      "  poke(s + 16, nbytes)",
      "  poke(s + 24, -1)",
      "  poke8(s + 32 + nbytes, 0)",
      "  return s",
      "\}",
      "",
      "fn str_from(p: Word, n: Word) -> Word \{",
      "  let s = str_new(n)",
      "  copy_bytes(s + 32, p, n)",
      "  return s",
      "\}",
      "",
      "fn str_nchars(s: Word) -> Word \{",
      "  let c = peek(s + 24)",
      "  if c >= 0 \{",
      "    return c",
      "  \}",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  var count: Word = 0",
      "  while i < n \{",
      "    if i + 8 <= n and w_and(peek(s + 32 + i), -9187201950435737472) == 0 \{",
      "      count = count + 8                  // 8 ASCII bytes",
      "      i = i + 8",
      "    \} else \{",
      "      if w_and(peek8(s + 32 + i), 192) != 128 \{",
      "        count = count + 1",
      "      \}",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  poke(s + 24, count)",
      "  return count",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// string builder: [rc][td_Buf][len][cap][bytes]",
      "// `bytes` points 32 bytes into a block shaped like a Str ([rc][td][nbytes][nchars][bytes][0]),",
      "// so sb_finish turns the buffer into the result string without copying.",
      "// ---------------------------------------------------------------------------",
      "fn sb_new() -> Word \{",
      "  return sb_with_cap(55)",
      "\}",
      "",
      "fn sb_with_cap(cap: Word) -> Word \{",
      "  let b = obj_new(40, static_addr(\"td_Buf\"))",
      "  poke(b + 16, 0)",
      "  poke(b + 24, cap)",
      "  poke(b + 32, alloc(33 + cap) + 32)",
      "  return b",
      "\}",
      "",
      "fn sb_reserve(b: Word, extra: Word) \{",
      "  let len = peek(b + 16)",
      "  let cap = peek(b + 24)",
      "  if len + extra <= cap \{",
      "    return",
      "  \}",
      "  var ncap = cap * 2 + 33",
      "  while ncap < len + extra \{",
      "    ncap = ncap * 2",
      "  \}",
      "  let nd = alloc(33 + ncap) + 32",
      "  copy_bytes(nd, peek(b + 32), len)",
      "  block_free(peek(b + 32) - 32)",
      "  poke(b + 32, nd)",
      "  poke(b + 24, ncap)",
      "\}",
      "",
      "fn sb_add_bytes(b: Word, p: Word, n: Word) \{",
      "  let len = peek(b + 16)",
      "  if len + n > peek(b + 24) \{",
      "    sb_reserve(b, n)",
      "  \}",
      "  copy_bytes(peek(b + 32) + len, p, n)",
      "  poke(b + 16, len + n)",
      "\}",
      "",
      "fn sb_add_byte(b: Word, c: Word) \{",
      "  let len = peek(b + 16)",
      "  if len >= peek(b + 24) \{",
      "    sb_reserve(b, 1)",
      "  \}",
      "  poke8(peek(b + 32) + len, c)",
      "  poke(b + 16, len + 1)",
      "\}",
      "",
      "fn sb_add_str(b: Word, s: Word) \{",
      "  sb_add_bytes(b, s + 32, peek(s + 16))",
      "\}",
      "",
      "fn sb_add_cstr(b: Word, s: Str) \{",
      "  sb_add_str(b, bits(s))",
      "\}",
      "",
      "fn sb_add_word(b: Word, v: Word) \{",
      "  // decimal of a raw signed word",
      "  if v < 0 \{",
      "    sb_add_byte(b, 45)",
      "    if v == -9223372036854775807 - 1 \{",
      "      sb_add_cstr(b, \"9223372036854775808\")",
      "      return",
      "    \}",
      "    sb_add_uword(b, 0 - v)",
      "    return",
      "  \}",
      "  sb_add_uword(b, v)",
      "\}",
      "",
      "fn sb_add_uword(b: Word, v: Word) \{",
      "  // count the digits, then write them straight into the buffer from the right",
      "  var n: Word = 1",
      "  var p: Word = 10",
      "  while n < 20 and not w_ult(v, p) \{",
      "    n = n + 1",
      "    p = p * 10",
      "  \}",
      "  let len = peek(b + 16)",
      "  if len + n > peek(b + 24) \{",
      "    sb_reserve(b, n)",
      "  \}",
      "  let dst = peek(b + 32) + len",
      "  var x = v",
      "  var i = n - 1",
      "  while i >= 0 \{",
      "    let q = w_udiv(x, 10)",
      "    poke8(dst + i, 48 + x - q * 10)",
      "    x = q",
      "    i = i - 1",
      "  \}",
      "  poke(b + 16, len + n)",
      "\}",
      "",
      "fn sb_len(b: Word) -> Word \{",
      "  return peek(b + 16)",
      "\}",
      "",
      "fn sb_finish(b: Word) -> Word \{",
      "  let n = peek(b + 16)",
      "  let cap = peek(b + 24)",
      "  if cap - n >= 16 and (n < 1024 or n * 2 < cap) \{",
      "    // much smaller than the buffer: copy into an exact-size string (the buffer is reused hot)",
      "    let r = str_from(peek(b + 32), n)",
      "    rc_dec(b)",
      "    return r",
      "  \}",
      "  let s = peek(b + 32) - 32",
      "  poke(s, 1)",
      "  poke(s + 8, static_addr(\"td_Str\"))",
      "  poke(s + 16, n)",
      "  poke(s + 24, -1)",
      "  poke8(s + 32 + n, 0)",
      "  poke(b + 32, 0)",
      "  rc_dec(b)",
      "  return s",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// output (buffered stdout, unbuffered stderr)",
      "// ---------------------------------------------------------------------------",
      "fn flush_out() \{",
      "  let gp = g()",
      "  let buf = static_addr(\"g_outbuf\")",
      "  var n = peek(gp + G_OUTLEN)",
      "  if peek(gp + G_PROP) != 0 \{",
      "    // a property's own output is not shown (as in the interpreter)",
      "    n = 0",
      "  \}",
      "  tr_out(buf, n)",
      "  var done: Word = 0",
      "  while done < n \{",
      "    let w = os_write(1, buf + done, n - done)",
      "    if w <= 0 \{",
      "      done = n",
      "    \} else \{",
      "      done = done + w",
      "    \}",
      "  \}",
      "  poke(gp + G_OUTLEN, 0)",
      "\}",
      "",
      "fn out_bytes(p: Word, n: Word) \{",
      "  let gp = g()",
      "  if peek(gp + G_OUTLEN) + n > OUT_CAP \{",
      "    flush_out()",
      "  \}",
      "  if n > OUT_CAP \{",
      "    tr_out(p, n)",
      "    var done: Word = 0",
      "    while done < n \{",
      "      let w = os_write(1, p + done, n - done)",
      "      if w <= 0 \{",
      "        return",
      "      \}",
      "      done = done + w",
      "    \}",
      "    return",
      "  \}",
      "  let len = peek(gp + G_OUTLEN)",
      "  copy_bytes(static_addr(\"g_outbuf\") + len, p, n)",
      "  poke(gp + G_OUTLEN, len + n)",
      "\}",
      "",
      "fn out_byte(c: Word) \{",
      "  let gp = g()",
      "  if peek(gp + G_OUTLEN) + 1 > OUT_CAP \{",
      "    flush_out()",
      "  \}",
      "  let len = peek(gp + G_OUTLEN)",
      "  poke8(static_addr(\"g_outbuf\") + len, c)",
      "  poke(gp + G_OUTLEN, len + 1)",
      "\}",
      "",
      "fn err_bytes(p: Word, n: Word) \{",
      "  tr_err(p, n)",
      "  var fd = peek(g() + G_ERRFD)",
      "  if fd == 0 \{",
      "    fd = 2",
      "  \}",
      "  var done: Word = 0",
      "  while done < n \{",
      "    let w = os_write(fd, p + done, n - done)",
      "    if w <= 0 \{",
      "      return",
      "    \}",
      "    done = done + w",
      "  \}",
      "\}",
      "",
      "fn err_str(s: Word) \{",
      "  err_bytes(s + 32, peek(s + 16))",
      "\}",
      "",
      "fn err_byte(c: Word) \{",
      "  let tmp = static_addr(\"g_scratch\")",
      "  poke8(tmp, c)",
      "  err_bytes(tmp, 1)",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// errors: same text format as the Klar interpreter",
      "// span data: [file][line][col][end_line][end_col][source line]",
      "// ---------------------------------------------------------------------------",
      "fn span_short(b: Word, sp: Word) \{",
      "  sb_add_str(b, peek(sp))",
      "  sb_add_byte(b, 58)",
      "  sb_add_word(b, peek(sp + 8))",
      "  sb_add_byte(b, 58)",
      "  sb_add_word(b, peek(sp + 16))",
      "\}",
      "",
      "fn list_new_str() -> Word \{",
      "  return list_with_cap(static_addr(\"td_ListStr\"), 4)",
      "\}",
      "",
      "fn detail_add(lst: Word, name: Word, value: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_str(b, name)",
      "  sb_add_cstr(b, \" = \")",
      "  sb_add_str(b, value)",
      "  rc_dec(value)",
      "  return list_push_owned_raw(lst, sb_finish(b))",
      "\}",
      "",
      "fn fail_with(code: Word, msg: Word, sp: Word, details: Word, hint: Word) -> Word \{",
      "  if peek(g() + G_PROP) != 0 \{",
      "    prop_failure(code, msg, sp, details, hint)",
      "  \}",
      "  return report_error(code, msg, sp, details, hint, 0)",
      "\}",
      "",
      "// prints a runtime error and exits (`stack`: the call-stack note as text, or 0 for the current stack)",
      "fn report_error(code: Word, msg: Word, sp: Word, details: Word, hint: Word, stack: Word) -> Word \{",
      "  worker_failing()",
      "  flush_out()",
      "  let notes = sb_new()",
      "  if peek(g() + G_PROF) != 0 and stack == 0 \{",
      "    stack_note(notes)",
      "  \}",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"runtime error[\")",
      "  sb_add_str(b, code)",
      "  sb_add_cstr(b, \"]: \")",
      "  sb_add_str(b, msg)",
      "  sb_add_byte(b, 10)",
      "  if sp != 0 \{",
      "    sb_add_cstr(b, \"  --> \")",
      "    span_short(b, sp)",
      "    sb_add_byte(b, 10)",
      "    code_frame(b, sp)",
      "  \}",
      "  if details != 0 \{",
      "    let n = peek(details + 16)",
      "    if n > 0 \{",
      "      sb_add_cstr(b, \"  note: values: \")",
      "      var i: Word = 0",
      "      while i < n \{",
      "        if i > 0 \{",
      "          sb_add_cstr(b, \", \")",
      "        \}",
      "        sb_add_str(b, peek(peek(details + 32) + i * 8))",
      "        i = i + 1",
      "      \}",
      "      sb_add_byte(b, 10)",
      "    \}",
      "  \}",
      "  if stack != 0 \{",
      "    sb_add_str(b, stack)",
      "  \} else if peek(g() + G_PROF) != 0 \{",
      "    sb_add_bytes(b, peek(notes + 32), peek(notes + 16))",
      "  \} else \{",
      "    stack_note(b)",
      "  \}",
      "  if peek(hint + 16) > 0 \{",
      "    sb_add_cstr(b, \"  hint: \")",
      "    sb_add_str(b, hint)",
      "    sb_add_byte(b, 10)",
      "  \}",
      "  // the error is kept apart from what the program itself wrote to stderr (klar/trace.py)",
      "  tr_error_text(b)",
      "  poke(g() + G_TR_QUIET, 1)",
      "  err_bytes(peek(b + 32), peek(b + 16))",
      "  poke(g() + G_TR_QUIET, 0)",
      "  prof_finish()",
      "  tr_end(1)",
      "  os_exit(1)",
      "  return 0",
      "\}",
      "",
      "fn code_frame(b: Word, sp: Word) \{",
      "  let line = peek(sp + 8)",
      "  if line <= 0 \{",
      "    return",
      "  \}",
      "  let num = sb_new()",
      "  sb_add_word(num, line)",
      "  let w = sb_len(num)",
      "  let text = peek(sp + 40)",
      "  sb_add_cstr(b, \"  \")",
      "  pad_spaces(b, w)",
      "  sb_add_cstr(b, \" |\\n  \")",
      "  sb_add_bytes(b, peek(num + 32), w)",
      "  rc_dec(num)",
      "  sb_add_cstr(b, \" | \")",
      "  sb_add_str(b, text)",
      "  sb_add_cstr(b, \"\\n  \")",
      "  pad_spaces(b, w)",
      "  sb_add_cstr(b, \" | \")",
      "  let col = peek(sp + 16)",
      "  pad_spaces(b, col - 1)",
      "  var width: Word = 1",
      "  if peek(sp + 24) == line \{",
      "    width = peek(sp + 32) - col",
      "  \} else \{",
      "    width = str_nchars(text) - (col - 1)",
      "  \}",
      "  if width < 1 \{",
      "    width = 1",
      "  \}",
      "  var i: Word = 0",
      "  while i < width \{",
      "    sb_add_byte(b, 94)",
      "    i = i + 1",
      "  \}",
      "  sb_add_byte(b, 10)",
      "\}",
      "",
      "fn pad_spaces(b: Word, n: Word) \{",
      "  var i: Word = 0",
      "  while i < n \{",
      "    sb_add_byte(b, 32)",
      "    i = i + 1",
      "  \}",
      "\}",
      "",
      "// ---- call stack reconstruction ----------------------------------------------------------",
      "// Every function keeps a standard RBP frame: [rbp] = caller's rbp, [rbp + 8] = return address.",
      "// The compiler writes g_fn_table (address ranges + names of Klar functions) and g_site_table",
      "// (return address -> call-site span). Walking the chain rebuilds g_frames[1..depth] =",
      "// (function name, span of the call it is making), innermost last — the layout stack_note prints.",
      "",
      "// index of the Klar function containing code address pc, or -1",
      "fn fn_index(pc: Word) -> Word \{",
      "  let t = static_addr(\"g_fn_table\")",
      "  var lo: Word = 0",
      "  var hi = peek(t)",
      "  while lo < hi \{",
      "    let mid = (lo + hi) / 2",
      "    let row = t + 8 + mid * 24",
      "    if pc < peek(row) \{",
      "      hi = mid",
      "    \} else if pc >= peek(row + 8) \{",
      "      lo = mid + 1",
      "    \} else \{",
      "      return mid",
      "    \}",
      "  \}",
      "  return -1",
      "\}",
      "",
      "fn site_of(ret: Word) -> Word \{",
      "  let t = static_addr(\"g_site_table\")",
      "  var lo: Word = 0",
      "  var hi = peek(t)",
      "  while lo < hi \{",
      "    let mid = (lo + hi) / 2",
      "    let a = peek(t + 8 + mid * 16)",
      "    if ret < a \{",
      "      hi = mid",
      "    \} else if ret > a \{",
      "      lo = mid + 1",
      "    \} else \{",
      "      return peek(t + 16 + mid * 16)",
      "    \}",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn rebuild_frames() \{",
      "  let frames = static_addr(\"g_frames\")",
      "  var depth: Word = 0",
      "  var fp = frame_ptr()",
      "  while fp != 0 \{",
      "    if fn_index(peek(fp + 8)) >= 0 \{",
      "      depth = depth + 1",
      "    \}",
      "    let next = peek(fp)",
      "    if w_ult(fp, next) \{",
      "      fp = next",
      "    \} else \{",
      "      fp = 0",
      "    \}",
      "  \}",
      "  if depth > 10001 \{",
      "    depth = 10001",
      "  \}",
      "  poke(static_addr(\"g_depth\"), depth)",
      "  var i = depth",
      "  fp = frame_ptr()",
      "  while fp != 0 and i >= 1 \{",
      "    let ret = peek(fp + 8)",
      "    let k = fn_index(ret)",
      "    if k >= 0 \{",
      "      poke(frames + i * 16, peek(static_addr(\"g_fn_table\") + 8 + k * 24 + 16))",
      "      poke(frames + i * 16 + 8, site_of(ret))",
      "      i = i - 1",
      "    \}",
      "    let next = peek(fp)",
      "    if w_ult(fp, next) \{",
      "      fp = next",
      "    \} else \{",
      "      fp = 0",
      "    \}",
      "  \}",
      "\}",
      "",
      "fn stack_note(b: Word) \{",
      "  rebuild_frames()",
      "  let depth = peek(static_addr(\"g_depth\"))",
      "  if depth <= 0 \{",
      "    return",
      "  \}",
      "  let frames = static_addr(\"g_frames\")",
      "  sb_add_cstr(b, \"  note: call stack (innermost first): \")",
      "  var i = depth",
      "  var shown: Word = 0",
      "  while i >= 1 \{",
      "    if depth > 8 and shown == 5 and i > 2 \{",
      "      sb_add_cstr(b, \" <- ... \")",
      "      sb_add_word(b, depth - 7)",
      "      sb_add_cstr(b, \" more frames ...\")",
      "      i = 2",
      "    \}",
      "    if shown > 0 \{",
      "      sb_add_cstr(b, \" <- \")",
      "    \}",
      "    sb_add_str(b, peek(frames + i * 16))",
      "    sb_add_cstr(b, \" (\")",
      "    let call_span = peek(frames + (i - 1) * 16 + 8)",
      "    if call_span != 0 \{",
      "      span_short(b, call_span)",
      "    \} else \{",
      "      sb_add_cstr(b, \"?\")",
      "    \}",
      "    sb_add_byte(b, 41)",
      "    shown = shown + 1",
      "    i = i - 1",
      "  \}",
      "  sb_add_byte(b, 10)",
      "\}",
      "",
      "fn fail_simple(code: Str, msg: Word, sp: Word) -> Word \{",
      "  return fail_with(bits(code), msg, sp, 0, bits(\"\"))",
      "\}",
      "",
      "fn fail_msg(code: Str, msg: Str, sp: Word) -> Word \{",
      "  return fail_with(bits(code), bits(msg), sp, 0, bits(\"\"))",
      "\}",
      "",
      "fn current_span() -> Word \{",
      "  rebuild_frames()",
      "  let depth = peek(static_addr(\"g_depth\"))",
      "  if depth <= 0 \{",
      "    return 0",
      "  \}",
      "  return peek(static_addr(\"g_frames\") + (depth - 1) * 16 + 8)",
      "\}",
      "",
      "fn div_zero(sp: Word) -> Word \{",
      "  return fail_with(bits(\"R0001\"), bits(\"division by zero\"), sp, 0, bits(\"check the divisor before dividing\"))",
      "\}",
      "",
      "fn stack_overflow() -> Word \{",
      "  let sp = current_span()",
      "  let depth = peek(static_addr(\"g_depth\"))",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"stack overflow: more than 10000 nested calls\")",
      "  if depth > 0 \{",
      "    sb_add_cstr(b, \" (in `\")",
      "    sb_add_str(b, peek(static_addr(\"g_frames\") + depth * 16))",
      "    sb_add_cstr(b, \"`)\")",
      "  \}",
      "  return fail_with(bits(\"R0006\"), sb_finish(b), sp, 0, bits(\"check the base case of the recursion\"))",
      "\}",
      "",
      "fn unreachable() -> Word \{",
      "  return fail_msg(\"R0099\", \"internal: no match arm matched\", current_span())",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// entry point",
      "// ---------------------------------------------------------------------------",
      "fn main_entry() -> Word \{",
      "  init_consts()",
      "  tr_begin()",
      "  poke(static_addr(\"g_frames\") + 8, static_addr(\"main_span\"))",
      "  let r = user_main()",
      "  prof_finish()",
      "  if peek(static_addr(\"main_kind\")) == 1 \{",
      "    if peek(r + 16) == 1 \{",
      "      let b = sb_new()",
      "      sb_add_cstr(b, \"main returned \")",
      "      show_into(b, r, peek(r + 8), false)",
      "      poke(static_addr(\"g_depth\"), 0)",
      "      fail_with(bits(\"R0007\"), sb_finish(b), static_addr(\"main_span\"), 0, bits(\"\"))",
      "    \}",
      "  \}",
      "  flush_out()",
      "  tr_end(0)",
      "  return 0",
      "\}",
      "",
    ],
    "rt/cov.klar" => [
      "// Klar runtime: statement coverage (`klarc coverage`). In a coverage build every statement of the main file marks",
      "// itself the first time it runs and reports its line on stderr (unbuffered, so that the forked runs of a property",
      "// report too): a line `\\0cov:<line>`.",
      "",
      "fn cov_line(line: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_byte(b, 0)",
      "  sb_add_cstr(b, \"cov:\")",
      "  sb_add_word(b, line)",
      "  sb_add_byte(b, 10)",
      "  let s = sb_finish(b)",
      "  write_all(2, s + 32, peek(s + 16))",
      "  rc_dec(s)",
      "  return 0",
      "\}",
      "",
    ],
    "rt/fake.klar" => [
      "// Klar runtime: the fakes behind the effects of tests (`test \"t\" uses fs, time, rand`), as in klar/fakes.py: an",
      "// empty file system in memory, a clock that starts at 0 (moved by `set_clock`) and a fixed sequence of random",
      "// numbers. A test executable runs one test per process and calls `fake_begin` before it; a property runs each input",
      "// in a child process, so every run starts from the same fakes.",
      "//",
      "// The file system is a linked list of entries [next, path, content]: `path` is absolute and normalized (no `.`, `..`",
      "// or double `/`), `content` is the text of a file or 0 for a directory.",
      "",
      "const G_FAKE: Word = 1048",
      "const G_FAKE_FS: Word = 1056",
      "const G_CLOCK: Word = 1064",
      "",
      "// the first state of the random numbers of a test (0x9E3779B97F4A7C15)",
      "const FAKE_SEED: Word = -7046029254386353131",
      "",
      "fn fake_begin() \{",
      "  let gp = g()",
      "  poke(gp + G_FAKE, 1)",
      "  poke(gp + G_FAKE_FS, fake_entry(0, str_from(bits(\"/\") + 32, 1), 0))",
      "  poke(gp + G_CLOCK, 0)",
      "  poke(gp + G_RAND, FAKE_SEED)",
      "\}",
      "",
      "fn fake_on() -> Bool \{",
      "  return peek(g() + G_FAKE) != 0",
      "\}",
      "",
      "fn fake_entry(next: Word, path: Word, content: Word) -> Word \{",
      "  let e = alloc(24)",
      "  poke(e, next)",
      "  poke(e + 8, path)",
      "  poke(e + 16, content)",
      "  return e",
      "\}",
      "",
      "// the absolute form of a path: relative paths start at `/`, `.` and `..` resolved",
      "fn fake_norm(path: Word) -> Word \{",
      "  let n = peek(path + 16)",
      "  let p = path + 32",
      "  let b = sb_new()",
      "  var i: Word = 0",
      "  while i <= n \{",
      "    var j = i",
      "    while j < n and peek8(p + j) != 47 \{",
      "      j = j + 1",
      "    \}",
      "    let len = j - i",
      "    if len == 0 or (len == 1 and peek8(p + i) == 46) \{",
      "      // an empty segment or `.`",
      "    \} else if len == 2 and peek8(p + i) == 46 and peek8(p + i + 1) == 46 \{",
      "      var k = sb_len(b) - 1",
      "      while k > 0 and peek8(peek(b + 32) + k) != 47 \{",
      "        k = k - 1",
      "      \}",
      "      if k < 0 \{",
      "        k = 0",
      "      \}",
      "      poke(b + 16, k)",
      "    \} else \{",
      "      sb_add_byte(b, 47)",
      "      sb_add_bytes(b, p + i, len)",
      "    \}",
      "    i = j + 1",
      "  \}",
      "  if sb_len(b) == 0 \{",
      "    sb_add_byte(b, 47)",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn fake_find(n: Word) -> Word \{",
      "  var e = peek(g() + G_FAKE_FS)",
      "  while e != 0 \{",
      "    if Str_eq(peek(e + 8), n) \{",
      "      return e",
      "    \}",
      "    e = peek(e)",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn fake_is_file(n: Word) -> Bool \{",
      "  let e = fake_find(n)",
      "  return e != 0 and peek(e + 16) != 0",
      "\}",
      "",
      "fn fake_is_dir_n(n: Word) -> Bool \{",
      "  let e = fake_find(n)",
      "  return e != 0 and peek(e + 16) == 0",
      "\}",
      "",
      "// the directory of an absolute path (`/` for `/x`)",
      "fn fake_parent(n: Word) -> Word \{",
      "  var k = peek(n + 16) - 1",
      "  while k > 0 and peek8(n + 32 + k) != 47 \{",
      "    k = k - 1",
      "  \}",
      "  if k <= 0 \{",
      "    return str_from(bits(\"/\") + 32, 1)",
      "  \}",
      "  return str_from(n + 32, k)",
      "\}",
      "",
      "// whether a file stands where a directory of path n would be",
      "fn fake_blocked(n: Word) -> Bool \{",
      "  rc_inc(n)",
      "  var cur = n",
      "  var found = false",
      "  while not found and peek(cur + 16) > 1 \{",
      "    if fake_is_file(cur) \{",
      "      found = true",
      "    \} else \{",
      "      let up = fake_parent(cur)",
      "      rc_dec(cur)",
      "      cur = up",
      "    \}",
      "  \}",
      "  rc_dec(cur)",
      "  return found",
      "\}",
      "",
      "fn fake_err(rtd: Word, verb: Str, path: Word, reason: Str) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"cannot \")",
      "  sb_add_cstr(b, verb)",
      "  sb_add_cstr(b, \" '\")",
      "  sb_add_str(b, path)",
      "  sb_add_cstr(b, \"': \")",
      "  sb_add_cstr(b, reason)",
      "  return err_new(rtd, sb_finish(b))",
      "\}",
      "",
      "fn fake_read_file(path: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  let e = fake_find(n)",
      "  rc_dec(n)",
      "  if e == 0 \{",
      "    return fake_err(rtd, \"read\", path, \"No such file or directory\")",
      "  \}",
      "  let c = peek(e + 16)",
      "  if c == 0 \{",
      "    return fake_err(rtd, \"read\", path, \"Is a directory\")",
      "  \}",
      "  if not valid_utf8(c) \{",
      "    return fake_err(rtd, \"read\", path, \"not valid UTF-8 text\")",
      "  \}",
      "  rc_inc(c)",
      "  return ok_new(rtd, c)",
      "\}",
      "",
      "fn fake_read_bytes(path: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  let e = fake_find(n)",
      "  rc_dec(n)",
      "  if e == 0 \{",
      "    return fake_err(rtd, \"read\", path, \"No such file or directory\")",
      "  \}",
      "  let c = peek(e + 16)",
      "  if c == 0 \{",
      "    return fake_err(rtd, \"read\", path, \"Is a directory\")",
      "  \}",
      "  let len = peek(c + 16)",
      "  let out = bytes_with_cap(len)",
      "  copy_bytes(peek(out + 32), c + 32, len)",
      "  poke(out + 16, len)",
      "  return ok_new(rtd, out)",
      "\}",
      "",
      "fn fake_write_bytes(path: Word, data: Word, rtd: Word) -> Word \{",
      "  let s = str_from(peek(data + 32), peek(data + 16))",
      "  let r = fake_write_file(path, s, rtd)",
      "  rc_dec(s)",
      "  return r",
      "\}",
      "",
      "fn fake_write_file(path: Word, content: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  let e = fake_find(n)",
      "  if e != 0 and peek(e + 16) == 0 \{",
      "    rc_dec(n)",
      "    return fake_err(rtd, \"write\", path, \"Is a directory\")",
      "  \}",
      "  let up = fake_parent(n)",
      "  let up_ok = fake_is_dir_n(up)",
      "  let blocked = fake_blocked(up)",
      "  rc_dec(up)",
      "  if not up_ok \{",
      "    rc_dec(n)",
      "    if blocked \{",
      "      return fake_err(rtd, \"write\", path, \"Not a directory\")",
      "    \}",
      "    return fake_err(rtd, \"write\", path, \"No such file or directory\")",
      "  \}",
      "  rc_inc(content)",
      "  if e != 0 \{",
      "    rc_dec(n)",
      "    rc_dec(peek(e + 16))",
      "    poke(e + 16, content)",
      "  \} else \{",
      "    let gp = g()",
      "    poke(gp + G_FAKE_FS, fake_entry(peek(gp + G_FAKE_FS), n, content))",
      "  \}",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
      "fn fake_file_exists(path: Word) -> Bool \{",
      "  let n = fake_norm(path)",
      "  let r = fake_is_file(n)",
      "  rc_dec(n)",
      "  return r",
      "\}",
      "",
      "fn fake_is_dir(path: Word) -> Bool \{",
      "  let n = fake_norm(path)",
      "  let r = fake_is_dir_n(n)",
      "  rc_dec(n)",
      "  return r",
      "\}",
      "",
      "fn fake_list_dir(path: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  if not fake_is_dir_n(n) \{",
      "    let not_dir = fake_is_file(n) or fake_blocked(n)",
      "    rc_dec(n)",
      "    if not_dir \{",
      "      return fake_err(rtd, \"list\", path, \"Not a directory\")",
      "    \}",
      "    return fake_err(rtd, \"list\", path, \"No such file or directory\")",
      "  \}",
      "  // the entries directly below n: their path starts with n + \"/\" (n itself is \"/\" for the root)",
      "  var plen = peek(n + 16) + 1",
      "  if plen == 2 \{",
      "    plen = 1",
      "  \}",
      "  var names = list_new_str()",
      "  var e = peek(g() + G_FAKE_FS)",
      "  while e != 0 \{",
      "    let k = peek(e + 8)",
      "    let klen = peek(k + 16)",
      "    if klen > plen and bytes_eq(k + 32, n + 32, plen - 1) and peek8(k + 32 + plen - 1) == 47 \{",
      "      var slash = false",
      "      var i = plen",
      "      while i < klen \{",
      "        if peek8(k + 32 + i) == 47 \{",
      "          slash = true",
      "        \}",
      "        i = i + 1",
      "      \}",
      "      if not slash \{",
      "        names = list_push_owned_raw(names, str_from(k + 32 + plen, klen - plen))",
      "      \}",
      "    \}",
      "    e = peek(e)",
      "  \}",
      "  rc_dec(n)",
      "  let sorted = List_sort(names, 0)",
      "  rc_dec(names)",
      "  return ok_new(rtd, sorted)",
      "\}",
      "",
      "fn fake_make_dir(path: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  if fake_is_file(n) \{",
      "    rc_dec(n)",
      "    return fake_err(rtd, \"create\", path, \"File exists\")",
      "  \}",
      "  if fake_blocked(n) \{",
      "    rc_dec(n)",
      "    return fake_err(rtd, \"create\", path, \"Not a directory\")",
      "  \}",
      "  var cur = n",
      "  while fake_find(cur) == 0 \{",
      "    let gp = g()",
      "    rc_inc(cur)",
      "    poke(gp + G_FAKE_FS, fake_entry(peek(gp + G_FAKE_FS), cur, 0))",
      "    let up = fake_parent(cur)",
      "    rc_dec(cur)",
      "    cur = up",
      "  \}",
      "  rc_dec(cur)",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
      "fn fake_remove_file(path: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  let e = fake_find(n)",
      "  rc_dec(n)",
      "  if e != 0 and peek(e + 16) == 0 \{",
      "    return fake_err(rtd, \"remove\", path, \"Is a directory\")",
      "  \}",
      "  if e == 0 \{",
      "    return fake_err(rtd, \"remove\", path, \"No such file or directory\")",
      "  \}",
      "  // unlink the entry",
      "  let gp = g()",
      "  if peek(gp + G_FAKE_FS) == e \{",
      "    poke(gp + G_FAKE_FS, peek(e))",
      "  \} else \{",
      "    var prev = peek(gp + G_FAKE_FS)",
      "    while peek(prev) != e \{",
      "      prev = peek(prev)",
      "    \}",
      "    poke(prev, peek(e))",
      "  \}",
      "  rc_dec(peek(e + 8))",
      "  rc_dec(peek(e + 16))",
      "  block_free(e)",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
      "fn fake_set_executable(path: Word, rtd: Word) -> Word \{",
      "  let n = fake_norm(path)",
      "  let e = fake_find(n)",
      "  rc_dec(n)",
      "  if e == 0 \{",
      "    return fake_err(rtd, \"change\", path, \"No such file or directory\")",
      "  \}",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
      "fn b_set_clock(ms: Int, sp: Word) \{",
      "  sb_need(\"set_clock\", SB_TIME, \"time\", sp)",
      "  if not fake_on() \{",
      "    fail_msg(\"R0009\", \"set_clock: only tests have a clock that can be set\", sp)",
      "  \}",
      "  if ms < 0 or ms > 9000000000000 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"set_clock: \")",
      "    int_show(b, bits(ms))",
      "    sb_add_cstr(b, \" is not a time in milliseconds from 0 to 9000000000000\")",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  poke(g() + G_CLOCK, untag(ms) * 1000000)",
      "\}",
      "",
    ],
    "rt/float.klar" => [
      "// Klar runtime: Float formatting/parsing (exact, via Int bignums) and math helpers.",
      "",
      "const F_HIDDEN: Word = 4503599627370496",
      "const F_FRAC: Word = 4503599627370495",
      "const F_ABS: Word = 9223372036854775807",
      "",
      "fn fneg(f: Float) -> Float \{",
      "  return ffrom(w_xor(fbits(f), -9223372036854775808))",
      "\}",
      "",
      "fn float_div(a: Float, b: Float, sp: Word) -> Float \{",
      "  if b == 0.0 \{",
      "    div_zero(sp)",
      "  \}",
      "  return a / b",
      "\}",
      "",
      "fn float_mod(a: Float, b: Float, sp: Word) -> Float \{",
      "  if b == 0.0 \{",
      "    div_zero(sp)",
      "  \}",
      "  return a - b * float_trunc(a / b)",
      "\}",
      "",
      "fn float_trunc(f: Float) -> Float \{",
      "  let w = fbits(f)",
      "  let ex = w_and(w_shr(w, 52), 2047)",
      "  if ex >= 1075 \{",
      "    return f",
      "  \}",
      "  return w2f(f2w(f))",
      "\}",
      "",
      "fn is_finite(f: Float) -> Bool \{",
      "  return w_and(w_shr(fbits(f), 52), 2047) != 2047",
      "\}",
      "",
      "// ---- shortest round-trip decimal (Python repr) -----------------------------",
      "fn float_show(b: Word, f: Float) \{",
      "  let w = fbits(f)",
      "  let ex = w_and(w_shr(w, 52), 2047)",
      "  let frac = w_and(w, F_FRAC)",
      "  if ex == 2047 \{",
      "    if frac != 0 \{",
      "      sb_add_cstr(b, \"nan\")",
      "    \} else if w < 0 \{",
      "      sb_add_cstr(b, \"-inf\")",
      "    \} else \{",
      "      sb_add_cstr(b, \"inf\")",
      "    \}",
      "    return",
      "  \}",
      "  if w < 0 \{",
      "    sb_add_byte(b, 45)",
      "  \}",
      "  if ex == 0 and frac == 0 \{",
      "    sb_add_cstr(b, \"0.0\")",
      "    return",
      "  \}",
      "  let digits = sb_new()",
      "  let decpt = shortest_digits(digits, ex, frac)",
      "  let nd = sb_len(digits)",
      "  let dp = peek(digits + 32)",
      "  if decpt > 16 or decpt < -3 \{",
      "    sb_add_byte(b, peek8(dp))",
      "    if nd > 1 \{",
      "      sb_add_byte(b, 46)",
      "      sb_add_bytes(b, dp + 1, nd - 1)",
      "    \}",
      "    var e10 = decpt - 1",
      "    sb_add_byte(b, 101)",
      "    if e10 < 0 \{",
      "      sb_add_byte(b, 45)",
      "      e10 = 0 - e10",
      "    \} else \{",
      "      sb_add_byte(b, 43)",
      "    \}",
      "    if e10 < 10 \{",
      "      sb_add_byte(b, 48)",
      "    \}",
      "    sb_add_word(b, e10)",
      "  \} else if decpt <= 0 \{",
      "    sb_add_cstr(b, \"0.\")",
      "    var z: Word = 0",
      "    while z < 0 - decpt \{",
      "      sb_add_byte(b, 48)",
      "      z = z + 1",
      "    \}",
      "    sb_add_bytes(b, dp, nd)",
      "  \} else if decpt >= nd \{",
      "    sb_add_bytes(b, dp, nd)",
      "    var z2 = nd",
      "    while z2 < decpt \{",
      "      sb_add_byte(b, 48)",
      "      z2 = z2 + 1",
      "    \}",
      "    sb_add_cstr(b, \".0\")",
      "  \} else \{",
      "    sb_add_bytes(b, dp, decpt)",
      "    sb_add_byte(b, 46)",
      "    sb_add_bytes(b, dp + decpt, nd - decpt)",
      "  \}",
      "  rc_dec(digits)",
      "\}",
      "",
      "// Burger & Dybvig free-format digit generation; returns the decimal point position",
      "fn shortest_digits(out: Word, ex: Word, frac: Word) -> Word \{",
      "  var mant: Int = 0",
      "  var e2: Int = 0",
      "  if ex == 0 \{",
      "    mant = tag(frac)",
      "    e2 = -1074",
      "  \} else \{",
      "    mant = tag(frac + F_HIDDEN)",
      "    e2 = tag(ex) - 1075",
      "  \}",
      "  let even = mant % 2 == 0",
      "  let hidden: Int = tag(F_HIDDEN)",
      "  var r: Int = 0",
      "  var s: Int = 0",
      "  var mp: Int = 0",
      "  var mm: Int = 0",
      "  if e2 >= 0 \{",
      "    let be = pow2(e2)",
      "    if mant != hidden \{",
      "      r = mant * be * 2",
      "      s = 2",
      "      mp = be",
      "      mm = be",
      "    \} else \{",
      "      r = mant * be * 4",
      "      s = 4",
      "      mp = be * 2",
      "      mm = be",
      "    \}",
      "  \} else \{",
      "    if ex <= 1 or mant != hidden \{",
      "      r = mant * 2",
      "      s = pow2(0 - e2) * 2",
      "      mp = 1",
      "      mm = 1",
      "    \} else \{",
      "      r = mant * 4",
      "      s = pow2(1 - e2) * 2",
      "      mp = 2",
      "      mm = 1",
      "    \}",
      "  \}",
      "  let approx = ffrom(w_or(w_shl(ex, 52), frac))",
      "  var k: Int = ceil_log10(approx)",
      "  if ex == 0 \{",
      "    k = -307",
      "  \}",
      "  if k >= 0 \{",
      "    s = s * pow10(k)",
      "  \} else \{",
      "    let sc = pow10(0 - k)",
      "    r = r * sc",
      "    mp = mp * sc",
      "    mm = mm * sc",
      "  \}",
      "  while (even and r + mp >= s) or (not even and r + mp > s) \{",
      "    s = s * 10",
      "    k = k + 1",
      "  \}",
      "  while (even and (r + mp) * 10 < s) or (not even and (r + mp) * 10 <= s) \{",
      "    r = r * 10",
      "    mp = mp * 10",
      "    mm = mm * 10",
      "    k = k - 1",
      "  \}",
      "  var done = false",
      "  while not done \{",
      "    r = r * 10",
      "    mp = mp * 10",
      "    mm = mm * 10",
      "    let d = r / s",
      "    r = r % s",
      "    let low = (even and r <= mm) or (not even and r < mm)",
      "    let high = (even and r + mp >= s) or (not even and r + mp > s)",
      "    var digit = untag(d)",
      "    if low and high \{",
      "      if r * 2 > s or (r * 2 == s and digit % 2 == 1) \{",
      "        digit = digit + 1",
      "      \}",
      "      done = true",
      "    \} else if low \{",
      "      done = true",
      "    \} else if high \{",
      "      digit = digit + 1",
      "      done = true",
      "    \}",
      "    sb_add_byte(out, 48 + digit)",
      "  \}",
      "  return untag(k)",
      "\}",
      "",
      "fn ceil_log10(f: Float) -> Int \{",
      "  let x = fln(f) / 2.302585092994046",
      "  var k = f2w(x)",
      "  if w2f(k) < x \{",
      "    k = k + 1",
      "  \}",
      "  return tag(k)",
      "\}",
      "",
      "// ---- exact rational -> nearest double (round half to even) -------------------------",
      "fn ratio_to_double(n: Int, d: Int) -> Float \{",
      "  if n == 0 \{",
      "    return 0.0",
      "  \}",
      "  var e = int_bitlen(n) - int_bitlen(d)",
      "  if e >= 0 \{",
      "    if n < d * pow2(e) \{",
      "      e = e - 1",
      "    \}",
      "  \} else \{",
      "    if n * pow2(0 - e) < d \{",
      "      e = e - 1",
      "    \}",
      "  \}",
      "  var t = e - 52",
      "  if t < -1074 \{",
      "    t = -1074",
      "  \}",
      "  let sh = 2 - t",
      "  var q: Int = 0",
      "  var rem: Int = 0",
      "  if sh >= 0 \{",
      "    let num = n * pow2(sh)",
      "    q = num / d",
      "    rem = num % d",
      "  \} else \{",
      "    let den = d * pow2(0 - sh)",
      "    q = n / den",
      "    rem = n % den",
      "  \}",
      "  var m = q / 4",
      "  let rb = (q / 2) % 2",
      "  let sticky = q % 2 == 1 or rem != 0",
      "  if rb == 1 and (sticky or m % 2 == 1) \{",
      "    m = m + 1",
      "  \}",
      "  if m == tag(F_HIDDEN) * 2 \{",
      "    m = tag(F_HIDDEN)",
      "    t = t + 1",
      "  \}",
      "  if m < tag(F_HIDDEN) \{",
      "    return ffrom(untag(m))",
      "  \}",
      "  let biased = t + 52 + 1023",
      "  if biased >= 2047 \{",
      "    return ffrom(9218868437227405312)",
      "  \}",
      "  return ffrom(w_or(w_shl(untag(biased), 52), untag(m) - F_HIDDEN))",
      "\}",
      "",
      "// exact value of a finite double as (mantissa, exponent): value = mant * 2^e2",
      "fn float_mant(f: Float) -> Int \{",
      "  let w = fbits(f)",
      "  let ex = w_and(w_shr(w, 52), 2047)",
      "  let frac = w_and(w, F_FRAC)",
      "  if ex == 0 \{",
      "    return tag(frac)",
      "  \}",
      "  return tag(frac + F_HIDDEN)",
      "\}",
      "",
      "fn float_exp2(f: Float) -> Int \{",
      "  let ex = w_and(w_shr(fbits(f), 52), 2047)",
      "  if ex == 0 \{",
      "    return -1074",
      "  \}",
      "  return tag(ex) - 1075",
      "\}",
      "",
      "// |f| truncated to an Int (f finite)",
      "fn float_to_int(f: Float) -> Int \{",
      "  let a = ffrom(w_and(fbits(f), F_ABS))",
      "  if a < 4611686018427387904.0 \{",
      "    return tag(f2w(f))",
      "  \}",
      "  let v = float_mant(f) * pow2(float_exp2(f))",
      "  if f < 0.0 \{",
      "    return 0 - v",
      "  \}",
      "  return v",
      "\}",
      "",
      "fn int_to_float(x: Int, sp: Word) -> Float \{",
      "  let w = bits(x)",
      "  if w_and(w, 1) == 1 \{",
      "    return w2f(w_sar(w, 1))",
      "  \}",
      "  var mag = x",
      "  if x < 0 \{",
      "    mag = 0 - x",
      "  \}",
      "  let f = ratio_to_double(mag, 1)",
      "  if not is_finite(f) \{",
      "    fail_msg(\"R0009\", \"int too large to convert to float\", sp)",
      "  \}",
      "  if x < 0 \{",
      "    return fneg(f)",
      "  \}",
      "  return f",
      "\}",
      "",
      "fn need_finite(f: Float, sp: Word) \{",
      "  if not is_finite(f) \{",
      "    fail_msg(\"R0009\", \"cannot convert infinity or NaN to an integer\", sp)",
      "  \}",
      "\}",
      "",
      "// round(|f| * 10^digits) half-to-even, as an Int (f finite, digits >= 0)",
      "fn scaled_round(f: Float, digits: Int) -> Int \{",
      "  let mant = float_mant(f)",
      "  let e2 = float_exp2(f)",
      "  if e2 >= 0 \{",
      "    return mant * pow2(e2) * pow10(digits)",
      "  \}",
      "  let num = mant * pow10(digits)",
      "  let den = pow2(0 - e2)",
      "  var q = num / den",
      "  let r = num % den",
      "  if r * 2 > den or (r * 2 == den and q % 2 == 1) \{",
      "    q = q + 1",
      "  \}",
      "  return q",
      "\}",
      "",
      "// ---- Float methods -------------------------------------------------------------------",
      "fn Float_to_int(f: Float, sp: Word) -> Int \{",
      "  need_finite(f, sp)",
      "  return float_to_int(f)",
      "\}",
      "",
      "fn Float_round(f: Float, sp: Word) -> Int \{",
      "  return Float_floor(f + 0.5, sp)",
      "\}",
      "",
      "fn Float_floor(f: Float, sp: Word) -> Int \{",
      "  need_finite(f, sp)",
      "  let t = float_trunc(f)",
      "  if t > f \{",
      "    return float_to_int(t - 1.0)",
      "  \}",
      "  return float_to_int(t)",
      "\}",
      "",
      "fn Float_ceil(f: Float, sp: Word) -> Int \{",
      "  need_finite(f, sp)",
      "  let t = float_trunc(f)",
      "  if t < f \{",
      "    return float_to_int(t + 1.0)",
      "  \}",
      "  return float_to_int(t)",
      "\}",
      "",
      "fn Float_abs(f: Float) -> Float \{",
      "  return ffrom(w_and(fbits(f), F_ABS))",
      "\}",
      "",
      "fn Float_sqrt(f: Float, sp: Word) -> Float \{",
      "  if f < 0.0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"Float.sqrt of negative number \")",
      "    float_show(b, f)",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  return fsqrt(f)",
      "\}",
      "",
      "fn Float_min(a: Float, b: Float) -> Float \{",
      "  if b < a \{",
      "    return b",
      "  \}",
      "  return a",
      "\}",
      "",
      "fn Float_max(a: Float, b: Float) -> Float \{",
      "  if b > a \{",
      "    return b",
      "  \}",
      "  return a",
      "\}",
      "",
      "fn Float_sin(f: Float) -> Float \{",
      "  return fsin(f)",
      "\}",
      "",
      "fn Float_cos(f: Float) -> Float \{",
      "  return fcos(f)",
      "\}",
      "",
      "fn Float_ln(f: Float, sp: Word) -> Float \{",
      "  if f <= 0.0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"Float.ln of non-positive number \")",
      "    float_show(b, f)",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  return fln(f)",
      "\}",
      "",
      "fn Float_exp(f: Float, sp: Word) -> Float \{",
      "  let r = fexp(f)",
      "  if is_finite(f) and not is_finite(r) \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"Float.exp(\")",
      "    float_show(b, f)",
      "    sb_add_cstr(b, \") overflows\")",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn Float_pow(x: Float, y: Float, sp: Word) -> Float \{",
      "  if y == 0.0 \{",
      "    return 1.0",
      "  \}",
      "  if x == 1.0 \{",
      "    return 1.0",
      "  \}",
      "  if x == 0.0 \{",
      "    if y < 0.0 \{",
      "      fail_msg(\"R0009\", \"Float.pow: 0.0 cannot be raised to a negative power\", sp)",
      "    \}",
      "    return 0.0",
      "  \}",
      "  var r: Float = 0.0",
      "  if x < 0.0 \{",
      "    if float_trunc(y) != y \{",
      "      fail_msg(\"R0009\", \"Float.pow: negative base with fractional exponent\", sp)",
      "    \}",
      "    r = fpow(fneg(x), y)",
      "    let yi = Float_to_int(y, sp)",
      "    if yi % 2 != 0 \{",
      "      r = fneg(r)",
      "    \}",
      "  \} else \{",
      "    r = fpow(x, y)",
      "  \}",
      "  if is_finite(x) and is_finite(y) and not is_finite(r) \{",
      "    fail_msg(\"R0009\", \"Float.pow: numerical result out of range\", sp)",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn Float_round_to(f: Float, digits: Int) -> Float \{",
      "  if not is_finite(f) \{",
      "    return f",
      "  \}",
      "  var v: Float = 0.0",
      "  if digits >= 0 \{",
      "    v = ratio_to_double(scaled_round(f, digits), pow10(digits))",
      "  \} else \{",
      "    let p = pow10(0 - digits)",
      "    let mant = float_mant(f)",
      "    let e2 = float_exp2(f)",
      "    var num = mant",
      "    var den = p",
      "    if e2 >= 0 \{",
      "      num = mant * pow2(e2)",
      "    \} else \{",
      "      den = p * pow2(0 - e2)",
      "    \}",
      "    var q = num / den",
      "    let r = num % den",
      "    if r * 2 > den or (r * 2 == den and q % 2 == 1) \{",
      "      q = q + 1",
      "    \}",
      "    v = ratio_to_double(q * p, 1)",
      "  \}",
      "  if fbits(f) < 0 \{",
      "    return fneg(v)",
      "  \}",
      "  return v",
      "\}",
      "",
      "fn Float_fixed(f: Float, digits: Int, sp: Word) -> Word \{",
      "  if digits < 0 \{",
      "    let b0 = sb_new()",
      "    sb_add_cstr(b0, \"Float.fixed: negative digits \")",
      "    int_show(b0, bits(digits))",
      "    fail_simple(\"R0009\", sb_finish(b0), sp)",
      "  \}",
      "  let b = sb_new()",
      "  if not is_finite(f) \{",
      "    float_show(b, f)",
      "    return sb_finish(b)",
      "  \}",
      "  if fbits(f) < 0 \{",
      "    sb_add_byte(b, 45)",
      "  \}",
      "  let q = scaled_round(f, digits)",
      "  let ds = sb_new()",
      "  int_show(ds, bits(q))",
      "  let nd = sb_len(ds)",
      "  let dw = untag(digits)",
      "  var zeros = dw + 1 - nd",
      "  while zeros > 0 \{",
      "    sb_add_byte(b, 48)",
      "    zeros = zeros - 1",
      "  \}",
      "  sb_add_bytes(b, peek(ds + 32), nd)",
      "  rc_dec(ds)",
      "  if dw > 0 \{",
      "    // insert '.' before the last dw digits",
      "    let full = sb_finish(b)",
      "    let out = sb_new()",
      "    let n = peek(full + 16)",
      "    sb_add_bytes(out, full + 32, n - dw)",
      "    sb_add_byte(out, 46)",
      "    sb_add_bytes(out, full + 32 + n - dw, dw)",
      "    rc_dec(full)",
      "    return sb_finish(out)",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn Float_to_str(f: Float) -> Word \{",
      "  let b = sb_new()",
      "  float_show(b, f)",
      "  return sb_finish(b)",
      "\}",
      "",
      "// ---- parsing: [+-]?(digits[.digits*] | .digits)([eE][+-]?digits)?, surrounding whitespace allowed",
      "fn parse_float_text(s: Word, ok_flag: Word) -> Float \{",
      "  let n = peek(s + 16)",
      "  let p = s + 32",
      "  var i: Word = 0",
      "  while i < n and is_space_byte(peek8(p + i)) \{",
      "    i = i + 1",
      "  \}",
      "  var end = n",
      "  while end > i and is_space_byte(peek8(p + end - 1)) \{",
      "    end = end - 1",
      "  \}",
      "  poke(ok_flag, 0)",
      "  var neg = false",
      "  if i < end and (peek8(p + i) == 43 or peek8(p + i) == 45) \{",
      "    neg = peek8(p + i) == 45",
      "    i = i + 1",
      "  \}",
      "  var digits: Int = 0",
      "  var nint: Word = 0",
      "  var nfrac: Word = 0",
      "  while i < end and is_digit_byte(peek8(p + i)) \{",
      "    digits = digits * 10 + tag(peek8(p + i) - 48)",
      "    nint = nint + 1",
      "    i = i + 1",
      "  \}",
      "  if i < end and peek8(p + i) == 46 \{",
      "    i = i + 1",
      "    while i < end and is_digit_byte(peek8(p + i)) \{",
      "      digits = digits * 10 + tag(peek8(p + i) - 48)",
      "      nfrac = nfrac + 1",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  if nint == 0 and nfrac == 0 \{",
      "    return 0.0",
      "  \}",
      "  var exp10: Int = 0",
      "  if i < end and (peek8(p + i) == 101 or peek8(p + i) == 69) \{",
      "    i = i + 1",
      "    var eneg = false",
      "    if i < end and (peek8(p + i) == 43 or peek8(p + i) == 45) \{",
      "      eneg = peek8(p + i) == 45",
      "      i = i + 1",
      "    \}",
      "    var ne: Word = 0",
      "    while i < end and is_digit_byte(peek8(p + i)) \{",
      "      if exp10 < 100000 \{",
      "        exp10 = exp10 * 10 + tag(peek8(p + i) - 48)",
      "      \}",
      "      ne = ne + 1",
      "      i = i + 1",
      "    \}",
      "    if ne == 0 \{",
      "      return 0.0",
      "    \}",
      "    if eneg \{",
      "      exp10 = 0 - exp10",
      "    \}",
      "  \}",
      "  if i != end \{",
      "    return 0.0",
      "  \}",
      "  poke(ok_flag, 1)",
      "  exp10 = exp10 - tag(nfrac)",
      "  var v: Float = 0.0",
      "  if digits == 0 \{",
      "    v = 0.0",
      "  \} else if exp10 > 400 \{",
      "    v = ffrom(9218868437227405312)",
      "  \} else if exp10 < -800 \{",
      "    v = 0.0",
      "  \} else if exp10 >= 0 \{",
      "    v = ratio_to_double(digits * pow10(exp10), 1)",
      "  \} else \{",
      "    v = ratio_to_double(digits, pow10(0 - exp10))",
      "  \}",
      "  if neg \{",
      "    return fneg(v)",
      "  \}",
      "  return v",
      "\}",
      "",
      "fn is_space_byte(c: Word) -> Bool \{",
      "  return c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)",
      "\}",
      "",
      "fn is_digit_byte(c: Word) -> Bool \{",
      "  return c >= 48 and c <= 57",
      "\}",
      "",
      "// IEEE-754 bits as a signed 64-bit Int (`Float.to_bits`) and back (`float_from_bits`)",
      "fn Float_to_bits(f: Float) -> Int \{",
      "  let w = fbits(f)",
      "  let hi = tag(w_sar(w, 32))",
      "  let lo = tag(w_and(w, 4294967295))",
      "  return hi * 4294967296 + lo",
      "\}",
      "",
      "fn b_float_from_bits(n: Int, sp: Word) -> Float \{",
      "  if n < 0 - pow2(63) or n >= pow2(64) \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"float_from_bits: \")",
      "    int_show(b, bits(n))",
      "    sb_add_cstr(b, \" is not a 64-bit pattern\")",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  var x = n",
      "  if x < 0 \{",
      "    x = x + pow2(64)",
      "  \}",
      "  let hi = untag(x / 4294967296)",
      "  let lo = untag(x % 4294967296)",
      "  return ffrom(w_or(w_shl(hi, 32), lo))",
      "\}",
      "",
    ],
    "rt/globals.klar" => [
      "// Klar runtime: global built-in functions (print, range, time, ...). Names: b_<builtin>.",
      "",
      "fn b_print(v: Word, td_T: Word) \{",
      "  if peek(td_T) == K_STR \{",
      "    out_bytes(v + 32, peek(v + 16))",
      "  \} else \{",
      "    let b = sb_new()",
      "    show_into(b, v, td_T, true)",
      "    out_bytes(peek(b + 32), peek(b + 16))",
      "    rc_dec(b)",
      "  \}",
      "  out_byte(10)",
      "\}",
      "",
      "// print_raw(text): the text as it is, without a line break",
      "fn b_print_raw(s: Word) \{",
      "  out_bytes(s + 32, peek(s + 16))",
      "\}",
      "",
      "// print to stderr (stdout is flushed first, so the two streams stay in order)",
      "fn b_eprint(v: Word, td_T: Word) \{",
      "  flush_out()",
      "  let b = sb_new()",
      "  show_into(b, v, td_T, true)",
      "  sb_add_byte(b, 10)",
      "  err_bytes(peek(b + 32), peek(b + 16))",
      "  rc_dec(b)",
      "\}",
      "",
      "fn b_range(lo: Int, hi: Int, rtd: Word) -> Word \{",
      "  if not is_small(lo) or not is_small(hi) \{",
      "    fail_msg(\"R0009\", \"range: bounds too large\", current_span())",
      "  \}",
      "  return list_from_range(rtd, untag(lo), untag(hi))",
      "\}",
      "",
      "fn real_now_ns(sp: Word) -> Int \{",
      "  sb_need(\"now_ns\", SB_TIME, \"time\", sp)",
      "  if fake_on() \{",
      "    return tag(peek(g() + G_CLOCK))",
      "  \}",
      "  return tag(os_time_ns())",
      "\}",
      "",
      "fn real_now_ms(sp: Word) -> Int \{",
      "  sb_need(\"now_ms\", SB_TIME, \"time\", sp)",
      "  if fake_on() \{",
      "    return tag(peek(g() + G_CLOCK) / 1000000)",
      "  \}",
      "  return tag(os_wall_ns() / 1000000)",
      "\}",
      "",
      "fn b_fail(msg: Word, sp: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"fail: \")",
      "  sb_add_str(b, msg)",
      "  return fail_with(bits(\"R0004\"), sb_finish(b), sp, 0, bits(\"\"))",
      "\}",
      "",
      "fn b_todo(what: Word, sp: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"reached unfinished code: todo(\\\"\")",
      "  sb_add_str(b, what)",
      "  sb_add_cstr(b, \"\\\")\")",
      "  return fail_with(bits(\"R0012\"), sb_finish(b), sp, 0, bits(\"\"))",
      "\}",
      "",
      "fn real_random_int(lo: Int, hi: Int, sp: Word) -> Int \{",
      "  sb_need(\"random_int\", SB_RAND, \"rand\", sp)",
      "  if lo > hi \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"random_int: min (\")",
      "    int_show(b, bits(lo))",
      "    sb_add_cstr(b, \") > max (\")",
      "    int_show(b, bits(hi))",
      "    sb_add_cstr(b, \")\")",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  let gp = g()",
      "  var x = peek(gp + G_RAND)",
      "  if x == 0 \{",
      "    x = w_or(os_time_ns(), 1)",
      "  \}",
      "  x = w_xor(x, w_shl(x, 13))",
      "  x = w_xor(x, w_shr(x, 7))",
      "  x = w_xor(x, w_shl(x, 17))",
      "  poke(gp + G_RAND, x)",
      "  let r: Int = tag(w_shr(x, 3))",
      "  return lo + r % (hi - lo + 1)",
      "\}",
      "",
      "// read_exact(n): the next n bytes of standard input (shares the buffer of read_line)",
      "fn real_read_exact(n: Word, rtd: Word) -> Word \{",
      "  let gp = g()",
      "  let buf = static_addr(\"g_inbuf\")",
      "  var want = w_sar(n, 1)",
      "  let b = sb_new()",
      "  var got: Word = 0",
      "  while got < want \{",
      "    if peek(gp + G_INPOS) >= peek(gp + G_INLEN) \{",
      "      if peek(gp + G_INEOF) == 1 \{",
      "        want = got",
      "      \} else \{",
      "        flush_out()",
      "        let r = os_read(0, buf, 65536)",
      "        if r <= 0 \{",
      "          poke(gp + G_INEOF, 1)",
      "          want = got",
      "        \} else \{",
      "          poke(gp + G_INPOS, 0)",
      "          poke(gp + G_INLEN, r)",
      "        \}",
      "      \}",
      "    \}",
      "    if got < want \{",
      "      let pos = peek(gp + G_INPOS)",
      "      sb_add_byte(b, peek8(buf + pos))",
      "      poke(gp + G_INPOS, pos + 1)",
      "      got = got + 1",
      "    \}",
      "  \}",
      "  if got == 0 and w_sar(n, 1) > 0 \{",
      "    rc_dec(b)",
      "    return none()",
      "  \}",
      "  return some_new(rtd, sb_finish(b))",
      "\}",
      "",
      "fn real_read_line(rtd: Word) -> Word \{",
      "  let gp = g()",
      "  let buf = static_addr(\"g_inbuf\")",
      "  let b = sb_new()",
      "  var got = false",
      "  var reading = true",
      "  while reading \{",
      "    if peek(gp + G_INPOS) >= peek(gp + G_INLEN) \{",
      "      if peek(gp + G_INEOF) == 1 \{",
      "        reading = false",
      "      \} else \{",
      "        flush_out()",
      "        let n = os_read(0, buf, 65536)",
      "        if n <= 0 \{",
      "          poke(gp + G_INEOF, 1)",
      "          reading = false",
      "        \} else \{",
      "          poke(gp + G_INPOS, 0)",
      "          poke(gp + G_INLEN, n)",
      "        \}",
      "      \}",
      "    \}",
      "    if reading \{",
      "      let pos = peek(gp + G_INPOS)",
      "      let c = peek8(buf + pos)",
      "      poke(gp + G_INPOS, pos + 1)",
      "      got = true",
      "      if c == 10 \{",
      "        reading = false",
      "      \} else \{",
      "        sb_add_byte(b, c)",
      "      \}",
      "    \}",
      "  \}",
      "  if not got \{",
      "    rc_dec(b)",
      "    return none()",
      "  \}",
      "  var n2 = sb_len(b)",
      "  if n2 > 0 and peek8(peek(b + 32) + n2 - 1) == 13 \{",
      "    poke(b + 16, n2 - 1)",
      "  \}",
      "  return some_new(rtd, sb_finish(b))",
      "\}",
      "",
      "fn cstr_len(p: Word) -> Word \{",
      "  var n: Word = 0",
      "  while peek8(p + n) != 0 \{",
      "    n = n + 1",
      "  \}",
      "  return n",
      "\}",
      "",
      "fn real_cli_args(rtd: Word) -> Word \{",
      "  var out = list_with_cap(rtd, 4)",
      "  if os_platform() != 1 \{",
      "    let argc = os_argc()",
      "    var i: Word = 1",
      "    while i < argc \{",
      "      let p = os_argv(i)",
      "      out = list_push_owned_raw(out, str_from(p, cstr_len(p)))",
      "      i = i + 1",
      "    \}",
      "    return out",
      "  \}",
      "  // Windows: split GetCommandLineA, honouring double quotes; skip the program name",
      "  let cl = os_cmdline()",
      "  let n = cstr_len(cl)",
      "  var i2: Word = 0",
      "  var index: Word = 0",
      "  while i2 < n \{",
      "    while i2 < n and peek8(cl + i2) == 32 \{",
      "      i2 = i2 + 1",
      "    \}",
      "    if i2 < n \{",
      "      let b = sb_new()",
      "      var quoted = false",
      "      while i2 < n and (quoted or peek8(cl + i2) != 32) \{",
      "        let c = peek8(cl + i2)",
      "        if c == 34 \{",
      "          quoted = not quoted",
      "        \} else \{",
      "          sb_add_byte(b, c)",
      "        \}",
      "        i2 = i2 + 1",
      "      \}",
      "      if index > 0 \{",
      "        out = list_push_owned_raw(out, sb_finish(b))",
      "      \} else \{",
      "        rc_dec(b)",
      "      \}",
      "      index = index + 1",
      "    \}",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn io_error_text(b: Word, code: Word) \{",
      "  if code == -2 or os_platform() == 1 \{",
      "    sb_add_cstr(b, \"No such file or directory\")",
      "  \} else if code == -13 \{",
      "    sb_add_cstr(b, \"Permission denied\")",
      "  \} else if code == -21 \{",
      "    sb_add_cstr(b, \"Is a directory\")",
      "  \} else if code == -20 \{",
      "    sb_add_cstr(b, \"Not a directory\")",
      "  \} else if code == -17 \{",
      "    sb_add_cstr(b, \"File exists\")",
      "  \} else \{",
      "    sb_add_cstr(b, \"I/O error\")",
      "  \}",
      "\}",
      "",
      "fn real_read_file(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"read_file\", path, sp)",
      "  if fake_on() \{",
      "    return fake_read_file(path, rtd)",
      "  \}",
      "  let fd = os_open(path + 32, 0)",
      "  if fd < 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"cannot read '\")",
      "    sb_add_str(b, path)",
      "    sb_add_cstr(b, \"': \")",
      "    io_error_text(b, fd)",
      "    return err_new(rtd, sb_finish(b))",
      "  \}",
      "  let content = sb_new()",
      "  let chunk = alloc(65536)",
      "  var reading = true",
      "  while reading \{",
      "    let n = os_read(fd, chunk, 65536)",
      "    if n <= 0 \{",
      "      reading = false",
      "    \} else \{",
      "      sb_add_bytes(content, chunk, n)",
      "    \}",
      "  \}",
      "  block_free(chunk)",
      "  os_close(fd)",
      "  let s = sb_finish(content)",
      "  if not valid_utf8(s) \{",
      "    rc_dec(s)",
      "    let b2 = sb_new()",
      "    sb_add_cstr(b2, \"cannot read '\")",
      "    sb_add_str(b2, path)",
      "    sb_add_cstr(b2, \"': not valid UTF-8 text\")",
      "    return err_new(rtd, sb_finish(b2))",
      "  \}",
      "  return ok_new(rtd, s)",
      "\}",
      "",
      "fn valid_utf8(s: Word) -> Bool \{",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = peek8(s + 32 + i)",
      "    var need: Word = 0",
      "    if c < 128 \{",
      "      need = 0",
      "    \} else if c >= 194 and c < 224 \{",
      "      need = 1",
      "    \} else if c >= 224 and c < 240 \{",
      "      need = 2",
      "    \} else if c >= 240 and c < 245 \{",
      "      need = 3",
      "    \} else \{",
      "      return false",
      "    \}",
      "    var k: Word = 1",
      "    while k <= need \{",
      "      if i + k >= n or w_and(peek8(s + 32 + i + k), 192) != 128 \{",
      "        return false",
      "      \}",
      "      k = k + 1",
      "    \}",
      "    i = i + 1 + need",
      "  \}",
      "  return true",
      "\}",
      "",
      "fn real_write_file(path: Word, content: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"write_file\", path, sp)",
      "  if fake_on() \{",
      "    return fake_write_file(path, content, rtd)",
      "  \}",
      "  let fd = os_open(path + 32, 1)",
      "  if fd < 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"cannot write '\")",
      "    sb_add_str(b, path)",
      "    sb_add_cstr(b, \"': \")",
      "    io_error_text(b, fd)",
      "    return err_new(rtd, sb_finish(b))",
      "  \}",
      "  var done: Word = 0",
      "  let n = peek(content + 16)",
      "  while done < n \{",
      "    let w = os_write(fd, content + 32 + done, n - done)",
      "    if w <= 0 \{",
      "      done = n",
      "    \} else \{",
      "      done = done + w",
      "    \}",
      "  \}",
      "  os_close(fd)",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
      "fn real_file_exists(path: Word, sp: Word) -> Bool \{",
      "  sb_need_fs(\"file_exists\", path, sp)",
      "  if fake_on() \{",
      "    return fake_file_exists(path)",
      "  \}",
      "  return os_file_exists(path + 32)",
      "\}",
      "",
      "fn b_dbg(v: Word, td: Word, text: Word, sp: Word) \{",
      "  flush_out()",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"[dbg \")",
      "  span_short(b, sp)",
      "  sb_add_cstr(b, \"] \")",
      "  sb_add_str(b, text)",
      "  sb_add_cstr(b, \" = \")",
      "  show_into(b, v, td, false)",
      "  sb_add_byte(b, 10)",
      "  err_bytes(peek(b + 32), peek(b + 16))",
      "  rc_dec(b)",
      "\}",
      "",
      "fn b_exit(code: Int) -> Word \{",
      "  var c: Word = 0",
      "  if is_small(code) \{",
      "    c = untag(code)",
      "  \} else if code > 0 \{",
      "    c = 255",
      "  \}",
      "  if c < 0 \{",
      "    c = 0",
      "  \}",
      "  if c > 255 \{",
      "    c = 255",
      "  \}",
      "  flush_out()",
      "  prof_finish()",
      "  tr_end(c)",
      "  os_exit(c)",
      "  return 0",
      "\}",
      "",
      "// environment variable: Linux and macOS walk envp (after argv on the initial stack), Windows asks kernel32",
      "fn real_env_var(name: Word, rtd: Word) -> Word \{",
      "  let n = peek(name + 16)",
      "  if os_platform() != 1 \{",
      "    var i = os_argc() + 1",
      "    var p = os_argv(i)",
      "    while p != 0 \{",
      "      if bytes_eq(p, name + 32, n) and peek8(p + n) == 61 \{",
      "        return some_new(rtd, str_from(p + n + 1, cstr_len(p + n + 1)))",
      "      \}",
      "      i = i + 1",
      "      p = os_argv(i)",
      "    \}",
      "    return none()",
      "  \}",
      "  let cap: Word = 32768",
      "  let buf = alloc(cap)",
      "  let len = os_getenv(name + 32, buf, cap)",
      "  if len <= 0 or len >= cap \{",
      "    block_free(buf)",
      "    return none()",
      "  \}",
      "  let s = str_from(buf, len)",
      "  block_free(buf)",
      "  return some_new(rtd, s)",
      "\}",
      "",
      "// ---- processes --------------------------------------------------------------------------------------------------",
      "",
      "fn spawn_error(prog: Word, code: Word, rtd: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"cannot run '\")",
      "  sb_add_str(b, prog)",
      "  sb_add_cstr(b, \"': \")",
      "  io_error_text(b, code)",
      "  return err_new(rtd, sb_finish(b))",
      "\}",
      "",
      "fn has_byte(s: Word, c: Word) -> Bool \{",
      "  var i: Word = 0",
      "  let n = peek(s + 16)",
      "  while i < n \{",
      "    if peek8(s + 32 + i) == c \{",
      "      return true",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return false",
      "\}",
      "",
      "// Linux: the program file for a name: itself when it contains '/', else the first match in PATH (0: none)",
      "// Windows: `dir\\prog` + ext when that file exists, else 0",
      "fn win_candidate(dir: Word, n: Word, prog: Word, ext: Str) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_bytes(b, dir, n)",
      "  if n > 0 and peek8(dir + n - 1) != 92 \{",
      "    sb_add_byte(b, 92)",
      "  \}",
      "  sb_add_str(b, prog)",
      "  sb_add_cstr(b, ext)",
      "  let cand = sb_finish(b)",
      "  if os_file_exists(cand + 32) \{",
      "    return cand",
      "  \}",
      "  rc_dec(cand)",
      "  return 0",
      "\}",
      "",
      "// Windows: the program's full path, searched in PATH only (CreateProcessA would look in the current directory",
      "// first, where an untrusted project could put its own git.exe); a name with a directory is taken as it is. A name",
      "// without an extension tries .exe, .com, .bat, .cmd. 0 when nothing is found.",
      "fn win_find_program(prog: Word) -> Word \{",
      "  if has_byte(prog, 92) or has_byte(prog, 47) or has_byte(prog, 58) \{",
      "    rc_inc(prog)",
      "    return prog",
      "  \}",
      "  let cap: Word = 32768",
      "  let path = alloc(cap)",
      "  let len = os_getenv(bits(\"PATH\") + 32, path, cap)",
      "  var found: Word = 0",
      "  if len > 0 and len < cap \{",
      "    var start = path",
      "    var q = path",
      "    let end = path + len",
      "    while found == 0 and q <= end \{",
      "      if q == end or peek8(q) == 59 \{",
      "        let n = q - start",
      "        if n > 0 \{",
      "          if has_byte(prog, 46) \{",
      "            found = win_candidate(start, n, prog, \"\")",
      "          \} else \{",
      "            found = win_candidate(start, n, prog, \".exe\")",
      "            if found == 0 \{",
      "              found = win_candidate(start, n, prog, \".com\")",
      "            \}",
      "            if found == 0 \{",
      "              found = win_candidate(start, n, prog, \".bat\")",
      "            \}",
      "            if found == 0 \{",
      "              found = win_candidate(start, n, prog, \".cmd\")",
      "            \}",
      "          \}",
      "        \}",
      "        start = q + 1",
      "      \}",
      "      q = q + 1",
      "    \}",
      "  \}",
      "  block_free(path)",
      "  return found",
      "\}",
      "",
      "// the Windows command line of args, the program replaced by its full path (0 when it is not found)",
      "fn win_command_line(args: Word) -> Word \{",
      "  let n = peek(args + 16)",
      "  let prog = win_find_program(list_at(args, 0))",
      "  if prog == 0 \{",
      "    return 0",
      "  \}",
      "  let b = sb_new()",
      "  add_win_arg(b, prog)",
      "  rc_dec(prog)",
      "  var j: Word = 1",
      "  while j < n \{",
      "    sb_add_byte(b, 32)",
      "    add_win_arg(b, list_at(args, j))",
      "    j = j + 1",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn find_program(prog: Word) -> Word \{",
      "  if has_byte(prog, 47) \{",
      "    if not os_file_exists(prog + 32) \{",
      "      return 0",
      "    \}",
      "    rc_inc(prog)",
      "    return prog",
      "  \}",
      "  let name = bits(\"PATH\")",
      "  var i = os_argc() + 1",
      "  var p = os_argv(i)",
      "  while p != 0 \{",
      "    if bytes_eq(p, name + 32, 4) and peek8(p + 4) == 61 \{",
      "      var start = p + 5",
      "      var q = start",
      "      var going = true",
      "      while going \{",
      "        let c = peek8(q)",
      "        if c == 58 or c == 0 \{",
      "          if q > start \{",
      "            let b = sb_new()",
      "            sb_add_bytes(b, start, q - start)",
      "            sb_add_byte(b, 47)",
      "            sb_add_str(b, prog)",
      "            let cand = sb_finish(b)",
      "            if os_file_exists(cand + 32) \{",
      "              return cand",
      "            \}",
      "            rc_dec(cand)",
      "          \}",
      "          if c == 0 \{",
      "            going = false",
      "          \}",
      "          start = q + 1",
      "        \}",
      "        q = q + 1",
      "      \}",
      "      return 0",
      "    \}",
      "    i = i + 1",
      "    p = os_argv(i)",
      "  \}",
      "  return 0",
      "\}",
      "",
      "// Windows: one argument of a command line, quoted when it is empty or has spaces, tabs or quotes",
      "fn add_win_arg(b: Word, s: Word) \{",
      "  let n = peek(s + 16)",
      "  let quote = n == 0 or has_byte(s, 32) or has_byte(s, 9) or has_byte(s, 34)",
      "  if not quote \{",
      "    sb_add_str(b, s)",
      "    return",
      "  \}",
      "  sb_add_byte(b, 34)",
      "  var i: Word = 0",
      "  var slashes: Word = 0",
      "  while i < n \{",
      "    let c = peek8(s + 32 + i)",
      "    if c == 92 \{",
      "      slashes = slashes + 1",
      "    \} else \{",
      "      if c == 34 \{",
      "        var k: Word = 0",
      "        while k < slashes + 1 \{",
      "          sb_add_byte(b, 92)",
      "          k = k + 1",
      "        \}",
      "      \}",
      "      slashes = 0",
      "    \}",
      "    sb_add_byte(b, c)",
      "    i = i + 1",
      "  \}",
      "  var k2: Word = 0",
      "  while k2 < slashes \{",
      "    sb_add_byte(b, 92)",
      "    k2 = k2 + 1",
      "  \}",
      "  sb_add_byte(b, 34)",
      "\}",
      "",
      "fn real_run_command(args: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_proc(\"run_command\", args, sp)",
      "  let n = peek(args + 16)",
      "  if n == 0 \{",
      "    return err_new(rtd, bits(\"run_command: no program given\"))",
      "  \}",
      "  flush_out()",
      "  let prog = list_at(args, 0)",
      "  if os_platform() != 1 \{",
      "    let path = find_program(prog)",
      "    if path == 0 \{",
      "      return spawn_error(prog, -2, rtd)",
      "    \}",
      "    let argv = alloc(8 * (n + 1))",
      "    poke(argv, path + 32)",
      "    var i: Word = 1",
      "    while i < n \{",
      "      poke(argv + 8 * i, list_at(args, i) + 32)",
      "      i = i + 1",
      "    \}",
      "    poke(argv + 8 * n, 0)",
      "    let st = os_spawn(argv)",
      "    block_free(argv)",
      "    rc_dec(path)",
      "    if st < 0 \{",
      "      return spawn_error(prog, st, rtd)",
      "    \}",
      "    var code = w_and(w_shr(st, 8), 255)",
      "    if w_and(st, 127) != 0 \{",
      "      code = 128 + w_and(st, 127)",
      "    \}",
      "    return ok_new(rtd, bits(tag(code)))",
      "  \}",
      "  let cl = win_command_line(args)",
      "  if cl == 0 \{",
      "    return spawn_error(prog, -2, rtd)",
      "  \}",
      "  let r = os_spawn(cl + 32)",
      "  rc_dec(cl)",
      "  if r < 0 \{",
      "    return spawn_error(prog, -2, rtd)",
      "  \}",
      "  return ok_new(rtd, bits(tag(r)))",
      "\}",
      "",
      "fn real_set_executable(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"set_executable\", path, sp)",
      "  if fake_on() \{",
      "    return fake_set_executable(path, rtd)",
      "  \}",
      "  if os_platform() == 1 \{",
      "    return ok_new(rtd, 0)",
      "  \}",
      "  let r = os_chmod(path + 32, 493)",
      "  if r < 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"cannot change '\")",
      "    sb_add_str(b, path)",
      "    sb_add_cstr(b, \"': \")",
      "    io_error_text(b, r)",
      "    return err_new(rtd, sb_finish(b))",
      "  \}",
      "  return ok_new(rtd, 0)",
      "\}",
      "",
      "// ---------------------------------------------------------------------------",
      "// directories",
      "// ---------------------------------------------------------------------------",
      "fn real_is_dir(path: Word, sp: Word) -> Bool \{",
      "  sb_need_fs(\"is_dir\", path, sp)",
      "  if fake_on() \{",
      "    return fake_is_dir(path)",
      "  \}",
      "  return os_is_dir(path + 32)",
      "\}",
      "",
      "fn list_dir_error(path: Word, code: Word, rtd: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"cannot list '\")",
      "  sb_add_str(b, path)",
      "  sb_add_cstr(b, \"': \")",
      "  io_error_text(b, code)",
      "  return err_new(rtd, sb_finish(b))",
      "\}",
      "",
      "// adds the entry name at p (a C string) unless it is \".\" or \"..\"",
      "fn add_entry(names: Word, p: Word) -> Word \{",
      "  let n = cstr_len(p)",
      "  if peek8(p) == 46 and (n == 1 or (n == 2 and peek8(p + 1) == 46)) \{",
      "    return names",
      "  \}",
      "  return list_push_owned_raw(names, str_from(p, n))",
      "\}",
      "",
      "fn real_list_dir(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"list_dir\", path, sp)",
      "  if fake_on() \{",
      "    return fake_list_dir(path, rtd)",
      "  \}",
      "  var names = list_new_str()",
      "  if os_platform() == 1 \{",
      "    let b = sb_new()",
      "    sb_add_str(b, path)",
      "    sb_add_cstr(b, \"\\\\*\")",
      "    let pattern = sb_finish(b)",
      "    let data = alloc(320)",
      "    let h = os_find_first(pattern + 32, data)",
      "    rc_dec(pattern)",
      "    if h == -1 \{",
      "      block_free(data)",
      "      rc_dec(names)",
      "      return list_dir_error(path, -2, rtd)",
      "    \}",
      "    var more = true",
      "    while more \{",
      "      names = add_entry(names, data + 44)",
      "      more = os_find_next(h, data) != 0",
      "    \}",
      "    os_find_close(h)",
      "    block_free(data)",
      "  \} else \{",
      "    let fd = os_open(path + 32, 0)",
      "    if fd < 0 \{",
      "      rc_dec(names)",
      "      return list_dir_error(path, fd, rtd)",
      "    \}",
      "    let buf = alloc(32768)",
      "    var name_at: Word = 19",
      "    if os_platform() == 2 \{",
      "      name_at = 21",
      "    \}",
      "    var failed: Word = 0",
      "    var reading = true",
      "    while reading \{",
      "      let n = os_getdents(fd, buf, 32768)",
      "      if n <= 0 \{",
      "        failed = n",
      "        reading = false",
      "      \} else \{",
      "        // struct linux_dirent64: ino, off, reclen (16 bits), type (8 bits), name; macOS adds namlen (16 bits)",
      "        var off: Word = 0",
      "        while off < n \{",
      "          names = add_entry(names, buf + off + name_at)",
      "          off = off + w_and(peek32(buf + off + 16), 65535)",
      "        \}",
      "      \}",
      "    \}",
      "    os_close(fd)",
      "    block_free(buf)",
      "    if failed < 0 \{",
      "      rc_dec(names)",
      "      return list_dir_error(path, failed, rtd)",
      "    \}",
      "  \}",
      "  let sorted = List_sort(names, 0)",
      "  rc_dec(names)",
      "  return ok_new(rtd, sorted)",
      "\}",
      "",
      "// make_dir(path): creates the directory and the missing ones above it (like Python's os.makedirs(exist_ok=True))",
      "fn real_make_dir(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"make_dir\", path, sp)",
      "  if fake_on() \{",
      "    return fake_make_dir(path, rtd)",
      "  \}",
      "  let n = peek(path + 16)",
      "  let buf = alloc(n + 1)",
      "  copy_bytes(buf, path + 32, n)",
      "  var last: Word = 0",
      "  var i: Word = 1",
      "  while i <= n \{",
      "    let c = peek8(path + 32 + i)",
      "    if i == n or c == 47 or c == 92 \{",
      "      poke8(buf + i, 0)",
      "      if not os_is_dir(buf) \{",
      "        last = os_mkdir(buf)",
      "      \}",
      "      poke8(buf + i, c)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  poke8(buf + n, 0)",
      "  let ok = os_is_dir(buf)",
      "  block_free(buf)",
      "  if ok \{",
      "    return ok_new(rtd, 0)",
      "  \}",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"cannot create '\")",
      "  sb_add_str(b, path)",
      "  sb_add_cstr(b, \"': \")",
      "  if last == 0 or last == -1 \{",
      "    last = -17",
      "  \}",
      "  io_error_text(b, last)",
      "  return err_new(rtd, sb_finish(b))",
      "\}",
      "",
      "// current_dir(): the working directory",
      "fn real_current_dir(sp: Word) -> Word \{",
      "  sb_need_any_fs(\"current_dir\", sp)",
      "  if fake_on() \{",
      "    return str_from(bits(\"/\") + 32, 1)",
      "  \}",
      "  return raw_cwd()",
      "\}",
      "",
      "// the working directory (absolute)",
      "fn raw_cwd() -> Word \{",
      "  let buf = alloc(4096)",
      "  let r = os_getcwd(buf, 4096)",
      "  var n: Word = 0",
      "  if r > 0 \{",
      "    n = r",
      "    if os_platform() == 0 \{",
      "      n = r - 1",
      "    \}",
      "  \}",
      "  let s = str_from(buf, n)",
      "  block_free(buf)",
      "  return s",
      "\}",
      "",
      "// remove_file(path): deletes a file",
      "fn real_remove_file(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_fs(\"remove_file\", path, sp)",
      "  if fake_on() \{",
      "    return fake_remove_file(path, rtd)",
      "  \}",
      "  let r = os_unlink(path + 32)",
      "  if r >= 0 \{",
      "    return ok_new(rtd, 0)",
      "  \}",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"cannot remove '\")",
      "  sb_add_str(b, path)",
      "  sb_add_cstr(b, \"': \")",
      "  io_error_text(b, r)",
      "  return err_new(rtd, sb_finish(b))",
      "\}",
      "",
      "// Windows: a temporary file name `%TEMP%\\klar-<time>-<what>`",
      "fn win_temp(stamp: Word, what: Str) -> Word \{",
      "  let b = sb_new()",
      "  let buf = alloc(4096)",
      "  let len = os_getenv(bits(\"TEMP\") + 32, buf, 4096)",
      "  if len > 0 and len < 4096 \{",
      "    sb_add_bytes(b, buf, len)",
      "    sb_add_byte(b, 92)",
      "  \}",
      "  block_free(buf)",
      "  sb_add_cstr(b, \"klar-\")",
      "  sb_add_word(b, stamp)",
      "  sb_add_byte(b, 45)",
      "  sb_add_cstr(b, what)",
      "  return sb_finish(b)",
      "\}",
      "",
      "// the whole content of a file as a string (\"\" when it cannot be read)",
      "fn slurp(path: Word) -> Word \{",
      "  let b = sb_new()",
      "  let fd = os_open(path + 32, 0)",
      "  if fd >= 0 \{",
      "    let chunk = alloc(65536)",
      "    var reading = true",
      "    while reading \{",
      "      let n = os_read(fd, chunk, 65536)",
      "      if n <= 0 \{",
      "        reading = false",
      "      \} else \{",
      "        sb_add_bytes(b, chunk, n)",
      "      \}",
      "    \}",
      "    block_free(chunk)",
      "    os_close(fd)",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "// run_capture on Windows: the input, stdout and stderr go through temporary files (no deadlock without poll); the",
      "// program is found in PATH by CreateProcessA, like run_command",
      "fn run_capture_win(args: Word, dir: Word, input: Word, rtd: Word) -> Word \{",
      "  flush_out()",
      "  let prog = list_at(args, 0)",
      "  let cl = win_command_line(args)",
      "  if cl == 0 \{",
      "    return spawn_error(prog, -2, rtd)",
      "  \}",
      "  let stamp = os_time_ns()",
      "  let p_in = win_temp(stamp, \"in\")",
      "  let p_out = win_temp(stamp, \"out\")",
      "  let p_err = win_temp(stamp, \"err\")",
      "  let w = os_open(p_in + 32, 1)",
      "  if w >= 0 \{",
      "    if peek(input + 16) > 0 \{",
      "      os_write(w, input + 32, peek(input + 16))",
      "    \}",
      "    os_close(w)",
      "  \}",
      "  let hin = os_open(p_in + 32, 0)",
      "  let hout = os_open(p_out + 32, 1)",
      "  let herr = os_open(p_err + 32, 1)",
      "  var dirp: Word = 0",
      "  if peek(dir + 16) > 0 \{",
      "    dirp = dir + 32",
      "  \}",
      "  let code = os_spawn_std(cl + 32, dirp, hin, hout, herr)",
      "  os_close(hin)",
      "  os_close(hout)",
      "  os_close(herr)",
      "  rc_dec(cl)",
      "  let out = slurp(p_out)",
      "  let err = slurp(p_err)",
      "  os_unlink(p_in + 32)",
      "  os_unlink(p_out + 32)",
      "  os_unlink(p_err + 32)",
      "  rc_dec(p_in)",
      "  rc_dec(p_out)",
      "  rc_dec(p_err)",
      "  if code < 0 \{",
      "    rc_dec(out)",
      "    rc_dec(err)",
      "    return spawn_error(prog, -2, rtd)",
      "  \}",
      "  let cs = sb_new()",
      "  sb_add_word(cs, code)",
      "  var res = list_new_str()",
      "  res = list_push_owned_raw(res, sb_finish(cs))",
      "  res = list_push_owned_raw(res, out)",
      "  res = list_push_owned_raw(res, err)",
      "  return ok_new(rtd, res)",
      "\}",
      "",
      "// run_capture(args, dir, input): runs a program (searched in PATH) in `dir` (\"\" = here) with `input` as its stdin",
      "// and returns [exit code, stdout, stderr]; both streams are read together (poll), so neither can fill up and block",
      "// the child. The input goes into the pipe before the child starts (so at most one pipe buffer: 64 KB).",
      "fn real_run_capture(args: Word, dir: Word, input: Word, rtd: Word, sp: Word) -> Word \{",
      "  sb_need_proc(\"run_capture\", args, sp)",
      "  let n = peek(args + 16)",
      "  if n == 0 \{",
      "    return err_new(rtd, bits(\"run_capture: no program given\"))",
      "  \}",
      "  if peek(input + 16) > 65536 \{",
      "    return err_new(rtd, bits(\"run_capture: the input is limited to 64 KB\"))",
      "  \}",
      "  if os_platform() == 1 \{",
      "    return run_capture_win(args, dir, input, rtd)",
      "  \}",
      "  flush_out()",
      "  let prog = list_at(args, 0)",
      "  let path = find_program(prog)",
      "  if path == 0 \{",
      "    return spawn_error(prog, -2, rtd)",
      "  \}",
      "  let argv = alloc(8 * (n + 1))",
      "  poke(argv, path + 32)",
      "  var i: Word = 1",
      "  while i < n \{",
      "    poke(argv + 8 * i, list_at(args, i) + 32)",
      "    i = i + 1",
      "  \}",
      "  poke(argv + 8 * n, 0)",
      "  // the environment: the strings after argv's terminating null",
      "  var ne: Word = 0",
      "  while os_argv(os_argc() + 1 + ne) != 0 \{",
      "    ne = ne + 1",
      "  \}",
      "  let envp = alloc(8 * (ne + 1))",
      "  var e: Word = 0",
      "  while e <= ne \{",
      "    poke(envp + 8 * e, os_argv(os_argc() + 1 + e))",
      "    e = e + 1",
      "  \}",
      "  let fds = alloc(24)",
      "  os_pipe(fds)",
      "  os_pipe(fds + 8)",
      "  os_pipe(fds + 16)",
      "  if peek(input + 16) > 0 \{",
      "    os_write(peek32(fds + 20), input + 32, peek(input + 16))",
      "  \}",
      "  os_close(peek32(fds + 20))",
      "  let pid = os_fork()",
      "  if pid == 0 \{",
      "    os_dup2(peek32(fds + 16), 0)",
      "    os_dup2(peek32(fds + 4), 1)",
      "    os_dup2(peek32(fds + 12), 2)",
      "    os_close(peek32(fds))",
      "    os_close(peek32(fds + 4))",
      "    os_close(peek32(fds + 8))",
      "    os_close(peek32(fds + 12))",
      "    os_close(peek32(fds + 16))",
      "    if peek(dir + 16) > 0 and os_chdir(dir + 32) < 0 \{",
      "      os_exit(127)",
      "    \}",
      "    os_execve(path + 32, argv, envp)",
      "    os_exit(127)",
      "  \}",
      "  os_close(peek32(fds + 4))",
      "  os_close(peek32(fds + 12))",
      "  os_close(peek32(fds + 16))",
      "  let out = sb_new()",
      "  let err = sb_new()",
      "  let buf = alloc(65536)",
      "  let pfd = alloc(16)",
      "  var fd_out = peek32(fds)",
      "  var fd_err = peek32(fds + 8)",
      "  while fd_out >= 0 or fd_err >= 0 \{",
      "    poke32(pfd, fd_out)",
      "    poke32(pfd + 4, 1)",
      "    poke32(pfd + 8, fd_err)",
      "    poke32(pfd + 12, 1)",
      "    os_poll(pfd, 2)",
      "    if fd_out >= 0 and w_and(w_shr(peek32(pfd + 4), 16), 65535) != 0 \{",
      "      let r = os_read(fd_out, buf, 65536)",
      "      if r <= 0 \{",
      "        os_close(fd_out)",
      "        fd_out = -1",
      "      \} else \{",
      "        sb_add_bytes(out, buf, r)",
      "      \}",
      "    \}",
      "    if fd_err >= 0 and w_and(w_shr(peek32(pfd + 12), 16), 65535) != 0 \{",
      "      let r = os_read(fd_err, buf, 65536)",
      "      if r <= 0 \{",
      "        os_close(fd_err)",
      "        fd_err = -1",
      "      \} else \{",
      "        sb_add_bytes(err, buf, r)",
      "      \}",
      "    \}",
      "  \}",
      "  block_free(buf)",
      "  block_free(pfd)",
      "  block_free(fds)",
      "  block_free(argv)",
      "  block_free(envp)",
      "  rc_dec(path)",
      "  let st = os_wait(pid)",
      "  var code = w_and(w_shr(st, 8), 255)",
      "  if w_and(st, 127) != 0 \{",
      "    code = 128 + w_and(st, 127)",
      "  \}",
      "  let cs = sb_new()",
      "  sb_add_word(cs, code)",
      "  var res = list_new_str()",
      "  res = list_push_owned_raw(res, sb_finish(cs))",
      "  res = list_push_owned_raw(res, sb_finish(out))",
      "  res = list_push_owned_raw(res, sb_finish(err))",
      "  return ok_new(rtd, res)",
      "\}",
      "",
    ],
    "rt/int.klar" => [
      "// Klar runtime: arbitrary-precision Int (slow paths; the compiler inlines 63-bit fast paths).",
      "// Int word: odd = small ((v << 1) | 1); even = pointer to a bignum",
      "// bignum: [rc][td_Big][sign -1|1][n][limbs base 2^30, least significant first]",
      "",
      "const LIMB_MASK: Word = 1073741823",
      "const LIMB_BASE: Word = 1073741824",
      "",
      "fn big_alloc(n: Word) -> Word \{",
      "  let b = obj_new(32 + n * 8, static_addr(\"td_Big\"))",
      "  poke(b + 16, 1)",
      "  poke(b + 24, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(b + 32 + i * 8, 0)",
      "    i = i + 1",
      "  \}",
      "  return b",
      "\}",
      "",
      "fn limb(b: Word, i: Word) -> Word \{",
      "  return peek(b + 32 + i * 8)",
      "\}",
      "",
      "fn set_limb(b: Word, i: Word, v: Word) \{",
      "  poke(b + 32 + i * 8, v)",
      "\}",
      "",
      "fn nlimbs(b: Word) -> Word \{",
      "  return peek(b + 24)",
      "\}",
      "",
      "fn big_trim(b: Word) \{",
      "  var n = peek(b + 24)",
      "  while n > 0 and limb(b, n - 1) == 0 \{",
      "    n = n - 1",
      "  \}",
      "  poke(b + 24, n)",
      "\}",
      "",
      "// a new reference to a bignum holding the value of Int word x",
      "fn to_big(x: Word) -> Word \{",
      "  if w_and(x, 1) == 0 \{",
      "    rc_inc(x)",
      "    return x",
      "  \}",
      "  let v = w_sar(x, 1)",
      "  var mag = v",
      "  let b = big_alloc(3)",
      "  if v < 0 \{",
      "    poke(b + 16, -1)",
      "    mag = 0 - v",
      "  \}",
      "  set_limb(b, 0, w_and(mag, LIMB_MASK))",
      "  set_limb(b, 1, w_and(w_shr(mag, 30), LIMB_MASK))",
      "  set_limb(b, 2, w_shr(mag, 60))",
      "  big_trim(b)",
      "  return b",
      "\}",
      "",
      "// owned bignum -> canonical Int word (small when it fits in 61 bits)",
      "fn normalize(b: Word) -> Word \{",
      "  big_trim(b)",
      "  let n = nlimbs(b)",
      "  if n == 0 \{",
      "    rc_dec(b)",
      "    return 1",
      "  \}",
      "  if n <= 3 \{",
      "    var top: Word = 0",
      "    if n == 3 \{",
      "      top = limb(b, 2)",
      "    \}",
      "    if top < 2 \{",
      "      var v = limb(b, 0)",
      "      if n >= 2 \{",
      "        v = v + w_shl(limb(b, 1), 30)",
      "      \}",
      "      if n == 3 \{",
      "        v = v + w_shl(top, 60)",
      "      \}",
      "      if peek(b + 16) < 0 \{",
      "        v = 0 - v",
      "      \}",
      "      rc_dec(b)",
      "      return w_or(w_shl(v, 1), 1)",
      "    \}",
      "  \}",
      "  return b",
      "\}",
      "",
      "fn mag_cmp(a: Word, b: Word) -> Word \{",
      "  let na = nlimbs(a)",
      "  let nb = nlimbs(b)",
      "  if na != nb \{",
      "    if na < nb \{",
      "      return -1",
      "    \}",
      "    return 1",
      "  \}",
      "  var i = na - 1",
      "  while i >= 0 \{",
      "    let x = limb(a, i)",
      "    let y = limb(b, i)",
      "    if x != y \{",
      "      if x < y \{",
      "        return -1",
      "      \}",
      "      return 1",
      "    \}",
      "    i = i - 1",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn mag_add(a: Word, b: Word) -> Word \{",
      "  let na = nlimbs(a)",
      "  let nb = nlimbs(b)",
      "  var n = na",
      "  if nb > n \{",
      "    n = nb",
      "  \}",
      "  let r = big_alloc(n + 1)",
      "  var carry: Word = 0",
      "  var i: Word = 0",
      "  while i < n \{",
      "    var t = carry",
      "    if i < na \{",
      "      t = t + limb(a, i)",
      "    \}",
      "    if i < nb \{",
      "      t = t + limb(b, i)",
      "    \}",
      "    set_limb(r, i, w_and(t, LIMB_MASK))",
      "    carry = w_shr(t, 30)",
      "    i = i + 1",
      "  \}",
      "  set_limb(r, n, carry)",
      "  return r",
      "\}",
      "",
      "// |a| >= |b|",
      "fn mag_sub(a: Word, b: Word) -> Word \{",
      "  let na = nlimbs(a)",
      "  let nb = nlimbs(b)",
      "  let r = big_alloc(na)",
      "  var borrow: Word = 0",
      "  var i: Word = 0",
      "  while i < na \{",
      "    var t = limb(a, i) - borrow",
      "    if i < nb \{",
      "      t = t - limb(b, i)",
      "    \}",
      "    if t < 0 \{",
      "      t = t + LIMB_BASE",
      "      borrow = 1",
      "    \} else \{",
      "      borrow = 0",
      "    \}",
      "    set_limb(r, i, t)",
      "    i = i + 1",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn mag_mul(a: Word, b: Word) -> Word \{",
      "  let na = nlimbs(a)",
      "  let nb = nlimbs(b)",
      "  let r = big_alloc(na + nb + 1)",
      "  var i: Word = 0",
      "  while i < na \{",
      "    let x = limb(a, i)",
      "    var carry: Word = 0",
      "    var j: Word = 0",
      "    while j < nb \{",
      "      let t = limb(r, i + j) + x * limb(b, j) + carry",
      "      set_limb(r, i + j, w_and(t, LIMB_MASK))",
      "      carry = w_shr(t, 30)",
      "      j = j + 1",
      "    \}",
      "    var k = i + nb",
      "    while carry != 0 \{",
      "      let t2 = limb(r, k) + carry",
      "      set_limb(r, k, w_and(t2, LIMB_MASK))",
      "      carry = w_shr(t2, 30)",
      "      k = k + 1",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn bitlen30(x: Word) -> Word \{",
      "  var n: Word = 0",
      "  var v = x",
      "  while v != 0 \{",
      "    v = w_shr(v, 1)",
      "    n = n + 1",
      "  \}",
      "  return n",
      "\}",
      "",
      "// magnitude division (Knuth, algorithm D); quotient -> G_DIVQ, remainder -> G_DIVR (owned bignums)",
      "fn mag_divmod(a: Word, b: Word) \{",
      "  let gp = g()",
      "  let na = nlimbs(a)",
      "  let nb = nlimbs(b)",
      "  if mag_cmp(a, b) < 0 \{",
      "    poke(gp + G_DIVQ, big_alloc(0))",
      "    let r0 = big_alloc(na)",
      "    copy_words(r0 + 32, a + 32, na)",
      "    poke(gp + G_DIVR, r0)",
      "    return",
      "  \}",
      "  if nb == 1 \{",
      "    let d = limb(b, 0)",
      "    let q1 = big_alloc(na)",
      "    var rem: Word = 0",
      "    var i = na - 1",
      "    while i >= 0 \{",
      "      let cur = rem * LIMB_BASE + limb(a, i)",
      "      set_limb(q1, i, cur / d)",
      "      rem = cur % d",
      "      i = i - 1",
      "    \}",
      "    let r1 = big_alloc(1)",
      "    set_limb(r1, 0, rem)",
      "    poke(gp + G_DIVQ, q1)",
      "    poke(gp + G_DIVR, r1)",
      "    return",
      "  \}",
      "  let s = 30 - bitlen30(limb(b, nb - 1))",
      "  let vn = big_alloc(nb)",
      "  let un = big_alloc(na + 1)",
      "  var i2: Word = nb - 1",
      "  while i2 > 0 \{",
      "    set_limb(vn, i2, w_and(w_or(w_shl(limb(b, i2), s), w_shr(limb(b, i2 - 1), 30 - s)), LIMB_MASK))",
      "    i2 = i2 - 1",
      "  \}",
      "  set_limb(vn, 0, w_and(w_shl(limb(b, 0), s), LIMB_MASK))",
      "  set_limb(un, na, w_shr(limb(a, na - 1), 30 - s))",
      "  var i3: Word = na - 1",
      "  while i3 > 0 \{",
      "    set_limb(un, i3, w_and(w_or(w_shl(limb(a, i3), s), w_shr(limb(a, i3 - 1), 30 - s)), LIMB_MASK))",
      "    i3 = i3 - 1",
      "  \}",
      "  set_limb(un, 0, w_and(w_shl(limb(a, 0), s), LIMB_MASK))",
      "  if s == 0 \{",
      "    set_limb(un, na, 0)",
      "  \}",
      "  let q = big_alloc(na - nb + 1)",
      "  let vtop = limb(vn, nb - 1)",
      "  let vsec = limb(vn, nb - 2)",
      "  var j = na - nb",
      "  while j >= 0 \{",
      "    let num = limb(un, j + nb) * LIMB_BASE + limb(un, j + nb - 1)",
      "    var qhat = num / vtop",
      "    var rhat = num - qhat * vtop",
      "    var adjusting = true",
      "    while adjusting \{",
      "      if qhat >= LIMB_BASE or qhat * vsec > rhat * LIMB_BASE + limb(un, j + nb - 2) \{",
      "        qhat = qhat - 1",
      "        rhat = rhat + vtop",
      "        if rhat >= LIMB_BASE \{",
      "          adjusting = false",
      "        \}",
      "      \} else \{",
      "        adjusting = false",
      "      \}",
      "    \}",
      "    var k: Word = 0",
      "    var t: Word = 0",
      "    var m: Word = 0",
      "    while m < nb \{",
      "      let p = qhat * limb(vn, m)",
      "      t = limb(un, m + j) - k - w_and(p, LIMB_MASK)",
      "      set_limb(un, m + j, w_and(t, LIMB_MASK))",
      "      k = w_sar(p, 30) - w_sar(t, 30)",
      "      m = m + 1",
      "    \}",
      "    t = limb(un, j + nb) - k",
      "    set_limb(un, j + nb, t)",
      "    if t < 0 \{",
      "      qhat = qhat - 1",
      "      k = 0",
      "      var m2: Word = 0",
      "      while m2 < nb \{",
      "        let t3 = limb(un, m2 + j) + limb(vn, m2) + k",
      "        set_limb(un, m2 + j, w_and(t3, LIMB_MASK))",
      "        k = w_sar(t3, 30)",
      "        m2 = m2 + 1",
      "      \}",
      "      set_limb(un, j + nb, limb(un, j + nb) + k)",
      "    \}",
      "    set_limb(q, j, qhat)",
      "    j = j - 1",
      "  \}",
      "  let r = big_alloc(nb)",
      "  var i4: Word = 0",
      "  while i4 < nb \{",
      "    if s == 0 \{",
      "      set_limb(r, i4, limb(un, i4))",
      "    \} else \{",
      "      set_limb(r, i4, w_and(w_or(w_shr(limb(un, i4), s), w_shl(limb(un, i4 + 1), 30 - s)), LIMB_MASK))",
      "    \}",
      "    i4 = i4 + 1",
      "  \}",
      "  rc_dec(un)",
      "  rc_dec(vn)",
      "  poke(gp + G_DIVQ, q)",
      "  poke(gp + G_DIVR, r)",
      "\}",
      "",
      "fn big_sign(b: Word) -> Word \{",
      "  if nlimbs(b) == 0 \{",
      "    return 0",
      "  \}",
      "  return peek(b + 16)",
      "\}",
      "",
      "fn signed_add(a: Word, sa: Word, b: Word, sb: Word) -> Word \{",
      "  if sa == sb or nlimbs(b) == 0 \{",
      "    let r = mag_add(a, b)",
      "    poke(r + 16, sa)",
      "    return r",
      "  \}",
      "  if nlimbs(a) == 0 \{",
      "    let r2 = mag_add(a, b)",
      "    poke(r2 + 16, sb)",
      "    return r2",
      "  \}",
      "  let c = mag_cmp(a, b)",
      "  if c == 0 \{",
      "    return big_alloc(0)",
      "  \}",
      "  if c > 0 \{",
      "    let r3 = mag_sub(a, b)",
      "    poke(r3 + 16, sa)",
      "    return r3",
      "  \}",
      "  let r4 = mag_sub(b, a)",
      "  poke(r4 + 16, sb)",
      "  return r4",
      "\}",
      "",
      "fn int_add(x: Word, y: Word) -> Word \{",
      "  let a = to_big(x)",
      "  let b = to_big(y)",
      "  let r = signed_add(a, peek(a + 16), b, peek(b + 16))",
      "  rc_dec(a)",
      "  rc_dec(b)",
      "  return normalize(r)",
      "\}",
      "",
      "fn int_sub(x: Word, y: Word) -> Word \{",
      "  let a = to_big(x)",
      "  let b = to_big(y)",
      "  let r = signed_add(a, peek(a + 16), b, 0 - peek(b + 16))",
      "  rc_dec(a)",
      "  rc_dec(b)",
      "  return normalize(r)",
      "\}",
      "",
      "fn int_mul(x: Word, y: Word) -> Word \{",
      "  let a = to_big(x)",
      "  let b = to_big(y)",
      "  let r = mag_mul(a, b)",
      "  poke(r + 16, peek(a + 16) * peek(b + 16))",
      "  rc_dec(a)",
      "  rc_dec(b)",
      "  return normalize(r)",
      "\}",
      "",
      "fn int_divmod(x: Word, y: Word) \{",
      "  let a = to_big(x)",
      "  let b = to_big(y)",
      "  mag_divmod(a, b)",
      "  let gp = g()",
      "  poke(peek(gp + G_DIVQ) + 16, peek(a + 16) * peek(b + 16))",
      "  poke(peek(gp + G_DIVR) + 16, peek(a + 16))",
      "  rc_dec(a)",
      "  rc_dec(b)",
      "\}",
      "",
      "fn int_div(x: Word, y: Word) -> Word \{",
      "  int_divmod(x, y)",
      "  let gp = g()",
      "  rc_dec(peek(gp + G_DIVR))",
      "  return normalize(peek(gp + G_DIVQ))",
      "\}",
      "",
      "fn int_mod(x: Word, y: Word) -> Word \{",
      "  int_divmod(x, y)",
      "  let gp = g()",
      "  rc_dec(peek(gp + G_DIVQ))",
      "  return normalize(peek(gp + G_DIVR))",
      "\}",
      "",
      "fn int_neg(x: Word) -> Word \{",
      "  let a = to_big(x)",
      "  let r = big_alloc(nlimbs(a))",
      "  copy_words(r + 32, a + 32, nlimbs(a))",
      "  poke(r + 16, 0 - peek(a + 16))",
      "  rc_dec(a)",
      "  return normalize(r)",
      "\}",
      "",
      "// raw -1 / 0 / 1",
      "fn int_cmp(x: Word, y: Word) -> Word \{",
      "  if w_and(w_and(x, y), 1) == 1 \{",
      "    if x < y \{",
      "      return -1",
      "    \}",
      "    if x > y \{",
      "      return 1",
      "    \}",
      "    return 0",
      "  \}",
      "  let a = to_big(x)",
      "  let b = to_big(y)",
      "  let sa = big_sign(a)",
      "  let sb = big_sign(b)",
      "  var r: Word = 0",
      "  if sa != sb \{",
      "    if sa < sb \{",
      "      r = -1",
      "    \} else \{",
      "      r = 1",
      "    \}",
      "  \} else \{",
      "    r = mag_cmp(a, b) * sa",
      "  \}",
      "  rc_dec(a)",
      "  rc_dec(b)",
      "  return r",
      "\}",
      "",
      "fn int_eq(x: Word, y: Word) -> Bool \{",
      "  return int_cmp(x, y) == 0",
      "\}",
      "",
      "// decimal text of an Int word",
      "fn int_show(sb: Word, x: Word) \{",
      "  if w_and(x, 1) == 1 \{",
      "    sb_add_word(sb, w_sar(x, 1))",
      "    return",
      "  \}",
      "  if peek(x + 16) < 0 \{",
      "    sb_add_byte(sb, 45)",
      "  \}",
      "  let n = nlimbs(x)",
      "  let work = big_alloc(n)",
      "  copy_words(work + 32, x + 32, n)",
      "  let chunks = alloc(8 * (n * 30 / 29 + 2))",
      "  var nc: Word = 0",
      "  var len = n",
      "  while len > 0 \{",
      "    var rem: Word = 0",
      "    var i = len - 1",
      "    while i >= 0 \{",
      "      let cur = rem * LIMB_BASE + limb(work, i)",
      "      set_limb(work, i, cur / 1000000000)",
      "      rem = cur % 1000000000",
      "      i = i - 1",
      "    \}",
      "    poke(chunks + nc * 8, rem)",
      "    nc = nc + 1",
      "    while len > 0 and limb(work, len - 1) == 0 \{",
      "      len = len - 1",
      "    \}",
      "  \}",
      "  nc = nc - 1",
      "  sb_add_word(sb, peek(chunks + nc * 8))",
      "  while nc > 0 \{",
      "    nc = nc - 1",
      "    let c = peek(chunks + nc * 8)",
      "    var p: Word = 100000000",
      "    while p > 0 \{",
      "      sb_add_byte(sb, 48 + (c / p) % 10)",
      "      p = p / 10",
      "    \}",
      "  \}",
      "  block_free(chunks)",
      "  rc_dec(work)",
      "\}",
      "",
      "fn int_hash(x: Word) -> Word \{",
      "  if w_and(x, 1) == 1 \{",
      "    return x",
      "  \}",
      "  var h: Word = 1469598103934665603",
      "  var i: Word = 0",
      "  while i < nlimbs(x) \{",
      "    h = w_xor(h, limb(x, i)) * 1099511628211",
      "    i = i + 1",
      "  \}",
      "  return h",
      "\}",
      "",
      "// number of bits of |x|",
      "fn int_bitlen(x: Int) -> Int \{",
      "  let w = bits(x)",
      "  if w_and(w, 1) == 1 \{",
      "    var v = w_sar(w, 1)",
      "    if v < 0 \{",
      "      v = 0 - v",
      "    \}",
      "    var n: Word = 0",
      "    while v != 0 \{",
      "      v = w_shr(v, 1)",
      "      n = n + 1",
      "    \}",
      "    return tag(n)",
      "  \}",
      "  let nl = nlimbs(w)",
      "  return tag((nl - 1) * 30 + bitlen30(limb(w, nl - 1)))",
      "\}",
      "",
      "fn int_parse_dec(s: Word) -> Int \{",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  var neg = false",
      "  if n > 0 and (peek8(s + 32) == 45 or peek8(s + 32) == 43) \{",
      "    neg = peek8(s + 32) == 45",
      "    i = 1",
      "  \}",
      "  var acc: Int = 0",
      "  while i < n \{",
      "    let c = peek8(s + 32 + i)",
      "    if c >= 48 and c <= 57 \{",
      "      acc = acc * 10 + tag(c - 48)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  if neg \{",
      "    return 0 - acc",
      "  \}",
      "  return acc",
      "\}",
      "",
      "fn pow_int(base: Int, e: Int) -> Int \{",
      "  var result: Int = 1",
      "  var b = base",
      "  var k = e",
      "  while k > 0 \{",
      "    if k % 2 == 1 \{",
      "      result = result * b",
      "    \}",
      "    k = k / 2",
      "    if k > 0 \{",
      "      b = b * b",
      "    \}",
      "  \}",
      "  return result",
      "\}",
      "",
      "fn pow2(e: Int) -> Int \{",
      "  return pow_int(2, e)",
      "\}",
      "",
      "fn pow10(e: Int) -> Int \{",
      "  return pow_int(10, e)",
      "\}",
      "",
      "// ---- bitwise operations (infinite two's complement, like the interpreter) ---------------------",
      "// two's complement of x in n limbs of 30 bits (sign-extended), in a fresh raw block",
      "fn tc_limbs(x: Word, n: Word) -> Word \{",
      "  let b = to_big(x)",
      "  let out = alloc(n * 8)",
      "  let neg = peek(b + 16) < 0",
      "  var borrow: Word = 0",
      "  if neg \{",
      "    borrow = 1",
      "  \}",
      "  var i: Word = 0",
      "  while i < n \{",
      "    var v: Word = 0",
      "    if i < nlimbs(b) \{",
      "      v = limb(b, i)",
      "    \}",
      "    if neg \{",
      "      v = v - borrow",
      "      if v < 0 \{",
      "        v = v + LIMB_BASE",
      "        borrow = 1",
      "      \} else \{",
      "        borrow = 0",
      "      \}",
      "      v = w_xor(v, LIMB_MASK)",
      "    \}",
      "    poke(out + i * 8, v)",
      "    i = i + 1",
      "  \}",
      "  rc_dec(b)",
      "  return out",
      "\}",
      "",
      "// Int from n two's complement limbs (consumes the block)",
      "fn from_tc(t: Word, n: Word) -> Word \{",
      "  let neg = w_and(peek(t + (n - 1) * 8), 536870912) != 0",
      "  let r = big_alloc(n)",
      "  var carry: Word = 1",
      "  var i: Word = 0",
      "  while i < n \{",
      "    var v = peek(t + i * 8)",
      "    if neg \{",
      "      v = w_xor(v, LIMB_MASK) + carry",
      "      carry = w_shr(v, 30)",
      "      v = w_and(v, LIMB_MASK)",
      "    \}",
      "    set_limb(r, i, v)",
      "    i = i + 1",
      "  \}",
      "  if neg \{",
      "    poke(r + 16, -1)",
      "  \}",
      "  block_free(t)",
      "  return normalize(r)",
      "\}",
      "",
      "// op: 0 = and, 1 = or, 2 = xor",
      "fn int_bitop(op: Word, x: Word, y: Word) -> Word \{",
      "  var n: Word = 3",
      "  if w_and(x, 1) == 0 and nlimbs(x) + 1 > n \{",
      "    n = nlimbs(x) + 1",
      "  \}",
      "  if w_and(y, 1) == 0 and nlimbs(y) + 1 > n \{",
      "    n = nlimbs(y) + 1",
      "  \}",
      "  let a = tc_limbs(x, n)",
      "  let b = tc_limbs(y, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let p = peek(a + i * 8)",
      "    let q = peek(b + i * 8)",
      "    if op == 0 \{",
      "      poke(a + i * 8, w_and(p, q))",
      "    \} else if op == 1 \{",
      "      poke(a + i * 8, w_or(p, q))",
      "    \} else \{",
      "      poke(a + i * 8, w_xor(p, q))",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  block_free(b)",
      "  return from_tc(a, n)",
      "\}",
      "",
      "fn Int_bit_and(x: Word, y: Word) -> Int \{",
      "  if w_and(w_and(x, y), 1) == 1 \{",
      "    return unbits(w_and(x, y))",
      "  \}",
      "  return unbits(int_bitop(0, x, y))",
      "\}",
      "",
      "fn Int_bit_or(x: Word, y: Word) -> Int \{",
      "  if w_and(w_and(x, y), 1) == 1 \{",
      "    return unbits(w_or(x, y))",
      "  \}",
      "  return unbits(int_bitop(1, x, y))",
      "\}",
      "",
      "fn Int_bit_xor(x: Word, y: Word) -> Int \{",
      "  if w_and(w_and(x, y), 1) == 1 \{",
      "    return unbits(w_or(w_xor(x, y), 1))",
      "  \}",
      "  return unbits(int_bitop(2, x, y))",
      "\}",
      "",
      "fn Int_bit_not(x: Int) -> Int \{",
      "  return 0 - x - 1",
      "\}",
      "",
      "fn shift_amount(n: Int, what: Str, sp: Word) -> Int \{",
      "  if n < 0 or n > 1048576 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"Int.\")",
      "    sb_add_cstr(b, what)",
      "    sb_add_cstr(b, \": shift must be between 0 and 1048576, got \")",
      "    int_show(b, bits(n))",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  return n",
      "\}",
      "",
      "fn Int_shift_left(x: Int, n: Int, sp: Word) -> Int \{",
      "  return x * pow2(shift_amount(n, \"shift_left\", sp))",
      "\}",
      "",
      "fn Int_shift_right(x: Int, n: Int, sp: Word) -> Int \{",
      "  let p = pow2(shift_amount(n, \"shift_right\", sp))",
      "  let q = x / p",
      "  if x < 0 and q * p != x \{",
      "    return q - 1",
      "  \}",
      "  return q",
      "\}",
      "",
      "fn Int_to_char(x: Int, rtd: Word) -> Word \{",
      "  if not is_small(x) \{",
      "    return none()",
      "  \}",
      "  let c = untag(x)",
      "  if c < 0 or c > 1114111 or (c >= 55296 and c <= 57343) \{",
      "    return none()",
      "  \}",
      "  let b = sb_new()",
      "  sb_add_cp(b, c)",
      "  let s = sb_finish(b)",
      "  poke(s + 24, 1)",
      "  return some_new(rtd, s)",
      "\}",
      "",
    ],
    "rt/limit.klar" => [
      "// Klar runtime: the time limit of `--timeout N` (THREATS.md T9, as klar/interpreter.py TimeLimit). The build puts",
      "// `g_limit` into the executable: [seconds] (0: no limit — and then the program has no ticks at all). With a limit the",
      "// compiler calls `limit_tick` at the top of every `while` iteration and at the start of every function, with the",
      "// span of the loop or of the function's name; the clock is read once per 4096 ticks, and past the limit the program",
      "// stops with R0018 there, with the call stack. A test runs in a process of its own, so each test has the whole limit.",
      "",
      "const G_LIM_TICKS: Word = 1144",
      "const G_LIM_END: Word = 1152",
      "const LIM_EVERY: Word = 4096",
      "",
      "fn limit_seconds() -> Word \{",
      "  return peek(static_addr(\"g_limit\"))",
      "\}",
      "",
      "fn limit_tick(sp: Word) -> Word \{",
      "  let gp = g()",
      "  let ticks = peek(gp + G_LIM_TICKS) + 1",
      "  poke(gp + G_LIM_TICKS, ticks)",
      "  if ticks % LIM_EVERY != 1 \{",
      "    return 0",
      "  \}",
      "  let now = os_wall_ns()",
      "  let end = peek(gp + G_LIM_END)",
      "  if end == 0 \{",
      "    // the first tick starts the clock",
      "    poke(gp + G_LIM_END, now + limit_seconds() * 1000000000)",
      "    return 0",
      "  \}",
      "  if now > end \{",
      "    time_limit_exceeded(sp)",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn time_limit_exceeded(sp: Word) \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"time limit exceeded: still running after \")",
      "  sb_add_word(b, limit_seconds())",
      "  sb_add_cstr(b, \" s\")",
      "  let h = sb_new()",
      "  sb_add_cstr(h, \"an endless loop or a slow algorithm: check the loop's condition or the recursion \")",
      "  sb_add_cstr(h, \"(or raise the limit with `--timeout N`)\")",
      "  fail_with(bits(\"R0018\"), sb_finish(b), sp, 0, sb_finish(h))",
      "\}",
      "",
    ],
    "rt/list.klar" => [
      "// Klar runtime: List[T] = [rc][td][len][cap][data] ; data = block of cap words.",
      "// Parameters are borrowed, results owned. `*_owned` functions consume their first argument",
      "// and update it in place when it is uniquely referenced (rc == 1).",
      "",
      "fn list_with_cap(td: Word, cap: Word) -> Word \{",
      "  let l = obj_new(40, td)",
      "  poke(l + 16, 0)",
      "  var c = cap",
      "  if c < 4 \{",
      "    c = 4",
      "  \}",
      "  poke(l + 24, c)",
      "  poke(l + 32, alloc(mem_size(c, 8)))",
      "  return l",
      "\}",
      "",
      "fn list_elem_td(l: Word) -> Word \{",
      "  return peek(peek(l + 8) + 16)",
      "\}",
      "",
      "fn list_data(l: Word) -> Word \{",
      "  return peek(l + 32)",
      "\}",
      "",
      "fn list_len_raw(l: Word) -> Word \{",
      "  return peek(l + 16)",
      "\}",
      "",
      "fn list_at(l: Word, i: Word) -> Word \{",
      "  return peek(peek(l + 32) + i * 8)",
      "\}",
      "",
      "// unique copy of l with room for `extra` more elements (elements retained)",
      "fn list_copy(l: Word, extra: Word) -> Word \{",
      "  let n = peek(l + 16)",
      "  let r = list_with_cap(peek(l + 8), n + extra)",
      "  copy_words(peek(r + 32), peek(l + 32), n)",
      "  let et = list_elem_td(l)",
      "  if is_rc_kind(et) \{",
      "    var i: Word = 0",
      "    while i < n \{",
      "      retain_v(list_at(l, i), et)",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  poke(r + 16, n)",
      "  return r",
      "\}",
      "",
      "fn list_grow(l: Word, need: Word) \{",
      "  let cap = peek(l + 24)",
      "  if need <= cap \{",
      "    return",
      "  \}",
      "  var nc = cap * 2",
      "  while nc < need \{",
      "    nc = nc * 2",
      "  \}",
      "  let nd = alloc(mem_size(nc, 8))",
      "  copy_words(nd, peek(l + 32), peek(l + 16))",
      "  block_free(peek(l + 32))",
      "  poke(l + 32, nd)",
      "  poke(l + 24, nc)",
      "\}",
      "",
      "// make l (owned) uniquely referenced: returns l itself or a fresh copy",
      "fn list_unique(l: Word, extra: Word) -> Word \{",
      "  if peek(l) == 1 \{",
      "    list_grow(l, peek(l + 16) + extra)",
      "    return l",
      "  \}",
      "  let c = list_copy(l, extra)",
      "  rc_dec(l)",
      "  return c",
      "\}",
      "",
      "// append an owned value to an owned list",
      "fn list_push_owned_raw(l: Word, v: Word) -> Word \{",
      "  let n0 = peek(l + 16)",
      "  if peek(l) == 1 and n0 < peek(l + 24) \{",
      "    poke(peek(l + 32) + n0 * 8, v)",
      "    poke(l + 16, n0 + 1)",
      "    return l",
      "  \}",
      "  let u = list_unique(l, 1)",
      "  let n = peek(u + 16)",
      "  list_grow(u, n + 1)",
      "  poke(peek(u + 32) + n * 8, v)",
      "  poke(u + 16, n + 1)",
      "  return u",
      "\}",
      "",
      "fn list_from_range(td: Word, lo: Word, hi: Word) -> Word \{",
      "  var n = hi - lo",
      "  if n < 0 \{",
      "    n = 0",
      "  \}",
      "  let l = list_with_cap(td, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(peek(l + 32) + i * 8, w_or(w_shl(lo + i, 1), 1))",
      "    i = i + 1",
      "  \}",
      "  poke(l + 16, n)",
      "  return l",
      "\}",
      "",
      "// ---- List methods --------------------------------------------------------------------",
      "fn index_or_fail(i: Int, n: Word, what: Str, sp: Word, upper_inclusive: Bool) -> Word \{",
      "  var ok = is_small(i)",
      "  var k: Word = 0",
      "  if ok \{",
      "    k = untag(i)",
      "    if upper_inclusive \{",
      "      ok = k >= 0 and k <= n",
      "    \} else \{",
      "      ok = k >= 0 and k < n",
      "    \}",
      "  \}",
      "  if not ok \{",
      "    let b = sb_new()",
      "    sb_add_str(b, bits(what))",
      "    sb_add_cstr(b, \": index \")",
      "    int_show(b, bits(i))",
      "    sb_add_cstr(b, \" out of bounds for length \")",
      "    sb_add_word(b, n)",
      "    fail_simple(\"R0011\", sb_finish(b), sp)",
      "  \}",
      "  return k",
      "\}",
      "",
      "fn List_len(xs: Word) -> Int \{",
      "  return tag(peek(xs + 16))",
      "\}",
      "",
      "fn List_is_empty(xs: Word) -> Bool \{",
      "  return peek(xs + 16) == 0",
      "\}",
      "",
      "fn some_elem(xs: Word, k: Word, rtd: Word) -> Word \{",
      "  let v = list_at(xs, k)",
      "  retain_v(v, list_elem_td(xs))",
      "  return some_new(rtd, v)",
      "\}",
      "",
      "fn List_get(xs: Word, i: Int, rtd: Word) -> Word \{",
      "  if not is_small(i) \{",
      "    return none()",
      "  \}",
      "  let k = untag(i)",
      "  if k < 0 or k >= peek(xs + 16) \{",
      "    return none()",
      "  \}",
      "  return some_elem(xs, k, rtd)",
      "\}",
      "",
      "// `match xs.get(i)` without the Option (klar/native/lower.py `option_slot`): the slot of element `i` (-1: there is",
      "// none), and the element in a slot, retained",
      "fn list_slot(xs: Word, i: Int) -> Word \{",
      "  if not is_small(i) \{",
      "    return -1",
      "  \}",
      "  let k = untag(i)",
      "  if k < 0 or k >= peek(xs + 16) \{",
      "    return -1",
      "  \}",
      "  return k",
      "\}",
      "",
      "fn list_take(xs: Word, k: Word) -> Word \{",
      "  let v = list_at(xs, k)",
      "  retain_v(v, list_elem_td(xs))",
      "  return v",
      "\}",
      "",
      "fn List_get_or(xs: Word, i: Int, d: Word, td_T: Word) -> Word \{",
      "  if is_small(i) \{",
      "    let k = untag(i)",
      "    if k >= 0 and k < peek(xs + 16) \{",
      "      let v = list_at(xs, k)",
      "      retain_v(v, td_T)",
      "      return v",
      "    \}",
      "  \}",
      "  retain_v(d, td_T)",
      "  return d",
      "\}",
      "",
      "fn List_first(xs: Word, rtd: Word) -> Word \{",
      "  if peek(xs + 16) == 0 \{",
      "    return none()",
      "  \}",
      "  return some_elem(xs, 0, rtd)",
      "\}",
      "",
      "fn List_last(xs: Word, rtd: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  if n == 0 \{",
      "    return none()",
      "  \}",
      "  return some_elem(xs, n - 1, rtd)",
      "\}",
      "",
      "fn List_push(xs: Word, item: Word) -> Word \{",
      "  let r = list_copy(xs, 1)",
      "  retain_v(item, list_elem_td(xs))",
      "  return list_push_owned_raw(r, item)",
      "\}",
      "",
      "fn List_push_owned(xs: Word, item: Word) -> Word \{",
      "  return list_push_owned_raw(xs, item)",
      "\}",
      "",
      "fn List_set_owned(xs: Word, i: Int, item: Word, sp: Word) -> Word \{",
      "  let k = index_or_fail(i, peek(xs + 16), \"List.set\", sp, false)",
      "  let u = list_unique(xs, 0)",
      "  release_v(list_at(u, k), list_elem_td(u))",
      "  poke(peek(u + 32) + k * 8, item)",
      "  return u",
      "\}",
      "",
      "fn List_set(xs: Word, i: Int, item: Word, sp: Word) -> Word \{",
      "  index_or_fail(i, peek(xs + 16), \"List.set\", sp, false)",
      "  rc_inc(xs)",
      "  retain_v(item, list_elem_td(xs))",
      "  return List_set_owned(xs, i, item, sp)",
      "\}",
      "",
      "fn List_insert_owned(xs: Word, i: Int, item: Word, sp: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let k = index_or_fail(i, n, \"List.insert\", sp, true)",
      "  let u = list_unique(xs, 1)",
      "  let d = peek(u + 32)",
      "  var j = n",
      "  while j > k \{",
      "    poke(d + j * 8, peek(d + (j - 1) * 8))",
      "    j = j - 1",
      "  \}",
      "  poke(d + k * 8, item)",
      "  poke(u + 16, n + 1)",
      "  return u",
      "\}",
      "",
      "fn List_insert(xs: Word, i: Int, item: Word, sp: Word) -> Word \{",
      "  index_or_fail(i, peek(xs + 16), \"List.insert\", sp, true)",
      "  rc_inc(xs)",
      "  retain_v(item, list_elem_td(xs))",
      "  return List_insert_owned(xs, i, item, sp)",
      "\}",
      "",
      "fn List_remove_at_owned(xs: Word, i: Int, sp: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let k = index_or_fail(i, n, \"List.remove_at\", sp, false)",
      "  let u = list_unique(xs, 0)",
      "  let d = peek(u + 32)",
      "  release_v(peek(d + k * 8), list_elem_td(u))",
      "  var j = k",
      "  while j < n - 1 \{",
      "    poke(d + j * 8, peek(d + (j + 1) * 8))",
      "    j = j + 1",
      "  \}",
      "  poke(u + 16, n - 1)",
      "  return u",
      "\}",
      "",
      "fn List_remove_at(xs: Word, i: Int, sp: Word) -> Word \{",
      "  index_or_fail(i, peek(xs + 16), \"List.remove_at\", sp, false)",
      "  rc_inc(xs)",
      "  return List_remove_at_owned(xs, i, sp)",
      "\}",
      "",
      "// consumes both lists, like every `*_owned` function: the lowering hands over its references (`out.concat(f(x))`",
      "// leaked the temporary when `other` was only borrowed here)",
      "fn List_concat_owned(xs: Word, other: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let m = peek(other + 16)",
      "  let u = list_unique(xs, m)",
      "  list_grow(u, n + m)",
      "  copy_words(peek(u + 32) + n * 8, peek(other + 32), m)",
      "  let et = list_elem_td(u)",
      "  if is_rc_kind(et) \{",
      "    var i: Word = 0",
      "    while i < m \{",
      "      retain_v(list_at(other, i), et)",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  poke(u + 16, n + m)",
      "  rc_dec(other)",
      "  return u",
      "\}",
      "",
      "fn List_concat(xs: Word, other: Word) -> Word \{",
      "  rc_inc(xs)",
      "  rc_inc(other)",
      "  return List_concat_owned(xs, other)",
      "\}",
      "",
      "fn List_map(xs: Word, f: Word, rtd: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let out = list_with_cap(rtd, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(peek(out + 32) + i * 8, call1(f, list_at(xs, i)))",
      "    poke(out + 16, i + 1)",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn List_filter(xs: Word, keep: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let out = list_with_cap(peek(xs + 8), n)",
      "  let et = list_elem_td(xs)",
      "  let rc = is_rc_kind(et)",
      "  let src = peek(xs + 32)",
      "  let dst = peek(out + 32)",
      "  var m: Word = 0",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let v = peek(src + i * 8)",
      "    if call1(keep, v) != 0 \{",
      "      if rc \{",
      "        retain_v(v, et)",
      "      \}",
      "      poke(dst + m * 8, v)",
      "      m = m + 1",
      "      poke(out + 16, m)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn List_fold(xs: Word, init: Word, f: Word, td_A: Word) -> Word \{",
      "  var acc = init",
      "  retain_v(acc, td_A)",
      "  let n = peek(xs + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let next = call2(f, acc, list_at(xs, i))",
      "    release_v(acc, td_A)",
      "    acc = next",
      "    i = i + 1",
      "  \}",
      "  return acc",
      "\}",
      "",
      "fn List_any(xs: Word, pred: Word) -> Bool \{",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    if call1(pred, list_at(xs, i)) != 0 \{",
      "      return true",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return false",
      "\}",
      "",
      "fn List_all(xs: Word, pred: Word) -> Bool \{",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    if call1(pred, list_at(xs, i)) == 0 \{",
      "      return false",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return true",
      "\}",
      "",
      "fn List_find(xs: Word, pred: Word, rtd: Word) -> Word \{",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    if call1(pred, list_at(xs, i)) != 0 \{",
      "      return some_elem(xs, i, rtd)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return none()",
      "\}",
      "",
      "fn List_count(xs: Word, pred: Word) -> Int \{",
      "  var c: Word = 0",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    if call1(pred, list_at(xs, i)) != 0 \{",
      "      c = c + 1",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return tag(c)",
      "\}",
      "",
      "fn List_contains(xs: Word, item: Word) -> Bool \{",
      "  let et = list_elem_td(xs)",
      "  var i: Word = 0",
      "  if peek(et) == K_STR \{",
      "    // the common case (`[\"add\", \"sub\"].contains(op)`): no nesting check per element",
      "    while i < peek(xs + 16) \{",
      "      if Str_eq(list_at(xs, i), item) \{",
      "        return true",
      "      \}",
      "      i = i + 1",
      "    \}",
      "    return false",
      "  \}",
      "  while i < peek(xs + 16) \{",
      "    if eq_v(list_at(xs, i), item, et) \{",
      "      return true",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return false",
      "\}",
      "",
      "fn List_index_of(xs: Word, item: Word, rtd: Word) -> Word \{",
      "  let et = list_elem_td(xs)",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    if eq_v(list_at(xs, i), item, et) \{",
      "      return some_new(rtd, bits(tag(i)))",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return none()",
      "\}",
      "",
      "fn List_reverse(xs: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let r = list_copy(xs, 0)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(peek(r + 32) + i * 8, list_at(xs, n - 1 - i))",
      "    i = i + 1",
      "  \}",
      "  return r",
      "\}",
      "",
      "// stable merge sort of `n` words at `a` by keys at `keys` (same positions) with descriptor kt",
      "fn merge_sort(a: Word, keys: Word, n: Word, kt: Word, sp: Word) \{",
      "  if n < 2 \{",
      "    return",
      "  \}",
      "  let ta = alloc(n * 8)",
      "  let tk = alloc(n * 8)",
      "  var width: Word = 1",
      "  while width < n \{",
      "    var lo: Word = 0",
      "    while lo < n \{",
      "      var mid = lo + width",
      "      if mid > n \{",
      "        mid = n",
      "      \}",
      "      var hi = lo + 2 * width",
      "      if hi > n \{",
      "        hi = n",
      "      \}",
      "      var i = lo",
      "      var j = mid",
      "      var k = lo",
      "      while k < hi \{",
      "        var take_left = false",
      "        if i < mid and j < hi \{",
      "          let c = cmp_v(peek(keys + j * 8), peek(keys + i * 8), kt)",
      "          if c == -2 \{",
      "            not_comparable(sp)",
      "          \}",
      "          take_left = c >= 0",
      "        \} else \{",
      "          take_left = i < mid",
      "        \}",
      "        if take_left \{",
      "          poke(ta + k * 8, peek(a + i * 8))",
      "          poke(tk + k * 8, peek(keys + i * 8))",
      "          i = i + 1",
      "        \} else \{",
      "          poke(ta + k * 8, peek(a + j * 8))",
      "          poke(tk + k * 8, peek(keys + j * 8))",
      "          j = j + 1",
      "        \}",
      "        k = k + 1",
      "      \}",
      "      lo = hi",
      "    \}",
      "    copy_words(a, ta, n)",
      "    copy_words(keys, tk, n)",
      "    width = width * 2",
      "  \}",
      "  block_free(ta)",
      "  block_free(tk)",
      "\}",
      "",
      "// ---- specialized sorts: raw words (small Ints) and strings, stable merge sort ----------------",
      "fn isort_words(a: Word, lo: Word, hi: Word) \{",
      "  var i = lo + 1",
      "  while i < hi \{",
      "    let v = peek(a + i * 8)",
      "    var j = i - 1",
      "    while j >= lo and peek(a + j * 8) > v \{",
      "      poke(a + (j + 1) * 8, peek(a + j * 8))",
      "      j = j - 1",
      "    \}",
      "    poke(a + (j + 1) * 8, v)",
      "    i = i + 1",
      "  \}",
      "\}",
      "",
      "fn merge_words(src: Word, dst: Word, lo: Word, mid: Word, hi: Word) \{",
      "  var i = lo",
      "  var j = mid",
      "  var k = lo",
      "  while i < mid and j < hi \{",
      "    let x = peek(src + i * 8)",
      "    let y = peek(src + j * 8)",
      "    if y < x \{",
      "      poke(dst + k * 8, y)",
      "      j = j + 1",
      "    \} else \{",
      "      poke(dst + k * 8, x)",
      "      i = i + 1",
      "    \}",
      "    k = k + 1",
      "  \}",
      "  copy_words(dst + k * 8, src + i * 8, mid - i)",
      "  copy_words(dst + (k + mid - i) * 8, src + j * 8, hi - j)",
      "\}",
      "",
      "fn isort_strs(a: Word, lo: Word, hi: Word) \{",
      "  var i = lo + 1",
      "  while i < hi \{",
      "    let v = peek(a + i * 8)",
      "    var j = i - 1",
      "    while j >= lo and Str_cmp(peek(a + j * 8), v) > 0 \{",
      "      poke(a + (j + 1) * 8, peek(a + j * 8))",
      "      j = j - 1",
      "    \}",
      "    poke(a + (j + 1) * 8, v)",
      "    i = i + 1",
      "  \}",
      "\}",
      "",
      "fn merge_strs(src: Word, dst: Word, lo: Word, mid: Word, hi: Word) \{",
      "  var i = lo",
      "  var j = mid",
      "  var k = lo",
      "  while i < mid and j < hi \{",
      "    let x = peek(src + i * 8)",
      "    let y = peek(src + j * 8)",
      "    if Str_cmp(y, x) < 0 \{",
      "      poke(dst + k * 8, y)",
      "      j = j + 1",
      "    \} else \{",
      "      poke(dst + k * 8, x)",
      "      i = i + 1",
      "    \}",
      "    k = k + 1",
      "  \}",
      "  copy_words(dst + k * 8, src + i * 8, mid - i)",
      "  copy_words(dst + (k + mid - i) * 8, src + j * 8, hi - j)",
      "\}",
      "",
      "// strs: false = raw signed words, true = Str objects",
      "fn sort_fast(a: Word, n: Word, strs: Bool) \{",
      "  var lo: Word = 0",
      "  while lo < n \{",
      "    var hi = lo + 16",
      "    if hi > n \{",
      "      hi = n",
      "    \}",
      "    if strs \{",
      "      isort_strs(a, lo, hi)",
      "    \} else \{",
      "      isort_words(a, lo, hi)",
      "    \}",
      "    lo = hi",
      "  \}",
      "  if n <= 16 \{",
      "    return",
      "  \}",
      "  let tmp = alloc(n * 8)",
      "  var src = a",
      "  var dst = tmp",
      "  var width: Word = 16",
      "  while width < n \{",
      "    lo = 0",
      "    while lo < n \{",
      "      var mid = lo + width",
      "      if mid > n \{",
      "        mid = n",
      "      \}",
      "      var hi2 = lo + 2 * width",
      "      if hi2 > n \{",
      "        hi2 = n",
      "      \}",
      "      if strs \{",
      "        merge_strs(src, dst, lo, mid, hi2)",
      "      \} else \{",
      "        merge_words(src, dst, lo, mid, hi2)",
      "      \}",
      "      lo = hi2",
      "    \}",
      "    let t = src",
      "    src = dst",
      "    dst = t",
      "    width = width * 2",
      "  \}",
      "  if src != a \{",
      "    copy_words(a, src, n)",
      "  \}",
      "  block_free(tmp)",
      "\}",
      "",
      "fn all_small(p: Word, n: Word) -> Bool \{",
      "  var i: Word = 0",
      "  while i < n \{",
      "    if w_and(peek(p + i * 8), 1) == 0 \{",
      "      return false",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return true",
      "\}",
      "",
      "fn List_sort(xs: Word, sp: Word) -> Word \{",
      "  let r = list_copy(xs, 0)",
      "  let n = peek(r + 16)",
      "  let k = peek(list_elem_td(r))",
      "  if k == K_STR or (k == K_INT and all_small(peek(r + 32), n)) \{",
      "    sort_fast(peek(r + 32), n, k == K_STR)",
      "    return r",
      "  \}",
      "  if n > 1 and cmp_v(list_at(r, 0), list_at(r, 0), list_elem_td(r)) == -2 \{",
      "    not_comparable(sp)",
      "  \}",
      "  let keys = alloc(n * 8 + 8)",
      "  copy_words(keys, peek(r + 32), n)",
      "  merge_sort(peek(r + 32), keys, n, list_elem_td(r), sp)",
      "  block_free(keys)",
      "  return r",
      "\}",
      "",
      "fn List_sort_by(xs: Word, key: Word, td_K: Word, sp: Word) -> Word \{",
      "  let r = list_copy(xs, 0)",
      "  let n = peek(r + 16)",
      "  let keys = alloc(n * 8 + 8)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(keys + i * 8, call1(key, list_at(r, i)))",
      "    i = i + 1",
      "  \}",
      "  merge_sort(peek(r + 32), keys, n, td_K, sp)",
      "  release_words(keys, n, td_K)",
      "  block_free(keys)",
      "  return r",
      "\}",
      "",
      "fn sub_list(xs: Word, a: Word, z: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  var lo = a",
      "  var hi = z",
      "  if hi > n \{",
      "    hi = n",
      "  \}",
      "  if lo > hi \{",
      "    lo = hi",
      "  \}",
      "  let r = list_with_cap(peek(xs + 8), hi - lo)",
      "  copy_words(peek(r + 32), peek(xs + 32) + lo * 8, hi - lo)",
      "  let et = list_elem_td(xs)",
      "  if is_rc_kind(et) \{",
      "    var i = lo",
      "    while i < hi \{",
      "      retain_v(list_at(xs, i), et)",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  poke(r + 16, hi - lo)",
      "  return r",
      "\}",
      "",
      "fn List_slice(xs: Word, start: Int, end: Int) -> Word \{",
      "  return sub_list(xs, clamp_index(start), clamp_index(end))",
      "\}",
      "",
      "fn List_take(xs: Word, n: Int) -> Word \{",
      "  return sub_list(xs, 0, clamp_index(n))",
      "\}",
      "",
      "fn List_drop(xs: Word, n: Int) -> Word \{",
      "  return sub_list(xs, clamp_index(n), peek(xs + 16))",
      "\}",
      "",
      "fn List_join(xs: Word, sep: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let ns = peek(sep + 16)",
      "  var total: Word = 0",
      "  var i: Word = 0",
      "  while i < n \{",
      "    total = total + peek(list_at(xs, i) + 16)",
      "    i = i + 1",
      "  \}",
      "  if n > 1 \{",
      "    total = total + ns * (n - 1)",
      "  \}",
      "  let s = str_new(total)",
      "  var p = s + 32",
      "  i = 0",
      "  while i < n \{",
      "    if i > 0 \{",
      "      if ns == 1 \{",
      "        poke8(p, peek8(sep + 32))",
      "      \} else \{",
      "        copy_bytes(p, sep + 32, ns)",
      "      \}",
      "      p = p + ns",
      "    \}",
      "    let part = list_at(xs, i)",
      "    let np = peek(part + 16)",
      "    copy_bytes(p, part + 32, np)",
      "    p = p + np",
      "    i = i + 1",
      "  \}",
      "  return s",
      "\}",
      "",
      "fn List_sum(xs: Word) -> Int \{",
      "  var total: Int = 0",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    let x: Int = unbits(list_at(xs, i))",
      "    total = total + x",
      "    i = i + 1",
      "  \}",
      "  return total",
      "\}",
      "",
      "// math.fsum-style exact summation (Shewchuk partials), like Python's sum_float",
      "fn List_sum_float(xs: Word) -> Float \{",
      "  let n = peek(xs + 16)",
      "  let partials = alloc(n * 8 + 16)",
      "  var np: Word = 0",
      "  var i: Word = 0",
      "  while i < n \{",
      "    var x = ffrom(list_at(xs, i))",
      "    var j: Word = 0",
      "    var k: Word = 0",
      "    while j < np \{",
      "      var y = ffrom(peek(partials + j * 8))",
      "      if Float_abs(x) < Float_abs(y) \{",
      "        let t = x",
      "        x = y",
      "        y = t",
      "      \}",
      "      let hi = x + y",
      "      let lo = y - (hi - x)",
      "      if lo != 0.0 \{",
      "        poke(partials + k * 8, fbits(lo))",
      "        k = k + 1",
      "      \}",
      "      x = hi",
      "      j = j + 1",
      "    \}",
      "    poke(partials + k * 8, fbits(x))",
      "    np = k + 1",
      "    i = i + 1",
      "  \}",
      "  var total: Float = 0.0",
      "  if np > 0 \{",
      "    total = ffrom(peek(partials + (np - 1) * 8))",
      "    var m = np - 1",
      "    var done = false",
      "    while m > 0 and not done \{",
      "      let x2 = total",
      "      let y2 = ffrom(peek(partials + (m - 1) * 8))",
      "      total = x2 + y2",
      "      let yr = total - x2",
      "      let lo2 = y2 - yr",
      "      if lo2 != 0.0 \{",
      "        done = true",
      "        if m >= 2 \{",
      "          let nxt = ffrom(peek(partials + (m - 2) * 8))",
      "          if (lo2 < 0.0 and nxt < 0.0) or (lo2 > 0.0 and nxt > 0.0) \{",
      "            let y3 = lo2 * 2.0",
      "            let x3 = total + y3",
      "            if y3 == x3 - total \{",
      "              total = x3",
      "            \}",
      "          \}",
      "        \}",
      "      \}",
      "      m = m - 1",
      "    \}",
      "  \}",
      "  block_free(partials)",
      "  return total",
      "\}",
      "",
      "fn List_enumerate(xs: Word, rtd: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let out = list_with_cap(rtd, n)",
      "  let itd = peek(rtd + 16)",
      "  let et = list_elem_td(xs)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let v = list_at(xs, i)",
      "    retain_v(v, et)",
      "    poke(peek(out + 32) + i * 8, record2(itd, bits(tag(i)), v))",
      "    i = i + 1",
      "  \}",
      "  poke(out + 16, n)",
      "  return out",
      "\}",
      "",
      "fn List_zip(xs: Word, other: Word, rtd: Word) -> Word \{",
      "  var n = peek(xs + 16)",
      "  if peek(other + 16) < n \{",
      "    n = peek(other + 16)",
      "  \}",
      "  let out = list_with_cap(rtd, n)",
      "  let ptd = peek(rtd + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let a = list_at(xs, i)",
      "    let b = list_at(other, i)",
      "    retain_v(a, list_elem_td(xs))",
      "    retain_v(b, list_elem_td(other))",
      "    poke(peek(out + 32) + i * 8, record2(ptd, a, b))",
      "    i = i + 1",
      "  \}",
      "  poke(out + 16, n)",
      "  return out",
      "\}",
      "",
      "fn List_flat_map(xs: Word, f: Word, rtd: Word) -> Word \{",
      "  var out = list_with_cap(rtd, 4)",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    let part = call1(f, list_at(xs, i))",
      "    out = List_concat_owned(out, part)",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn List_flatten(xs: Word, rtd: Word) -> Word \{",
      "  var out = list_with_cap(rtd, 4)",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    let part = list_at(xs, i)",
      "    rc_inc(part)",
      "    out = List_concat_owned(out, part)",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn List_unique(xs: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  var out = list_with_cap(peek(xs + 8), n)",
      "  let et = list_elem_td(xs)",
      "  var icap: Word = 16",
      "  while icap < n * 2 \{",
      "    icap = icap * 2",
      "  \}",
      "  let idx = alloc(icap * 8)",
      "  var z: Word = 0",
      "  while z < icap \{",
      "    poke(idx + z * 8, 0)",
      "    z = z + 1",
      "  \}",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let v = list_at(xs, i)",
      "    var slot = w_and(hash_v(v, et), icap - 1)",
      "    var found = false",
      "    var probing = true",
      "    while probing \{",
      "      let e = peek(idx + slot * 8)",
      "      if e == 0 \{",
      "        probing = false",
      "      \} else if eq_v(list_at(out, e - 1), v, et) \{",
      "        found = true",
      "        probing = false",
      "      \} else \{",
      "        slot = w_and(slot + 1, icap - 1)",
      "      \}",
      "    \}",
      "    if not found \{",
      "      retain_v(v, et)",
      "      out = list_push_owned_raw(out, v)",
      "      poke(idx + slot * 8, peek(out + 16))",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  block_free(idx)",
      "  return out",
      "\}",
      "",
      "fn List_partition(xs: Word, pred: Word, rtd: Word) -> Word \{",
      "  let ltd = peek(peek(rtd + 24))",
      "  var yes = list_with_cap(ltd, 4)",
      "  var no = list_with_cap(ltd, 4)",
      "  let et = list_elem_td(xs)",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    let v = list_at(xs, i)",
      "    retain_v(v, et)",
      "    if call1(pred, v) != 0 \{",
      "      yes = list_push_owned_raw(yes, v)",
      "    \} else \{",
      "      no = list_push_owned_raw(no, v)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return record2(rtd, yes, no)",
      "\}",
      "",
      "fn List_group_by(xs: Word, key: Word, rtd: Word) -> Word \{",
      "  var m = map_new(rtd)",
      "  let ltd = peek(rtd + 24)",
      "  let et = list_elem_td(xs)",
      "  var i: Word = 0",
      "  while i < peek(xs + 16) \{",
      "    let v = list_at(xs, i)",
      "    let k = call1(key, v)",
      "    retain_v(v, et)",
      "    let pos = map_find(m, k)",
      "    if pos >= 0 \{",
      "      let slot = peek(m + 40) + pos * 8",
      "      poke(slot, list_push_owned_raw(peek(slot), v))",
      "      release_v(k, peek(rtd + 16))",
      "    \} else \{",
      "      let fresh = list_push_owned_raw(list_with_cap(ltd, 4), v)",
      "      m = Map_set_owned(m, k, fresh)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return m",
      "\}",
      "",
      "fn List_chunks(xs: Word, size: Int, rtd: Word, sp: Word) -> Word \{",
      "  if size <= 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"List.chunks: size must be positive, got \")",
      "    int_show(b, bits(size))",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  let k = clamp_index(size)",
      "  var out = list_with_cap(rtd, 4)",
      "  var i: Word = 0",
      "  let n = peek(xs + 16)",
      "  while i < n \{",
      "    out = list_push_owned_raw(out, sub_list(xs, i, i + k))",
      "    i = i + k",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn extreme(xs: Word, keys: Word, kt: Word, want: Word, rtd: Word, sp: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  if n == 0 \{",
      "    return none()",
      "  \}",
      "  var best: Word = 0",
      "  var i: Word = 1",
      "  while i < n \{",
      "    let c = cmp_v(peek(keys + i * 8), peek(keys + best * 8), kt)",
      "    if c == -2 \{",
      "      fail_msg(\"R0009\", \"values are not comparable (only Int, Float, Str)\", sp)",
      "    \}",
      "    if c == want \{",
      "      best = i",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  if n == 1 and cmp_v(peek(keys), peek(keys), kt) == -2 \{",
      "    fail_msg(\"R0009\", \"values are not comparable (only Int, Float, Str)\", sp)",
      "  \}",
      "  return some_elem(xs, best, rtd)",
      "\}",
      "",
      "fn List_min(xs: Word, rtd: Word, sp: Word) -> Word \{",
      "  return extreme(xs, peek(xs + 32), list_elem_td(xs), -1, rtd, sp)",
      "\}",
      "",
      "fn List_max(xs: Word, rtd: Word, sp: Word) -> Word \{",
      "  return extreme(xs, peek(xs + 32), list_elem_td(xs), 1, rtd, sp)",
      "\}",
      "",
      "fn by_key(xs: Word, key: Word, td_K: Word, want: Word, rtd: Word, sp: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  let keys = alloc(n * 8 + 8)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    poke(keys + i * 8, call1(key, list_at(xs, i)))",
      "    i = i + 1",
      "  \}",
      "  let r = extreme(xs, keys, td_K, want, rtd, sp)",
      "  release_words(keys, n, td_K)",
      "  block_free(keys)",
      "  return r",
      "\}",
      "",
      "fn List_min_by(xs: Word, key: Word, rtd: Word, td_K: Word, sp: Word) -> Word \{",
      "  return by_key(xs, key, td_K, -1, rtd, sp)",
      "\}",
      "",
      "fn List_max_by(xs: Word, key: Word, rtd: Word, td_K: Word, sp: Word) -> Word \{",
      "  return by_key(xs, key, td_K, 1, rtd, sp)",
      "\}",
      "",
    ],
    "rt/map.klar" => [
      "// Klar runtime: Map[K, V] = [rc][td][len][cap][keys][vals][index][icap]",
      "// insertion-ordered entries + open-addressing index of (entry + 1), 0 = empty slot.",
      "",
      "fn map_new(td: Word) -> Word \{",
      "  let m = obj_new(64, td)",
      "  poke(m + 16, 0)",
      "  poke(m + 24, 0)",
      "  poke(m + 32, 0)",
      "  poke(m + 40, 0)",
      "  poke(m + 48, 0)",
      "  poke(m + 56, 0)",
      "  return m",
      "\}",
      "",
      "fn map_key_td(m: Word) -> Word \{",
      "  return peek(peek(m + 8) + 16)",
      "\}",
      "",
      "fn map_val_td(m: Word) -> Word \{",
      "  return peek(peek(m + 8) + 24)",
      "\}",
      "",
      "// entry index of key, or -1",
      "fn map_find(m: Word, key: Word) -> Word \{",
      "  let icap = peek(m + 56)",
      "  if icap == 0 \{",
      "    return -1",
      "  \}",
      "  let kt = map_key_td(m)",
      "  let idx = peek(m + 48)",
      "  var slot = w_and(hash_v(key, kt), icap - 1)",
      "  var probing = true",
      "  while probing \{",
      "    let e = peek(idx + slot * 8)",
      "    if e == 0 \{",
      "      return -1",
      "    \}",
      "    if eq_v(peek(peek(m + 32) + (e - 1) * 8), key, kt) \{",
      "      return e - 1",
      "    \}",
      "    slot = w_and(slot + 1, icap - 1)",
      "  \}",
      "  return -1",
      "\}",
      "",
      "fn map_rebuild_index(m: Word, icap: Word) \{",
      "  if peek(m + 48) != 0 \{",
      "    block_free(peek(m + 48))",
      "  \}",
      "  let idx = alloc(icap * 8)",
      "  var i: Word = 0",
      "  while i < icap \{",
      "    poke(idx + i * 8, 0)",
      "    i = i + 1",
      "  \}",
      "  poke(m + 48, idx)",
      "  poke(m + 56, icap)",
      "  let kt = map_key_td(m)",
      "  var e: Word = 0",
      "  while e < peek(m + 16) \{",
      "    var slot = w_and(hash_v(peek(peek(m + 32) + e * 8), kt), icap - 1)",
      "    while peek(idx + slot * 8) != 0 \{",
      "      slot = w_and(slot + 1, icap - 1)",
      "    \}",
      "    poke(idx + slot * 8, e + 1)",
      "    e = e + 1",
      "  \}",
      "\}",
      "",
      "fn map_reserve(m: Word, need: Word) \{",
      "  let cap = peek(m + 24)",
      "  if need > cap \{",
      "    var nc = cap * 2",
      "    if nc < 8 \{",
      "      nc = 8",
      "    \}",
      "    while nc < need \{",
      "      nc = nc * 2",
      "    \}",
      "    let nk = alloc(nc * 8)",
      "    let nv = alloc(nc * 8)",
      "    if cap > 0 \{",
      "      copy_words(nk, peek(m + 32), peek(m + 16))",
      "      copy_words(nv, peek(m + 40), peek(m + 16))",
      "      block_free(peek(m + 32))",
      "      block_free(peek(m + 40))",
      "    \}",
      "    poke(m + 32, nk)",
      "    poke(m + 40, nv)",
      "    poke(m + 24, nc)",
      "  \}",
      "  if need * 2 > peek(m + 56) \{",
      "    var ic: Word = 16",
      "    while ic < need * 2 \{",
      "      ic = ic * 2",
      "    \}",
      "    map_rebuild_index(m, ic)",
      "  \}",
      "\}",
      "",
      "fn map_copy(m: Word) -> Word \{",
      "  let r = map_new(peek(m + 8))",
      "  let n = peek(m + 16)",
      "  map_reserve(r, n)",
      "  copy_words(peek(r + 32), peek(m + 32), n)",
      "  copy_words(peek(r + 40), peek(m + 40), n)",
      "  let kt = map_key_td(m)",
      "  let vt = map_val_td(m)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    retain_v(peek(peek(m + 32) + i * 8), kt)",
      "    retain_v(peek(peek(m + 40) + i * 8), vt)",
      "    i = i + 1",
      "  \}",
      "  poke(r + 16, n)",
      "  map_rebuild_index(r, peek(r + 56))",
      "  return r",
      "\}",
      "",
      "fn map_unique(m: Word) -> Word \{",
      "  if peek(m) == 1 \{",
      "    return m",
      "  \}",
      "  let c = map_copy(m)",
      "  rc_dec(m)",
      "  return c",
      "\}",
      "",
      "// insert/replace with owned key and value into an owned map",
      "fn Map_set_owned(m: Word, key: Word, value: Word) -> Word \{",
      "  let u = map_unique(m)",
      "  let found = map_find(u, key)",
      "  if found >= 0 \{",
      "    release_v(peek(peek(u + 40) + found * 8), map_val_td(u))",
      "    poke(peek(u + 40) + found * 8, value)",
      "    release_v(key, map_key_td(u))",
      "    return u",
      "  \}",
      "  let n = peek(u + 16)",
      "  map_reserve(u, n + 1)",
      "  poke(peek(u + 32) + n * 8, key)",
      "  poke(peek(u + 40) + n * 8, value)",
      "  poke(u + 16, n + 1)",
      "  let icap = peek(u + 56)",
      "  let idx = peek(u + 48)",
      "  var slot = w_and(hash_v(key, map_key_td(u)), icap - 1)",
      "  while peek(idx + slot * 8) != 0 \{",
      "    slot = w_and(slot + 1, icap - 1)",
      "  \}",
      "  poke(idx + slot * 8, n + 1)",
      "  return u",
      "\}",
      "",
      "// ---- Map methods ---------------------------------------------------------------------",
      "fn Map_len(m: Word) -> Int \{",
      "  return tag(peek(m + 16))",
      "\}",
      "",
      "fn Map_is_empty(m: Word) -> Bool \{",
      "  return peek(m + 16) == 0",
      "\}",
      "",
      "fn Map_get(m: Word, key: Word, rtd: Word) -> Word \{",
      "  let i = map_find(m, key)",
      "  if i < 0 \{",
      "    return none()",
      "  \}",
      "  let v = peek(peek(m + 40) + i * 8)",
      "  retain_v(v, map_val_td(m))",
      "  return some_new(rtd, v)",
      "\}",
      "",
      "// `match m.get(k)` without the Option (klar/native/lower.py `option_slot`): the slot of key `k` (-1: absent), and",
      "// the value in a slot, retained",
      "fn map_slot(m: Word, key: Word) -> Word \{",
      "  return map_find(m, key)",
      "\}",
      "",
      "fn map_take(m: Word, i: Word) -> Word \{",
      "  let v = peek(peek(m + 40) + i * 8)",
      "  retain_v(v, map_val_td(m))",
      "  return v",
      "\}",
      "",
      "// `m.get(k).unwrap_or(d)` without the Option (klar/native/lower.py `get_or`)",
      "fn map_get_or(m: Word, key: Word, d: Word) -> Word \{",
      "  let i = map_find(m, key)",
      "  if i < 0 \{",
      "    retain_v(d, map_val_td(m))",
      "    return d",
      "  \}",
      "  return map_take(m, i)",
      "\}",
      "",
      "fn Map_has(m: Word, key: Word) -> Bool \{",
      "  return map_find(m, key) >= 0",
      "\}",
      "",
      "fn Map_set(m: Word, key: Word, value: Word) -> Word \{",
      "  rc_inc(m)",
      "  retain_v(key, map_key_td(m))",
      "  retain_v(value, map_val_td(m))",
      "  return Map_set_owned(m, key, value)",
      "\}",
      "",
      "fn Map_remove_owned(m: Word, key: Word) -> Word \{",
      "  let i = map_find(m, key)",
      "  release_v(key, map_key_td(m))",
      "  if i < 0 \{",
      "    return m",
      "  \}",
      "  let u = map_unique(m)",
      "  let n = peek(u + 16)",
      "  let ks = peek(u + 32)",
      "  let vs = peek(u + 40)",
      "  release_v(peek(ks + i * 8), map_key_td(u))",
      "  release_v(peek(vs + i * 8), map_val_td(u))",
      "  var j = i",
      "  while j < n - 1 \{",
      "    poke(ks + j * 8, peek(ks + (j + 1) * 8))",
      "    poke(vs + j * 8, peek(vs + (j + 1) * 8))",
      "    j = j + 1",
      "  \}",
      "  poke(u + 16, n - 1)",
      "  map_rebuild_index(u, peek(u + 56))",
      "  return u",
      "\}",
      "",
      "fn Map_remove(m: Word, key: Word) -> Word \{",
      "  rc_inc(m)",
      "  retain_v(key, map_key_td(m))",
      "  return Map_remove_owned(m, key)",
      "\}",
      "",
      "fn Map_keys(m: Word, rtd: Word) -> Word \{",
      "  let n = peek(m + 16)",
      "  let out = list_with_cap(rtd, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let k = peek(peek(m + 32) + i * 8)",
      "    retain_v(k, map_key_td(m))",
      "    poke(peek(out + 32) + i * 8, k)",
      "    i = i + 1",
      "  \}",
      "  poke(out + 16, n)",
      "  return out",
      "\}",
      "",
      "fn Map_values(m: Word, rtd: Word) -> Word \{",
      "  let n = peek(m + 16)",
      "  let out = list_with_cap(rtd, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let v = peek(peek(m + 40) + i * 8)",
      "    retain_v(v, map_val_td(m))",
      "    poke(peek(out + 32) + i * 8, v)",
      "    i = i + 1",
      "  \}",
      "  poke(out + 16, n)",
      "  return out",
      "\}",
      "",
      "fn Map_entries(m: Word, rtd: Word) -> Word \{",
      "  let n = peek(m + 16)",
      "  let out = list_with_cap(rtd, n)",
      "  let etd = peek(rtd + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let k = peek(peek(m + 32) + i * 8)",
      "    let v = peek(peek(m + 40) + i * 8)",
      "    retain_v(k, map_key_td(m))",
      "    retain_v(v, map_val_td(m))",
      "    poke(peek(out + 32) + i * 8, record2(etd, k, v))",
      "    i = i + 1",
      "  \}",
      "  poke(out + 16, n)",
      "  return out",
      "\}",
      "",
      "fn Map_map_values(m: Word, f: Word, rtd: Word) -> Word \{",
      "  var out = map_new(rtd)",
      "  var i: Word = 0",
      "  while i < peek(m + 16) \{",
      "    let k = peek(peek(m + 32) + i * 8)",
      "    retain_v(k, map_key_td(m))",
      "    out = Map_set_owned(out, k, call1(f, peek(peek(m + 40) + i * 8)))",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn Map_update_owned(m: Word, key: Word, default: Word, f: Word) -> Word \{",
      "  let i = map_find(m, key)",
      "  var cur = default",
      "  if i >= 0 \{",
      "    cur = peek(peek(m + 40) + i * 8)",
      "  \}",
      "  let nv = call1(f, cur)",
      "  release_v(default, map_val_td(m))",
      "  rc_dec(f)              // consumed, like the other arguments (the lowering hands over its reference)",
      "  return Map_set_owned(m, key, nv)",
      "\}",
      "",
      "fn Map_update(m: Word, key: Word, default: Word, f: Word) -> Word \{",
      "  rc_inc(m)",
      "  retain_v(key, map_key_td(m))",
      "  retain_v(default, map_val_td(m))",
      "  rc_inc(f)",
      "  return Map_update_owned(m, key, default, f)",
      "\}",
      "",
      "fn Map_filter(m: Word, keep: Word) -> Word \{",
      "  var out = map_new(peek(m + 8))",
      "  var i: Word = 0",
      "  while i < peek(m + 16) \{",
      "    let k = peek(peek(m + 32) + i * 8)",
      "    let v = peek(peek(m + 40) + i * 8)",
      "    if call2(keep, k, v) != 0 \{",
      "      retain_v(k, map_key_td(m))",
      "      retain_v(v, map_val_td(m))",
      "      out = Map_set_owned(out, k, v)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn Map_merge(m: Word, other: Word) -> Word \{",
      "  var out = map_copy(m)",
      "  var i: Word = 0",
      "  while i < peek(other + 16) \{",
      "    let k = peek(peek(other + 32) + i * 8)",
      "    let v = peek(peek(other + 40) + i * 8)",
      "    retain_v(k, map_key_td(m))",
      "    retain_v(v, map_val_td(m))",
      "    out = Map_set_owned(out, k, v)",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
    ],
    "rt/misc.klar" => [
      "// Klar runtime: Int / Option / Result methods and object helpers.",
      "",
      "fn none() -> Word \{",
      "  return static_addr(\"obj_None\")",
      "\}",
      "",
      "fn some_new(rtd: Word, v: Word) -> Word \{",
      "  let o = obj_new(32, rtd)",
      "  poke(o + 16, 1)",
      "  poke(o + 24, v)",
      "  return o",
      "\}",
      "",
      "fn ok_new(rtd: Word, v: Word) -> Word \{",
      "  let o = obj_new(32, rtd)",
      "  poke(o + 16, 0)",
      "  poke(o + 24, v)",
      "  return o",
      "\}",
      "",
      "fn err_new(rtd: Word, v: Word) -> Word \{",
      "  let o = obj_new(32, rtd)",
      "  poke(o + 16, 1)",
      "  poke(o + 24, v)",
      "  return o",
      "\}",
      "",
      "fn record2(td: Word, a: Word, b: Word) -> Word \{",
      "  let o = obj_new(32, td)",
      "  poke(o + 16, a)",
      "  poke(o + 24, b)",
      "  return o",
      "\}",
      "",
      "fn small_or_fail(i: Int, what: Str, sp: Word) -> Word \{",
      "  if not is_small(i) \{",
      "    fail_msg(\"R0009\", \"index too large\", sp)",
      "  \}",
      "  return untag(i)",
      "\}",
      "",
      "// ---- Int ----------------------------------------------------------------------",
      "fn Int_to_float(x: Int, sp: Word) -> Float \{",
      "  if is_small(x) \{",
      "    return w2f(untag(x))",
      "  \}",
      "  return int_to_float(x, sp)",
      "\}",
      "",
      "fn Int_abs(x: Int) -> Int \{",
      "  if x < 0 \{",
      "    return 0 - x",
      "  \}",
      "  return x",
      "\}",
      "",
      "fn Int_min(a: Int, b: Int) -> Int \{",
      "  if b < a \{",
      "    return b",
      "  \}",
      "  return a",
      "\}",
      "",
      "fn Int_max(a: Int, b: Int) -> Int \{",
      "  if b > a \{",
      "    return b",
      "  \}",
      "  return a",
      "\}",
      "",
      "fn Int_clamp(x: Int, low: Int, high: Int) -> Int \{",
      "  var m = x",
      "  if high < x \{",
      "    m = high",
      "  \}",
      "  if m > low \{",
      "    return m",
      "  \}",
      "  return low",
      "\}",
      "",
      "fn Int_is_even(x: Int) -> Bool \{",
      "  return x % 2 == 0",
      "\}",
      "",
      "fn Int_sign(x: Int) -> Int \{",
      "  if x > 0 \{",
      "    return 1",
      "  \}",
      "  if x < 0 \{",
      "    return -1",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn Int_pow(x: Int, e: Int, sp: Word) -> Int \{",
      "  if e < 0 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"Int.pow: negative exponent \")",
      "    int_show(b, bits(e))",
      "    sb_add_cstr(b, \" (use Float for fractions)\")",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  return pow_int(x, e)",
      "\}",
      "",
      "// ---- Option -----------------------------------------------------------------------",
      "fn Option_is_some(o: Word) -> Bool \{",
      "  return peek(o + 16) == 1",
      "\}",
      "",
      "fn Option_is_none(o: Word) -> Bool \{",
      "  return peek(o + 16) == 0",
      "\}",
      "",
      "fn Option_unwrap_or(o: Word, d: Word, td_T: Word) -> Word \{",
      "  if peek(o + 16) == 1 \{",
      "    let v = peek(o + 24)",
      "    retain_v(v, td_T)",
      "    return v",
      "  \}",
      "  retain_v(d, td_T)",
      "  return d",
      "\}",
      "",
      "fn Option_map(o: Word, f: Word, rtd: Word) -> Word \{",
      "  if peek(o + 16) == 0 \{",
      "    return none()",
      "  \}",
      "  return some_new(rtd, call1(f, peek(o + 24)))",
      "\}",
      "",
      "fn Option_and_then(o: Word, f: Word) -> Word \{",
      "  if peek(o + 16) == 0 \{",
      "    return none()",
      "  \}",
      "  return call1(f, peek(o + 24))",
      "\}",
      "",
      "fn Option_ok_or(o: Word, e: Word, rtd: Word, td_T: Word, td_E: Word) -> Word \{",
      "  if peek(o + 16) == 1 \{",
      "    let v = peek(o + 24)",
      "    retain_v(v, td_T)",
      "    return ok_new(rtd, v)",
      "  \}",
      "  retain_v(e, td_E)",
      "  return err_new(rtd, e)",
      "\}",
      "",
      "// ---- Result -----------------------------------------------------------------------",
      "fn Result_is_ok(r: Word) -> Bool \{",
      "  return peek(r + 16) == 0",
      "\}",
      "",
      "fn Result_is_err(r: Word) -> Bool \{",
      "  return peek(r + 16) == 1",
      "\}",
      "",
      "fn Result_unwrap_or(r: Word, d: Word, td_T: Word) -> Word \{",
      "  if peek(r + 16) == 0 \{",
      "    let v = peek(r + 24)",
      "    retain_v(v, td_T)",
      "    return v",
      "  \}",
      "  retain_v(d, td_T)",
      "  return d",
      "\}",
      "",
      "fn Result_map(r: Word, f: Word, rtd: Word) -> Word \{",
      "  if peek(r + 16) == 0 \{",
      "    return ok_new(rtd, call1(f, peek(r + 24)))",
      "  \}",
      "  rc_inc(r)",
      "  return r",
      "\}",
      "",
      "fn Result_map_err(r: Word, f: Word, rtd: Word) -> Word \{",
      "  if peek(r + 16) == 1 \{",
      "    return err_new(rtd, call1(f, peek(r + 24)))",
      "  \}",
      "  rc_inc(r)",
      "  return r",
      "\}",
      "",
      "fn Result_ok(r: Word, rtd: Word, td_T: Word) -> Word \{",
      "  if peek(r + 16) == 0 \{",
      "    let v = peek(r + 24)",
      "    retain_v(v, td_T)",
      "    return some_new(rtd, v)",
      "  \}",
      "  return none()",
      "\}",
      "",
    ],
    "rt/par.klar" => [
      "// Klar runtime: List.par_map — a pure function applied to a list by worker processes.",
      "//",
      "// The list is cut into one contiguous chunk per CPU (at most 64). Each chunk runs in a child process made by fork:",
      "// it sees the whole program state as it was (copy-on-write), applies `f` to its elements in order and sends the",
      "// results back through a pipe in a small binary format (one stream per worker: a status byte, then the values).",
      "// The parent reads the streams in chunk order and rebuilds the values with their type descriptors, so the result",
      "// is the list `map` would give. A runtime error in a worker is reported exactly as `map` would report it: the",
      "// worker writes its report into the pipe instead of stderr, and the parent prints the report of the first failing",
      "// chunk, stops the other workers and exits with the worker's code. Where there are no worker processes (Windows,",
      "// one CPU, inside a worker, in a profile build, lists shorter than 2) par_map is map; Linux and macOS have them.",
      "//",
      "// The checker guarantees that `f` is pure (no effects) and that the results contain no functions.",
      "",
      "const PAR_MAX: Word = 64",
      "",
      "fn List_par_map(xs: Word, f: Word, rtd: Word) -> Word \{",
      "  let n = peek(xs + 16)",
      "  var k: Word = 1",
      "  if n >= 2 and peek(g() + G_WORKER) == 0 and peek(g() + G_PROF) == 0 and os_platform() != 1 \{",
      "    k = cpu_count()",
      "  \}",
      "  if k > n \{",
      "    k = n",
      "  \}",
      "  if k > PAR_MAX \{",
      "    k = PAR_MAX",
      "  \}",
      "  if k < 2 \{",
      "    return List_map(xs, f, rtd)",
      "  \}",
      "  flush_out()",
      "  let et = peek(rtd + 16)",
      "  let tab = alloc(k * 16)",
      "  var j: Word = 0",
      "  while j < k \{",
      "    start_worker(xs, f, et, tab, j, k)",
      "    j = j + 1",
      "  \}",
      "  let out = list_with_cap(rtd, n)",
      "  j = 0",
      "  while j < k \{",
      "    collect_chunk(xs, f, out, tab, j, k)",
      "    j = j + 1",
      "  \}",
      "  block_free(tab)",
      "  return out",
      "\}",
      "",
      "fn chunk_lo(n: Word, j: Word, k: Word) -> Word \{",
      "  return w_udiv(n * j, k)",
      "\}",
      "",
      "// Starts the worker of chunk j: tab[j] = (pid, read end of its pipe); pid -1 when the parent must do the chunk.",
      "fn start_worker(xs: Word, f: Word, et: Word, tab: Word, j: Word, k: Word) \{",
      "  let fds = static_addr(\"g_scratch\")",
      "  poke(tab + j * 16, -1)",
      "  if os_pipe(fds) < 0 \{",
      "    return",
      "  \}",
      "  let rfd = peek32(fds)",
      "  let wfd = peek32(fds + 4)",
      "  let pid = os_fork()",
      "  if pid == 0 \{",
      "    os_close(rfd)",
      "    let n = peek(xs + 16)",
      "    run_worker(xs, f, et, chunk_lo(n, j, k), chunk_lo(n, j + 1, k), wfd)",
      "  \}",
      "  os_close(wfd)",
      "  if pid < 0 \{",
      "    os_close(rfd)",
      "    return",
      "  \}",
      "  poke(tab + j * 16, pid)",
      "  poke(tab + j * 16 + 8, rfd)",
      "\}",
      "",
      "// In the worker: map the chunk, send [0][values...] and exit.",
      "fn run_worker(xs: Word, f: Word, et: Word, lo: Word, hi: Word, wfd: Word) \{",
      "  let gp = g()",
      "  poke(gp + G_WORKER, 1)",
      "  poke(gp + G_WFD, wfd)",
      "  let b = sb_with_cap(4096)",
      "  sb_add_byte(b, 0)",
      "  var i = lo",
      "  while i < hi \{",
      "    let v = call1(f, list_at(xs, i))",
      "    put_value(b, v, et)",
      "    release_v(v, et)",
      "    i = i + 1",
      "  \}",
      "  write_all(wfd, peek(b + 32), peek(b + 16))",
      "  os_exit(0)",
      "\}",
      "",
      "// Called first by every runtime error report: in a worker the report goes into the pipe, after the status byte 1.",
      "fn worker_failing() \{",
      "  let gp = g()",
      "  if peek(gp + G_WORKER) == 1 and peek(gp + G_ERRFD) == 0 \{",
      "    let fd = peek(gp + G_WFD)",
      "    poke(gp + G_ERRFD, fd)",
      "    let tmp = static_addr(\"g_scratch\")",
      "    poke8(tmp, 1)",
      "    write_all(fd, tmp, 1)",
      "  \}",
      "\}",
      "",
      "fn write_all(fd: Word, p: Word, n: Word) \{",
      "  var done: Word = 0",
      "  while done < n \{",
      "    let w = os_write(fd, p + done, n - done)",
      "    if w <= 0 \{",
      "      return",
      "    \}",
      "    done = done + w",
      "  \}",
      "\}",
      "",
      "// Appends the results of chunk j to `out` (computing them here when the chunk has no worker).",
      "fn collect_chunk(xs: Word, f: Word, out: Word, tab: Word, j: Word, k: Word) \{",
      "  let n = peek(xs + 16)",
      "  let lo = chunk_lo(n, j, k)",
      "  let hi = chunk_lo(n, j + 1, k)",
      "  let et = list_elem_td(out)",
      "  let pid = peek(tab + j * 16)",
      "  if pid < 0 \{",
      "    var i = lo",
      "    while i < hi \{",
      "      append_owned(out, call1(f, list_at(xs, i)))",
      "      i = i + 1",
      "    \}",
      "    return",
      "  \}",
      "  let fd = peek(tab + j * 16 + 8)",
      "  let b = sb_with_cap(4096)",
      "  var reading = true",
      "  while reading \{",
      "    sb_reserve(b, 65536)",
      "    let len = peek(b + 16)",
      "    let r = os_read(fd, peek(b + 32) + len, peek(b + 24) - len)",
      "    if r <= 0 \{",
      "      reading = false",
      "    \} else \{",
      "      poke(b + 16, len + r)",
      "    \}",
      "  \}",
      "  os_close(fd)",
      "  let status = os_wait(pid)",
      "  let data = peek(b + 32)",
      "  let len = peek(b + 16)",
      "  if len > 0 and peek8(data) == 0 \{",
      "    let st = alloc(16)",
      "    poke(st, data + 1)",
      "    poke(st + 8, data + len)",
      "    var i = lo",
      "    while i < hi \{",
      "      append_owned(out, get_value(st, et))",
      "      i = i + 1",
      "    \}",
      "    block_free(st)",
      "    rc_dec(b)",
      "    return",
      "  \}",
      "  // the worker failed: its report (if any) is the error of the whole par_map",
      "  stop_workers(tab, j + 1, k)",
      "  var code: Word = 2",
      "  if len > 0 and peek8(data) == 1 \{",
      "    err_bytes(data + 1, len - 1)",
      "    if status >= 0 and w_and(status, 127) == 0 \{",
      "      code = w_and(w_shr(status, 8), 255)",
      "    \}",
      "  \} else \{",
      "    err_str(bits(\"runtime error[R0014]: a par_map worker process stopped without a result\\n\"))",
      "  \}",
      "  os_exit(code)",
      "\}",
      "",
      "fn stop_workers(tab: Word, from: Word, k: Word) \{",
      "  var j = from",
      "  while j < k \{",
      "    let pid = peek(tab + j * 16)",
      "    if pid > 0 \{",
      "      os_kill(pid, 9)",
      "      os_wait(pid)",
      "    \}",
      "    j = j + 1",
      "  \}",
      "\}",
      "",
      "fn append_owned(out: Word, v: Word) \{",
      "  let n = peek(out + 16)",
      "  poke(peek(out + 32) + n * 8, v)",
      "  poke(out + 16, n + 1)",
      "\}",
      "",
      "fn cpu_count() -> Word \{",
      "  let buf = static_addr(\"g_scratch\")",
      "  let got = os_cpu_mask(buf, 128)",
      "  if os_platform() == 2 \{",
      "    // macOS: os_cpu_mask is the number of CPUs",
      "    if got < 1 \{",
      "      return 1",
      "    \}",
      "    return got",
      "  \}",
      "  if got <= 0 \{",
      "    return 1",
      "  \}",
      "  var c: Word = 0",
      "  var i: Word = 0",
      "  while i < got \{",
      "    var byte = peek8(buf + i)",
      "    while byte != 0 \{",
      "      c = c + w_and(byte, 1)",
      "      byte = w_shr(byte, 1)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  if c < 1 \{",
      "    return 1",
      "  \}",
      "  return c",
      "\}",
      "",
      "// ---- values as bytes ------------------------------------------------------------------------------------------",
      "// Words are 8 bytes, little-endian. Int: [0][tagged] or [1][limb count][sign word, count word, limbs...];",
      "// Str / Bytes: [n][bytes]; List: [n][items]; Map: [n][key, value]*; record: fields; enum: [variant][fields].",
      "",
      "fn put_word(b: Word, v: Word) \{",
      "  let tmp = static_addr(\"g_scratch\") + 128",
      "  poke(tmp, v)",
      "  sb_add_bytes(b, tmp, 8)",
      "\}",
      "",
      "fn put_value(b: Word, v: Word, td: Word) \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    if w_and(v, 1) == 1 \{",
      "      put_word(b, 0)",
      "      put_word(b, v)",
      "    \} else \{",
      "      let limbs = peek(v + 24)",
      "      put_word(b, 1)",
      "      put_word(b, limbs)",
      "      sb_add_bytes(b, v + 16, 16 + limbs * 8)",
      "    \}",
      "  \} else if k < K_STR \{",
      "    put_word(b, v)",
      "  \} else if k == K_STR \{",
      "    put_word(b, peek(v + 16))",
      "    sb_add_bytes(b, v + 32, peek(v + 16))",
      "  \} else if k == K_BYTES \{",
      "    put_word(b, peek(v + 16))",
      "    sb_add_bytes(b, peek(v + 32), peek(v + 16))",
      "  \} else if k == K_LIST \{",
      "    let n = peek(v + 16)",
      "    let et = peek(td + 16)",
      "    put_word(b, n)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      put_value(b, list_at(v, i), et)",
      "      i = i + 1",
      "    \}",
      "  \} else if k == K_MAP \{",
      "    let n = peek(v + 16)",
      "    put_word(b, n)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      put_value(b, peek(peek(v + 32) + i * 8), peek(td + 16))",
      "      put_value(b, peek(peek(v + 40) + i * 8), peek(td + 24))",
      "      i = i + 1",
      "    \}",
      "  \} else if k == K_RECORD \{",
      "    let nf = peek(td + 16)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      put_value(b, peek(v + 16 + i * 8), peek(peek(td + 24) + i * 8))",
      "      i = i + 1",
      "    \}",
      "  \} else if k == K_ENUM \{",
      "    let tagv = peek(v + 16)",
      "    let row = peek(td + 24) + tagv * 32",
      "    put_word(b, tagv)",
      "    var i: Word = 0",
      "    while i < peek(row + 8) \{",
      "      put_value(b, peek(v + 24 + i * 8), peek(peek(row + 16) + i * 8))",
      "      i = i + 1",
      "    \}",
      "  \} else \{",
      "    fatal(bits(\"internal: par_map cannot send this value\"))",
      "  \}",
      "\}",
      "",
      "// st = [next byte][end]",
      "fn get_word(st: Word) -> Word \{",
      "  let p = peek(st)",
      "  if p + 8 > peek(st + 8) \{",
      "    fatal(bits(\"internal: truncated par_map result\"))",
      "  \}",
      "  poke(st, p + 8)",
      "  return peek(p)",
      "\}",
      "",
      "fn get_bytes(st: Word, n: Word) -> Word \{",
      "  let p = peek(st)",
      "  if n < 0 or p + n > peek(st + 8) \{",
      "    fatal(bits(\"internal: truncated par_map result\"))",
      "  \}",
      "  poke(st, p + n)",
      "  return p",
      "\}",
      "",
      "fn get_value(st: Word, td: Word) -> Word \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    if get_word(st) == 0 \{",
      "      return get_word(st)",
      "    \}",
      "    let limbs = get_word(st)",
      "    let o = obj_new(32 + limbs * 8, static_addr(\"td_Big\"))",
      "    copy_bytes(o + 16, get_bytes(st, 16 + limbs * 8), 16 + limbs * 8)",
      "    return o",
      "  \}",
      "  if k < K_STR \{",
      "    return get_word(st)",
      "  \}",
      "  if k == K_STR \{",
      "    let n = get_word(st)",
      "    return str_from(get_bytes(st, n), n)",
      "  \}",
      "  if k == K_BYTES \{",
      "    let n = get_word(st)",
      "    return bytes_from(get_bytes(st, n), n)",
      "  \}",
      "  if k == K_LIST \{",
      "    let n = get_word(st)",
      "    let l = list_with_cap(td, n)",
      "    let et = peek(td + 16)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      append_owned(l, get_value(st, et))",
      "      i = i + 1",
      "    \}",
      "    return l",
      "  \}",
      "  if k == K_MAP \{",
      "    let n = get_word(st)",
      "    var m = map_new(td)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      let key = get_value(st, peek(td + 16))",
      "      m = Map_set_owned(m, key, get_value(st, peek(td + 24)))",
      "      i = i + 1",
      "    \}",
      "    return m",
      "  \}",
      "  if k == K_RECORD \{",
      "    let nf = peek(td + 16)",
      "    let o = obj_new(16 + nf * 8, td)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      poke(o + 16 + i * 8, get_value(st, peek(peek(td + 24) + i * 8)))",
      "      i = i + 1",
      "    \}",
      "    return o",
      "  \}",
      "  if k == K_ENUM \{",
      "    let tagv = get_word(st)",
      "    let row = peek(td + 24) + tagv * 32",
      "    let nf = peek(row + 8)",
      "    let o = obj_new(24 + nf * 8, td)",
      "    poke(o + 16, tagv)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      poke(o + 24 + i * 8, get_value(st, peek(peek(row + 16) + i * 8)))",
      "      i = i + 1",
      "    \}",
      "    return o",
      "  \}",
      "  return fatal(bits(\"internal: par_map cannot receive this value\"))",
      "\}",
      "",
    ],
    "rt/profile.klar" => [
      "// Klar runtime: the profiler of `klarc profile`. A profile build calls prof_start with its tables, prof_enter /",
      "// prof_exit around every user function, prof_line before every statement; at the end of the program (or at a",
      "// runtime error, or exit) prof_finish writes the counts on stderr for klarc:",
      "//   `\\0prof:T <total ns>` / `\\0prof:F <calls> <total ns> <self ns> <first exit> <key>` /",
      "//   `\\0prof:L <count> <first run> <file>:<line>`",
      "// (state at g_rt + G_PROF: [keys table][lines table][fn stats][line stats][stack][depth][start][seq][call site])",
      "",
      "fn prof_state() -> Word \{",
      "  return peek(g() + G_PROF)",
      "\}",
      "",
      "fn prof_start(keys: Word, lines: Word) -> Word \{",
      "  let st = alloc(72)",
      "  let nf = peek(keys)",
      "  let nl = peek(lines)",
      "  let fs = alloc(nf * 40 + 8)",
      "  var i: Word = 0",
      "  while i < nf * 5 \{",
      "    poke(fs + i * 8, 0)",
      "    i = i + 1",
      "  \}",
      "  let ls = alloc(nl * 16 + 8)",
      "  i = 0",
      "  while i < nl * 2 \{",
      "    poke(ls + i * 8, 0)",
      "    i = i + 1",
      "  \}",
      "  poke(st, keys)",
      "  poke(st + 8, lines)",
      "  poke(st + 16, fs)",
      "  poke(st + 24, ls)",
      "  poke(st + 32, alloc(24 * 10010))",
      "  poke(st + 40, 0)",
      "  poke(st + 48, os_time_ns())",
      "  poke(st + 56, 0)",
      "  poke(st + 64, 0)",
      "  poke(g() + G_PROF, st)",
      "  return 0",
      "\}",
      "",
      "fn prof_next_seq(st: Word) -> Word \{",
      "  let s = peek(st + 56) + 1",
      "  poke(st + 56, s)",
      "  return s",
      "\}",
      "",
      "fn prof_line(idx: Word) -> Word \{",
      "  let st = prof_state()",
      "  if st == 0 \{",
      "    return 0",
      "  \}",
      "  let row = peek(st + 24) + idx * 16",
      "  if peek(row) == 0 \{",
      "    poke(row + 8, prof_next_seq(st))",
      "  \}",
      "  poke(row, peek(row) + 1)",
      "  return 0",
      "\}",
      "",
      "fn prof_enter(id: Word) -> Word \{",
      "  let st = prof_state()",
      "  if st == 0 \{",
      "    return 0",
      "  \}",
      "  let d = peek(st + 40)",
      "  if d < 10000 \{",
      "    let fr = peek(st + 32) + d * 24",
      "    poke(fr, id)",
      "    poke(fr + 8, os_time_ns())",
      "    poke(fr + 16, 0)",
      "  \}",
      "  poke(st + 40, d + 1)",
      "  return 0",
      "\}",
      "",
      "// a call expression of the program: the lambdas it calls (directly or through a built-in) are named after its line",
      "// (like klar profile); returns the site it replaces, which the caller puts back after the call",
      "fn prof_site(id: Word) -> Word \{",
      "  let st = prof_state()",
      "  if st == 0 \{",
      "    return 0",
      "  \}",
      "  let old = peek(st + 64)",
      "  poke(st + 64, id)",
      "  return old",
      "\}",
      "",
      "fn prof_enter_site() -> Word \{",
      "  let st = prof_state()",
      "  if st == 0 \{",
      "    return 0",
      "  \}",
      "  return prof_enter(peek(st + 64))",
      "\}",
      "",
      "fn prof_exit() -> Word \{",
      "  let st = prof_state()",
      "  if st == 0 \{",
      "    return 0",
      "  \}",
      "  let d = peek(st + 40) - 1",
      "  if d < 0 \{",
      "    return 0",
      "  \}",
      "  poke(st + 40, d)",
      "  if d >= 10000 \{",
      "    return 0",
      "  \}",
      "  let fr = peek(st + 32) + d * 24",
      "  let id = peek(fr)",
      "  let elapsed = os_time_ns() - peek(fr + 8)",
      "  // [calls][total][self][first exit]",
      "  let rec = peek(st + 16) + id * 40",
      "  if peek(rec) == 0 \{",
      "    poke(rec + 24, prof_next_seq(st))",
      "  \}",
      "  poke(rec, peek(rec) + 1)",
      "  var outer = true",
      "  var k: Word = 0",
      "  while k < d \{",
      "    if peek(peek(st + 32) + k * 24) == id \{",
      "      outer = false",
      "    \}",
      "    k = k + 1",
      "  \}",
      "  if outer \{",
      "    poke(rec + 8, peek(rec + 8) + elapsed)",
      "  \}",
      "  poke(rec + 16, peek(rec + 16) + elapsed - peek(fr + 16))",
      "  if d > 0 \{",
      "    let parent = peek(st + 32) + (d - 1) * 24",
      "    poke(parent + 16, peek(parent + 16) + elapsed)",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn prof_put(b: Word) \{",
      "  let s = sb_finish(b)",
      "  write_all(2, s + 32, peek(s + 16))",
      "  rc_dec(s)",
      "\}",
      "",
      "// the end of the program: the open calls end now, then the counts go to stderr",
      "fn prof_finish() -> Word \{",
      "  let st = prof_state()",
      "  if st == 0 \{",
      "    return 0",
      "  \}",
      "  flush_out()",
      "  while peek(st + 40) > 0 \{",
      "    prof_exit()",
      "  \}",
      "  poke(g() + G_PROF, 0)",
      "  let b = sb_new()",
      "  sb_add_byte(b, 0)",
      "  sb_add_cstr(b, \"prof:T \")",
      "  sb_add_word(b, os_time_ns() - peek(st + 48))",
      "  sb_add_byte(b, 10)",
      "  prof_put(b)",
      "  let keys = peek(st)",
      "  var i: Word = 0",
      "  while i < peek(keys) \{",
      "    let rec = peek(st + 16) + i * 40",
      "    if peek(rec) > 0 \{",
      "      let r = sb_new()",
      "      sb_add_byte(r, 0)",
      "      sb_add_cstr(r, \"prof:F \")",
      "      sb_add_word(r, peek(rec))",
      "      sb_add_byte(r, 32)",
      "      sb_add_word(r, peek(rec + 8))",
      "      sb_add_byte(r, 32)",
      "      sb_add_word(r, peek(rec + 16))",
      "      sb_add_byte(r, 32)",
      "      sb_add_word(r, peek(rec + 24))",
      "      sb_add_byte(r, 32)",
      "      sb_add_str(r, peek(keys + 8 + i * 8))",
      "      sb_add_byte(r, 10)",
      "      prof_put(r)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  let lines = peek(st + 8)",
      "  i = 0",
      "  while i < peek(lines) \{",
      "    let row = peek(st + 24) + i * 16",
      "    if peek(row) > 0 \{",
      "      let r = sb_new()",
      "      sb_add_byte(r, 0)",
      "      sb_add_cstr(r, \"prof:L \")",
      "      sb_add_word(r, peek(row))",
      "      sb_add_byte(r, 32)",
      "      sb_add_word(r, peek(row + 8))",
      "      sb_add_byte(r, 32)",
      "      sb_add_str(r, peek(lines + 8 + i * 16))",
      "      sb_add_byte(r, 58)",
      "      sb_add_word(r, peek(lines + 16 + i * 16))",
      "      sb_add_byte(r, 10)",
      "      prof_put(r)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return 0",
      "\}",
      "",
    ],
    "rt/prop.klar" => [
      "// Klar runtime: property-based testing in native code, with the inputs `klar test` generates.",
      "//",
      "// The interpreter (klar/interpreter.py) draws inputs from Python's `random.Random(f\"\{seed\}:\{name\}\")`; to report the",
      "// same counterexamples, this file reproduces that generator exactly: the seed string is hashed with SHA-512 and fed to",
      "// a Mersenne Twister (init_by_array), and random() / getrandbits / randbelow / randint / choice / uniform / round(x, 3)",
      "// follow CPython. Each run of a property happens in a child process (fork), so a runtime error ends only that run;",
      "// the child reports the error through a pipe and the parent shrinks the inputs like the interpreter does.",
      "",
      "// ---- SHA-512 -------------------------------------------------------------------------------------------------",
      "",
      "fn sha_k() -> Word \{",
      "  let k = alloc(640)",
      "  poke(k + 0, 4794697086780616226)",
      "  poke(k + 8, 8158064640168781261)",
      "  poke(k + 16, -5349999486874862801)",
      "  poke(k + 24, -1606136188198331460)",
      "  poke(k + 32, 4131703408338449720)",
      "  poke(k + 40, 6480981068601479193)",
      "  poke(k + 48, -7908458776815382629)",
      "  poke(k + 56, -6116909921290321640)",
      "  poke(k + 64, -2880145864133508542)",
      "  poke(k + 72, 1334009975649890238)",
      "  poke(k + 80, 2608012711638119052)",
      "  poke(k + 88, 6128411473006802146)",
      "  poke(k + 96, 8268148722764581231)",
      "  poke(k + 104, -9160688886553864527)",
      "  poke(k + 112, -7215885187991268811)",
      "  poke(k + 120, -4495734319001033068)",
      "  poke(k + 128, -1973867731355612462)",
      "  poke(k + 136, -1171420211273849373)",
      "  poke(k + 144, 1135362057144423861)",
      "  poke(k + 152, 2597628984639134821)",
      "  poke(k + 160, 3308224258029322869)",
      "  poke(k + 168, 5365058923640841347)",
      "  poke(k + 176, 6679025012923562964)",
      "  poke(k + 184, 8573033837759648693)",
      "  poke(k + 192, -7476448914759557205)",
      "  poke(k + 200, -6327057829258317296)",
      "  poke(k + 208, -5763719355590565569)",
      "  poke(k + 216, -4658551843659510044)",
      "  poke(k + 224, -4116276920077217854)",
      "  poke(k + 232, -3051310485924567259)",
      "  poke(k + 240, 489312712824947311)",
      "  poke(k + 248, 1452737877330783856)",
      "  poke(k + 256, 2861767655752347644)",
      "  poke(k + 264, 3322285676063803686)",
      "  poke(k + 272, 5560940570517711597)",
      "  poke(k + 280, 5996557281743188959)",
      "  poke(k + 288, 7280758554555802590)",
      "  poke(k + 296, 8532644243296465576)",
      "  poke(k + 304, -9096487096722542874)",
      "  poke(k + 312, -7894198246740708037)",
      "  poke(k + 320, -6719396339535248540)",
      "  poke(k + 328, -6333637450476146687)",
      "  poke(k + 336, -4446306890439682159)",
      "  poke(k + 344, -4076793802049405392)",
      "  poke(k + 352, -3345356375505022440)",
      "  poke(k + 360, -2983346525034927856)",
      "  poke(k + 368, -860691631967231958)",
      "  poke(k + 376, 1182934255886127544)",
      "  poke(k + 384, 1847814050463011016)",
      "  poke(k + 392, 2177327727835720531)",
      "  poke(k + 400, 2830643537854262169)",
      "  poke(k + 408, 3796741975233480872)",
      "  poke(k + 416, 4115178125766777443)",
      "  poke(k + 424, 5681478168544905931)",
      "  poke(k + 432, 6601373596472566643)",
      "  poke(k + 440, 7507060721942968483)",
      "  poke(k + 448, 8399075790359081724)",
      "  poke(k + 456, 8693463985226723168)",
      "  poke(k + 464, -8878714635349349518)",
      "  poke(k + 472, -8302665154208450068)",
      "  poke(k + 480, -8016688836872298968)",
      "  poke(k + 488, -6606660893046293015)",
      "  poke(k + 496, -4685533653050689259)",
      "  poke(k + 504, -4147400797238176981)",
      "  poke(k + 512, -3880063495543823972)",
      "  poke(k + 520, -3348786107499101689)",
      "  poke(k + 528, -1523767162380948706)",
      "  poke(k + 536, -757361751448694408)",
      "  poke(k + 544, 500013540394364858)",
      "  poke(k + 552, 748580250866718886)",
      "  poke(k + 560, 1242879168328830382)",
      "  poke(k + 568, 1977374033974150939)",
      "  poke(k + 576, 2944078676154940804)",
      "  poke(k + 584, 3659926193048069267)",
      "  poke(k + 592, 4368137639120453308)",
      "  poke(k + 600, 4836135668995329356)",
      "  poke(k + 608, 5532061633213252278)",
      "  poke(k + 616, 6448918945643986474)",
      "  poke(k + 624, 6902733635092675308)",
      "  poke(k + 632, 7801388544844847127)",
      "  return k",
      "\}",
      "",
      "fn sha_h0(h: Word) \{",
      "  poke(h + 0, 7640891576956012808)",
      "  poke(h + 8, -4942790177534073029)",
      "  poke(h + 16, 4354685564936845355)",
      "  poke(h + 24, -6534734903238641935)",
      "  poke(h + 32, 5840696475078001361)",
      "  poke(h + 40, -7276294671716946913)",
      "  poke(h + 48, 2270897969802886507)",
      "  poke(h + 56, 6620516959819538809)",
      "\}",
      "",
      "fn rotr(x: Word, n: Word) -> Word \{",
      "  return w_or(w_shr(x, n), w_shl(x, 64 - n))",
      "\}",
      "",
      "fn be64(p: Word) -> Word \{",
      "  var v: Word = 0",
      "  var i: Word = 0",
      "  while i < 8 \{",
      "    v = w_or(w_shl(v, 8), peek8(p + i))",
      "    i = i + 1",
      "  \}",
      "  return v",
      "\}",
      "",
      "// SHA-512 of n bytes at p: the 64-byte digest is written to out",
      "fn sha512(p: Word, n: Word, out: Word) \{",
      "  let k = sha_k()",
      "  let h = alloc(64)",
      "  sha_h0(h)",
      "  // the padded message: data, 0x80, zeros, the length in bits (128-bit big-endian)",
      "  var total = n + 17",
      "  total = total + w_and(128 - w_and(total, 127), 127)",
      "  let msg = alloc(total)",
      "  var i: Word = 0",
      "  while i < total \{",
      "    poke8(msg + i, 0)",
      "    i = i + 1",
      "  \}",
      "  copy_bytes(msg, p, n)",
      "  poke8(msg + n, 128)",
      "  let bitlen = n * 8",
      "  i = 0",
      "  while i < 8 \{",
      "    poke8(msg + total - 1 - i, w_and(w_shr(bitlen, i * 8), 255))",
      "    i = i + 1",
      "  \}",
      "  let w = alloc(640)",
      "  var blk: Word = 0",
      "  while blk < total \{",
      "    var t: Word = 0",
      "    while t < 16 \{",
      "      poke(w + t * 8, be64(msg + blk + t * 8))",
      "      t = t + 1",
      "    \}",
      "    while t < 80 \{",
      "      let w15 = peek(w + (t - 15) * 8)",
      "      let w2 = peek(w + (t - 2) * 8)",
      "      let s0 = w_xor(w_xor(rotr(w15, 1), rotr(w15, 8)), w_shr(w15, 7))",
      "      let s1 = w_xor(w_xor(rotr(w2, 19), rotr(w2, 61)), w_shr(w2, 6))",
      "      poke(w + t * 8, peek(w + (t - 16) * 8) + s0 + peek(w + (t - 7) * 8) + s1)",
      "      t = t + 1",
      "    \}",
      "    var a = peek(h)",
      "    var b = peek(h + 8)",
      "    var c = peek(h + 16)",
      "    var d = peek(h + 24)",
      "    var e = peek(h + 32)",
      "    var f = peek(h + 40)",
      "    var g2 = peek(h + 48)",
      "    var hh = peek(h + 56)",
      "    t = 0",
      "    while t < 80 \{",
      "      let s1 = w_xor(w_xor(rotr(e, 14), rotr(e, 18)), rotr(e, 41))",
      "      let ch = w_xor(w_and(e, f), w_and(w_xor(e, -1), g2))",
      "      let t1 = hh + s1 + ch + peek(k + t * 8) + peek(w + t * 8)",
      "      let s0 = w_xor(w_xor(rotr(a, 28), rotr(a, 34)), rotr(a, 39))",
      "      let maj = w_xor(w_xor(w_and(a, b), w_and(a, c)), w_and(b, c))",
      "      let t2 = s0 + maj",
      "      hh = g2",
      "      g2 = f",
      "      f = e",
      "      e = d + t1",
      "      d = c",
      "      c = b",
      "      b = a",
      "      a = t1 + t2",
      "      t = t + 1",
      "    \}",
      "    poke(h, peek(h) + a)",
      "    poke(h + 8, peek(h + 8) + b)",
      "    poke(h + 16, peek(h + 16) + c)",
      "    poke(h + 24, peek(h + 24) + d)",
      "    poke(h + 32, peek(h + 32) + e)",
      "    poke(h + 40, peek(h + 40) + f)",
      "    poke(h + 48, peek(h + 48) + g2)",
      "    poke(h + 56, peek(h + 56) + hh)",
      "    blk = blk + 128",
      "  \}",
      "  i = 0",
      "  while i < 64 \{",
      "    poke8(out + i, w_and(w_shr(peek(h + w_and(i, -8)), 56 - 8 * w_and(i, 7)), 255))",
      "    i = i + 1",
      "  \}",
      "  block_free(msg)",
      "  block_free(w)",
      "  block_free(h)",
      "  block_free(k)",
      "\}",
      "",
      "// ---- Python's random.Random -----------------------------------------------------------------------------------",
      "// state: 624 words of the Mersenne Twister (32-bit values) and the index at +4992",
      "",
      "const MT_N: Word = 624",
      "",
      "fn mt_init(st: Word, s: Word) \{",
      "  poke(st, w_and(s, 4294967295))",
      "  var i: Word = 1",
      "  while i < MT_N \{",
      "    let prev = peek(st + (i - 1) * 8)",
      "    poke(st + i * 8, w_and(1812433253 * w_xor(prev, w_shr(prev, 30)) + i, 4294967295))",
      "    i = i + 1",
      "  \}",
      "  poke(st + MT_N * 8, MT_N)",
      "\}",
      "",
      "// init_by_array with the key words (32-bit) at key",
      "fn mt_init_array(st: Word, key: Word, klen: Word) \{",
      "  mt_init(st, 19650218)",
      "  var i: Word = 1",
      "  var j: Word = 0",
      "  var k = MT_N",
      "  if klen > k \{",
      "    k = klen",
      "  \}",
      "  while k > 0 \{",
      "    let prev = peek(st + (i - 1) * 8)",
      "    let x = w_xor(peek(st + i * 8), w_xor(prev, w_shr(prev, 30)) * 1664525)",
      "    poke(st + i * 8, w_and(x + peek(key + j * 8) + j, 4294967295))",
      "    i = i + 1",
      "    j = j + 1",
      "    if i >= MT_N \{",
      "      poke(st, peek(st + (MT_N - 1) * 8))",
      "      i = 1",
      "    \}",
      "    if j >= klen \{",
      "      j = 0",
      "    \}",
      "    k = k - 1",
      "  \}",
      "  k = MT_N - 1",
      "  while k > 0 \{",
      "    let prev = peek(st + (i - 1) * 8)",
      "    let x = w_xor(peek(st + i * 8), w_xor(prev, w_shr(prev, 30)) * 1566083941)",
      "    poke(st + i * 8, w_and(x - i, 4294967295))",
      "    i = i + 1",
      "    if i >= MT_N \{",
      "      poke(st, peek(st + (MT_N - 1) * 8))",
      "      i = 1",
      "    \}",
      "    k = k - 1",
      "  \}",
      "  poke(st, 2147483648)",
      "\}",
      "",
      "fn mt_next(st: Word) -> Word \{",
      "  if peek(st + MT_N * 8) >= MT_N \{",
      "    var kk: Word = 0",
      "    while kk < MT_N \{",
      "      let y = w_or(w_and(peek(st + kk * 8), 2147483648), w_and(peek(st + w_urem(kk + 1, MT_N) * 8), 2147483647))",
      "      var v = w_xor(peek(st + w_urem(kk + 397, MT_N) * 8), w_shr(y, 1))",
      "      if w_and(y, 1) == 1 \{",
      "        v = w_xor(v, 2567483615)",
      "      \}",
      "      poke(st + kk * 8, v)",
      "      kk = kk + 1",
      "    \}",
      "    poke(st + MT_N * 8, 0)",
      "  \}",
      "  let idx = peek(st + MT_N * 8)",
      "  var y = peek(st + idx * 8)",
      "  poke(st + MT_N * 8, idx + 1)",
      "  y = w_xor(y, w_shr(y, 11))",
      "  y = w_xor(y, w_and(w_shl(y, 7), 2636928640))",
      "  y = w_xor(y, w_and(w_shl(y, 15), 4022730752))",
      "  y = w_xor(y, w_shr(y, 18))",
      "  return w_and(y, 4294967295)",
      "\}",
      "",
      "// random.Random(text): SHA-512 of the text appended to it, as one big integer, gives the key words",
      "fn rng_new(text: Word) -> Word \{",
      "  let n = peek(text + 16)",
      "  let bytes = alloc(n + 64)",
      "  copy_bytes(bytes, text + 32, n)",
      "  sha512(text + 32, n, bytes + n)",
      "  let total = n + 64",
      "  let klen = w_udiv(total + 3, 4)",
      "  let key = alloc(klen * 8)",
      "  var i: Word = 0",
      "  while i < klen \{",
      "    var v: Word = 0",
      "    var b: Word = 0",
      "    while b < 4 \{",
      "      // byte b of word i, counted from the end of the big-endian string",
      "      let at = total - 1 - (i * 4 + b)",
      "      if at >= 0 \{",
      "        v = w_or(v, w_shl(peek8(bytes + at), 8 * b))",
      "      \}",
      "      b = b + 1",
      "    \}",
      "    poke(key + i * 8, v)",
      "    i = i + 1",
      "  \}",
      "  let st = alloc((MT_N + 1) * 8)",
      "  mt_init_array(st, key, klen)",
      "  block_free(key)",
      "  block_free(bytes)",
      "  return st",
      "\}",
      "",
      "fn rng_random(st: Word) -> Float \{",
      "  let a = w_shr(mt_next(st), 5)",
      "  let b = w_shr(mt_next(st), 6)",
      "  return w2f(a * 67108864 + b) / 9007199254740992.0",
      "\}",
      "",
      "fn bit_length(n: Word) -> Word \{",
      "  var k: Word = 0",
      "  var v = n",
      "  while v > 0 \{",
      "    k = k + 1",
      "    v = w_shr(v, 1)",
      "  \}",
      "  return k",
      "\}",
      "",
      "// getrandbits(k) for k <= 62",
      "fn rng_bits(st: Word, k: Word) -> Word \{",
      "  if k <= 32 \{",
      "    return w_shr(mt_next(st), 32 - k)",
      "  \}",
      "  let lo = mt_next(st)",
      "  let hi = w_shr(mt_next(st), 64 - k)",
      "  return w_or(lo, w_shl(hi, 32))",
      "\}",
      "",
      "// _randbelow(n), n >= 1",
      "fn rng_below(st: Word, n: Word) -> Word \{",
      "  let k = bit_length(n)",
      "  var r = rng_bits(st, k)",
      "  while r >= n \{",
      "    r = rng_bits(st, k)",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn rng_randint(st: Word, a: Word, b: Word) -> Word \{",
      "  return a + rng_below(st, b - a + 1)",
      "\}",
      "",
      "fn rng_uniform(st: Word, a: Float, b: Float) -> Float \{",
      "  return a + (b - a) * rng_random(st)",
      "\}",
      "",
      "// Python's round(x, 3): x * 1000 rounded exactly (ties to even), then divided back",
      "fn round3(x: Float) -> Float \{",
      "  let raw = fbits(x)",
      "  let neg = raw < 0",
      "  let ex = w_and(w_shr(raw, 52), 2047)",
      "  var m = w_and(raw, 4503599627370495)",
      "  if ex == 0 \{",
      "    if m == 0 \{",
      "      return x",
      "    \}",
      "  \} else \{",
      "    m = w_or(m, 4503599627370496)",
      "  \}",
      "  var e = ex - 1075",
      "  if ex == 0 \{",
      "    e = -1074",
      "  \}",
      "  // |x| = m * 2^e; |x| * 1000 = m * 1000 * 2^e",
      "  let p = m * 1000",
      "  var q: Word = 0",
      "  if e >= 0 \{",
      "    q = w_shl(p, e)",
      "  \} else if -e < 63 \{",
      "    let s = -e",
      "    q = w_shr(p, s)",
      "    let rem = w_and(p, w_shl(1, s) - 1)",
      "    let half = w_shl(1, s - 1)",
      "    if rem > half or (rem == half and w_and(q, 1) == 1) \{",
      "      q = q + 1",
      "    \}",
      "  \}",
      "  let r = w2f(q) / 1000.0",
      "  if neg \{",
      "    return ffrom(w_or(fbits(r), w_shl(1, 63)))",
      "  \}",
      "  return r",
      "\}",
      "",
      "// ---- generating inputs (Interpreter.gen) ---------------------------------------------------------------------",
      "",
      "const ALPHABET: Str = \"abcxyzAB01 -_é\"",
      "",
      "fn td_is(td: Word, name: Str) -> Bool \{",
      "  return Str_eq(peek(td + 8), bits(name))",
      "\}",
      "",
      "fn int_value(w: Word) -> Word \{",
      "  return bits(tag(w))",
      "\}",
      "",
      "fn enum_obj(td: Word, tagv: Word, nf: Word) -> Word \{",
      "  let o = obj_new(24 + nf * 8, td)",
      "  poke(o + 16, tagv)",
      "  return o",
      "\}",
      "",
      "// the n-th character of ALPHABET, as UTF-8 bytes appended to b",
      "fn add_alpha(b: Word, i: Word) \{",
      "  let s = bits(ALPHABET)",
      "  var at: Word = 0",
      "  var k: Word = 0",
      "  while k < i \{",
      "    at = at + utf8_len(peek8(s + 32 + at))",
      "    k = k + 1",
      "  \}",
      "  sb_add_bytes(b, s + 32 + at, utf8_len(peek8(s + 32 + at)))",
      "\}",
      "",
      "fn utf8_len(c: Word) -> Word \{",
      "  if c < 128 \{",
      "    return 1",
      "  \}",
      "  if c < 224 \{",
      "    return 2",
      "  \}",
      "  if c < 240 \{",
      "    return 3",
      "  \}",
      "  return 4",
      "\}",
      "",
      "// the variants an enum value may take at this depth (deep down, only the non-recursive ones)",
      "fn enum_choices(td: Word, depth: Word, out: Word) -> Word \{",
      "  let nv = peek(td + 16)",
      "  var n: Word = 0",
      "  if depth > 3 and peek(td + 40) != 0 \{",
      "    let flags = peek(td + 40)",
      "    var i: Word = 0",
      "    while i < nv \{",
      "      if peek(flags + i * 8) == 0 \{",
      "        poke(out + n * 8, i)",
      "        n = n + 1",
      "      \}",
      "      i = i + 1",
      "    \}",
      "    if n == 0 \{",
      "      // all recursive: the one with the fewest fields (the first of them)",
      "      var best: Word = 0",
      "      var j: Word = 1",
      "      while j < nv \{",
      "        if peek(peek(td + 24) + j * 32 + 8) < peek(peek(td + 24) + best * 32 + 8) \{",
      "          best = j",
      "        \}",
      "        j = j + 1",
      "      \}",
      "      poke(out, best)",
      "      n = 1",
      "    \}",
      "    return n",
      "  \}",
      "  var i: Word = 0",
      "  while i < nv \{",
      "    poke(out + i * 8, i)",
      "    i = i + 1",
      "  \}",
      "  return nv",
      "\}",
      "",
      "fn gen(st: Word, td: Word, size: Word, depth: Word) -> Word \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    let r = rng_random(st)",
      "    if r < 0.3 \{",
      "      let c = rng_below(st, 8)",
      "      if c == 0 \{",
      "        return int_value(0)",
      "      \} else if c == 1 \{",
      "        return int_value(1)",
      "      \} else if c == 2 \{",
      "        return int_value(-1)",
      "      \} else if c == 3 \{",
      "        return int_value(2)",
      "      \} else if c == 4 \{",
      "        return int_value(-2)",
      "      \} else if c == 5 \{",
      "        return int_value(10)",
      "      \} else if c == 6 \{",
      "        return int_value(-10)",
      "      \}",
      "      return int_value(100)",
      "    \}",
      "    if r < 0.35 \{",
      "      return int_value(rng_randint(st, -1000000000000, 1000000000000))",
      "    \}",
      "    return int_value(rng_randint(st, 0 - size * 10, size * 10))",
      "  \}",
      "  if k == K_FLOAT \{",
      "    if rng_random(st) < 0.25 \{",
      "      let c = rng_below(st, 5)",
      "      if c == 0 \{",
      "        return fbits(0.0)",
      "      \} else if c == 1 \{",
      "        return fbits(1.0)",
      "      \} else if c == 2 \{",
      "        return fbits(-1.0)",
      "      \} else if c == 3 \{",
      "        return fbits(0.5)",
      "      \}",
      "      return fbits(-0.5)",
      "    \}",
      "    let lim = w2f(size * 10)",
      "    return fbits(round3(rng_uniform(st, 0.0 - lim, lim)))",
      "  \}",
      "  if k == K_BOOL \{",
      "    if rng_random(st) < 0.5 \{",
      "      return 1",
      "    \}",
      "    return 0",
      "  \}",
      "  if k == K_STR \{",
      "    let n = rng_randint(st, 0, size)",
      "    let b = sb_new()",
      "    var i: Word = 0",
      "    while i < n \{",
      "      add_alpha(b, rng_below(st, 14))",
      "      i = i + 1",
      "    \}",
      "    return sb_finish(b)",
      "  \}",
      "  if k == K_BYTES \{",
      "    let n = rng_randint(st, 0, size)",
      "    let buf = alloc(n + 1)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      let x = rng_randint(st, 0, 255)",
      "      let c = rng_below(st, 6)",
      "      var v = x",
      "      if c == 0 \{",
      "        v = 0",
      "      \} else if c == 1 \{",
      "        v = 1",
      "      \} else if c == 2 \{",
      "        v = 127",
      "      \} else if c == 3 \{",
      "        v = 128",
      "      \} else if c == 4 \{",
      "        v = 255",
      "      \}",
      "      poke8(buf + i, v)",
      "      i = i + 1",
      "    \}",
      "    let out = bytes_from(buf, n)",
      "    block_free(buf)",
      "    return out",
      "  \}",
      "  if k == K_LIST \{",
      "    let n = rng_randint(st, 0, size)",
      "    let l = list_with_cap(td, n)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      append_owned(l, gen(st, peek(td + 16), size, depth + 1))",
      "      i = i + 1",
      "    \}",
      "    return l",
      "  \}",
      "  if k == K_MAP \{",
      "    let n = rng_randint(st, 0, size)",
      "    var m = map_new(td)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      let key = gen(st, peek(td + 16), size, depth + 1)",
      "      m = Map_set_owned(m, key, gen(st, peek(td + 24), size, depth + 1))",
      "      i = i + 1",
      "    \}",
      "    return m",
      "  \}",
      "  if k == K_RECORD \{",
      "    let nf = peek(td + 16)",
      "    let o = obj_new(16 + nf * 8, td)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      poke(o + 16 + i * 8, gen(st, peek(peek(td + 24) + i * 8), size, depth + 1))",
      "      i = i + 1",
      "    \}",
      "    return o",
      "  \}",
      "  if k == K_ENUM \{",
      "    let vtab = peek(td + 24)",
      "    if td_is(td, \"Option\") and peek(td + 32) == 1 \{",
      "      if rng_random(st) < 0.25 \{",
      "        return enum_obj(td, 0, 0)",
      "      \}",
      "      let o = enum_obj(td, 1, 1)",
      "      poke(o + 24, gen(st, peek(peek(vtab + 32 + 16)), size, depth + 1))",
      "      return o",
      "    \}",
      "    if td_is(td, \"Result\") and peek(td + 32) == 1 \{",
      "      var tagv: Word = 1",
      "      if rng_random(st) < 0.5 \{",
      "        tagv = 0",
      "      \}",
      "      let o = enum_obj(td, tagv, 1)",
      "      poke(o + 24, gen(st, peek(peek(vtab + tagv * 32 + 16)), size, depth + 1))",
      "      return o",
      "    \}",
      "    let choices = alloc(peek(td + 16) * 8 + 8)",
      "    let n = enum_choices(td, depth, choices)",
      "    let tagv = peek(choices + rng_below(st, n) * 8)",
      "    block_free(choices)",
      "    let row = vtab + tagv * 32",
      "    let nf = peek(row + 8)",
      "    let o = enum_obj(td, tagv, nf)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      poke(o + 24 + i * 8, gen(st, peek(peek(row + 16) + i * 8), size, depth + 1))",
      "      i = i + 1",
      "    \}",
      "    return o",
      "  \}",
      "  return 0",
      "\}",
      "",
      "// ---- shrinking (Interpreter.shrink_value) -----------------------------------------------------------------------",
      "// a vector of words: [len][cap][data]",
      "",
      "fn vec_new() -> Word \{",
      "  let v = alloc(24)",
      "  poke(v, 0)",
      "  poke(v + 8, 8)",
      "  poke(v + 16, alloc(64))",
      "  return v",
      "\}",
      "",
      "fn vec_push(v: Word, x: Word) \{",
      "  let n = peek(v)",
      "  if n == peek(v + 8) \{",
      "    let data = alloc(n * 16)",
      "    copy_words(data, peek(v + 16), n)",
      "    poke(v + 16, data)",
      "    poke(v + 8, n * 2)",
      "  \}",
      "  poke(peek(v + 16) + n * 8, x)",
      "  poke(v, n + 1)",
      "\}",
      "",
      "fn vec_at(v: Word, i: Word) -> Word \{",
      "  return peek(peek(v + 16) + i * 8)",
      "\}",
      "",
      "// byte offset of character ci in a string",
      "fn char_at(s: Word, ci: Word) -> Word \{",
      "  var at: Word = 0",
      "  var k: Word = 0",
      "  let n = peek(s + 16)",
      "  while k < ci and at < n \{",
      "    at = at + utf8_len(peek8(s + 32 + at))",
      "    k = k + 1",
      "  \}",
      "  return at",
      "\}",
      "",
      "fn str_part(s: Word, a: Word, b: Word) -> Word \{",
      "  let pa = char_at(s, a)",
      "  let pb = char_at(s, b)",
      "  return str_from(s + 32 + pa, pb - pa)",
      "\}",
      "",
      "fn list_part(l: Word, td: Word, a: Word, b: Word) -> Word \{",
      "  let out = list_with_cap(td, b - a + 1)",
      "  var i = a",
      "  while i < b \{",
      "    let x = list_at(l, i)",
      "    retain_v(x, peek(td + 16))",
      "    append_owned(out, x)",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "// copy of a list without element `skip`",
      "fn list_without(l: Word, td: Word, skip: Word) -> Word \{",
      "  let n = peek(l + 16)",
      "  let out = list_with_cap(td, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    if i != skip \{",
      "      let x = list_at(l, i)",
      "      retain_v(x, peek(td + 16))",
      "      append_owned(out, x)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn list_with(l: Word, td: Word, at: Word, c: Word) -> Word \{",
      "  let n = peek(l + 16)",
      "  let out = list_with_cap(td, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    if i == at \{",
      "      append_owned(out, c)",
      "    \} else \{",
      "      let x = list_at(l, i)",
      "      retain_v(x, peek(td + 16))",
      "      append_owned(out, x)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn map_without(m: Word, td: Word, skip: Word) -> Word \{",
      "  var out = map_new(td)",
      "  let n = peek(m + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    if i != skip \{",
      "      let key = peek(peek(m + 32) + i * 8)",
      "      let val = peek(peek(m + 40) + i * 8)",
      "      retain_v(key, peek(td + 16))",
      "      retain_v(val, peek(td + 24))",
      "      out = Map_set_owned(out, key, val)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return out",
      "\}",
      "",
      "// copy of a record / enum object (header `hdr` words before the fields) with field i replaced by c (owned)",
      "fn obj_with(o: Word, td: Word, hdr: Word, nf: Word, ftab: Word, i: Word, c: Word) -> Word \{",
      "  let r = obj_new(hdr + nf * 8, td)",
      "  if hdr == 24 \{",
      "    poke(r + 16, peek(o + 16))",
      "  \}",
      "  var j: Word = 0",
      "  while j < nf \{",
      "    if j == i \{",
      "      poke(r + hdr + j * 8, c)",
      "    \} else \{",
      "      let x = peek(o + hdr + j * 8)",
      "      retain_v(x, peek(ftab + j * 8))",
      "      poke(r + hdr + j * 8, x)",
      "    \}",
      "    j = j + 1",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn shrink(v: Word, td: Word) -> Word \{",
      "  let out = vec_new()",
      "  let k = peek(td)",
      "  if k == K_BOOL \{",
      "    if v == 1 \{",
      "      vec_push(out, 0)",
      "    \}",
      "  \} else if k == K_INT \{",
      "    if w_and(v, 1) == 1 and v != 1 \{",
      "      let x = w_sar(v, 1)",
      "      var step: Word = 1",
      "      if x < 0 \{",
      "        step = -1",
      "      \}",
      "      vec_push(out, int_value(0))",
      "      vec_push(out, int_value(x / 2))",
      "      vec_push(out, int_value(x - step))",
      "    \}",
      "  \} else if k == K_FLOAT \{",
      "    let x = ffrom(v)",
      "    if x != 0.0 \{",
      "      vec_push(out, fbits(0.0))",
      "      vec_push(out, fbits(w2f(f2w(x))))",
      "      vec_push(out, fbits(x / 2.0))",
      "    \}",
      "  \} else if k == K_STR \{",
      "    let n = str_nchars(v)",
      "    if n > 0 \{",
      "      vec_push(out, str_part(v, 0, 0))",
      "      vec_push(out, str_part(v, 0, n / 2))",
      "      vec_push(out, str_part(v, 1, n))",
      "      vec_push(out, str_part(v, 0, n - 1))",
      "    \}",
      "  \} else if k == K_BYTES \{",
      "    let n = peek(v + 16)",
      "    if n > 0 \{",
      "      let p = peek(v + 32)",
      "      vec_push(out, bytes_from(p, 0))",
      "      vec_push(out, bytes_from(p, n / 2))",
      "      vec_push(out, bytes_from(p + 1, n - 1))",
      "      vec_push(out, bytes_from(p, n - 1))",
      "    \}",
      "  \} else if k == K_LIST \{",
      "    let n = peek(v + 16)",
      "    if n > 0 \{",
      "      vec_push(out, list_part(v, td, 0, 0))",
      "      vec_push(out, list_part(v, td, 0, n / 2))",
      "      vec_push(out, list_part(v, td, n / 2, n))",
      "      var i: Word = 0",
      "      while i < n and i < 8 \{",
      "        vec_push(out, list_without(v, td, i))",
      "        i = i + 1",
      "      \}",
      "      i = 0",
      "      while i < n and i < 8 \{",
      "        let sub = shrink(list_at(v, i), peek(td + 16))",
      "        var j: Word = 0",
      "        while j < peek(sub) and j < 3 \{",
      "          vec_push(out, list_with(v, td, i, vec_at(sub, j)))",
      "          j = j + 1",
      "        \}",
      "        i = i + 1",
      "      \}",
      "    \}",
      "  \} else if k == K_MAP \{",
      "    let n = peek(v + 16)",
      "    if n > 0 \{",
      "      vec_push(out, map_new(td))",
      "      var i: Word = 0",
      "      while i < n and i < 8 \{",
      "        vec_push(out, map_without(v, td, i))",
      "        i = i + 1",
      "      \}",
      "    \}",
      "  \} else if k == K_ENUM \{",
      "    let tagv = peek(v + 16)",
      "    let row = peek(td + 24) + tagv * 32",
      "    let nf = peek(row + 8)",
      "    let special = peek(td + 32) == 1",
      "    if special and td_is(td, \"Option\") and tagv == 1 \{",
      "      vec_push(out, enum_obj(td, 0, 0))",
      "    \}",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      let sub = shrink(peek(v + 24 + i * 8), peek(peek(row + 16) + i * 8))",
      "      var j: Word = 0",
      "      while j < peek(sub) and j < 3 \{",
      "        vec_push(out, obj_with(v, td, 24, nf, peek(row + 16), i, vec_at(sub, j)))",
      "        j = j + 1",
      "      \}",
      "      i = i + 1",
      "    \}",
      "    if not special \{",
      "      // simpler values of a recursive enum: a payload of the same enum",
      "      i = 0",
      "      while i < nf \{",
      "        let ftd = peek(peek(row + 16) + i * 8)",
      "        if peek(ftd) == K_ENUM and Str_eq(peek(ftd + 8), peek(td + 8)) \{",
      "          vec_push(out, peek(v + 24 + i * 8))",
      "        \}",
      "        i = i + 1",
      "      \}",
      "    \}",
      "  \} else if k == K_RECORD \{",
      "    let nf = peek(td + 16)",
      "    var i: Word = 0",
      "    while i < nf \{",
      "      let sub = shrink(peek(v + 16 + i * 8), peek(peek(td + 24) + i * 8))",
      "      var j: Word = 0",
      "      while j < peek(sub) and j < 3 \{",
      "        vec_push(out, obj_with(v, td, 16, nf, peek(td + 24), i, vec_at(sub, j)))",
      "        j = j + 1",
      "      \}",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  // only candidates that differ from the value",
      "  let kept = vec_new()",
      "  var i: Word = 0",
      "  while i < peek(out) \{",
      "    if not eq_v(vec_at(out, i), v, td) \{",
      "      vec_push(kept, vec_at(out, i))",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return kept",
      "\}",
      "",
      "// ---- running a property ------------------------------------------------------------------------------------------",
      "// One run happens in a child process; a runtime error there (fail_with with G_PROP set) is sent back through a pipe as",
      "// [code][message][span][details...][stack note][hint] (strings as length + bytes) and the child exits. Without fork",
      "// (Windows) the run happens in this process: G_PROPJB holds the os_setjmp buffer, and the report goes back there by",
      "// os_longjmp (the memory the failed run held is not freed).",
      "",
      "fn put_str(b: Word, s: Word) \{",
      "  put_word(b, peek(s + 16))",
      "  sb_add_bytes(b, s + 32, peek(s + 16))",
      "\}",
      "",
      "// in the child: the report of a runtime error, written to the parent (or kept for try_prop_here)",
      "fn prop_failure(code: Word, msg: Word, sp: Word, details: Word, hint: Word) \{",
      "  let b = sb_new()",
      "  put_str(b, code)",
      "  put_str(b, msg)",
      "  put_word(b, sp)",
      "  var n: Word = 0",
      "  if details != 0 \{",
      "    n = peek(details + 16)",
      "  \}",
      "  put_word(b, n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    put_str(b, list_at(details, i))",
      "    i = i + 1",
      "  \}",
      "  let note = sb_new()",
      "  stack_note(note)",
      "  let stack = sb_finish(note)",
      "  put_str(b, stack)",
      "  put_str(b, hint)",
      "  let s = sb_finish(b)",
      "  let jb = peek(g() + G_PROPJB)",
      "  if jb != 0 \{",
      "    poke(jb + 64, s)",
      "    os_longjmp(jb, 1)",
      "  \}",
      "  write_all(peek(g() + G_PROP), s + 32, peek(s + 16))",
      "  os_exit(1)",
      "\}",
      "",
      "fn get_str(st: Word) -> Word \{",
      "  let n = get_word(st)",
      "  return str_from(get_bytes(st, n), n)",
      "\}",
      "",
      "// [code][msg][span][details list][stack text][hint]",
      "fn read_failure(text: Word) -> Word \{",
      "  let st = alloc(16)",
      "  poke(st, text + 32)",
      "  poke(st + 8, text + 32 + peek(text + 16))",
      "  let f = alloc(48)",
      "  poke(f, get_str(st))",
      "  poke(f + 8, get_str(st))",
      "  poke(f + 16, get_word(st))",
      "  let n = get_word(st)",
      "  let details = list_new_str()",
      "  var i: Word = 0",
      "  while i < n \{",
      "    append_owned(details, get_str(st))",
      "    i = i + 1",
      "  \}",
      "  poke(f + 24, details)",
      "  poke(f + 32, get_str(st))",
      "  poke(f + 40, get_str(st))",
      "  block_free(st)",
      "  return f",
      "\}",
      "",
      "// the run in this process (no fork): 0 when it holds, else its failure",
      "fn try_prop_here(clo: Word, args: Word) -> Word \{",
      "  flush_out()",
      "  let gp = g()",
      "  let jb = alloc(72)",
      "  poke(jb + 64, 0)",
      "  let nest = peek(gp + G_NEST)",
      "  poke(gp + G_PROP, 1)",
      "  poke(gp + G_PROPJB, jb)",
      "  if fake_on() \{",
      "    fake_begin()        // every run starts from fresh fakes (with fork, each child starts from the parent's)",
      "  \}",
      "  if os_setjmp(jb) == 0 \{",
      "    call1(clo, args)",
      "  \}",
      "  // (back here after the run, or from prop_failure)",
      "  poke(gp + G_NEST, nest)",
      "  poke(gp + G_OUTLEN, 0)",
      "  poke(gp + G_PROP, 0)",
      "  poke(gp + G_PROPJB, 0)",
      "  let text = peek(jb + 64)",
      "  block_free(jb)",
      "  if text == 0 \{",
      "    return 0",
      "  \}",
      "  return read_failure(text)",
      "\}",
      "",
      "// runs the property once with these arguments: 0 when it holds, else its failure",
      "fn try_prop(clo: Word, args: Word) -> Word \{",
      "  if os_platform() == 1 \{",
      "    return try_prop_here(clo, args)",
      "  \}",
      "  flush_out()",
      "  let fds = alloc(8)",
      "  os_pipe(fds)",
      "  let rfd = peek32(fds)",
      "  let wfd = peek32(fds + 4)",
      "  let pid = os_fork()",
      "  if pid == 0 \{",
      "    os_close(rfd)",
      "    poke(g() + G_PROP, wfd)",
      "    call1(clo, args)",
      "    poke(g() + G_OUTLEN, 0)",
      "    os_exit(0)",
      "  \}",
      "  os_close(wfd)",
      "  let b = sb_new()",
      "  let buf = alloc(4096)",
      "  var reading = true",
      "  while reading \{",
      "    let r = os_read(rfd, buf, 4096)",
      "    if r <= 0 \{",
      "      reading = false",
      "    \} else \{",
      "      sb_add_bytes(b, buf, r)",
      "    \}",
      "  \}",
      "  block_free(buf)",
      "  os_close(rfd)",
      "  block_free(fds)",
      "  let status = os_wait(pid)",
      "  let text = sb_finish(b)",
      "  if peek(text + 16) > 0 \{",
      "    return read_failure(text)",
      "  \}",
      "  if status == 0 \{",
      "    return 0",
      "  \}",
      "  // the child died without a report",
      "  let f = alloc(48)",
      "  poke(f, bits(\"R0000\"))",
      "  poke(f + 8, bits(\"the property's process ended unexpectedly\"))",
      "  poke(f + 16, 0)",
      "  poke(f + 24, list_new_str())",
      "  poke(f + 32, bits(\"\"))",
      "  poke(f + 40, bits(\"\"))",
      "  return f",
      "\}",
      "",
      "// Windows: the k-th word from the end of the command line (1 = the last), when it has 4 words or more; else 0",
      "fn cmdline_word(k: Word) -> Word \{",
      "  let cl = os_cmdline()",
      "  let n = cstr_len(cl)",
      "  let starts = alloc(8 * 64)",
      "  var count: Word = 0",
      "  var quoted = false",
      "  var in_word = false",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = peek8(cl + i)",
      "    if c == 34 \{",
      "      quoted = not quoted",
      "    \}",
      "    if c == 32 and not quoted \{",
      "      in_word = false",
      "    \} else if not in_word \{",
      "      in_word = true",
      "      if count < 64 \{",
      "        poke(starts + count * 8, cl + i)",
      "      \}",
      "      count = count + 1",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  var p: Word = 0",
      "  if count >= 4 and count <= 64 and k <= count \{",
      "    p = peek(starts + (count - k) * 8)",
      "  \}",
      "  block_free(starts)",
      "  return p",
      "\}",
      "",
      "// word i of `exe runs seed index` (Windows: counted from the end of the command line)",
      "fn arg_word(i: Word, default: Word) -> Word \{",
      "  var p: Word = 0",
      "  if os_platform() == 1 \{",
      "    p = cmdline_word(4 - i)",
      "  \} else if os_argc() == 4 \{",
      "    p = os_argv(i)",
      "  \}",
      "  if p == 0 \{",
      "    return default",
      "  \}",
      "  var v: Word = 0",
      "  var neg = false",
      "  var j: Word = 0",
      "  if peek8(p) == 45 \{",
      "    neg = true",
      "    j = 1",
      "  \}",
      "  while peek8(p + j) >= 48 and peek8(p + j) <= 57 \{",
      "    v = v * 10 + peek8(p + j) - 48",
      "    j = j + 1",
      "  \}",
      "  if neg \{",
      "    return 0 - v",
      "  \}",
      "  return v",
      "\}",
      "",
      "// the property `name` (span: its declaration): `clo` runs its body with an array of `n` arguments of the types `tds`",
      "// (names `names`); the executable takes `runs seed index` (default 100 runs, seed 0)",
      "fn prop_run(clo: Word, tds: Word, n: Word, names: Word, name: Word, sp: Word) -> Word \{",
      "  let runs = arg_word(1, 100)",
      "  let seed = arg_word(2, 0)",
      "  let sb = sb_new()",
      "  sb_add_word(sb, seed)",
      "  sb_add_byte(sb, 58)",
      "  sb_add_str(sb, name)",
      "  let st = rng_new(sb_finish(sb))",
      "  var i: Word = 0",
      "  while i < runs \{",
      "    var div = runs",
      "    if div < 1 \{",
      "      div = 1",
      "    \}",
      "    let size = 1 + (i * 10) / div",
      "    let args = alloc(n * 8 + 8)",
      "    var j: Word = 0",
      "    while j < n \{",
      "      poke(args + j * 8, gen(st, peek(tds + j * 8), size, 0))",
      "      j = j + 1",
      "    \}",
      "    let failure = try_prop(clo, args)",
      "    if failure != 0 and Str_eq(peek(failure), bits(\"R0018\")) \{",
      "      // out of time (rt/limit.klar): shrinking would run the slow input again and again",
      "      report_error(peek(failure), peek(failure + 8), peek(failure + 16), peek(failure + 24), peek(failure + 40),",
      "        peek(failure + 32))",
      "    \}",
      "    if failure != 0 \{",
      "      prop_falsified(clo, tds, n, names, args, failure, i + 1, seed, sp)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn prop_falsified(clo: Word, tds: Word, n: Word, names: Word, args0: Word, failure: Word, run: Word, seed: Word,",
      "  sp: Word) \{",
      "    var best = args0",
      "    var best_err = failure",
      "    var attempts: Word = 0",
      "    var improved = true",
      "    while improved and attempts < 1000 \{",
      "      improved = false",
      "      var i: Word = 0",
      "      while i < n and not improved and attempts < 1000 \{",
      "        let cands = shrink(peek(best + i * 8), peek(tds + i * 8))",
      "        var j: Word = 0",
      "        while j < peek(cands) and not improved and attempts < 1000 \{",
      "          attempts = attempts + 1",
      "          let trial = alloc(n * 8 + 8)",
      "          copy_words(trial, best, n)",
      "          poke(trial + i * 8, vec_at(cands, j))",
      "          let e = try_prop(clo, trial)",
      "          if e != 0 \{",
      "            best = trial",
      "            best_err = e",
      "            improved = true",
      "          \}",
      "          j = j + 1",
      "        \}",
      "        i = i + 1",
      "      \}",
      "    \}",
      "    // the report: the inputs, then the failure's own values",
      "    let inputs = list_new_str()",
      "    let hint = sb_new()",
      "    sb_add_cstr(hint, \"minimal counterexample: \")",
      "    var i: Word = 0",
      "    while i < n \{",
      "      let b = sb_new()",
      "      sb_add_str(b, peek(names + i * 8))",
      "      sb_add_cstr(b, \" = \")",
      "      show_into(b, peek(best + i * 8), peek(tds + i * 8), false)",
      "      let s = sb_finish(b)",
      "      if i > 0 \{",
      "        sb_add_cstr(hint, \", \")",
      "      \}",
      "      sb_add_str(hint, s)",
      "      append_owned(inputs, s)",
      "      i = i + 1",
      "    \}",
      "    sb_add_cstr(hint, \"; reproduce with `--seed \")",
      "    sb_add_word(hint, seed)",
      "    sb_add_cstr(hint, \"`\")",
      "    let details = peek(best_err + 24)",
      "    i = 0",
      "    while i < peek(details + 16) \{",
      "      let d = list_at(details, i)",
      "      rc_inc(d)",
      "      append_owned(inputs, d)",
      "      i = i + 1",
      "    \}",
      "    let msg = sb_new()",
      "    sb_add_cstr(msg, \"property falsified after \")",
      "    sb_add_word(msg, run)",
      "    sb_add_cstr(msg, \" run(s) (seed \")",
      "    sb_add_word(msg, seed)",
      "    sb_add_cstr(msg, \"): \")",
      "    sb_add_str(msg, peek(best_err + 8))",
      "    report_error(bits(\"R0010\"), sb_finish(msg), peek(best_err + 16), inputs, sb_finish(hint), peek(best_err + 32))",
      "  \}",
      "",
    ],
    "rt/sandbox.klar" => [
      "// Klar runtime: the rights of `--allow` (klar/sandbox.py, with the same checks and messages). `klar build --allow`",
      "// puts them into the executable as `g_allow`: [0] without rights, else [1, shown, fs, proc, time, rand, net, #dirs,",
      "// dirs, #programs, programs, env, #variables, variables] (`shown`: the rights as the message names them; dirs,",
      "// programs and variables: arrays of strings).",
      "",
      "const SB_SHOWN: Word = 8",
      "const SB_FS: Word = 16",
      "const SB_PROC: Word = 24",
      "const SB_TIME: Word = 32",
      "const SB_RAND: Word = 40",
      "const SB_NET: Word = 48",
      "const SB_NDIRS: Word = 56",
      "const SB_DIRS: Word = 64",
      "const SB_NPROGS: Word = 72",
      "const SB_PROGS: Word = 80",
      "const SB_ENV: Word = 88",
      "const SB_NENVS: Word = 96",
      "const SB_ENVS: Word = 104",
      "",
      "fn allow_area() -> Word \{",
      "  return static_addr(\"g_allow\")",
      "\}",
      "",
      "fn sb_on() -> Bool \{",
      "  return peek(allow_area()) != 0",
      "\}",
      "",
      "fn sb_deny(what: Str, right: Str, arg: Word, sp: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"`\")",
      "  sb_add_cstr(b, what)",
      "  sb_add_cstr(b, \"` needs `--allow \")",
      "  sb_add_cstr(b, right)",
      "  sb_add_cstr(b, \"`\")",
      "  if arg != 0 \{",
      "    sb_add_cstr(b, \" for '\")",
      "    sb_add_str(b, arg)",
      "    sb_add_cstr(b, \"'\")",
      "  \}",
      "  sb_add_cstr(b, \" (allowed: \")",
      "  sb_add_str(b, peek(allow_area() + SB_SHOWN))",
      "  sb_add_cstr(b, \")\")",
      "  let h = sb_new()",
      "  if peek8(bits(right) + 32) == 102 \{",
      "    sb_add_cstr(h, \"add the right to `--allow`: `fs` for every file or `fs:DIR` for one directory\")",
      "  \} else if peek8(bits(right) + 32) == 112 \{",
      "    sb_add_cstr(h, \"add the right to `--allow`: `proc` for every program or `proc:NAME` for one\")",
      "  \} else \{",
      "    sb_add_cstr(h, \"add `\")",
      "    sb_add_cstr(h, right)",
      "    sb_add_cstr(h, \"` to `--allow`\")",
      "  \}",
      "  var at = sp",
      "  if at == 0 \{",
      "    at = current_span()",
      "  \}",
      "  return fail_with(bits(\"R0016\"), sb_finish(b), at, 0, sb_finish(h))",
      "\}",
      "",
      "// a right without an argument (`time`, `rand`, `net`): `at` is its place in g_allow",
      "fn sb_need(what: Str, at: Word, right: Str, sp: Word) \{",
      "  if sb_on() and peek(allow_area() + at) == 0 \{",
      "    sb_deny(what, right, 0, sp)",
      "  \}",
      "\}",
      "",
      "// the absolute form of a path as its parts joined by `/` (no leading `/`), the way the system opens it: `\\` is a",
      "// separator too, relative paths start at the working directory, and `.`, `..` and symbolic links are resolved part",
      "// by part, as realpath does — so `link/..` is the parent of the link's target, and a link inside an allowed",
      "// directory that points outside of it is outside (klar/sandbox.py: `os.path.realpath`). Windows: no links resolved.",
      "fn sb_norm(path: Word) -> Word \{",
      "  let b = sb_new()",
      "  let n = peek(path + 16)",
      "  let first = peek8(path + 32)",
      "  let absolute = n > 0 and (first == 47 or first == 92) or (n >= 2 and peek8(path + 33) == 58)",
      "  if not absolute \{",
      "    let cwd = raw_cwd()",
      "    sb_add_segments(b, cwd)",
      "    rc_dec(cwd)",
      "  \}",
      "  var q = str_from(path + 32, n)",
      "  let buf = alloc(4096)",
      "  var links: Word = 0",
      "  var i: Word = 0",
      "  while i <= peek(q + 16) \{",
      "    let qn = peek(q + 16)",
      "    let p = q + 32",
      "    var j = i",
      "    while j < qn and peek8(p + j) != 47 and peek8(p + j) != 92 \{",
      "      j = j + 1",
      "    \}",
      "    let len = j - i",
      "    var next = j + 1",
      "    if len == 0 or (len == 1 and peek8(p + i) == 46) \{",
      "      // an empty part or `.`",
      "    \} else if len == 2 and peek8(p + i) == 46 and peek8(p + i + 1) == 46 \{",
      "      sb_pop_segment(b)",
      "    \} else \{",
      "      let mark = sb_len(b)",
      "      if mark > 0 \{",
      "        sb_add_byte(b, 47)",
      "      \}",
      "      sb_add_bytes(b, p + i, len)",
      "      if links < 40 \{",
      "        let c = sb_new()",
      "        sb_add_byte(c, 47)",
      "        sb_add_bytes(c, peek(b + 32), sb_len(b))",
      "        let cs = sb_finish(c)",
      "        let r = os_readlink(cs + 32, buf, 4095)",
      "        rc_dec(cs)",
      "        if r > 0 \{",
      "          // a link: its target takes its place, followed by the rest of the path",
      "          links = links + 1",
      "          poke(b + 16, mark)",
      "          if peek8(buf) == 47 \{",
      "            poke(b + 16, 0)",
      "          \}",
      "          let nq = sb_new()",
      "          sb_add_bytes(nq, buf, r)",
      "          sb_add_byte(nq, 47)",
      "          if j < qn \{",
      "            sb_add_bytes(nq, p + j, qn - j)",
      "          \}",
      "          let q2 = sb_finish(nq)",
      "          rc_dec(q)",
      "          q = q2",
      "          next = 0",
      "        \}",
      "      \}",
      "    \}",
      "    i = next",
      "  \}",
      "  block_free(buf)",
      "  rc_dec(q)",
      "  return sb_finish(b)",
      "\}",
      "",
      "// drops the last part of a path being built (`..`)",
      "fn sb_pop_segment(b: Word) \{",
      "  var k = sb_len(b) - 1",
      "  while k > 0 and peek8(peek(b + 32) + k) != 47 \{",
      "    k = k - 1",
      "  \}",
      "  if k < 0 \{",
      "    k = 0",
      "  \}",
      "  poke(b + 16, k)",
      "\}",
      "",
      "fn sb_add_segments(b: Word, s: Word) \{",
      "  let n = peek(s + 16)",
      "  let p = s + 32",
      "  var i: Word = 0",
      "  while i <= n \{",
      "    var j = i",
      "    while j < n and peek8(p + j) != 47 and peek8(p + j) != 92 \{",
      "      j = j + 1",
      "    \}",
      "    let len = j - i",
      "    if len == 0 or (len == 1 and peek8(p + i) == 46) \{",
      "      // an empty part or `.`",
      "    \} else if len == 2 and peek8(p + i) == 46 and peek8(p + i + 1) == 46 \{",
      "      var k = sb_len(b) - 1",
      "      while k > 0 and peek8(peek(b + 32) + k) != 47 \{",
      "        k = k - 1",
      "      \}",
      "      if k < 0 \{",
      "        k = 0",
      "      \}",
      "      poke(b + 16, k)",
      "    \} else \{",
      "      if sb_len(b) > 0 \{",
      "        sb_add_byte(b, 47)",
      "      \}",
      "      sb_add_bytes(b, p + i, len)",
      "    \}",
      "    i = j + 1",
      "  \}",
      "\}",
      "",
      "// whether path (normalized) lies in dir (normalized): equal, or dir followed by `/`; the root (empty) holds all",
      "fn sb_inside(path: Word, dir: Word) -> Bool \{",
      "  let dn = peek(dir + 16)",
      "  let pn = peek(path + 16)",
      "  if dn == 0 \{",
      "    return true",
      "  \}",
      "  if pn < dn or not bytes_eq(path + 32, dir + 32, dn) \{",
      "    return false",
      "  \}",
      "  return pn == dn or peek8(path + 32 + dn) == 47",
      "\}",
      "",
      "fn sb_need_fs(what: Str, path: Word, sp: Word) \{",
      "  if not sb_on() or peek(allow_area() + SB_FS) != 0 \{",
      "    return",
      "  \}",
      "  let p = sb_norm(path)",
      "  let dirs = peek(allow_area() + SB_DIRS)",
      "  var ok = false",
      "  var i: Word = 0",
      "  while not ok and i < peek(allow_area() + SB_NDIRS) \{",
      "    let d = sb_norm(peek(dirs + i * 8))",
      "    ok = sb_inside(p, d)",
      "    rc_dec(d)",
      "    i = i + 1",
      "  \}",
      "  rc_dec(p)",
      "  if not ok \{",
      "    sb_deny(what, \"fs\", path, sp)",
      "  \}",
      "\}",
      "",
      "fn sb_need_any_fs(what: Str, sp: Word) \{",
      "  if sb_on() and peek(allow_area() + SB_FS) == 0 and peek(allow_area() + SB_NDIRS) == 0 \{",
      "    sb_deny(what, \"fs\", 0, sp)",
      "  \}",
      "\}",
      "",
      "// may the program read the environment variable `name`? Without `env` / `env:NAME` in `--allow`, `env_var` returns",
      "// None (klar/sandbox.py `env_ok`): API keys and other secrets stay out of the program's output (THREATS.md T8)",
      "fn sb_env_ok(name: Word) -> Bool \{",
      "  if not sb_on() or peek(allow_area() + SB_ENV) != 0 \{",
      "    return true",
      "  \}",
      "  let names = peek(allow_area() + SB_ENVS)",
      "  var i: Word = 0",
      "  while i < peek(allow_area() + SB_NENVS) \{",
      "    if Str_eq(peek(names + i * 8), name) \{",
      "      return true",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return false",
      "\}",
      "",
      "fn sb_need_proc(what: Str, args: Word, sp: Word) \{",
      "  if not sb_on() or peek(allow_area() + SB_PROC) != 0 \{",
      "    return",
      "  \}",
      "  var prog = bits(\"\")",
      "  if peek(args + 16) > 0 \{",
      "    prog = peek(peek(args + 32))",
      "  \}",
      "  let progs = peek(allow_area() + SB_PROGS)",
      "  var i: Word = 0",
      "  while i < peek(allow_area() + SB_NPROGS) \{",
      "    if Str_eq(peek(progs + i * 8), prog) \{",
      "      return",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  sb_deny(what, \"proc\", prog, sp)",
      "\}",
      "",
    ],
    "rt/show.klar" => [
      "// Klar runtime: generic operations driven by type descriptors (show, ==, hash, ordering).",
      "",
      "// Printing, comparing and hashing walk values recursively; a value nested deeper than NEST_MAX (a list of lists of",
      "// ... built in a loop) would overflow the machine stack, so the depth is counted (g_rt + G_NEST) and is R0006 past it.",
      "const NEST_MAX: Word = 100000",
      "",
      "fn nest_in() \{",
      "  let gp = g()",
      "  let d = peek(gp + G_NEST) + 1",
      "  poke(gp + G_NEST, d)",
      "  if d > NEST_MAX \{",
      "    poke(gp + G_NEST, 0)",
      "    fail_msg(\"R0006\", \"stack overflow: a value nested more than 100000 levels deep\", current_span())",
      "  \}",
      "\}",
      "",
      "fn nest_out() \{",
      "  let gp = g()",
      "  poke(gp + G_NEST, peek(gp + G_NEST) - 1)",
      "\}",
      "",
      "fn show_into(b: Word, v: Word, td: Word, top: Bool) \{",
      "  nest_in()",
      "  show_into_at(b, v, td, top)",
      "  nest_out()",
      "\}",
      "",
      "fn eq_v(a: Word, b: Word, td: Word) -> Bool \{",
      "  nest_in()",
      "  let r = eq_v_at(a, b, td)",
      "  nest_out()",
      "  return r",
      "\}",
      "",
      "fn hash_v(v: Word, td: Word) -> Word \{",
      "  nest_in()",
      "  let r = hash_v_at(v, td)",
      "  nest_out()",
      "  return r",
      "\}",
      "",
      "fn show_into_at(b: Word, v: Word, td: Word, top: Bool) \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    int_show(b, v)",
      "  \} else if k == K_STR \{",
      "    if top \{",
      "      sb_add_str(b, v)",
      "    \} else \{",
      "      show_quoted(b, v)",
      "    \}",
      "  \} else if k == K_FLOAT \{",
      "    float_show(b, ffrom(v))",
      "  \} else if k == K_BOOL \{",
      "    if v != 0 \{",
      "      sb_add_cstr(b, \"true\")",
      "    \} else \{",
      "      sb_add_cstr(b, \"false\")",
      "    \}",
      "  \} else if k == K_UNIT \{",
      "    sb_add_cstr(b, \"()\")",
      "  \} else if k == K_WORD \{",
      "    sb_add_word(b, v)",
      "  \} else if k == K_BYTES \{",
      "    bytes_show(b, v)",
      "  \} else if k == K_LIST \{",
      "    let et = peek(td + 16)",
      "    sb_add_byte(b, 91)",
      "    let n = peek(v + 16)",
      "    let data = peek(v + 32)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      if i > 0 \{",
      "        sb_add_cstr(b, \", \")",
      "      \}",
      "      show_into(b, peek(data + i * 8), et, false)",
      "      i = i + 1",
      "    \}",
      "    sb_add_byte(b, 93)",
      "  \} else if k == K_MAP \{",
      "    let n2 = peek(v + 16)",
      "    if n2 == 0 \{",
      "      sb_add_cstr(b, \"Map \\\{\\\}\")",
      "      return",
      "    \}",
      "    sb_add_cstr(b, \"Map \\\{ \")",
      "    var j: Word = 0",
      "    while j < n2 \{",
      "      if j > 0 \{",
      "        sb_add_cstr(b, \", \")",
      "      \}",
      "      show_into(b, peek(peek(v + 32) + j * 8), peek(td + 16), false)",
      "      sb_add_cstr(b, \": \")",
      "      show_into(b, peek(peek(v + 40) + j * 8), peek(td + 24), false)",
      "      j = j + 1",
      "    \}",
      "    sb_add_cstr(b, \" \\\}\")",
      "  \} else if k == K_RECORD \{",
      "    sb_add_str(b, peek(td + 8))",
      "    sb_add_cstr(b, \" \\\{ \")",
      "    let nf = peek(td + 16)",
      "    var f: Word = 0",
      "    while f < nf \{",
      "      if f > 0 \{",
      "        sb_add_cstr(b, \", \")",
      "      \}",
      "      sb_add_str(b, peek(peek(td + 32) + f * 8))",
      "      sb_add_cstr(b, \": \")",
      "      show_into(b, peek(v + 16 + f * 8), peek(peek(td + 24) + f * 8), false)",
      "      f = f + 1",
      "    \}",
      "    sb_add_cstr(b, \" \\\}\")",
      "  \} else if k == K_ENUM \{",
      "    let row = peek(td + 24) + peek(v + 16) * 32",
      "    let nv = peek(row + 8)",
      "    let style = peek(td + 32)",
      "    if style == 0 \{",
      "      sb_add_str(b, peek(td + 8))",
      "      sb_add_byte(b, 46)",
      "    \}",
      "    sb_add_str(b, peek(row))",
      "    if nv > 0 \{",
      "      sb_add_byte(b, 40)",
      "      var a: Word = 0",
      "      while a < nv \{",
      "        if a > 0 \{",
      "          sb_add_cstr(b, \", \")",
      "        \}",
      "        if style == 0 \{",
      "          sb_add_str(b, peek(peek(row + 24) + a * 8))",
      "          sb_add_cstr(b, \": \")",
      "        \}",
      "        show_into(b, peek(v + 24 + a * 8), peek(peek(row + 16) + a * 8), false)",
      "        a = a + 1",
      "      \}",
      "      sb_add_byte(b, 41)",
      "    \}",
      "  \} else if k == K_FN \{",
      "    sb_add_cstr(b, \"<fn <lambda>>\")",
      "  \}",
      "\}",
      "",
      "fn show_quoted(b: Word, s: Word) \{",
      "  sb_add_byte(b, 34)",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = peek8(s + 32 + i)",
      "    if c == 92 \{",
      "      sb_add_cstr(b, \"\\\\\\\\\")",
      "    \} else if c == 34 \{",
      "      sb_add_cstr(b, \"\\\\\\\"\")",
      "    \} else if c == 10 \{",
      "      sb_add_cstr(b, \"\\\\n\")",
      "    \} else if c == 9 \{",
      "      sb_add_cstr(b, \"\\\\t\")",
      "    \} else if c == 123 \{",
      "      sb_add_cstr(b, \"\\\\\\\{\")",
      "    \} else if c == 125 \{",
      "      sb_add_cstr(b, \"\\\\\\\}\")",
      "    \} else \{",
      "      sb_add_byte(b, c)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  sb_add_byte(b, 34)",
      "\}",
      "",
      "fn show_to_str(v: Word, td: Word) -> Word \{",
      "  if peek(td) == K_STR \{",
      "    rc_inc(v)",
      "    return v",
      "  \}",
      "  let b = sb_new()",
      "  show_into(b, v, td, true)",
      "  return sb_finish(b)",
      "\}",
      "",
      "// a value inside an error report (`name = value`): strings quoted, as in the interpreter",
      "fn show_detail(v: Word, td: Word) -> Word \{",
      "  let b = sb_new()",
      "  show_into(b, v, td, false)",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn Str_eq(a: Word, b: Word) -> Bool \{",
      "  if a == b \{",
      "    return true",
      "  \}",
      "  let n = peek(a + 16)",
      "  if n != peek(b + 16) \{",
      "    return false",
      "  \}",
      "  return bytes_eq(a + 32, b + 32, n)",
      "\}",
      "",
      "// raw -1 / 0 / 1, byte order (= code point order for UTF-8)",
      "fn Str_cmp(a: Word, b: Word) -> Word \{",
      "  let na = peek(a + 16)",
      "  let nb = peek(b + 16)",
      "  var n = na",
      "  if nb < n \{",
      "    n = nb",
      "  \}",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let x = peek8(a + 32 + i)",
      "    let y = peek8(b + 32 + i)",
      "    if x != y \{",
      "      if x < y \{",
      "        return -1",
      "      \}",
      "      return 1",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  if na < nb \{",
      "    return -1",
      "  \}",
      "  if na > nb \{",
      "    return 1",
      "  \}",
      "  return 0",
      "\}",
      "",
      "fn eq_v_at(a: Word, b: Word, td: Word) -> Bool \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    if w_and(w_and(a, b), 1) == 1 \{",
      "      return a == b",
      "    \}",
      "    return int_cmp(a, b) == 0",
      "  \}",
      "  if k == K_FLOAT \{",
      "    return ffrom(a) == ffrom(b)",
      "  \}",
      "  if k < K_STR \{",
      "    return a == b",
      "  \}",
      "  if a == b \{",
      "    return true",
      "  \}",
      "  if k == K_STR \{",
      "    return Str_eq(a, b)",
      "  \}",
      "  if k == K_BYTES \{",
      "    return bytes_equal(a, b)",
      "  \}",
      "  if k == K_LIST \{",
      "    let n = peek(a + 16)",
      "    if n != peek(b + 16) \{",
      "      return false",
      "    \}",
      "    let et = peek(td + 16)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      if not eq_v(peek(peek(a + 32) + i * 8), peek(peek(b + 32) + i * 8), et) \{",
      "        return false",
      "      \}",
      "      i = i + 1",
      "    \}",
      "    return true",
      "  \}",
      "  if k == K_MAP \{",
      "    let n2 = peek(a + 16)",
      "    if n2 != peek(b + 16) \{",
      "      return false",
      "    \}",
      "    var j: Word = 0",
      "    while j < n2 \{",
      "      let idx = map_find(b, peek(peek(a + 32) + j * 8))",
      "      if idx < 0 \{",
      "        return false",
      "      \}",
      "      if not eq_v(peek(peek(a + 40) + j * 8), peek(peek(b + 40) + idx * 8), peek(td + 24)) \{",
      "        return false",
      "      \}",
      "      j = j + 1",
      "    \}",
      "    return true",
      "  \}",
      "  if k == K_RECORD \{",
      "    let nf = peek(td + 16)",
      "    var f: Word = 0",
      "    while f < nf \{",
      "      if not eq_v(peek(a + 16 + f * 8), peek(b + 16 + f * 8), peek(peek(td + 24) + f * 8)) \{",
      "        return false",
      "      \}",
      "      f = f + 1",
      "    \}",
      "    return true",
      "  \}",
      "  if k == K_ENUM \{",
      "    if peek(a + 16) != peek(b + 16) \{",
      "      return false",
      "    \}",
      "    let row = peek(td + 24) + peek(a + 16) * 32",
      "    let nv = peek(row + 8)",
      "    var x: Word = 0",
      "    while x < nv \{",
      "      if not eq_v(peek(a + 24 + x * 8), peek(b + 24 + x * 8), peek(peek(row + 16) + x * 8)) \{",
      "        return false",
      "      \}",
      "      x = x + 1",
      "    \}",
      "    return true",
      "  \}",
      "  return false",
      "\}",
      "",
      "fn hash_bytes(p: Word, n: Word) -> Word \{",
      "  var h: Word = -3750763034362895579",
      "  var i: Word = 0",
      "  while i < n \{",
      "    h = w_xor(h, peek8(p + i)) * 1099511628211",
      "    i = i + 1",
      "  \}",
      "  return h",
      "\}",
      "",
      "fn hash_v_at(v: Word, td: Word) -> Word \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    return int_hash(v)",
      "  \}",
      "  if k == K_STR \{",
      "    return hash_bytes(v + 32, peek(v + 16))",
      "  \}",
      "  if k == K_BYTES \{",
      "    return hash_bytes(peek(v + 32), peek(v + 16))",
      "  \}",
      "  if k < K_STR \{",
      "    return v * 1099511628211",
      "  \}",
      "  var h: Word = 7",
      "  if k == K_LIST \{",
      "    var i: Word = 0",
      "    while i < peek(v + 16) \{",
      "      h = h * 31 + hash_v(peek(peek(v + 32) + i * 8), peek(td + 16))",
      "      i = i + 1",
      "    \}",
      "    return h",
      "  \}",
      "  if k == K_RECORD \{",
      "    var f: Word = 0",
      "    while f < peek(td + 16) \{",
      "      h = h * 31 + hash_v(peek(v + 16 + f * 8), peek(peek(td + 24) + f * 8))",
      "      f = f + 1",
      "    \}",
      "    return h",
      "  \}",
      "  if k == K_ENUM \{",
      "    let row = peek(td + 24) + peek(v + 16) * 32",
      "    h = peek(v + 16) + 1",
      "    var x: Word = 0",
      "    while x < peek(row + 8) \{",
      "      h = h * 31 + hash_v(peek(v + 24 + x * 8), peek(peek(row + 16) + x * 8))",
      "      x = x + 1",
      "    \}",
      "    return h",
      "  \}",
      "  return h + peek(v + 16)",
      "\}",
      "",
      "// ordering for sort/min/max: raw -1 / 0 / 1; -2 when the type is not ordered",
      "fn cmp_v(a: Word, b: Word, td: Word) -> Word \{",
      "  let k = peek(td)",
      "  if k == K_INT \{",
      "    return int_cmp(a, b)",
      "  \}",
      "  if k == K_FLOAT \{",
      "    if ffrom(a) < ffrom(b) \{",
      "      return -1",
      "    \}",
      "    if ffrom(a) > ffrom(b) \{",
      "      return 1",
      "    \}",
      "    return 0",
      "  \}",
      "  if k == K_STR \{",
      "    return Str_cmp(a, b)",
      "  \}",
      "  return -2",
      "\}",
      "",
      "fn not_comparable(sp: Word) -> Word \{",
      "  return fail_msg(\"R0009\", \"sort: values are not comparable (only Int, Float, Str can be sorted)\", sp)",
      "\}",
      "",
    ],
    "rt/softmath.klar" => [
      "// Klar runtime: software sin, cos, ln, exp and pow for targets without instructions for them (arm64).",
      "// Ports of the FreeBSD/Sun fdlibm algorithms (error < 1 ulp); the argument reduction of sin/cos for huge",
      "// arguments is exact (2/pi to 1200 bits as an Int). The x86-64 back-end uses the x87 instructions instead.",
      "// fdlibm works on the 32-bit halves of a double: hi(x) is the signed high word, lo(x) the low one.",
      "",
      "const TWO_OVER_PI: Int = ",
      "",
      "fn hi32(x: Float) -> Word \{",
      "  return w_sar(fbits(x), 32)",
      "\}",
      "",
      "fn lo32(x: Float) -> Word \{",
      "  return w_and(fbits(x), 4294967295)",
      "\}",
      "",
      "fn with_hi(x: Float, h: Word) -> Float \{",
      "  return ffrom(w_or(w_shl(h, 32), lo32(x)))",
      "\}",
      "",
      "fn from_words(h: Word, l: Word) -> Float \{",
      "  return ffrom(w_or(w_shl(h, 32), w_and(l, 4294967295)))",
      "\}",
      "",
      "// ---- ln ------------------------------------------------------------------------------------------------------",
      "fn soft_ln(x0: Float) -> Float \{",
      "  var x = x0",
      "  var hx = hi32(x)",
      "  let lx = lo32(x)",
      "  var k: Word = 0",
      "  if hx < 1048576 \{",
      "    if w_or(w_and(hx, 2147483647), lx) == 0 \{",
      "      return -1.0 / 0.0",
      "    \}",
      "    if hx < 0 \{",
      "      return (x - x) / 0.0",
      "    \}",
      "    k = k - 54",
      "    x = x * 18014398509481984.0",
      "    hx = hi32(x)",
      "  \}",
      "  if hx >= 2146435072 \{",
      "    return x + x",
      "  \}",
      "  k = k + w_sar(hx, 20) - 1023",
      "  hx = w_and(hx, 1048575)",
      "  let i = w_and(hx + 614244, 1048576)",
      "  x = with_hi(x, w_or(hx, w_xor(i, 1072693248)))",
      "  k = k + w_shr(i, 20)",
      "  let f = x - 1.0",
      "  let dk = w2f(k)",
      "  if w_and(1048575, 2 + hx) < 3 \{",
      "    if f == 0.0 \{",
      "      if k == 0 \{",
      "        return 0.0",
      "      \}",
      "      return dk * 0.693147180369123816490 + dk * 0.00000000019082149292705877",
      "    \}",
      "    let rr = f * f * (0.5 - 0.33333333333333333 * f)",
      "    if k == 0 \{",
      "      return f - rr",
      "    \}",
      "    return dk * 0.693147180369123816490 - ((rr - dk * 0.00000000019082149292705877) - f)",
      "  \}",
      "  let s = f / (2.0 + f)",
      "  let z = s * s",
      "  let w = z * z",
      "  let t1 = w * (0.3999999999940942 + w * (0.22222198432149784 + w * 0.15313837699209373))",
      "  let t2 = z * (0.6666666666666735 + w * (0.2857142874366239 + w * (0.1818357216161805 +",
      "      w * 0.14798198605116586)))",
      "  let r = t2 + t1",
      "  if w_or(hx - 398458, 440401 - hx) > 0 \{",
      "    let hfsq = 0.5 * f * f",
      "    if k == 0 \{",
      "      return f - (hfsq - s * (hfsq + r))",
      "    \}",
      "    return dk * 0.693147180369123816490 - ((hfsq - (s * (hfsq + r) + dk * 0.00000000019082149292705877)) - f)",
      "  \}",
      "  if k == 0 \{",
      "    return f - s * (f - r)",
      "  \}",
      "  return dk * 0.693147180369123816490 - ((s * (f - r) - dk * 0.00000000019082149292705877) - f)",
      "\}",
      "",
      "// ---- exp -----------------------------------------------------------------------------------------------------",
      "fn soft_exp(x0: Float) -> Float \{",
      "  var x = x0",
      "  var hx = hi32(x)",
      "  let xsb = w_and(w_shr(hx, 31), 1)",
      "  hx = w_and(hx, 2147483647)",
      "  if hx >= 1082535490 \{",
      "    if hx >= 2146435072 \{",
      "      if w_or(w_and(hx, 1048575), lo32(x)) != 0 \{",
      "        return x + x",
      "      \}",
      "      if xsb == 0 \{",
      "        return x",
      "      \}",
      "      return 0.0",
      "    \}",
      "    if x > 709.782712893384 \{",
      "      return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "    \}",
      "    if x < -745.1332191019411 \{",
      "      return ffrom(103582791429521408) * ffrom(103582791429521408)",
      "    \}",
      "  \}",
      "  var hi = 0.0",
      "  var lo = 0.0",
      "  var k: Word = 0",
      "  if hx > 1071001154 \{",
      "    if hx < 1072734898 \{",
      "      if xsb == 0 \{",
      "        hi = x - 0.6931471803691238",
      "        lo = 0.00000000019082149292705877",
      "        k = 1",
      "      \} else \{",
      "        hi = x + 0.6931471803691238",
      "        lo = -0.00000000019082149292705877",
      "        k = -1",
      "      \}",
      "    \} else \{",
      "      if xsb == 0 \{",
      "        k = f2w(1.4426950408889634 * x + 0.5)",
      "      \} else \{",
      "        k = f2w(1.4426950408889634 * x - 0.5)",
      "      \}",
      "      let t = w2f(k)",
      "      hi = x - t * 0.6931471803691238",
      "      lo = t * 0.00000000019082149292705877",
      "    \}",
      "    x = hi - lo",
      "  \} else if hx < 1043333120 \{",
      "    if ffrom(9094988921128908188) + x > 1.0 \{",
      "      return 1.0 + x",
      "    \}",
      "  \}",
      "  let t = x * x",
      "  let c = x - t * (0.16666666666666602 + t * (-0.0027777777777015593 + t * (0.00006613756321437934 +",
      "      t * (-0.0000016533902205465252 + t * 0.000000041381367970572385))))",
      "  if k == 0 \{",
      "    return 1.0 - ((x * c) / (c - 2.0) - x)",
      "  \}",
      "  let y = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi)",
      "  if k >= -1021 \{",
      "    return with_hi(y, hi32(y) + w_shl(k, 20))",
      "  \}",
      "  return with_hi(y, hi32(y) + w_shl(k + 1000, 20)) * ffrom(103582791429521408)",
      "\}",
      "",
      "// ---- sin / cos -------------------------------------------------------------------------------------------------",
      "fn k_sin(x: Float, y: Float, iy: Word) -> Float \{",
      "  let ix = w_and(hi32(x), 2147483647)",
      "  if ix < 1044381696 \{",
      "    if f2w(x) == 0 \{",
      "      return x",
      "    \}",
      "  \}",
      "  let z = x * x",
      "  let v = z * x",
      "  let r = 0.00833333333332249 + z * (-0.0001984126982985795 + z * (0.0000027557313707070068 + z *",
      "      (-0.000000025050760253406863 + z * 0.000000000158969099521155)))",
      "  if iy == 0 \{",
      "    return x + v * (-0.16666666666666632 + z * r)",
      "  \}",
      "  return x - ((z * (0.5 * y - v * r) - y) - v * -0.16666666666666632)",
      "\}",
      "",
      "fn k_cos(x: Float, y: Float) -> Float \{",
      "  let ix = w_and(hi32(x), 2147483647)",
      "  if ix < 1044381696 \{",
      "    if f2w(x) == 0 \{",
      "      return 1.0",
      "    \}",
      "  \}",
      "  let z = x * x",
      "  let r = z * (0.0416666666666666 + z * (-0.001388888888887411 + z * (0.00002480158728947673 + z *",
      "      (-0.00000027557314351390663 + z * (0.000000002087572321298175 + z * -0.000000000011359647557788195)))))",
      "  if ix < 1070805811 \{",
      "    return 1.0 - (0.5 * z - (z * r - x * y))",
      "  \}",
      "  var qx = 0.28125",
      "  if ix <= 1072234496 \{",
      "    qx = from_words(ix - 2097152, 0)",
      "  \}",
      "  let hz = 0.5 * z - qx",
      "  let a = 1.0 - qx",
      "  return a - (hz - (z * r - x * y))",
      "\}",
      "",
      "// x = n*pi/2 + (y0 + y1): returns n and writes y0, y1 to the two words at out",
      "fn rem_pio2(x: Float, out: Word) -> Word \{",
      "  let hx = hi32(x)",
      "  let ix = w_and(hx, 2147483647)",
      "  if ix <= 1072243195 \{",
      "    poke(out, fbits(x))",
      "    poke(out + 8, 0)",
      "    return 0",
      "  \}",
      "  if ix < 1073928572 \{",
      "    if hx > 0 \{",
      "      var z = x - 1.5707963267341256",
      "      if ix != 1073291771 \{",
      "        let y0 = z - 0.00000000006077100506506192",
      "        poke(out, fbits(y0))",
      "        poke(out + 8, fbits((z - y0) - 0.00000000006077100506506192))",
      "      \} else \{",
      "        z = z - 0.00000000006077100506303966",
      "        let y0 = z - 0.0000000000000000000020222662487959506",
      "        poke(out, fbits(y0))",
      "        poke(out + 8, fbits((z - y0) - 0.0000000000000000000020222662487959506))",
      "      \}",
      "      return 1",
      "    \}",
      "    var z = x + 1.5707963267341256",
      "    if ix != 1073291771 \{",
      "      let y0 = z + 0.00000000006077100506506192",
      "      poke(out, fbits(y0))",
      "      poke(out + 8, fbits((z - y0) + 0.00000000006077100506506192))",
      "    \} else \{",
      "      z = z + 0.00000000006077100506303966",
      "      let y0 = z + 0.0000000000000000000020222662487959506",
      "      poke(out, fbits(y0))",
      "      poke(out + 8, fbits((z - y0) + 0.0000000000000000000020222662487959506))",
      "    \}",
      "    return -1",
      "  \}",
      "  if ix <= 1094263291 \{",
      "    let t = ffrom(w_and(fbits(x), F_ABS))",
      "    let n = f2w(t * 0.6366197723675814 + 0.5)",
      "    let fnum = w2f(n)",
      "    var r = t - fnum * 1.5707963267341256",
      "    var w = fnum * 0.00000000006077100506506192",
      "    let j = w_sar(ix, 20)",
      "    var y0 = r - w",
      "    var i = j - w_and(w_sar(hi32(y0), 20), 2047)",
      "    if i > 16 \{",
      "      var t2 = r",
      "      w = fnum * 0.00000000006077100506303966",
      "      r = t2 - w",
      "      w = fnum * 0.0000000000000000000020222662487959506 - ((t2 - r) - w)",
      "      y0 = r - w",
      "      i = j - w_and(w_sar(hi32(y0), 20), 2047)",
      "      if i > 49 \{",
      "        t2 = r",
      "        w = fnum * 0.0000000000000000000020222662487111665",
      "        r = t2 - w",
      "        w = fnum * 0.000000000000000000000000000000084784276603689 - ((t2 - r) - w)",
      "        y0 = r - w",
      "      \}",
      "    \}",
      "    let y1 = (r - y0) - w",
      "    if hx < 0 \{",
      "      poke(out, fbits(fneg(y0)))",
      "      poke(out + 8, fbits(fneg(y1)))",
      "      return 0 - n",
      "    \}",
      "    poke(out, fbits(y0))",
      "    poke(out + 8, fbits(y1))",
      "    return n",
      "  \}",
      "  if ix >= 2146435072 \{",
      "    poke(out, fbits(x - x))",
      "    poke(out + 8, fbits(x - x))",
      "    return 0",
      "  \}",
      "  return rem_pio2_big(x, out)",
      "\}",
      "",
      "// the exact reduction of a huge |x|: x * 2/pi = q + f with 2/pi to 1200 bits; f to 120 bits, times pi/2 in",
      "// double-double",
      "fn rem_pio2_big(x: Float, out: Word) -> Word \{",
      "  let ax = ffrom(w_and(fbits(x), F_ABS))",
      "  let prod = float_mant(ax) * TWO_OVER_PI",
      "  let shift = 1200 - float_exp2(ax)",
      "  let unit = pow2(shift)",
      "  let q = prod / unit",
      "  var f = (prod - q * unit) / pow2(shift - 120)",
      "  var n = untag(q % 8)",
      "  if f >= pow2(119) \{",
      "    f = f - pow2(120)",
      "    n = n + 1",
      "  \}",
      "  let fhi = f / pow2(67)",
      "  let fhd = int_to_float(fhi, 0) * 0.00000000000000011102230246251565",
      "  let fld = int_to_float(f - fhi * pow2(67), 0) * 0.000000000000000000000000000000000000752316384526264",
      "  // (fhd + fld) * (pio2_hi + pio2_lo), with the exact product of the high parts (Veltkamp split)",
      "  let ph = 1.5707963267948966",
      "  let pl = 0.00000000000000006123233995736766",
      "  let p = fhd * ph",
      "  let ca = 134217729.0 * fhd",
      "  let ah = ca - (ca - fhd)",
      "  let al = fhd - ah",
      "  let cb = 134217729.0 * ph",
      "  let bh = cb - (cb - ph)",
      "  let bl = ph - bh",
      "  let err = ((ah * bh - p) + ah * bl + al * bh) + al * bl",
      "  let rlo = err + fhd * pl + fld * ph",
      "  let y0 = p + rlo",
      "  let y1 = rlo - (y0 - p)",
      "  if x < 0.0 \{",
      "    poke(out, fbits(fneg(y0)))",
      "    poke(out + 8, fbits(fneg(y1)))",
      "    return 0 - n",
      "  \}",
      "  poke(out, fbits(y0))",
      "  poke(out + 8, fbits(y1))",
      "  return n",
      "\}",
      "",
      "fn soft_sin(x: Float) -> Float \{",
      "  let ix = w_and(hi32(x), 2147483647)",
      "  if ix <= 1072243195 \{",
      "    return k_sin(x, 0.0, 0)",
      "  \}",
      "  if ix >= 2146435072 \{",
      "    return x - x",
      "  \}",
      "  let out = static_addr(\"g_scratch\") + 128",
      "  let n = rem_pio2(x, out)",
      "  let y0 = ffrom(peek(out))",
      "  let y1 = ffrom(peek(out + 8))",
      "  let m = w_and(n, 3)",
      "  if m == 0 \{",
      "    return k_sin(y0, y1, 1)",
      "  \}",
      "  if m == 1 \{",
      "    return k_cos(y0, y1)",
      "  \}",
      "  if m == 2 \{",
      "    return fneg(k_sin(y0, y1, 1))",
      "  \}",
      "  return fneg(k_cos(y0, y1))",
      "\}",
      "",
      "fn soft_cos(x: Float) -> Float \{",
      "  let ix = w_and(hi32(x), 2147483647)",
      "  if ix <= 1072243195 \{",
      "    return k_cos(x, 0.0)",
      "  \}",
      "  if ix >= 2146435072 \{",
      "    return x - x",
      "  \}",
      "  let out = static_addr(\"g_scratch\") + 128",
      "  let n = rem_pio2(x, out)",
      "  let y0 = ffrom(peek(out))",
      "  let y1 = ffrom(peek(out + 8))",
      "  let m = w_and(n, 3)",
      "  if m == 0 \{",
      "    return k_cos(y0, y1)",
      "  \}",
      "  if m == 1 \{",
      "    return fneg(k_sin(y0, y1, 1))",
      "  \}",
      "  if m == 2 \{",
      "    return fneg(k_cos(y0, y1))",
      "  \}",
      "  return k_sin(y0, y1, 1)",
      "\}",
      "",
      "// ---- pow (x > 0 here: the callers handle signs, zeros and the special values) ---------------------------------",
      "fn scale2(z0: Float, n0: Word) -> Float \{",
      "  var z = z0",
      "  var n = n0",
      "  while n < -1000 \{",
      "    z = z * ffrom(w_shl(23, 52))",
      "    n = n + 1000",
      "  \}",
      "  return z * ffrom(w_shl(n + 1023, 52))",
      "\}",
      "",
      "fn clear_lo(x: Float) -> Float \{",
      "  return ffrom(w_and(fbits(x), -4294967296))",
      "\}",
      "",
      "// x > 0 (or +inf / NaN), y anything: the callers handle negative bases, zeros, y == 0 and x == 1",
      "fn soft_pow(x: Float, y: Float) -> Float \{",
      "  let hx = hi32(x)",
      "  let lx = lo32(x)",
      "  let hy = hi32(y)",
      "  let ly = lo32(y)",
      "  var ix = w_and(hx, 2147483647)",
      "  let iy = w_and(hy, 2147483647)",
      "  if w_or(iy, ly) == 0 \{",
      "    return 1.0",
      "  \}",
      "  if ix > 2146435072 or (ix == 2146435072 and lx != 0) or iy > 2146435072 or (iy == 2146435072 and ly != 0) \{",
      "    return x + y",
      "  \}",
      "  if ly == 0 \{",
      "    if iy == 2146435072 \{",
      "      if w_or(ix - 1072693248, lx) == 0 \{",
      "        return 1.0",
      "      \}",
      "      if ix >= 1072693248 \{",
      "        if hy >= 0 \{",
      "          return y",
      "        \}",
      "        return 0.0",
      "      \}",
      "      if hy < 0 \{",
      "        return fneg(y)",
      "      \}",
      "      return 0.0",
      "    \}",
      "    if iy == 1072693248 \{",
      "      if hy < 0 \{",
      "        return 1.0 / x",
      "      \}",
      "      return x",
      "    \}",
      "    if hy == 1073741824 \{",
      "      return x * x",
      "    \}",
      "    if hy == 1071644672 \{",
      "      return fsqrt(x)",
      "    \}",
      "  \}",
      "  var ax = ffrom(w_and(fbits(x), F_ABS))",
      "  if lx == 0 \{",
      "    if ix == 2146435072 or ix == 0 or ix == 1072693248 \{",
      "      if hy < 0 \{",
      "        return 1.0 / ax",
      "      \}",
      "      return ax",
      "    \}",
      "  \}",
      "  var t1 = 0.0",
      "  var t2 = 0.0",
      "  if iy > 1105199104 \{",
      "    if iy > 1139802112 \{",
      "      if ix <= 1072693247 \{",
      "        if hy < 0 \{",
      "          return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "        \}",
      "        return ffrom(118622047889322841) * ffrom(118622047889322841)",
      "      \}",
      "      if hy > 0 \{",
      "        return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "      \}",
      "      return ffrom(118622047889322841) * ffrom(118622047889322841)",
      "    \}",
      "    if ix < 1072693247 \{",
      "      if hy < 0 \{",
      "        return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "      \}",
      "      return ffrom(118622047889322841) * ffrom(118622047889322841)",
      "    \}",
      "    if ix > 1072693248 \{",
      "      if hy > 0 \{",
      "        return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "      \}",
      "      return ffrom(118622047889322841) * ffrom(118622047889322841)",
      "    \}",
      "    let t = ax - 1.0",
      "    let w = (t * t) * (0.5 - t * (0.3333333333333333333333 - t * 0.25))",
      "    let u = 1.4426950216293335 * t",
      "    let v = t * 0.000000019259629911266175 - w * 1.4426950408889634",
      "    t1 = clear_lo(u + v)",
      "    t2 = v - (t1 - u)",
      "  \} else \{",
      "    var n: Word = 0",
      "    if ix < 1048576 \{",
      "      ax = ax * 9007199254740992.0",
      "      n = n - 53",
      "      ix = hi32(ax)",
      "    \}",
      "    n = n + w_sar(ix, 20) - 1023",
      "    let j = w_and(ix, 1048575)",
      "    ix = w_or(j, 1072693248)",
      "    var k: Word = 0",
      "    if j <= 235662 \{",
      "      k = 0",
      "    \} else if j < 767610 \{",
      "      k = 1",
      "    \} else \{",
      "      k = 0",
      "      n = n + 1",
      "      ix = ix - 1048576",
      "    \}",
      "    ax = with_hi(ax, ix)",
      "    var bp = 1.0",
      "    var dp_h = 0.0",
      "    var dp_l = 0.0",
      "    if k == 1 \{",
      "      bp = 1.5",
      "      dp_h = 0.5849624872207642",
      "      dp_l = 0.00000001350039202129749",
      "    \}",
      "    var u = ax - bp",
      "    var v = 1.0 / (ax + bp)",
      "    let ss = u * v",
      "    let s_h = clear_lo(ss)",
      "    var t_h = from_words(w_or(w_sar(ix, 1), 536870912) + 524288 + w_shl(k, 18), 0)",
      "    var t_l = ax - (t_h - bp)",
      "    let s_l = v * ((u - s_h * t_h) - s_h * t_l)",
      "    var s2 = ss * ss",
      "    var r = s2 * s2 * (0.5999999999999946 + s2 * (0.4285714285785502 + s2 * (0.33333332981837743 +",
      "        s2 * (0.272728123808534 + s2 * (0.23066074577556175 + s2 * 0.20697501780033842)))))",
      "    r = r + s_l * (s_h + ss)",
      "    s2 = s_h * s_h",
      "    t_h = clear_lo(3.0 + s2 + r)",
      "    t_l = r - ((t_h - 3.0) - s2)",
      "    u = s_h * t_h",
      "    v = s_l * t_h + t_l * ss",
      "    let p_h = clear_lo(u + v)",
      "    let p_l = v - (p_h - u)",
      "    let z_h = 0.9617967009544373 * p_h",
      "    let z_l = -0.000000007028461650952758 * p_h + p_l * 0.9617966939259756 + dp_l",
      "    let t = w2f(n)",
      "    t1 = clear_lo(((z_h + z_l) + dp_h) + t)",
      "    t2 = z_l - (((t1 - t) - dp_h) - z_h)",
      "  \}",
      "  let y1 = clear_lo(y)",
      "  let pl = (y - y1) * t1 + y * t2",
      "  var ph = y1 * t1",
      "  var z = pl + ph",
      "  let j = hi32(z)",
      "  let i = lo32(z)",
      "  if j >= 1083179008 \{",
      "    if w_or(j - 1083179008, i) != 0 \{",
      "      return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "    \}",
      "    if pl + 0.00000000000000008008566259537294 > z - ph \{",
      "      return ffrom(9094988921128908188) * ffrom(9094988921128908188)",
      "    \}",
      "  \} else if w_and(j, 2147483647) >= 1083231232 \{",
      "    if w_or(j + 1064252416, i) != 0 \{",
      "      return ffrom(118622047889322841) * ffrom(118622047889322841)",
      "    \}",
      "    if pl <= z - ph \{",
      "      return ffrom(118622047889322841) * ffrom(118622047889322841)",
      "    \}",
      "  \}",
      "  let i2 = w_and(j, 2147483647)",
      "  var k2 = w_sar(i2, 20) - 1023",
      "  var n2: Word = 0",
      "  if i2 > 1071644672 \{",
      "    n2 = j + w_sar(1048576, k2 + 1)",
      "    k2 = w_sar(w_and(n2, 2147483647), 20) - 1023",
      "    let tt = from_words(w_and(n2, w_xor(w_sar(1048575, k2), -1)), 0)",
      "    n2 = w_sar(w_or(w_and(n2, 1048575), 1048576), 20 - k2)",
      "    if j < 0 \{",
      "      n2 = 0 - n2",
      "    \}",
      "    ph = ph - tt",
      "  \}",
      "  let t = clear_lo(pl + ph)",
      "  let u = t * 0.6931471824645996",
      "  let v = (pl - (t - ph)) * 0.6931471805599453 + t * -0.000000001904654299957768",
      "  z = u + v",
      "  let w = v - (z - u)",
      "  let tz = z * z",
      "  let tz1 = z - tz * (0.16666666666666602 + tz * (-0.0027777777777015593 + tz * (0.00006613756321437934 +",
      "      tz * (-0.0000016533902205465252 + tz * 0.000000041381367970572385))))",
      "  let r = (z * tz1) / (tz1 - 2.0) - (w + z * w)",
      "  z = 1.0 - (r - z)",
      "  let jz = hi32(z) + w_shl(n2, 20)",
      "  if w_sar(jz, 20) <= 0 \{",
      "    return scale2(z, n2)",
      "  \}",
      "  return with_hi(z, jz)",
      "\}",
      "",
    ],
    "rt/str.klar" => [
      "// Klar runtime: Str methods (UTF-8; lengths and indices count code points).",
      "",
      "fn Str_concat(a: Word, b: Word) -> Word \{",
      "  let na = peek(a + 16)",
      "  let nb = peek(b + 16)",
      "  let s = str_new(na + nb)",
      "  copy_bytes(s + 32, a + 32, na)",
      "  copy_bytes(s + 32 + na, b + 32, nb)",
      "  if peek(a + 24) >= 0 and peek(b + 24) >= 0 \{",
      "    poke(s + 24, peek(a + 24) + peek(b + 24))",
      "  \}",
      "  return s",
      "\}",
      "",
      "// `s = s + t`: appends in place when s is unique and has room",
      "fn Str_append_owned(a: Word, b: Word) -> Word \{",
      "  let na = peek(a + 16)",
      "  let nb = peek(b + 16)",
      "  if peek(a) == 1 and 33 + na + nb <= block_size(a) \{",
      "    copy_bytes(a + 32 + na, b + 32, nb)",
      "    poke8(a + 32 + na + nb, 0)",
      "    poke(a + 16, na + nb)",
      "    if peek(a + 24) >= 0 and peek(b + 24) >= 0 \{",
      "      poke(a + 24, peek(a + 24) + peek(b + 24))",
      "    \} else \{",
      "      poke(a + 24, -1)",
      "    \}",
      "    return a",
      "  \}",
      "  // grow geometrically so repeated appends stay linear",
      "  var cap = (na + nb) * 2",
      "  if cap < 32 \{",
      "    cap = 32",
      "  \}",
      "  let s = obj_new(33 + cap, static_addr(\"td_Str\"))",
      "  copy_bytes(s + 32, a + 32, na)",
      "  copy_bytes(s + 32 + na, b + 32, nb)",
      "  poke(s + 16, na + nb)",
      "  poke8(s + 32 + na + nb, 0)",
      "  if peek(a + 24) >= 0 and peek(b + 24) >= 0 \{",
      "    poke(s + 24, peek(a + 24) + peek(b + 24))",
      "  \} else \{",
      "    poke(s + 24, -1)",
      "  \}",
      "  rc_dec(a)",
      "  return s",
      "\}",
      "",
      "// ---- UTF-8 helpers -------------------------------------------------------------",
      "fn cp_len(c: Word) -> Word \{",
      "  if c < 128 \{",
      "    return 1",
      "  \}",
      "  if c < 224 \{",
      "    return 2",
      "  \}",
      "  if c < 240 \{",
      "    return 3",
      "  \}",
      "  return 4",
      "\}",
      "",
      "fn cp_at(p: Word) -> Word \{",
      "  let c = peek8(p)",
      "  if c < 128 \{",
      "    return c",
      "  \}",
      "  if c < 224 \{",
      "    return w_or(w_shl(w_and(c, 31), 6), w_and(peek8(p + 1), 63))",
      "  \}",
      "  if c < 240 \{",
      "    return w_or(w_or(w_shl(w_and(c, 15), 12), w_shl(w_and(peek8(p + 1), 63), 6)), w_and(peek8(p + 2), 63))",
      "  \}",
      "  return w_or(w_or(w_or(w_shl(w_and(c, 7), 18), w_shl(w_and(peek8(p + 1), 63), 12)),",
      "    w_shl(w_and(peek8(p + 2), 63), 6)), w_and(peek8(p + 3), 63))",
      "\}",
      "",
      "fn sb_add_cp(b: Word, cp: Word) \{",
      "  if cp < 128 \{",
      "    sb_add_byte(b, cp)",
      "  \} else if cp < 2048 \{",
      "    sb_add_byte(b, w_or(192, w_shr(cp, 6)))",
      "    sb_add_byte(b, w_or(128, w_and(cp, 63)))",
      "  \} else if cp < 65536 \{",
      "    sb_add_byte(b, w_or(224, w_shr(cp, 12)))",
      "    sb_add_byte(b, w_or(128, w_and(w_shr(cp, 6), 63)))",
      "    sb_add_byte(b, w_or(128, w_and(cp, 63)))",
      "  \} else \{",
      "    sb_add_byte(b, w_or(240, w_shr(cp, 18)))",
      "    sb_add_byte(b, w_or(128, w_and(w_shr(cp, 12), 63)))",
      "    sb_add_byte(b, w_or(128, w_and(w_shr(cp, 6), 63)))",
      "    sb_add_byte(b, w_or(128, w_and(cp, 63)))",
      "  \}",
      "\}",
      "",
      "// byte offset of code point index i (clamped to the end)",
      "fn cp_offset(s: Word, i: Word) -> Word \{",
      "  let n = peek(s + 16)",
      "  if str_nchars(s) == n \{",
      "    if i > n \{",
      "      return n",
      "    \}",
      "    return i",
      "  \}",
      "  var off: Word = 0",
      "  var k: Word = 0",
      "  while k < i and off < n \{",
      "    off = off + cp_len(peek8(s + 32 + off))",
      "    k = k + 1",
      "  \}",
      "  return off",
      "\}",
      "",
      "fn is_space_cp(c: Word) -> Bool \{",
      "  if c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31) \{",
      "    return true",
      "  \}",
      "  if c < 128 \{",
      "    return false",
      "  \}",
      "  return c == 133 or c == 160 or c == 5760 or (c >= 8192 and c <= 8202) or c == 8232 or c == 8233 or",
      "    c == 8239 or c == 8287 or c == 12288",
      "\}",
      "",
      "fn upper_cp(c: Word) -> Word \{",
      "  if c >= 97 and c <= 122 \{",
      "    return c - 32",
      "  \}",
      "  if c < 128 \{",
      "    return c",
      "  \}",
      "  if (c >= 224 and c <= 254 and c != 247) \{",
      "    return c - 32",
      "  \}",
      "  if c == 255 \{",
      "    return 376",
      "  \}",
      "  if c >= 1072 and c <= 1103 \{",
      "    return c - 32",
      "  \}",
      "  if c >= 1104 and c <= 1119 \{",
      "    return c - 80",
      "  \}",
      "  if c >= 945 and c <= 969 and c != 962 \{",
      "    return c - 32",
      "  \}",
      "  if c == 962 \{",
      "    return 931",
      "  \}",
      "  return c",
      "\}",
      "",
      "fn lower_cp(c: Word) -> Word \{",
      "  if c >= 65 and c <= 90 \{",
      "    return c + 32",
      "  \}",
      "  if c < 128 \{",
      "    return c",
      "  \}",
      "  if c >= 192 and c <= 222 and c != 215 \{",
      "    return c + 32",
      "  \}",
      "  if c == 376 \{",
      "    return 255",
      "  \}",
      "  if c >= 1040 and c <= 1071 \{",
      "    return c + 32",
      "  \}",
      "  if c >= 1024 and c <= 1039 \{",
      "    return c + 80",
      "  \}",
      "  if c >= 913 and c <= 937 and c != 930 \{",
      "    return c + 32",
      "  \}",
      "  return c",
      "\}",
      "",
      "fn map_case(s: Word, up: Bool) -> Word \{",
      "  let b = sb_new()",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = cp_at(s + 32 + i)",
      "    if up and c == 223 \{",
      "      sb_add_cstr(b, \"SS\")",
      "    \} else if up \{",
      "      sb_add_cp(b, upper_cp(c))",
      "    \} else \{",
      "      sb_add_cp(b, lower_cp(c))",
      "    \}",
      "    i = i + cp_len(peek8(s + 32 + i))",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "// byte index of `needle` in s at or after byte `from`, or -1",
      "// first index >= from of byte c in p[0..n), or n; scans 8 bytes at a time (SWAR zero-byte test)",
      "fn find_byte(p: Word, from: Word, n: Word, c: Word) -> Word \{",
      "  let ones: Word = 72340172838076673           // 0x0101010101010101",
      "  let highs: Word = -9187201950435737472       // 0x8080808080808080",
      "  let pat = c * ones",
      "  var i = from",
      "  while i + 8 <= n \{",
      "    let x = w_xor(peek(p + i), pat)",
      "    if w_and(w_and(x - ones, w_xor(x, -1)), highs) != 0 \{",
      "      var k = i",
      "      while peek8(p + k) != c \{",
      "        k = k + 1",
      "      \}",
      "      return k",
      "    \}",
      "    i = i + 8",
      "  \}",
      "  while i < n \{",
      "    if peek8(p + i) == c \{",
      "      return i",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return n",
      "\}",
      "",
      "fn find_bytes(s: Word, needle: Word, from: Word) -> Word \{",
      "  let n = peek(s + 16)",
      "  let m = peek(needle + 16)",
      "  if m == 0 \{",
      "    return from",
      "  \}",
      "  var i = from",
      "  while i + m <= n \{",
      "    if peek8(s + 32 + i) == peek8(needle + 32) and bytes_eq(s + 32 + i, needle + 32, m) \{",
      "      return i",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return -1",
      "\}",
      "",
      "fn cp_count_bytes(p: Word, nbytes: Word) -> Word \{",
      "  var i: Word = 0",
      "  var count: Word = 0",
      "  while i < nbytes \{",
      "    if w_and(peek8(p + i), 192) != 128 \{",
      "      count = count + 1",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return count",
      "\}",
      "",
      "// ---- methods ------------------------------------------------------------------------",
      "fn Str_len(s: Word) -> Int \{",
      "  return tag(str_nchars(s))",
      "\}",
      "",
      "fn Str_is_empty(s: Word) -> Bool \{",
      "  return peek(s + 16) == 0",
      "\}",
      "",
      "fn Str_upper(s: Word) -> Word \{",
      "  return map_case(s, true)",
      "\}",
      "",
      "fn Str_lower(s: Word) -> Word \{",
      "  return map_case(s, false)",
      "\}",
      "",
      "fn trim_range(s: Word, left: Bool, right: Bool) -> Word \{",
      "  let n = peek(s + 16)",
      "  var a: Word = 0",
      "  var z = n",
      "  if left \{",
      "    while a < n and is_space_cp(cp_at(s + 32 + a)) \{",
      "      a = a + cp_len(peek8(s + 32 + a))",
      "    \}",
      "  \}",
      "  if right \{",
      "    var moving = true",
      "    while moving and z > a \{",
      "      var st = z - 1",
      "      while st > a and w_and(peek8(s + 32 + st), 192) == 128 \{",
      "        st = st - 1",
      "      \}",
      "      if is_space_cp(cp_at(s + 32 + st)) \{",
      "        z = st",
      "      \} else \{",
      "        moving = false",
      "      \}",
      "    \}",
      "  \}",
      "  return str_from(s + 32 + a, z - a)",
      "\}",
      "",
      "fn Str_trim(s: Word) -> Word \{",
      "  return trim_range(s, true, true)",
      "\}",
      "",
      "fn Str_trim_start(s: Word) -> Word \{",
      "  return trim_range(s, true, false)",
      "\}",
      "",
      "fn Str_trim_end(s: Word) -> Word \{",
      "  return trim_range(s, false, true)",
      "\}",
      "",
      "fn Str_chars(s: Word, rtd: Word) -> Word \{",
      "  let out = list_with_cap(rtd, str_nchars(s))",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  var k: Word = 0",
      "  while i < n \{",
      "    let l = cp_len(peek8(s + 32 + i))",
      "    let c = str_from(s + 32 + i, l)",
      "    poke(c + 24, 1)",
      "    poke(peek(out + 32) + k * 8, c)",
      "    k = k + 1",
      "    i = i + l",
      "  \}",
      "  poke(out + 16, k)",
      "  return out",
      "\}",
      "",
      "fn Str_split(s: Word, sep: Word, rtd: Word) -> Word \{",
      "  if peek(sep + 16) == 0 \{",
      "    return Str_chars(s, rtd)",
      "  \}",
      "  var out = list_with_cap(rtd, 4)",
      "  var start: Word = 0",
      "  if peek(sep + 16) == 1 \{",
      "    let c = peek8(sep + 32)",
      "    let n = peek(s + 16)",
      "    let p = s + 32",
      "    var i = find_byte(p, 0, n, c)",
      "    while i < n \{",
      "      out = list_push_owned_raw(out, str_from(p + start, i - start))",
      "      start = i + 1",
      "      i = find_byte(p, start, n, c)",
      "    \}",
      "    return list_push_owned_raw(out, str_from(p + start, n - start))",
      "  \}",
      "  var pos = find_bytes(s, sep, 0)",
      "  while pos >= 0 \{",
      "    out = list_push_owned_raw(out, str_from(s + 32 + start, pos - start))",
      "    start = pos + peek(sep + 16)",
      "    pos = find_bytes(s, sep, start)",
      "  \}",
      "  return list_push_owned_raw(out, str_from(s + 32 + start, peek(s + 16) - start))",
      "\}",
      "",
      "fn Str_contains(s: Word, part: Word) -> Bool \{",
      "  return find_bytes(s, part, 0) >= 0",
      "\}",
      "",
      "fn Str_starts_with(s: Word, prefix: Word) -> Bool \{",
      "  let m = peek(prefix + 16)",
      "  return m <= peek(s + 16) and bytes_eq(s + 32, prefix + 32, m)",
      "\}",
      "",
      "fn Str_ends_with(s: Word, suffix: Word) -> Bool \{",
      "  let m = peek(suffix + 16)",
      "  let n = peek(s + 16)",
      "  return m <= n and bytes_eq(s + 32 + n - m, suffix + 32, m)",
      "\}",
      "",
      "fn Str_replace(s: Word, old: Word, new: Word) -> Word \{",
      "  let b = sb_new()",
      "  let n = peek(s + 16)",
      "  if peek(old + 16) == 0 \{",
      "    var i: Word = 0",
      "    sb_add_str(b, new)",
      "    while i < n \{",
      "      let l = cp_len(peek8(s + 32 + i))",
      "      sb_add_bytes(b, s + 32 + i, l)",
      "      sb_add_str(b, new)",
      "      i = i + l",
      "    \}",
      "    return sb_finish(b)",
      "  \}",
      "  var start: Word = 0",
      "  var pos = find_bytes(s, old, 0)",
      "  while pos >= 0 \{",
      "    sb_add_bytes(b, s + 32 + start, pos - start)",
      "    sb_add_str(b, new)",
      "    start = pos + peek(old + 16)",
      "    pos = find_bytes(s, old, start)",
      "  \}",
      "  sb_add_bytes(b, s + 32 + start, n - start)",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn Str_index_of(s: Word, part: Word, rtd: Word) -> Word \{",
      "  let pos = find_bytes(s, part, 0)",
      "  if pos < 0 \{",
      "    return none()",
      "  \}",
      "  return some_new(rtd, bits(tag(cp_count_bytes(s + 32, pos))))",
      "\}",
      "",
      "fn clamp_index(i: Int) -> Word \{",
      "  if i <= 0 \{",
      "    return 0",
      "  \}",
      "  if not is_small(i) \{",
      "    return 4611686018427387903",
      "  \}",
      "  return untag(i)",
      "\}",
      "",
      "fn Str_slice(s: Word, start: Int, end: Int) -> Word \{",
      "  let a = cp_offset(s, clamp_index(start))",
      "  let z = cp_offset(s, clamp_index(end))",
      "  if z <= a \{",
      "    return str_new(0)",
      "  \}",
      "  return str_from(s + 32 + a, z - a)",
      "\}",
      "",
      "fn Str_repeat(s: Word, times: Int) -> Word \{",
      "  if times <= 0 \{",
      "    return str_new(0)",
      "  \}",
      "  let n = peek(s + 16)",
      "  if n == 0 \{",
      "    return str_new(0)",
      "  \}",
      "  if not is_small(times) \{",
      "    out_of_memory()",
      "  \}",
      "  let k = untag(times)",
      "  let r = str_new(mem_size(k, n))",
      "  var i: Word = 0",
      "  while i < k \{",
      "    copy_bytes(r + 32 + i * n, s + 32, n)",
      "    i = i + 1",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn Str_to_int(s: Word, rtd: Word) -> Word \{",
      "  let t = Str_trim(s)",
      "  let n = peek(t + 16)",
      "  var i: Word = 0",
      "  if n > 0 and (peek8(t + 32) == 43 or peek8(t + 32) == 45) \{",
      "    i = 1",
      "  \}",
      "  if i >= n \{",
      "    rc_dec(t)",
      "    return none()",
      "  \}",
      "  while i < n \{",
      "    if not is_digit_byte(peek8(t + 32 + i)) \{",
      "      rc_dec(t)",
      "      return none()",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  let v = int_parse_dec(t)",
      "  rc_dec(t)",
      "  let w = bits(v)",
      "  retain_t(v)",
      "  return some_new(rtd, w)",
      "\}",
      "",
      "fn Str_to_float(s: Word, rtd: Word) -> Word \{",
      "  let flag = static_addr(\"g_scratch\") + 64",
      "  let f = parse_float_text(s, flag)",
      "  if peek(flag) == 0 \{",
      "    return none()",
      "  \}",
      "  return some_new(rtd, fbits(f))",
      "\}",
      "",
      "fn Str_lines(s: Word, rtd: Word) -> Word \{",
      "  var out = list_with_cap(rtd, 4)",
      "  let n = peek(s + 16)",
      "  var start: Word = 0",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let c = cp_at(s + 32 + i)",
      "    let l = cp_len(peek8(s + 32 + i))",
      "    if c == 10 or c == 13 or c == 11 or c == 12 or c == 28 or c == 29 or c == 30 or c == 133 or",
      "      c == 8232 or c == 8233 \{",
      "      out = list_push_owned_raw(out, str_from(s + 32 + start, i - start))",
      "      if c == 13 and i + 1 < n and peek8(s + 33 + i) == 10 \{",
      "        i = i + 1",
      "      \}",
      "      start = i + l",
      "    \}",
      "    i = i + l",
      "  \}",
      "  if start < n \{",
      "    out = list_push_owned_raw(out, str_from(s + 32 + start, n - start))",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn fill_char(fill: Word, sp: Word) -> Word \{",
      "  if str_nchars(fill) != 1 \{",
      "    let b = sb_new()",
      "    sb_add_cstr(b, \"fill must be exactly one character, got \")",
      "    show_quoted(b, fill)",
      "    fail_simple(\"R0009\", sb_finish(b), sp)",
      "  \}",
      "  return fill",
      "\}",
      "",
      "fn Str_pad_left(s: Word, width: Int, fill: Word, sp: Word) -> Word \{",
      "  fill_char(fill, sp)",
      "  let b = sb_new()",
      "  var k = clamp_index(width) - str_nchars(s)",
      "  while k > 0 \{",
      "    sb_add_str(b, fill)",
      "    k = k - 1",
      "  \}",
      "  sb_add_str(b, s)",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn Str_pad_right(s: Word, width: Int, fill: Word, sp: Word) -> Word \{",
      "  fill_char(fill, sp)",
      "  let b = sb_new()",
      "  sb_add_str(b, s)",
      "  var k = clamp_index(width) - str_nchars(s)",
      "  while k > 0 \{",
      "    sb_add_str(b, fill)",
      "    k = k - 1",
      "  \}",
      "  return sb_finish(b)",
      "\}",
      "",
      "fn Str_count(s: Word, part: Word, sp: Word) -> Int \{",
      "  if peek(part + 16) == 0 \{",
      "    fail_msg(\"R0009\", \"Str.count: empty part\", sp)",
      "  \}",
      "  var count: Word = 0",
      "  var pos = find_bytes(s, part, 0)",
      "  while pos >= 0 \{",
      "    count = count + 1",
      "    pos = find_bytes(s, part, pos + peek(part + 16))",
      "  \}",
      "  return tag(count)",
      "\}",
      "",
      "fn Str_reverse(s: Word) -> Word \{",
      "  let n = peek(s + 16)",
      "  let r = str_new(n)",
      "  var i: Word = 0",
      "  while i < n \{",
      "    let l = cp_len(peek8(s + 32 + i))",
      "    copy_bytes(r + 32 + n - i - l, s + 32 + i, l)",
      "    i = i + l",
      "  \}",
      "  return r",
      "\}",
      "",
      "fn Str_is_numeric(s: Word) -> Bool \{",
      "  let n = peek(s + 16)",
      "  if n == 0 \{",
      "    return false",
      "  \}",
      "  var i: Word = 0",
      "  while i < n \{",
      "    if not is_digit_byte(peek8(s + 32 + i)) \{",
      "      return false",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return true",
      "\}",
      "",
      "fn Str_codes(s: Word, rtd: Word) -> Word \{",
      "  let out = list_with_cap(rtd, str_nchars(s))",
      "  let n = peek(s + 16)",
      "  var i: Word = 0",
      "  var k: Word = 0",
      "  while i < n \{",
      "    poke(peek(out + 32) + k * 8, w_or(w_shl(cp_at(s + 32 + i), 1), 1))",
      "    k = k + 1",
      "    i = i + cp_len(peek8(s + 32 + i))",
      "  \}",
      "  poke(out + 16, k)",
      "  return out",
      "\}",
      "",
    ],
    "rt/trace.klar" => [
      "// Klar runtime: `klarc run --record` / `klarc replay` (as klar/trace.py). The build puts `g_trace` into the",
      "// executable: [mode (0 off, 1 record, 2 replay), the events to replay (path or 0), where to write the result (path)].",
      "// Recording keeps every result the program gets from outside (compiler/trace.klar turns them into the JSON trace of",
      "// klar/trace.py); a replay returns the kept results instead of calling the system. Both modes keep what the program",
      "// printed, its runtime error and its exit code, and write them at the end.",
      "//",
      "// The events are text: the built-in's name on a line, then its result —",
      "// `I<n>` Int, `B0`/`B1` Bool, `U` Unit, `S<len>`/`Y<len>` + bytes (Str/Bytes), `L<n>` + n strings, `N` / `O` + value",
      "// (Option), `K` + value / `E` + string (Result), `R` (the call raised an error) — each item ending with a line break.",
      "",
      "const G_TR_BUF: Word = 1072",
      "const G_TR_OUT: Word = 1080",
      "const G_TR_ERR: Word = 1088",
      "const G_TR_IN: Word = 1096",
      "const G_TR_POS: Word = 1104",
      "const G_TR_LEN: Word = 1112",
      "const G_TR_N: Word = 1120",
      "const G_TR_TEXT: Word = 1128",
      "const G_TR_QUIET: Word = 1136",
      "",
      "fn tr_mode() -> Word \{",
      "  return peek(static_addr(\"g_trace\"))",
      "\}",
      "",
      "fn tr_begin() \{",
      "  if tr_mode() == 0 \{",
      "    return",
      "  \}",
      "  let gp = g()",
      "  poke(gp + G_TR_BUF, sb_new())",
      "  poke(gp + G_TR_OUT, sb_new())",
      "  poke(gp + G_TR_ERR, sb_new())",
      "  poke(gp + G_TR_TEXT, sb_new())",
      "  if tr_mode() == 2 \{",
      "    let path = peek(static_addr(\"g_trace\") + 8)",
      "    let data = sb_new()",
      "    let fd = os_open(path + 32, 0)",
      "    if fd >= 0 \{",
      "      let chunk = alloc(65536)",
      "      var reading = true",
      "      while reading \{",
      "        let n = os_read(fd, chunk, 65536)",
      "        if n <= 0 \{",
      "          reading = false",
      "        \} else \{",
      "          sb_add_bytes(data, chunk, n)",
      "        \}",
      "      \}",
      "      block_free(chunk)",
      "      os_close(fd)",
      "    \}",
      "    poke(gp + G_TR_IN, peek(data + 32))",
      "    poke(gp + G_TR_LEN, peek(data + 16))",
      "    poke(gp + G_TR_POS, 0)",
      "  \}",
      "\}",
      "",
      "// output the program writes (stdout and its own stderr) is also kept while tracing",
      "fn tr_out(p: Word, n: Word) \{",
      "  if tr_mode() != 0 and peek(g() + G_TR_OUT) != 0 \{",
      "    sb_add_bytes(peek(g() + G_TR_OUT), p, n)",
      "  \}",
      "\}",
      "",
      "fn tr_err(p: Word, n: Word) \{",
      "  let gp = g()",
      "  if tr_mode() != 0 and peek(gp + G_TR_ERR) != 0 and peek(gp + G_TR_QUIET) == 0 \{",
      "    sb_add_bytes(peek(gp + G_TR_ERR), p, n)",
      "  \}",
      "\}",
      "",
      "// the text of the runtime error (without its last line break)",
      "fn tr_error_text(b: Word) \{",
      "  if tr_mode() == 0 or peek(g() + G_TR_TEXT) == 0 \{",
      "    return",
      "  \}",
      "  var n = peek(b + 16)",
      "  if n > 0 and peek8(peek(b + 32) + n - 1) == 10 \{",
      "    n = n - 1",
      "  \}",
      "  sb_add_bytes(peek(g() + G_TR_TEXT), peek(b + 32), n)",
      "\}",
      "",
      "fn tr_section(out: Word, name: Str, s: Word) \{",
      "  sb_add_cstr(out, name)",
      "  sb_add_word(out, peek(s + 16))",
      "  sb_add_byte(out, 10)",
      "  sb_add_bytes(out, peek(s + 32), peek(s + 16))",
      "  sb_add_byte(out, 10)",
      "\}",
      "",
      "// writes the result file (the events of a recording, the output, the error, the exit code)",
      "fn tr_end(code: Word) \{",
      "  if tr_mode() == 0 or peek(g() + G_TR_BUF) == 0 \{",
      "    return",
      "  \}",
      "  let gp = g()",
      "  let out = sb_new()",
      "  sb_add_cstr(out, \"KLART1\\n\")",
      "  if tr_mode() == 1 \{",
      "    let ev = peek(gp + G_TR_BUF)",
      "    sb_add_bytes(out, peek(ev + 32), peek(ev + 16))",
      "  \}",
      "  tr_section(out, \"@stdout \", peek(gp + G_TR_OUT))",
      "  tr_section(out, \"@stderr \", peek(gp + G_TR_ERR))",
      "  tr_section(out, \"@error \", peek(gp + G_TR_TEXT))",
      "  sb_add_cstr(out, \"@exit \")",
      "  sb_add_word(out, code)",
      "  sb_add_byte(out, 10)",
      "  let path = peek(static_addr(\"g_trace\") + 16)",
      "  let fd = os_open(path + 32, 1)",
      "  if fd >= 0 \{",
      "    var done: Word = 0",
      "    let n = peek(out + 16)",
      "    while done < n \{",
      "      let w = os_write(fd, peek(out + 32) + done, n - done)",
      "      if w <= 0 \{",
      "        done = n",
      "      \} else \{",
      "        done = done + w",
      "      \}",
      "    \}",
      "    os_close(fd)",
      "  \}",
      "  poke(gp + G_TR_BUF, 0)",
      "\}",
      "",
      "// ---- recording ------------------------------------------------------------------------------------------------",
      "",
      "fn tr_name(name: Str) \{",
      "  let b = peek(g() + G_TR_BUF)",
      "  sb_add_cstr(b, name)",
      "  sb_add_byte(b, 10)",
      "\}",
      "",
      "fn tr_put_bytes(kind: Word, p: Word, n: Word) \{",
      "  let b = peek(g() + G_TR_BUF)",
      "  sb_add_byte(b, kind)",
      "  sb_add_word(b, n)",
      "  sb_add_byte(b, 10)",
      "  sb_add_bytes(b, p, n)",
      "  sb_add_byte(b, 10)",
      "\}",
      "",
      "// puts a value of the shape `shape` (from position `at`): see the top of the file",
      "fn tr_put(shape: Str, at: Word, v: Word) \{",
      "  let b = peek(g() + G_TR_BUF)",
      "  let c = peek8(bits(shape) + 32 + at)",
      "  if c == 83 \{",
      "    tr_put_bytes(83, v + 32, peek(v + 16))",
      "  \} else if c == 89 \{",
      "    tr_put_bytes(89, peek(v + 32), peek(v + 16))",
      "  \} else if c == 73 \{",
      "    sb_add_byte(b, 73)",
      "    int_show(b, v)",
      "    sb_add_byte(b, 10)",
      "  \} else if c == 66 \{",
      "    sb_add_byte(b, 66)",
      "    sb_add_byte(b, 48 + v)",
      "    sb_add_byte(b, 10)",
      "  \} else if c == 85 \{",
      "    sb_add_cstr(b, \"U\\n\")",
      "  \} else if c == 76 \{",
      "    let n = peek(v + 16)",
      "    sb_add_byte(b, 76)",
      "    sb_add_word(b, n)",
      "    sb_add_byte(b, 10)",
      "    var i: Word = 0",
      "    while i < n \{",
      "      let s = peek(peek(v + 32) + i * 8)",
      "      tr_put_bytes(83, s + 32, peek(s + 16))",
      "      i = i + 1",
      "    \}",
      "  \} else if c == 79 \{",
      "    if v == none() or peek(v + 16) == 0 \{",
      "      sb_add_cstr(b, \"N\\n\")",
      "    \} else \{",
      "      sb_add_cstr(b, \"O\\n\")",
      "      tr_put(shape, at + 1, peek(v + 24))",
      "    \}",
      "  \} else if c == 82 \{",
      "    if peek(v + 16) == 0 \{",
      "      sb_add_cstr(b, \"K\\n\")",
      "      tr_put(shape, at + 1, peek(v + 24))",
      "    \} else \{",
      "      sb_add_cstr(b, \"E\\n\")",
      "      tr_put(\"S\", 0, peek(v + 24))",
      "    \}",
      "  \}",
      "\}",
      "",
      "fn tr_record(name: Str, shape: Str, v: Word) \{",
      "  if tr_mode() == 1 \{",
      "    tr_name(name)",
      "    tr_put(shape, 0, v)",
      "  \}",
      "\}",
      "",
      "fn tr_record_raised(name: Str) \{",
      "  if tr_mode() == 1 \{",
      "    tr_name(name)",
      "    sb_add_cstr(peek(g() + G_TR_BUF), \"R\\n\")",
      "  \}",
      "\}",
      "",
      "// ---- replaying ------------------------------------------------------------------------------------------------",
      "",
      "fn tr_replaying() -> Bool \{",
      "  return tr_mode() == 2",
      "\}",
      "",
      "// the text up to the next line break (the position moves after it)",
      "fn tr_line() -> Word \{",
      "  let gp = g()",
      "  let p = peek(gp + G_TR_IN)",
      "  let start = peek(gp + G_TR_POS)",
      "  var i = start",
      "  while i < peek(gp + G_TR_LEN) and peek8(p + i) != 10 \{",
      "    i = i + 1",
      "  \}",
      "  poke(gp + G_TR_POS, i + 1)",
      "  return str_from(p + start, i - start)",
      "\}",
      "",
      "fn tr_number(s: Word, from: Word) -> Word \{",
      "  var i = from",
      "  var neg = false",
      "  if i < peek(s + 16) and peek8(s + 32 + i) == 45 \{",
      "    neg = true",
      "    i = i + 1",
      "  \}",
      "  var x: Word = 0",
      "  while i < peek(s + 16) \{",
      "    x = x * 10 + peek8(s + 32 + i) - 48",
      "    i = i + 1",
      "  \}",
      "  if neg \{",
      "    return 0 - x",
      "  \}",
      "  return x",
      "\}",
      "",
      "fn tr_diverged(name: Str, other: Word, sp: Word) -> Word \{",
      "  let b = sb_new()",
      "  sb_add_cstr(b, \"replay diverged: the program calls `\")",
      "  sb_add_cstr(b, name)",
      "  if other == 0 \{",
      "    sb_add_cstr(b, \"`, but the recording has ended\")",
      "  \} else \{",
      "    sb_add_cstr(b, \"`, but the recording has `\")",
      "    sb_add_str(b, other)",
      "    sb_add_cstr(b, \"` next (event \")",
      "    sb_add_word(b, peek(g() + G_TR_N) + 1)",
      "    sb_add_cstr(b, \")\")",
      "  \}",
      "  var at = sp",
      "  if at == 0 \{",
      "    at = current_span()",
      "  \}",
      "  return fail_with(bits(\"R0017\"), sb_finish(b), at, 0, bits(\"the program or its input changed since the recording\"))",
      "\}",
      "",
      "// moves to the result of the next event, which must be a call of `name`; false when it raised (call it again)",
      "fn tr_next(name: Str, sp: Word) -> Bool \{",
      "  let gp = g()",
      "  if peek(gp + G_TR_POS) >= peek(gp + G_TR_LEN) \{",
      "    tr_diverged(name, 0, sp)",
      "  \}",
      "  let got = tr_line()",
      "  if not Str_eq(got, bits(name)) \{",
      "    tr_diverged(name, got, sp)",
      "  \}",
      "  rc_dec(got)",
      "  poke(gp + G_TR_N, peek(gp + G_TR_N) + 1)",
      "  let p = peek(gp + G_TR_IN) + peek(gp + G_TR_POS)",
      "  if peek8(p) == 82 \{",
      "    poke(gp + G_TR_POS, peek(gp + G_TR_POS) + 2)",
      "    return false",
      "  \}",
      "  return true",
      "\}",
      "",
      "fn tr_get_bytes(line: Word) -> Word \{",
      "  let gp = g()",
      "  let n = tr_number(line, 1)",
      "  let at = peek(gp + G_TR_IN) + peek(gp + G_TR_POS)",
      "  poke(gp + G_TR_POS, peek(gp + G_TR_POS) + n + 1)",
      "  if peek8(line + 32) == 89 \{",
      "    return bytes_from(at, n)",
      "  \}",
      "  return str_from(at, n)",
      "\}",
      "",
      "// reads a value of the shape `shape` (from `at`); `rtd`: the type of an Option or Result built here",
      "fn tr_get(shape: Str, at: Word, rtd: Word) -> Word \{",
      "  let line = tr_line()",
      "  let c = peek8(line + 32)",
      "  var v: Word = 0",
      "  if c == 83 or c == 89 \{",
      "    v = tr_get_bytes(line)",
      "  \} else if c == 73 \{",
      "    v = bits(tag(tr_number(line, 1)))",
      "  \} else if c == 66 \{",
      "    v = peek8(line + 33) - 48",
      "  \} else if c == 76 \{",
      "    let n = tr_number(line, 1)",
      "    var l = list_new_str()",
      "    var i: Word = 0",
      "    while i < n \{",
      "      let item = tr_line()",
      "      l = list_push_owned_raw(l, tr_get_bytes(item))",
      "      rc_dec(item)",
      "      i = i + 1",
      "    \}",
      "    v = l",
      "  \} else if c == 78 \{",
      "    v = none()",
      "  \} else if c == 79 \{",
      "    v = some_new(rtd, tr_get(shape, at + 1, 0))",
      "  \} else if c == 75 \{",
      "    v = ok_new(rtd, tr_get(shape, at + 1, 0))",
      "  \} else if c == 69 \{",
      "    v = err_new(rtd, tr_get(\"S\", 0, 0))",
      "  \}",
      "  rc_dec(line)",
      "  return v",
      "\}",
      "",
      "fn tr_number_line() -> Word \{",
      "  let line = tr_line()",
      "  let x = tr_number(line, 1)",
      "  rc_dec(line)",
      "  return x",
      "\}",
      "",
      "fn tr_record_bool(name: Str, v: Bool) \{",
      "  if tr_mode() == 1 \{",
      "    tr_name(name)",
      "    let b = peek(g() + G_TR_BUF)",
      "    if v \{",
      "      sb_add_cstr(b, \"B1\\n\")",
      "    \} else \{",
      "      sb_add_cstr(b, \"B0\\n\")",
      "    \}",
      "  \}",
      "\}",
      "",
      "// ---- the traced built-ins (the work is in real_*) -------------------------------------------------------------",
      "",
      "fn b_read_line(rtd: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"read_line\", 0) \{",
      "      return tr_get(\"OS\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_read_line(rtd)",
      "  tr_record(\"read_line\", \"OS\", r)",
      "  return r",
      "\}",
      "",
      "fn b_read_exact(n: Word, rtd: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"read_exact\", 0) \{",
      "      return tr_get(\"OS\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_read_exact(n, rtd)",
      "  tr_record(\"read_exact\", \"OS\", r)",
      "  return r",
      "\}",
      "",
      "fn b_cli_args(rtd: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"cli_args\", 0) \{",
      "      return tr_get(\"L\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_cli_args(rtd)",
      "  tr_record(\"cli_args\", \"L\", r)",
      "  return r",
      "\}",
      "",
      "fn b_env_var(name: Word, rtd: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"env_var\", 0) \{",
      "      return tr_get(\"OS\", 0, rtd)",
      "    \}",
      "  \}",
      "  var r = none()",
      "  if sb_env_ok(name) \{",
      "    r = real_env_var(name, rtd)",
      "  \}",
      "  tr_record(\"env_var\", \"OS\", r)",
      "  return r",
      "\}",
      "",
      "fn b_now_ms(sp: Word) -> Int \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"now_ms\", sp) \{",
      "      return tag(tr_number_line())",
      "    \}",
      "  \}",
      "  let r = real_now_ms(sp)",
      "  tr_record(\"now_ms\", \"I\", bits(r))",
      "  return r",
      "\}",
      "",
      "fn b_now_ns(sp: Word) -> Int \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"now_ns\", sp) \{",
      "      return tag(tr_number_line())",
      "    \}",
      "  \}",
      "  let r = real_now_ns(sp)",
      "  tr_record(\"now_ns\", \"I\", bits(r))",
      "  return r",
      "\}",
      "",
      "fn b_random_int(lo: Int, hi: Int, sp: Word) -> Int \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"random_int\", sp) \{",
      "      return tag(tr_number_line())",
      "    \}",
      "  \}",
      "  if lo > hi \{",
      "    tr_record_raised(\"random_int\")",
      "  \}",
      "  let r = real_random_int(lo, hi, sp)",
      "  tr_record(\"random_int\", \"I\", bits(r))",
      "  return r",
      "\}",
      "",
      "fn b_read_file(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"read_file\", sp) \{",
      "      return tr_get(\"RS\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_read_file(path, rtd, sp)",
      "  tr_record(\"read_file\", \"RS\", r)",
      "  return r",
      "\}",
      "",
      "fn b_file_exists(path: Word, sp: Word) -> Bool \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"file_exists\", sp) \{",
      "      return tr_number_line() == 1",
      "    \}",
      "  \}",
      "  let r = real_file_exists(path, sp)",
      "  tr_record_bool(\"file_exists\", r)",
      "  return r",
      "\}",
      "",
      "fn b_is_dir(path: Word, sp: Word) -> Bool \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"is_dir\", sp) \{",
      "      return tr_number_line() == 1",
      "    \}",
      "  \}",
      "  let r = real_is_dir(path, sp)",
      "  tr_record_bool(\"is_dir\", r)",
      "  return r",
      "\}",
      "",
      "fn b_list_dir(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"list_dir\", sp) \{",
      "      return tr_get(\"RL\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_list_dir(path, rtd, sp)",
      "  tr_record(\"list_dir\", \"RL\", r)",
      "  return r",
      "\}",
      "",
      "fn b_current_dir(sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"current_dir\", sp) \{",
      "      return tr_get(\"S\", 0, 0)",
      "    \}",
      "  \}",
      "  let r = real_current_dir(sp)",
      "  tr_record(\"current_dir\", \"S\", r)",
      "  return r",
      "\}",
      "",
      "fn b_write_file(path: Word, content: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"write_file\", sp) \{",
      "      return tr_get(\"RU\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_write_file(path, content, rtd, sp)",
      "  tr_record(\"write_file\", \"RU\", r)",
      "  return r",
      "\}",
      "",
      "fn b_make_dir(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"make_dir\", sp) \{",
      "      return tr_get(\"RU\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_make_dir(path, rtd, sp)",
      "  tr_record(\"make_dir\", \"RU\", r)",
      "  return r",
      "\}",
      "",
      "fn b_remove_file(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"remove_file\", sp) \{",
      "      return tr_get(\"RU\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_remove_file(path, rtd, sp)",
      "  tr_record(\"remove_file\", \"RU\", r)",
      "  return r",
      "\}",
      "",
      "fn b_set_executable(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"set_executable\", sp) \{",
      "      return tr_get(\"RU\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_set_executable(path, rtd, sp)",
      "  tr_record(\"set_executable\", \"RU\", r)",
      "  return r",
      "\}",
      "",
      "fn b_run_command(args: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"run_command\", sp) \{",
      "      return tr_get(\"RI\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_run_command(args, rtd, sp)",
      "  tr_record(\"run_command\", \"RI\", r)",
      "  return r",
      "\}",
      "",
      "fn b_run_capture(args: Word, dir: Word, input: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"run_capture\", sp) \{",
      "      return tr_get(\"RL\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_run_capture(args, dir, input, rtd, sp)",
      "  tr_record(\"run_capture\", \"RL\", r)",
      "  return r",
      "\}",
      "",
      "fn b_read_bytes(path: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"read_bytes\", sp) \{",
      "      return tr_get(\"RY\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_read_bytes(path, rtd, sp)",
      "  tr_record(\"read_bytes\", \"RY\", r)",
      "  return r",
      "\}",
      "",
      "fn b_write_bytes(path: Word, data: Word, rtd: Word, sp: Word) -> Word \{",
      "  if tr_replaying() \{",
      "    if tr_next(\"write_bytes\", sp) \{",
      "      return tr_get(\"RU\", 0, rtd)",
      "    \}",
      "  \}",
      "  let r = real_write_bytes(path, data, rtd, sp)",
      "  tr_record(\"write_bytes\", \"RU\", r)",
      "  return r",
      "\}",
      "",
    ],
    "std/csv.klar" => [
      "// std.csv — comma-separated values (RFC 4180: quoted fields may hold commas, quotes `\"\"` and line breaks).",
      "// use std.csv.\{parse_csv, format_csv, records\}",
      "",
      "/// The rows of a CSV text; `sep` is the field separator (usually \",\", or \";\" / \"\\t\").",
      "/// `Err` for a quote that is never closed or text right after a closing quote.",
      "/// >>> assert parse_csv_sep(\"a;b\\n1;2\\n\", \";\") == Ok([[\"a\", \"b\"], [\"1\", \"2\"]])",
      "pub fn parse_csv_sep(text: Str, sep: Str) -> Result[List[List[Str]], Str] \{",
      "  var rows: List[List[Str]] = []",
      "  var row: List[Str] = []",
      "  var field = \"\"",
      "  var quoted = false",
      "  var after_quote = false",
      "  var started = false",
      "  var line = 1",
      "  let cs = text.chars()",
      "  var i = 0",
      "  while i < cs.len() \{",
      "    let c = cs.get_or(i, \"\")",
      "    if quoted \{",
      "      if c == \"\\\"\" \{",
      "        if cs.get(i + 1) == Some(\"\\\"\") \{",
      "          field = field + \"\\\"\"",
      "          i = i + 1",
      "        \} else \{",
      "          quoted = false",
      "          after_quote = true",
      "        \}",
      "      \} else \{",
      "        if c == \"\\n\" \{",
      "          line = line + 1",
      "        \}",
      "        field = field + c",
      "      \}",
      "    \} else if c == sep \{",
      "      row = row.push(field)",
      "      field = \"\"",
      "      after_quote = false",
      "      started = true",
      "    \} else if c == \"\\n\" or c == \"\\r\" \{",
      "      if c == \"\\r\" and cs.get(i + 1) == Some(\"\\n\") \{",
      "        i = i + 1",
      "      \}",
      "      rows = rows.push(row.push(field))",
      "      row = []",
      "      field = \"\"",
      "      after_quote = false",
      "      started = false",
      "      line = line + 1",
      "    \} else if c == \"\\\"\" and field.is_empty() and not after_quote \{",
      "      quoted = true",
      "      started = true",
      "    \} else if after_quote \{",
      "      return Err(\"line \{line\}: text after a closing quote\")",
      "    \} else \{",
      "      field = field + c",
      "      started = true",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  if quoted \{",
      "    return Err(\"line \{line\}: a quoted field is not closed\")",
      "  \}",
      "  if started or not field.is_empty() or not row.is_empty() \{",
      "    rows = rows.push(row.push(field))",
      "  \}",
      "  return Ok(rows)",
      "\}",
      "",
      "/// The rows of a CSV text with `,` between the fields.",
      "/// >>> assert parse_csv(\"name,city\\nAnn,\\\"Paris, FR\\\"\\n\") == Ok([[\"name\", \"city\"], [\"Ann\", \"Paris, FR\"]])",
      "/// >>> assert parse_csv(\"q\\n\\\"say \\\"\\\"hi\\\"\\\"\\\"\") == Ok([[\"q\"], [\"say \\\"hi\\\"\"]])",
      "/// >>> assert parse_csv(\"\\\"open\") == Err(\"line 1: a quoted field is not closed\")",
      "pub fn parse_csv(text: Str) -> Result[List[List[Str]], Str] \{",
      "  return parse_csv_sep(text, \",\")",
      "\}",
      "",
      "fn needs_quotes(field: Str, sep: Str) -> Bool \{",
      "  return field.contains(sep) or field.contains(\"\\\"\") or field.contains(\"\\n\") or field.contains(\"\\r\") or",
      "    field.starts_with(\" \") or field.ends_with(\" \")",
      "\}",
      "",
      "/// One field as CSV: quoted when it holds the separator, a quote, a line break or edge spaces.",
      "/// >>> assert format_field(field: \"Paris, FR\", sep: \",\") == \"\\\"Paris, FR\\\"\"",
      "/// >>> assert format_field(field: \"plain\", sep: \",\") == \"plain\"",
      "pub fn format_field(field: Str, sep: Str) -> Str \{",
      "  if needs_quotes(field, sep) \{",
      "    return \"\\\"\" + field.replace(\"\\\"\", \"\\\"\\\"\") + \"\\\"\"",
      "  \}",
      "  return field",
      "\}",
      "",
      "/// Rows as CSV text with `sep` between the fields (every row ends with \"\\n\").",
      "/// >>> assert format_csv_sep([[\"a\", \"b;c\"]], \";\") == \"a;\\\"b;c\\\"\\n\"",
      "pub fn format_csv_sep(rows: List[List[Str]], sep: Str) -> Str \{",
      "  return rows.map(fn(r) => r.map(fn(f) => format_field(field: f, sep: sep)).join(sep) + \"\\n\").join(\"\")",
      "\}",
      "",
      "/// Rows as CSV text with `,` between the fields.",
      "/// >>> assert format_csv([[\"name\", \"note\"], [\"Ann\", \"says \\\"hi\\\"\"]]) == \"name,note\\nAnn,\\\"says \\\"\\\"hi\\\"\\\"\\\"\\n\"",
      "pub fn format_csv(rows: List[List[Str]]) -> Str \{",
      "  return format_csv_sep(rows, \",\")",
      "\}",
      "",
      "/// The rows after the first as maps from the names in the first row (missing fields are left out).",
      "/// >>> assert records([[\"name\", \"age\"], [\"Ann\", \"31\"]]) == [Map \{ \"name\": \"Ann\", \"age\": \"31\" \}]",
      "pub fn records(rows: List[List[Str]]) -> List[Map[Str, Str]] \{",
      "  let header = rows.first().unwrap_or([])",
      "  return rows.drop(1).map(fn(r) => r.zip(header).fold(Map \{\}, fn(acc, p) => acc.set(p.second, p.first)))",
      "\}",
      "",
      "test \"a table survives formatting and parsing\" \{",
      "  let rows = [[\"id\", \"text\"], [\"1\", \"a, b\"], [\"2\", \"line\\nbreak\"], [\"3\", \"\\\"quoted\\\"\"], [\"4\", \"\"]]",
      "  assert parse_csv(format_csv(rows)) == Ok(rows)",
      "  assert parse_csv(\"a,b\\r\\n1,2\\r\\n\") == Ok([[\"a\", \"b\"], [\"1\", \"2\"]])",
      "  assert parse_csv(\"\") == Ok([])",
      "  assert parse_csv(\"a,\\\"b\\\"x\") == Err(\"line 1: text after a closing quote\")",
      "\}",
      "",
      "property \"format and parse are inverse\" (rows: List[List[Str]]) \{",
      "  // rows of a CSV have at least one field; a lone empty field is an empty line",
      "  let usable = rows.filter(fn(r) => not r.is_empty() and r != [\"\"])",
      "  assert parse_csv(format_csv(usable)) == Ok(usable)",
      "\}",
      "",
    ],
    "std/hash.klar" => [
      "// std.hash — checksums and hashes of text (of its UTF-8 bytes): CRC-32, FNV-1a and SHA-256.",
      "// use std.hash.\{crc32, fnv1a, sha256\}",
      "",
      "const MASK32: Int = 4294967295",
      "",
      "/// The 8 hex digits of a 32-bit number.",
      "/// >>> assert hex32(255) == \"000000ff\"",
      "pub fn hex32(n: Int) -> Str \{",
      "  let digits = \"0123456789abcdef\"",
      "  var out = \"\"",
      "  var shift = 28",
      "  while shift >= 0 \{",
      "    let d = n.shift_right(shift).bit_and(15)",
      "    out = out + digits.slice(d, d + 1)",
      "    shift = shift - 4",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn crc_table() -> List[Int] \{",
      "  return range(0, 256).map(fn(n) => range(0, 8).fold(n, fn(c, _k) => match c.bit_and(1) == 1 \{",
      "    true => c.shift_right(1).bit_xor(3988292384),",
      "    false => c.shift_right(1),",
      "  \}))",
      "\}",
      "",
      "/// The CRC-32 checksum (as in zip, PNG and Ethernet).",
      "/// >>> assert hex32(crc32(\"The quick brown fox jumps over the lazy dog\")) == \"414fa339\"",
      "/// >>> assert crc32(\"\") == 0",
      "pub fn crc32(s: Str) -> Int \{",
      "  let table = crc_table()",
      "  let c = s.to_bytes().to_list().fold(MASK32, fn(acc, b) => table.get_or(acc.bit_xor(b).bit_and(255), 0)",
      "      .bit_xor(acc.shift_right(8)))",
      "  return c.bit_xor(MASK32)",
      "\}",
      "",
      "/// The 32-bit FNV-1a hash: fast, for hash tables and sharding (not for security).",
      "/// >>> assert hex32(fnv1a(\"hello\")) == \"4f9f2cab\"",
      "/// >>> assert fnv1a(\"\") == 2166136261",
      "pub fn fnv1a(s: Str) -> Int \{",
      "  return s.to_bytes().to_list().fold(2166136261, fn(h, b) => (h.bit_xor(b) * 16777619).bit_and(MASK32))",
      "\}",
      "",
      "const K256: List[Int] = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,",
      "  3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774,",
      "  264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671,",
      "  3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051,",
      "  2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,",
      "  430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815,",
      "  2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]",
      "",
      "fn rotr(x: Int, n: Int) -> Int \{",
      "  return x.shift_right(n).bit_or(x.shift_left(32 - n)).bit_and(MASK32)",
      "\}",
      "",
      "fn add32(a: Int, b: Int) -> Int \{",
      "  return (a + b).bit_and(MASK32)",
      "\}",
      "",
      "fn word_at(bytes: List[Int], at: Int) -> Int \{",
      "  return bytes.get_or(at, 0).shift_left(24).bit_or(bytes.get_or(at + 1, 0).shift_left(16))",
      "    .bit_or(bytes.get_or(at + 2, 0).shift_left(8)).bit_or(bytes.get_or(at + 3, 0))",
      "\}",
      "",
      "fn sha_block(h: List[Int], block: List[Int]) -> List[Int] \{",
      "  var w = range(0, 16).map(fn(i) => word_at(block, i * 4))",
      "  var t = 16",
      "  while t < 64 \{",
      "    let w15 = w.get_or(t - 15, 0)",
      "    let w2 = w.get_or(t - 2, 0)",
      "    let s0 = rotr(w15, 7).bit_xor(rotr(w15, 18)).bit_xor(w15.shift_right(3))",
      "    let s1 = rotr(w2, 17).bit_xor(rotr(w2, 19)).bit_xor(w2.shift_right(10))",
      "    w = w.push(add32(add32(w.get_or(t - 16, 0), s0), add32(w.get_or(t - 7, 0), s1)))",
      "    t = t + 1",
      "  \}",
      "  var a = h.get_or(0, 0)",
      "  var b = h.get_or(1, 0)",
      "  var c = h.get_or(2, 0)",
      "  var d = h.get_or(3, 0)",
      "  var e = h.get_or(4, 0)",
      "  var f = h.get_or(5, 0)",
      "  var g = h.get_or(6, 0)",
      "  var hh = h.get_or(7, 0)",
      "  var i = 0",
      "  while i < 64 \{",
      "    let s1 = rotr(e, 6).bit_xor(rotr(e, 11)).bit_xor(rotr(e, 25))",
      "    let ch = e.bit_and(f).bit_xor(e.bit_not().bit_and(MASK32).bit_and(g))",
      "    let t1 = add32(add32(add32(hh, s1), add32(ch, K256.get_or(i, 0))), w.get_or(i, 0))",
      "    let s0 = rotr(a, 2).bit_xor(rotr(a, 13)).bit_xor(rotr(a, 22))",
      "    let maj = a.bit_and(b).bit_xor(a.bit_and(c)).bit_xor(b.bit_and(c))",
      "    let t2 = add32(s0, maj)",
      "    hh = g",
      "    g = f",
      "    f = e",
      "    e = add32(d, t1)",
      "    d = c",
      "    c = b",
      "    b = a",
      "    a = add32(t1, t2)",
      "    i = i + 1",
      "  \}",
      "  let now = [a, b, c, d, e, f, g, hh]",
      "  return range(0, 8).map(fn(k) => add32(h.get_or(k, 0), now.get_or(k, 0)))",
      "\}",
      "",
      "/// The SHA-256 hash as 64 hex digits.",
      "/// >>> assert sha256(\"\") == \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"",
      "/// >>> assert sha256(\"abc\") == \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"",
      "pub fn sha256(s: Str) -> Str \{",
      "  let data = s.to_bytes().to_list()",
      "  let bits = data.len() * 8",
      "  var msg = data.push(128)",
      "  while msg.len() % 64 != 56 \{",
      "    msg = msg.push(0)",
      "  \}",
      "  msg = msg.concat(range(0, 8).map(fn(k) => bits.shift_right(56 - k * 8).bit_and(255)))",
      "  var h = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]",
      "  for block in msg.chunks(64) \{",
      "    h = sha_block(h, block)",
      "  \}",
      "  return h.map(fn(x) => hex32(x)).join(\"\")",
      "\}",
      "",
      "test \"longer inputs\" \{",
      "  assert sha256(\"The quick brown fox jumps over the lazy dog\") ==",
      "    \"d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592\"",
      "  assert sha256(\"a\".repeat(1000)) == \"41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3\"",
      "  assert sha256(\"é\") == \"4a99557e4033c3539de2eb65472017cad5f9557f7a0625a09f1c3f6e2ba69c4c\"",
      "  assert crc32(\"123456789\") == 3421780262",
      "\}",
      "",
    ],
    "std/json.klar" => [
      "// JSON: parse text into a `Json` value, read it with `field` / `item` / `lookup` / `as_*`, and print it back.",
      "// Integers stay exact (`Int` has arbitrary precision), so large ids survive a round trip.",
      "",
      "/// A JSON value. Objects keep the order of their keys.",
      "pub enum Json \{",
      "  Null,",
      "  Bool(value: Bool),",
      "  Int(value: Int),",
      "  Num(value: Float),",
      "  Text(value: Str),",
      "  Arr(items: List[Json]),",
      "  Obj(fields: Map[Str, Json]),",
      "\}",
      "",
      "// ---- reading values -------------------------------------------------------------------------------",
      "",
      "/// The value of a key of an object (`None` for other values or a missing key).",
      "/// >>> assert parse_json(\"\\\{\\\"a\\\": 1\\\}\").map(fn(j) => field(j, \"a\")) == Ok(Some(Json.Int(value: 1)))",
      "pub fn field(j: Json, key: Str) -> Option[Json] \{",
      "  return match j \{",
      "    Json.Obj(fields) => fields.get(key),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "/// The element at `index` of an array.",
      "pub fn item(j: Json, index: Int) -> Option[Json] \{",
      "  return match j \{",
      "    Json.Arr(items) => items.get(index),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "/// Follows a dotted path: object keys and array indexes, e.g. `\"users.0.name\"`.",
      "/// >>> assert parse_json(\"\\\{\\\"u\\\": [\\\{\\\"n\\\": \\\"ann\\\"\\\}]\\\}\").map(fn(j) => lookup(j, \"u.0.n\")) == Ok(Some(Json.Text(value: \"ann\")))",
      "pub fn lookup(j: Json, path: Str) -> Option[Json] \{",
      "  var cur = j",
      "  if path.is_empty() \{",
      "    return Some(cur)",
      "  \}",
      "  for part in path.split(\".\") \{",
      "    let next = match cur \{",
      "      Json.Arr(items) => match part.to_int() \{",
      "        Some(i) => items.get(i),",
      "        None => None,",
      "      \},",
      "      Json.Obj(fields) => fields.get(part),",
      "      _ => None,",
      "    \}",
      "    cur = next?",
      "  \}",
      "  return Some(cur)",
      "\}",
      "",
      "pub fn as_text(j: Json) -> Option[Str] \{",
      "  return match j \{",
      "    Json.Text(s) => Some(s),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "/// Integers, and numbers like `3.0` that have no fractional part.",
      "pub fn as_int(j: Json) -> Option[Int] \{",
      "  return match j \{",
      "    Json.Int(n) => Some(n),",
      "    Json.Num(x) => match x.abs() < 9007199254740992.0 and x == x.floor().to_float() \{",
      "      true => Some(x.to_int()),",
      "      false => None,",
      "    \},",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "/// Any number, as a Float.",
      "pub fn as_num(j: Json) -> Option[Float] \{",
      "  return match j \{",
      "    Json.Int(n) => Some(n.to_float()),",
      "    Json.Num(x) => Some(x),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "pub fn as_bool(j: Json) -> Option[Bool] \{",
      "  return match j \{",
      "    Json.Bool(b) => Some(b),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "pub fn as_items(j: Json) -> Option[List[Json]] \{",
      "  return match j \{",
      "    Json.Arr(items) => Some(items),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "pub fn as_fields(j: Json) -> Option[Map[Str, Json]] \{",
      "  return match j \{",
      "    Json.Obj(fields) => Some(fields),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "pub fn is_null(j: Json) -> Bool \{",
      "  return j == Json.Null",
      "\}",
      "",
      "// ---- building values ------------------------------------------------------------------------------",
      "",
      "/// An object from key/value pairs, in order.",
      "/// >>> assert json_text(json_object([Pair \{ first: \"x\", second: Json.Int(value: 1) \}])) == \"\\\{\\\"x\\\":1\\\}\"",
      "pub fn json_object(pairs: List[Pair[Str, Json]]) -> Json \{",
      "  var fields: Map[Str, Json] = Map \{\}",
      "  for p in pairs \{",
      "    fields = fields.set(p.first, p.second)",
      "  \}",
      "  return Json.Obj(fields: fields)",
      "\}",
      "",
      "pub fn json_strings(xs: List[Str]) -> Json \{",
      "  return Json.Arr(items: xs.map(fn(s) => Json.Text(value: s)))",
      "\}",
      "",
      "pub fn json_ints(xs: List[Int]) -> Json \{",
      "  return Json.Arr(items: xs.map(fn(n) => Json.Int(value: n)))",
      "\}",
      "",
      "// ---- printing -------------------------------------------------------------------------------------",
      "",
      "const HEX: Str = \"0123456789abcdef\"",
      "",
      "fn escape(s: Str) -> Str \{",
      "  var plain = true",
      "  for c in s.codes() \{",
      "    if c < 32 or c == 34 or c == 92 \{",
      "      plain = false",
      "      break",
      "    \}",
      "  \}",
      "  if plain \{",
      "    return \"\\\"\" + s + \"\\\"\"",
      "  \}",
      "  var out: List[Str] = [\"\\\"\"]",
      "  for c in s.codes() \{",
      "    let piece = match c \{",
      "      34 => \"\\\\\\\"\",",
      "      92 => \"\\\\\\\\\",",
      "      10 => \"\\\\n\",",
      "      13 => \"\\\\r\",",
      "      9 => \"\\\\t\",",
      "      8 => \"\\\\b\",",
      "      12 => \"\\\\f\",",
      "      x if x < 32 => \"\\\\u00\" + HEX.slice(x / 16, x / 16 + 1) + HEX.slice(x % 16, x % 16 + 1),",
      "      x => x.to_char().unwrap_or(\"?\"),",
      "    \}",
      "    out = out.push(piece)",
      "  \}",
      "  return out.push(\"\\\"\").join(\"\")",
      "\}",
      "",
      "fn number_text(x: Float) -> Str \{",
      "  if x - x != 0.0 \{      // NaN and infinities have no JSON form",
      "    return \"null\"",
      "  \}",
      "  return x.to_str()",
      "\}",
      "",
      "/// Compact JSON text (no spaces).",
      "/// >>> assert json_text(Json.Arr(items: [Json.Null, Json.Bool(value: true), Json.Text(value: \"a\\\"b\")])) == \"[null,true,\\\"a\\\\\\\"b\\\"]\"",
      "pub fn json_text(j: Json) -> Str \{",
      "  return match j \{",
      "    Json.Null => \"null\",",
      "    Json.Bool(b) => b.to_str(),",
      "    Json.Int(n) => n.to_str(),",
      "    Json.Num(x) => number_text(x),",
      "    Json.Text(s) => escape(s),",
      "    Json.Arr(items) => \"[\" + items.map(json_text).join(\",\") + \"]\",",
      "    Json.Obj(fields) => \"\\\{\" + fields.keys().map(fn(k) => escape(k) + \":\" + json_text(fields.get(k).unwrap_or(Json.Null)))",
      "      .join(\",\") + \"\\\}\",",
      "  \}",
      "\}",
      "",
      "fn pretty_at(j: Json, depth: Int) -> Str \{",
      "  let pad = \"  \".repeat(depth + 1)",
      "  let end = \"  \".repeat(depth)",
      "  return match j \{",
      "    Json.Arr(items) => match items.is_empty() \{",
      "      true => \"[]\",",
      "      false => \"[\\n\" + items.map(fn(x) => pad + pretty_at(x, depth + 1)).join(\",\\n\") + \"\\n\" + end + \"]\",",
      "    \},",
      "    Json.Obj(fields) => match fields.len() == 0 \{",
      "      true => \"\\\{\\\}\",",
      "      false => \"\\\{\\n\" + fields.keys()",
      "        .map(fn(k) => pad + escape(k) + \": \" + pretty_at(fields.get(k).unwrap_or(Json.Null), depth + 1))",
      "        .join(\",\\n\") + \"\\n\" + end + \"\\\}\",",
      "    \},",
      "    _ => json_text(j),",
      "  \}",
      "\}",
      "",
      "/// JSON text indented by two spaces, one value per line.",
      "pub fn json_pretty(j: Json) -> Str \{",
      "  return pretty_at(j, 0)",
      "\}",
      "",
      "// ---- parsing --------------------------------------------------------------------------------------",
      "",
      "/// What the parser has read so far: the value and the position after it.",
      "type Step \{ value: Json, pos: Int \}",
      "",
      "type Source \{ text: Str, codes: List[Int] \}",
      "",
      "fn code_at(src: Source, i: Int) -> Int \{",
      "  return src.codes.get_or(i, -1)",
      "\}",
      "",
      "fn where(src: Source, pos: Int) -> Str \{",
      "  var line = 1",
      "  var col = 1",
      "  for c in src.codes.take(pos) \{",
      "    if c == 10 \{",
      "      line = line + 1",
      "      col = 1",
      "    \} else \{",
      "      col = col + 1",
      "    \}",
      "  \}",
      "  return \"line \{line\}, column \{col\}\"",
      "\}",
      "",
      "fn fail_at(src: Source, pos: Int, what: Str) -> Result[Step, Str] \{",
      "  let found = match code_at(src, pos) \{",
      "    -1 => \"the end of the text\",",
      "    c => \"`\" + c.to_char().unwrap_or(\"?\") + \"`\",",
      "  \}",
      "  return Err(\"JSON: expected \{what\} at \{where(src, pos)\}, found \{found\}\")",
      "\}",
      "",
      "fn skip_ws(src: Source, start: Int) -> Int \{",
      "  var i = start",
      "  while true \{",
      "    let c = code_at(src, i)",
      "    if c != 32 and c != 10 and c != 13 and c != 9 \{",
      "      return i",
      "    \}",
      "    i = i + 1",
      "  \}",
      "\}",
      "",
      "fn hex_value(c: Int) -> Int \{",
      "  if c >= 48 and c <= 57 \{",
      "    return c - 48",
      "  \}",
      "  if c >= 97 and c <= 102 \{",
      "    return c - 87",
      "  \}",
      "  if c >= 65 and c <= 70 \{",
      "    return c - 55",
      "  \}",
      "  return -1",
      "\}",
      "",
      "fn hex4(src: Source, at: Int) -> Int \{",
      "  var n = 0",
      "  for k in range(0, 4) \{",
      "    let h = hex_value(code_at(src, at + k))",
      "    if h < 0 \{",
      "      return -1",
      "    \}",
      "    n = n * 16 + h",
      "  \}",
      "  return n",
      "\}",
      "",
      "fn parse_string(src: Source, start: Int) -> Result[Step, Str] \{",
      "  // start is just after the opening quote",
      "  var parts: List[Str] = []",
      "  var run = start",
      "  var i = start",
      "  while true \{",
      "    let c = code_at(src, i)",
      "    if c == -1 \{",
      "      return fail_at(src: src, pos: i, what: \"`\\\"` to close the string\")",
      "    \}",
      "    if c < 32 \{",
      "      return fail_at(src: src, pos: i, what: \"an escaped control character (`\\\\n`, `\\\\t`, ...)\")",
      "    \}",
      "    if c == 34 \{",
      "      parts = parts.push(src.text.slice(run, i))",
      "      return Ok(Step \{ value: Json.Text(value: parts.join(\"\")), pos: i + 1 \})",
      "    \}",
      "    if c == 92 \{",
      "      parts = parts.push(src.text.slice(run, i))",
      "      let e = code_at(src, i + 1)",
      "      var len = 2",
      "      let piece = match e \{",
      "        34 => \"\\\"\",",
      "        92 => \"\\\\\",",
      "        47 => \"/\",",
      "        98 => 8.to_char().unwrap_or(\"\"),",
      "        102 => 12.to_char().unwrap_or(\"\"),",
      "        110 => \"\\n\",",
      "        114 => \"\\r\",",
      "        116 => \"\\t\",",
      "        117 => \"\",",
      "        _ => \"?\",",
      "      \}",
      "      if piece == \"?\" \{",
      "        return fail_at(src: src, pos: i + 1, what: \"an escape (`\\\\\\\"`, `\\\\\\\\`, `\\\\n`, `\\\\u0041`, ...)\")",
      "      \}",
      "      if e == 117 \{",
      "        var cp = hex4(src, i + 2)",
      "        len = 6",
      "        if cp < 0 \{",
      "          return fail_at(src: src, pos: i + 2, what: \"4 hex digits after `\\\\u`\")",
      "        \}",
      "        if cp >= 55296 and cp <= 56319 and code_at(src, i + 6) == 92 and code_at(src, i + 7) == 117 \{",
      "          let low = hex4(src, i + 8)",
      "          if low >= 56320 and low <= 57343 \{",
      "            cp = 65536 + (cp - 55296) * 1024 + (low - 56320)",
      "            len = 12",
      "          \}",
      "        \}",
      "        parts = parts.push(cp.to_char().unwrap_or(\"?\"))",
      "      \} else \{",
      "        parts = parts.push(piece)",
      "      \}",
      "      i = i + len",
      "      run = i",
      "    \} else \{",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  return fail_at(src: src, pos: i, what: \"the end of the string\")",
      "\}",
      "",
      "fn is_number_char(c: Int) -> Bool \{",
      "  return (c >= 48 and c <= 57) or c == 45 or c == 43 or c == 46 or c == 101 or c == 69",
      "\}",
      "",
      "fn parse_number(src: Source, start: Int) -> Result[Step, Str] \{",
      "  var i = start",
      "  var float = false",
      "  while is_number_char(code_at(src, i)) \{",
      "    let c = code_at(src, i)",
      "    if c == 46 or c == 101 or c == 69 \{",
      "      float = true",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  let text = src.text.slice(start, i)",
      "  let digits = match text.starts_with(\"-\") \{",
      "    true => text.slice(1, text.len()),",
      "    false => text,",
      "  \}",
      "  let bad_start = digits.is_empty() or not digits.slice(0, 1).is_numeric() or",
      "    (digits.len() > 1 and digits.starts_with(\"0\") and digits.slice(1, 2).is_numeric())",
      "  if bad_start or digits.ends_with(\".\") or digits.contains(\".e\") or digits.contains(\".E\") \{",
      "    return fail_at(src: src, pos: start, what: \"a number like 12, -3.5 or 1e9\")",
      "  \}",
      "  if not float \{",
      "    return match text.to_int() \{",
      "      Some(n) => Ok(Step \{ value: Json.Int(value: n), pos: i \}),",
      "      None => fail_at(src: src, pos: start, what: \"a number\"),",
      "    \}",
      "  \}",
      "  return match text.to_float() \{",
      "    Some(x) => Ok(Step \{ value: Json.Num(value: x), pos: i \}),",
      "    None => fail_at(src: src, pos: start, what: \"a number like 12, -3.5 or 1e9\"),",
      "  \}",
      "\}",
      "",
      "fn word(src: Source, start: Int, w: Str, value: Json) -> Result[Step, Str] \{",
      "  if src.text.slice(start, start + w.len()) == w \{",
      "    return Ok(Step \{ value: value, pos: start + w.len() \})",
      "  \}",
      "  return fail_at(src: src, pos: start, what: \"a value (`null`, `true`, `false`, a number, a string, `[` or `\\\{`)\")",
      "\}",
      "",
      "fn parse_array(src: Source, start: Int) -> Result[Step, Str] \{",
      "  var items: List[Json] = []",
      "  var i = skip_ws(src, start)",
      "  if code_at(src, i) == 93 \{",
      "    return Ok(Step \{ value: Json.Arr(items: items), pos: i + 1 \})",
      "  \}",
      "  while true \{",
      "    let step = parse_value(src, i)?",
      "    items = items.push(step.value)",
      "    i = skip_ws(src, step.pos)",
      "    let c = code_at(src, i)",
      "    if c == 93 \{",
      "      return Ok(Step \{ value: Json.Arr(items: items), pos: i + 1 \})",
      "    \}",
      "    if c != 44 \{",
      "      return fail_at(src: src, pos: i, what: \"`,` or `]`\")",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return fail_at(src: src, pos: i, what: \"`]`\")",
      "\}",
      "",
      "fn parse_object(src: Source, start: Int) -> Result[Step, Str] \{",
      "  var fields: Map[Str, Json] = Map \{\}",
      "  var i = skip_ws(src, start)",
      "  if code_at(src, i) == 125 \{",
      "    return Ok(Step \{ value: Json.Obj(fields: fields), pos: i + 1 \})",
      "  \}",
      "  while true \{",
      "    if code_at(src, i) != 34 \{",
      "      return fail_at(src: src, pos: i, what: \"a key in double quotes\")",
      "    \}",
      "    let key = parse_string(src, i + 1)?",
      "    i = skip_ws(src, key.pos)",
      "    if code_at(src, i) != 58 \{",
      "      return fail_at(src: src, pos: i, what: \"`:` after the key\")",
      "    \}",
      "    let step = parse_value(src, i + 1)?",
      "    fields = fields.set(as_text(key.value).unwrap_or(\"\"), step.value)",
      "    i = skip_ws(src, step.pos)",
      "    let c = code_at(src, i)",
      "    if c == 125 \{",
      "      return Ok(Step \{ value: Json.Obj(fields: fields), pos: i + 1 \})",
      "    \}",
      "    if c != 44 \{",
      "      return fail_at(src: src, pos: i, what: \"`,` or `\\\}`\")",
      "    \}",
      "    i = skip_ws(src, i + 1)",
      "  \}",
      "  return fail_at(src: src, pos: i, what: \"`\\\}`\")",
      "\}",
      "",
      "fn parse_value(src: Source, start: Int) -> Result[Step, Str] \{",
      "  let i = skip_ws(src, start)",
      "  let c = code_at(src, i)",
      "  if c == 123 \{",
      "    return parse_object(src, i + 1)",
      "  \}",
      "  if c == 91 \{",
      "    return parse_array(src, i + 1)",
      "  \}",
      "  if c == 34 \{",
      "    return parse_string(src, i + 1)",
      "  \}",
      "  if c == 110 \{",
      "    return word(src: src, start: i, w: \"null\", value: Json.Null)",
      "  \}",
      "  if c == 116 \{",
      "    return word(src: src, start: i, w: \"true\", value: Json.Bool(value: true))",
      "  \}",
      "  if c == 102 \{",
      "    return word(src: src, start: i, w: \"false\", value: Json.Bool(value: false))",
      "  \}",
      "  if c == 45 or (c >= 48 and c <= 57) \{",
      "    return parse_number(src, i)",
      "  \}",
      "  return fail_at(src: src, pos: i, what: \"a value (`null`, `true`, `false`, a number, a string, `[` or `\\\{`)\")",
      "\}",
      "",
      "/// Parses a complete JSON text. Errors say what was expected and where (line and column).",
      "/// >>> assert parse_json(\"[1, 2.5, \\\"x\\\", null]\").map(json_text) == Ok(\"[1,2.5,\\\"x\\\",null]\")",
      "/// >>> assert parse_json(\"\\\{\\\"a\\\": \\\}\").is_err()",
      "pub fn parse_json(text: Str) -> Result[Json, Str] \{",
      "  let src = Source \{ text: text, codes: text.codes() \}",
      "  let step = parse_value(src, 0)?",
      "  let end = skip_ws(src, step.pos)",
      "  if end != src.codes.len() \{",
      "    return Err(\"JSON: unexpected text after the value at \{where(src, end)\}\")",
      "  \}",
      "  return Ok(step.value)",
      "\}",
      "",
      "test \"round trip of a document\" \{",
      "  let text = \"\\\{\\\"id\\\": 12345678901234567890, \\\"name\\\": \\\"Ann \\\\\\\"A\\\\\\\" \\\\u00e9\\\\ud83d\\\\ude00\\\", \\\"tags\\\": [\\\"x\\\", \\\"y\\\"],\" +",
      "    \" \\\"score\\\": -0.5, \\\"ok\\\": true, \\\"none\\\": null, \\\"nested\\\": \\\{\\\"empty\\\": [], \\\"obj\\\": \\\{\\\}\\\}\\\}\"",
      "  let j = parse_json(text).unwrap_or(Json.Null)",
      "  assert as_int(field(j, \"id\").unwrap_or(Json.Null)) == Some(12345678901234567890)",
      "  assert lookup(j, \"name\").map(fn(n) => as_text(n)) == Some(Some(\"Ann \\\"A\\\" é😀\"))",
      "  assert lookup(j, \"tags.1\") == Some(Json.Text(value: \"y\"))",
      "  assert lookup(j, \"tags.5\") == None",
      "  assert as_num(field(j, \"score\").unwrap_or(Json.Null)) == Some(-0.5)",
      "  assert parse_json(json_text(j)) == Ok(j)",
      "  assert parse_json(json_pretty(j)) == Ok(j)",
      "\}",
      "",
      "test \"errors point at the problem\" \{",
      "  assert parse_json(\"[1, 2\") == Err(\"JSON: expected `,` or `]` at line 1, column 6, found the end of the text\")",
      "  assert parse_json(\"\\\{\\n  \\\"a\\\" 1\\\}\") == Err(\"JSON: expected `:` after the key at line 2, column 7, found `1`\")",
      "  assert parse_json(\"01\").is_err()",
      "  assert parse_json(\"[1,]\").is_err()",
      "  assert parse_json(\"tru\").is_err()",
      "  assert parse_json(\"\\\"a\\nb\\\"\").is_err()",
      "  assert parse_json(\"1 2\").is_err()",
      "\}",
      "",
      "test \"pretty printing\" \{",
      "  let j = json_object([Pair \{ first: \"a\", second: json_ints([1, 2]) \}, Pair \{ first: \"b\", second: Json.Obj(fields: Map \{\}) \}])",
      "  assert json_pretty(j) == \"\\\{\\n  \\\"a\\\": [\\n    1,\\n    2\\n  ],\\n  \\\"b\\\": \\\{\\\}\\n\\\}\"",
      "  assert json_text(Json.Text(value: \"tab\\there\")) == \"\\\"tab\\\\there\\\"\"",
      "\}",
      "",
      "property \"strings survive a round trip\" (s: Str) \{",
      "  assert parse_json(json_text(Json.Text(value: s))) == Ok(Json.Text(value: s))",
      "\}",
      "",
      "property \"integers survive a round trip\" (xs: List[Int]) \{",
      "  assert parse_json(json_text(json_ints(xs))) == Ok(json_ints(xs))",
      "\}",
      "",
    ],
    "std/list.klar" => [
      "// std.list — extra list algorithms.  use std.list.\{frequencies, transpose, windows\}",
      "",
      "/// Integers from `start` (inclusive) to `end` (exclusive) with a step.",
      "/// >>> assert range_step(start: 0, end: 10, step: 3) == [0, 3, 6, 9]",
      "/// >>> assert range_step(start: 5, end: 0, step: -2) == [5, 3, 1]",
      "pub fn range_step(start: Int, end: Int, step: Int) -> List[Int]",
      "  requires step != 0",
      "\{",
      "  var out: List[Int] = []",
      "  var i = start",
      "  while (step > 0 and i < end) or (step < 0 and i > end) \{",
      "    out = out.push(i)",
      "    i = i + step",
      "  \}",
      "  return out",
      "\}",
      "",
      "/// How many times each element occurs.",
      "/// >>> assert frequencies([\"a\", \"b\", \"a\"]).get(\"a\") == Some(2)",
      "pub fn frequencies[T](xs: List[T]) -> Map[T, Int] \{",
      "  return xs.fold(Map \{\}, fn(acc, x) => acc.update(x, 0, fn(n) => n + 1))",
      "\}",
      "",
      "/// Sliding windows of `size` consecutive elements.",
      "/// >>> assert windows([1, 2, 3, 4], 3) == [[1, 2, 3], [2, 3, 4]]",
      "pub fn windows[T](xs: List[T], size: Int) -> List[List[T]]",
      "  requires size > 0",
      "\{",
      "  var out: List[List[T]] = []",
      "  for i in range(0, xs.len() - size + 1) \{",
      "    out = out.push(xs.slice(i, i + size))",
      "  \}",
      "  return out",
      "\}",
      "",
      "/// Swaps rows and columns; rows shorter than the first are padded by skipping.",
      "/// >>> assert transpose([[1, 2, 3], [4, 5, 6]]) == [[1, 4], [2, 5], [3, 6]]",
      "pub fn transpose[T](rows: List[List[T]]) -> List[List[T]] \{",
      "  let width = rows.first().map(fn(r) => r.len()).unwrap_or(0)",
      "  return range(0, width).map(fn(c) => rows.flat_map(fn(r) => match r.get(c) \{",
      "    Some(v) => [v],",
      "    None => [],",
      "  \}))",
      "\}",
      "",
      "/// Puts `sep` between elements.",
      "/// >>> assert intersperse([1, 2, 3], 0) == [1, 0, 2, 0, 3]",
      "pub fn intersperse[T](xs: List[T], sep: T) -> List[T] \{",
      "  var out: List[T] = []",
      "  for e in xs.enumerate() \{",
      "    if e.index > 0 \{",
      "      out = out.push(sep)",
      "    \}",
      "    out = out.push(e.value)",
      "  \}",
      "  return out",
      "\}",
      "",
      "/// Rotates left by `n` positions (negative rotates right).",
      "/// >>> assert rotate([1, 2, 3, 4], 1) == [2, 3, 4, 1]",
      "pub fn rotate[T](xs: List[T], n: Int) -> List[T] \{",
      "  if xs.is_empty() \{",
      "    return xs",
      "  \}",
      "  let k = ((n % xs.len()) + xs.len()) % xs.len()",
      "  return xs.drop(k).concat(xs.take(k))",
      "\}",
      "",
      "/// Elements present in both lists (order of the first list, no duplicates).",
      "/// >>> assert intersection([1, 2, 2, 3], [2, 3, 4]) == [2, 3]",
      "pub fn intersection[T](a: List[T], b: List[T]) -> List[T] \{",
      "  return a.filter(fn(x) => b.contains(x)).unique()",
      "\}",
      "",
      "/// Elements of `a` that are not in `b`.",
      "/// >>> assert difference([1, 2, 3], [2]) == [1, 3]",
      "pub fn difference[T](a: List[T], b: List[T]) -> List[T] \{",
      "  return a.filter(fn(x) => not b.contains(x))",
      "\}",
      "",
      "/// Binary search in a sorted list of Ints; returns the index if found.",
      "/// >>> assert binary_search([1, 3, 5, 7], 5) == Some(2)",
      "/// >>> assert binary_search([1, 3, 5, 7], 4) == None",
      "pub fn binary_search(sorted: List[Int], target: Int) -> Option[Int] \{",
      "  var lo = 0",
      "  var hi = sorted.len() - 1",
      "  while lo <= hi \{",
      "    let mid = (lo + hi) / 2",
      "    let v = sorted.get(mid)?",
      "    if v == target \{",
      "      return Some(mid)",
      "    \}",
      "    if v < target \{",
      "      lo = mid + 1",
      "    \} else \{",
      "      hi = mid - 1",
      "    \}",
      "  \}",
      "  return None",
      "\}",
      "",
      "/// Cumulative sums.",
      "/// >>> assert running_sum([1, 2, 3]) == [1, 3, 6]",
      "pub fn running_sum(xs: List[Int]) -> List[Int] \{",
      "  var total = 0",
      "  var out: List[Int] = []",
      "  for x in xs \{",
      "    total = total + x",
      "    out = out.push(total)",
      "  \}",
      "  return out",
      "\}",
      "",
      "test \"windows edge cases\" \{",
      "  assert windows([1, 2], 3) == []",
      "  assert windows([1], 1) == [[1]]",
      "\}",
      "",
      "test \"rotate negative\" \{",
      "  assert rotate([1, 2, 3], -1) == [3, 1, 2]",
      "  assert rotate([], 5) == []",
      "\}",
      "",
      "property \"rotate keeps elements\" (xs: List[Int], n: Int) \{",
      "  assert rotate(xs, n).sort() == xs.sort()",
      "\}",
      "",
      "property \"running_sum last equals sum\" (xs: List[Int]) \{",
      "  assert running_sum(xs).last().unwrap_or(0) == xs.sum()",
      "\}",
      "",
      "property \"binary_search finds present elements\" (xs: List[Int], x: Int) \{",
      "  let sorted = xs.push(x).sort().unique()",
      "  match binary_search(sorted, x) \{",
      "    Some(i) => \{ assert sorted.get(i) == Some(x) \},",
      "    None => \{ assert false, \"element not found\" \},",
      "  \}",
      "\}",
      "",
      "property \"transpose twice restores rectangular grids\" (n: Int) \{",
      "  let size = n.abs() % 5 + 1",
      "  let grid = range(0, size).map(fn(r) => range(0, 3).map(fn(c) => r * 10 + c))",
      "  assert transpose(transpose(grid)) == grid",
      "\}",
      "",
      "property \"frequencies sum to length\" (xs: List[Str]) \{",
      "  assert frequencies(xs).values().sum() == xs.len()",
      "\}",
      "",
    ],
    "std/math.klar" => [
      "// std.math — integer and floating point helpers.  use std.math.\{gcd, is_prime, mean, floor_div\}",
      "",
      "/// Greatest common divisor (always >= 0).",
      "/// >>> assert gcd(12, 18) == 6",
      "/// >>> assert gcd(-4, 6) == 2",
      "pub fn gcd(a: Int, b: Int) -> Int",
      "  ensures result >= 0",
      "\{",
      "  var x = a.abs()",
      "  var y = b.abs()",
      "  while y != 0 \{",
      "    let t = x % y",
      "    x = y",
      "    y = t",
      "  \}",
      "  return x",
      "\}",
      "",
      "/// Least common multiple; lcm(0, n) == 0.",
      "/// >>> assert lcm(4, 6) == 12",
      "pub fn lcm(a: Int, b: Int) -> Int \{",
      "  let g = gcd(a, b)",
      "  if g == 0 \{",
      "    return 0",
      "  \}",
      "  return (a / g * b).abs()",
      "\}",
      "",
      "/// Floor division: rounds towards minus infinity like Python's `//` (Klar's `/` truncates towards zero).",
      "/// >>> assert floor_div(7, 2) == 3",
      "/// >>> assert floor_div(-7, 2) == -4",
      "/// >>> assert floor_div(7, -2) == -4",
      "pub fn floor_div(a: Int, b: Int) -> Int",
      "  requires b != 0",
      "\{",
      "  let q = a / b",
      "  if a % b != 0 and (a < 0) != (b < 0) \{",
      "    return q - 1",
      "  \}",
      "  return q",
      "\}",
      "",
      "/// The remainder that goes with `floor_div`: it has the sign of `b`, like Python's `%` (Klar's `%` has the sign",
      "/// of `a`).",
      "/// >>> assert floor_mod(7, 3) == 1",
      "/// >>> assert floor_mod(-7, 3) == 2",
      "/// >>> assert floor_mod(7, -3) == -2",
      "pub fn floor_mod(a: Int, b: Int) -> Int",
      "  requires b != 0",
      "\{",
      "  return a - floor_div(a, b) * b",
      "\}",
      "",
      "/// Primality test by trial division.",
      "/// >>> assert is_prime(97)",
      "/// >>> assert not is_prime(1)",
      "pub fn is_prime(n: Int) -> Bool \{",
      "  if n < 2 \{",
      "    return false",
      "  \}",
      "  if n < 4 \{",
      "    return true",
      "  \}",
      "  if n % 2 == 0 \{",
      "    return false",
      "  \}",
      "  var d = 3",
      "  while d * d <= n \{",
      "    if n % d == 0 \{",
      "      return false",
      "    \}",
      "    d = d + 2",
      "  \}",
      "  return true",
      "\}",
      "",
      "/// All primes below `limit` (sieve of Eratosthenes).",
      "/// >>> assert primes_below(20) == [2, 3, 5, 7, 11, 13, 17, 19]",
      "pub fn primes_below(limit: Int) -> List[Int] \{",
      "  var marks: List[Bool] = []",
      "  for _i in range(0, limit) \{",
      "    marks = marks.push(true)",
      "  \}",
      "  var out: List[Int] = []",
      "  for n in range(2, limit) \{",
      "    if marks.get(n).unwrap_or(false) \{",
      "      out = out.push(n)",
      "      var m = n * n",
      "      while m < limit \{",
      "        marks = marks.set(m, false)",
      "        m = m + n",
      "      \}",
      "    \}",
      "  \}",
      "  return out",
      "\}",
      "",
      "/// n! for n >= 0.",
      "/// >>> assert factorial(5) == 120",
      "pub fn factorial(n: Int) -> Int",
      "  requires n >= 0",
      "\{",
      "  var acc = 1",
      "  for i in range(2, n + 1) \{",
      "    acc = acc * i",
      "  \}",
      "  return acc",
      "\}",
      "",
      "/// n-th Fibonacci number (fib(0) == 0), linear time.",
      "/// >>> assert fib(10) == 55",
      "pub fn fib(n: Int) -> Int",
      "  requires n >= 0",
      "\{",
      "  var a = 0",
      "  var b = 1",
      "  for _i in range(0, n) \{",
      "    let next = a + b",
      "    a = b",
      "    b = next",
      "  \}",
      "  return a",
      "\}",
      "",
      "/// Integer square root: the largest r with r * r <= n.",
      "/// >>> assert isqrt(17) == 4",
      "pub fn isqrt(n: Int) -> Int",
      "  requires n >= 0",
      "  ensures result * result <= n and (result + 1) * (result + 1) > n",
      "\{",
      "  if n < 2 \{",
      "    return n",
      "  \}",
      "  var x = n",
      "  var y = (x + 1) / 2",
      "  while y < x and y > 0 \{",
      "    x = y",
      "    y = (x + n / x) / 2",
      "  \}",
      "  return x",
      "\}",
      "",
      "/// Arithmetic mean; None for an empty list.",
      "/// >>> assert mean([1.0, 2.0, 3.0]) == Some(2.0)",
      "pub fn mean(xs: List[Float]) -> Option[Float] \{",
      "  if xs.is_empty() \{",
      "    return None",
      "  \}",
      "  return Some(xs.sum_float() / xs.len().to_float())",
      "\}",
      "",
      "/// Median; None for an empty list.",
      "/// >>> assert median([3.0, 1.0, 2.0]) == Some(2.0)",
      "/// >>> assert median([4.0, 1.0, 3.0, 2.0]) == Some(2.5)",
      "pub fn median(xs: List[Float]) -> Option[Float] \{",
      "  let sorted = xs.sort()",
      "  let n = sorted.len()",
      "  if n == 0 \{",
      "    return None",
      "  \}",
      "  if n % 2 == 1 \{",
      "    return sorted.get(n / 2)",
      "  \}",
      "  let lo = sorted.get(n / 2 - 1)?",
      "  let hi = sorted.get(n / 2)?",
      "  return Some((lo + hi) / 2.0)",
      "\}",
      "",
      "/// Population standard deviation; None for an empty list.",
      "pub fn std_dev(xs: List[Float]) -> Option[Float] \{",
      "  let m = mean(xs)?",
      "  let squares = xs.map(fn(x) => (x - m) * (x - m))",
      "  return Some((squares.sum_float() / xs.len().to_float()).sqrt())",
      "\}",
      "",
      "/// Clamps a Float into [low, high].",
      "/// >>> assert clamp_float(x: 5.5, low: 0.0, high: 1.0) == 1.0",
      "pub fn clamp_float(x: Float, low: Float, high: Float) -> Float",
      "  requires low <= high",
      "\{",
      "  return x.max(low).min(high)",
      "\}",
      "",
      "/// Product of all numbers (1 for an empty list).",
      "/// >>> assert product([2, 3, 4]) == 24",
      "pub fn product(xs: List[Int]) -> Int \{",
      "  return xs.fold(1, fn(acc, x) => acc * x)",
      "\}",
      "",
      "/// Floats are equal within an absolute tolerance.",
      "/// >>> assert approx_eq(a: 0.1 + 0.2, b: 0.3, tolerance: 0.000001)",
      "pub fn approx_eq(a: Float, b: Float, tolerance: Float) -> Bool \{",
      "  return (a - b).abs() <= tolerance",
      "\}",
      "",
      "/// Degrees to radians.",
      "pub fn to_radians(degrees: Float) -> Float \{",
      "  return degrees * PI / 180.0",
      "\}",
      "",
      "test \"gcd and lcm\" \{",
      "  assert gcd(0, 0) == 0",
      "  assert gcd(17, 5) == 1",
      "  assert lcm(0, 5) == 0",
      "  assert lcm(-3, 4) == 12",
      "\}",
      "",
      "test \"primes\" \{",
      "  assert primes_below(2) == []",
      "  assert primes_below(30).len() == 10",
      "  assert primes_below(100).all(fn(p) => is_prime(p))",
      "\}",
      "",
      "test \"factorial and fib\" \{",
      "  assert factorial(0) == 1",
      "  assert factorial(20) == 2432902008176640000",
      "  assert fib(0) == 0",
      "  assert fib(1) == 1",
      "  assert fib(90) == 2880067194370816120",
      "\}",
      "",
      "test \"statistics\" \{",
      "  assert mean([]).is_none()",
      "  assert median([]).is_none()",
      "  assert std_dev([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]) == Some(2.0)",
      "\}",
      "",
      "test \"angles\" \{",
      "  assert approx_eq(a: to_radians(180.0), b: PI, tolerance: 0.0000001)",
      "  assert approx_eq(a: to_radians(90.0).sin(), b: 1.0, tolerance: 0.0000001)",
      "\}",
      "",
      "property \"gcd divides both\" (a: Int, b: Int) \{",
      "  let g = gcd(a, b)",
      "  if g == 0 \{",
      "    return",
      "  \}",
      "  assert a % g == 0 and b % g == 0",
      "\}",
      "",
      "property \"isqrt is the floor square root\" (n: Int) \{",
      "  let m = n.abs()",
      "  let r = isqrt(m)",
      "  assert r * r <= m",
      "\}",
      "",
      "property \"sieve agrees with is_prime\" (n: Int) \{",
      "  let limit = n.abs() % 200",
      "  assert primes_below(limit) == range(0, limit).filter(fn(k) => is_prime(k))",
      "\}",
      "",
    ],
    "std/numfmt.klar" => [
      "// std.numfmt — numbers as text for people: digit groups, percentages, sizes, ordinals, Roman numerals.",
      "// use std.numfmt.\{group_digits, percent, human_bytes, ordinal\}",
      "",
      "/// Digits in groups of three with `sep` between them.",
      "/// >>> assert group_digits(n: 1234567, sep: \",\") == \"1,234,567\"",
      "/// >>> assert group_digits(n: -1000, sep: \" \") == \"-1 000\"",
      "/// >>> assert group_digits(n: 999, sep: \",\") == \"999\"",
      "pub fn group_digits(n: Int, sep: Str) -> Str \{",
      "  let digits = n.abs().to_str()",
      "  var out = \"\"",
      "  var i = 0",
      "  let len = digits.len()",
      "  for c in digits.chars() \{",
      "    if i > 0 and (len - i) % 3 == 0 \{",
      "      out = out + sep",
      "    \}",
      "    out = out + c",
      "    i = i + 1",
      "  \}",
      "  return match n < 0 \{",
      "    true => \"-\" + out,",
      "    false => out,",
      "  \}",
      "\}",
      "",
      "/// A fraction as a percentage with `digits` decimals.",
      "/// >>> assert percent(x: 0.125, digits: 1) == \"12.5%\"",
      "/// >>> assert percent(x: 1.0, digits: 0) == \"100%\"",
      "pub fn percent(x: Float, digits: Int) -> Str",
      "  requires digits >= 0",
      "\{",
      "  return (x * 100.0).fixed(digits) + \"%\"",
      "\}",
      "",
      "/// The integer with leading zeros up to `width` digits (the sign before them).",
      "/// >>> assert zero_pad(n: 7, width: 3) == \"007\"",
      "/// >>> assert zero_pad(n: -42, width: 4) == \"-0042\"",
      "/// >>> assert zero_pad(n: 12345, width: 3) == \"12345\"",
      "pub fn zero_pad(n: Int, width: Int) -> Str \{",
      "  let digits = n.abs().to_str().pad_left(width, \"0\")",
      "  return match n < 0 \{",
      "    true => \"-\" + digits,",
      "    false => digits,",
      "  \}",
      "\}",
      "",
      "/// A size in bytes with the largest unit (of 1024) that keeps it at least 1, one decimal above bytes.",
      "/// >>> assert human_bytes(512) == \"512 B\"",
      "/// >>> assert human_bytes(1536) == \"1.5 KB\"",
      "/// >>> assert human_bytes(5 * 1024 * 1024 * 1024) == \"5.0 GB\"",
      "pub fn human_bytes(n: Int) -> Str \{",
      "  let units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\"]",
      "  var size = n.to_float()",
      "  var u = 0",
      "  while size.abs() >= 1024.0 and u < units.len() - 1 \{",
      "    size = size / 1024.0",
      "    u = u + 1",
      "  \}",
      "  if u == 0 \{",
      "    return \"\{n\} B\"",
      "  \}",
      "  return size.fixed(1) + \" \" + units.get_or(u, \"?\")",
      "\}",
      "",
      "/// The English ordinal: 1st, 2nd, 3rd, 4th, 11th, 21st, ...",
      "/// >>> assert ordinal(1) == \"1st\"",
      "/// >>> assert ordinal(12) == \"12th\"",
      "/// >>> assert ordinal(23) == \"23rd\"",
      "/// >>> assert ordinal(111) == \"111th\"",
      "pub fn ordinal(n: Int) -> Str \{",
      "  let last2 = n.abs() % 100",
      "  let last = n.abs() % 10",
      "  let suffix = match last2 >= 11 and last2 <= 13 \{",
      "    true => \"th\",",
      "    false => match last \{",
      "      1 => \"st\",",
      "      2 => \"nd\",",
      "      3 => \"rd\",",
      "      _ => \"th\",",
      "    \},",
      "  \}",
      "  return \"\{n\}\{suffix\}\"",
      "\}",
      "",
      "/// The Roman numeral of 1..3999.",
      "/// >>> assert to_roman(1994) == \"MCMXCIV\"",
      "/// >>> assert to_roman(4) == \"IV\"",
      "pub fn to_roman(n: Int) -> Str",
      "  requires n >= 1 and n <= 3999",
      "\{",
      "  let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]",
      "  let symbols = [\"M\", \"CM\", \"D\", \"CD\", \"C\", \"XC\", \"L\", \"XL\", \"X\", \"IX\", \"V\", \"IV\", \"I\"]",
      "  var rest = n",
      "  var out = \"\"",
      "  var i = 0",
      "  while rest > 0 \{",
      "    let v = values.get_or(i, 1)",
      "    if rest >= v \{",
      "      out = out + symbols.get_or(i, \"I\")",
      "      rest = rest - v",
      "    \} else \{",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  return out",
      "\}",
      "",
      "/// The number of a Roman numeral (`None` for anything else).",
      "/// >>> assert from_roman(\"MCMXCIV\") == Some(1994)",
      "/// >>> assert from_roman(\"hello\") == None",
      "pub fn from_roman(s: Str) -> Option[Int] \{",
      "  let value = Map \{ \"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000 \}",
      "  var total = 0",
      "  var prev = 0",
      "  for c in s.upper().chars().reverse() \{",
      "    let v = match value.get(c) \{",
      "      Some(x) => x,",
      "      None => \{",
      "        return None",
      "      \},",
      "    \}",
      "    if v < prev \{",
      "      total = total - v",
      "    \} else \{",
      "      total = total + v",
      "      prev = v",
      "    \}",
      "  \}",
      "  if total < 1 or total > 3999 or to_roman(total) != s.upper() \{",
      "    return None",
      "  \}",
      "  return Some(total)",
      "\}",
      "",
      "property \"roman numerals round trip\" (n: Int) \{",
      "  let k = n.abs() % 3999 + 1",
      "  assert from_roman(to_roman(k)) == Some(k)",
      "\}",
      "",
      "property \"grouping keeps the digits\" (n: Int) \{",
      "  assert group_digits(n: n, sep: \",\").replace(\",\", \"\") == n.to_str()",
      "\}",
      "",
    ],
    "std/path.klar" => [
      "// std.path — file paths as text (separator `/`; nothing touches the disk).",
      "// use std.path.\{join, normalize, dirname, basename, extension\}",
      "",
      "/// Whether a path starts at the root.",
      "/// >>> assert is_absolute(\"/etc/hosts\")",
      "/// >>> assert not is_absolute(\"notes/a.txt\")",
      "pub fn is_absolute(p: Str) -> Bool \{",
      "  return p.starts_with(\"/\")",
      "\}",
      "",
      "/// `b` after `a` (just `b` when it is absolute or `a` is empty).",
      "/// >>> assert join(\"notes\", \"a.txt\") == \"notes/a.txt\"",
      "/// >>> assert join(\"notes/\", \"a.txt\") == \"notes/a.txt\"",
      "/// >>> assert join(\"notes\", \"/etc\") == \"/etc\"",
      "pub fn join(a: Str, b: Str) -> Str \{",
      "  if is_absolute(b) or a.is_empty() \{",
      "    return b",
      "  \}",
      "  if b.is_empty() or a.ends_with(\"/\") \{",
      "    return a + b",
      "  \}",
      "  return a + \"/\" + b",
      "\}",
      "",
      "/// Joins all parts in order (`join` of each next one).",
      "/// >>> assert join_all([\"a\", \"b\", \"c.txt\"]) == \"a/b/c.txt\"",
      "pub fn join_all(pieces: List[Str]) -> Str \{",
      "  return pieces.fold(\"\", fn(acc, p) => join(acc, p))",
      "\}",
      "",
      "/// The non-empty parts between the separators.",
      "/// >>> assert parts(\"/usr//local/bin/\") == [\"usr\", \"local\", \"bin\"]",
      "pub fn parts(p: Str) -> List[Str] \{",
      "  return p.split(\"/\").filter(fn(s) => not s.is_empty())",
      "\}",
      "",
      "/// The path without `.`, `..` (where it can go up) and repeated separators; \".\" for an empty relative path.",
      "/// >>> assert normalize(\"a/./b/../c//d\") == \"a/c/d\"",
      "/// >>> assert normalize(\"/../x\") == \"/x\"",
      "/// >>> assert normalize(\"../a/..\") == \"..\"",
      "/// >>> assert normalize(\"a/..\") == \".\"",
      "pub fn normalize(p: Str) -> Str \{",
      "  var out: List[Str] = []",
      "  for s in parts(p) \{",
      "    if s == \".\" \{",
      "      continue",
      "    \}",
      "    if s == \"..\" \{",
      "      if not out.is_empty() and out.last() != Some(\"..\") \{",
      "        out = out.take(out.len() - 1)",
      "      \} else if not is_absolute(p) \{",
      "        out = out.push(\"..\")",
      "      \}",
      "      continue",
      "    \}",
      "    out = out.push(s)",
      "  \}",
      "  let body = out.join(\"/\")",
      "  if is_absolute(p) \{",
      "    return \"/\" + body",
      "  \}",
      "  return match body.is_empty() \{",
      "    true => \".\",",
      "    false => body,",
      "  \}",
      "\}",
      "",
      "fn last_slash(p: Str) -> Option[Int] \{",
      "  var found: Option[Int] = None",
      "  var i = 0",
      "  for c in p.chars() \{",
      "    if c == \"/\" \{",
      "      found = Some(i)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return found",
      "\}",
      "",
      "/// The last part of a path (after the last `/`).",
      "/// >>> assert basename(\"/home/ann/notes.txt\") == \"notes.txt\"",
      "/// >>> assert basename(\"notes.txt\") == \"notes.txt\"",
      "pub fn basename(p: Str) -> Str \{",
      "  return match last_slash(p) \{",
      "    Some(i) => p.slice(i + 1, p.len()),",
      "    None => p,",
      "  \}",
      "\}",
      "",
      "/// Everything before the last part (\".\" when there is none, \"/\" for a file in the root).",
      "/// >>> assert dirname(\"/home/ann/notes.txt\") == \"/home/ann\"",
      "/// >>> assert dirname(\"notes.txt\") == \".\"",
      "/// >>> assert dirname(\"/notes.txt\") == \"/\"",
      "pub fn dirname(p: Str) -> Str \{",
      "  return match last_slash(p) \{",
      "    Some(0) => \"/\",",
      "    Some(i) => p.slice(0, i),",
      "    None => \".\",",
      "  \}",
      "\}",
      "",
      "fn last_dot(s: Str) -> Option[Int] \{",
      "  var found: Option[Int] = None",
      "  var i = 0",
      "  for c in s.chars() \{",
      "    if c == \".\" and i > 0 \{",
      "      found = Some(i)",
      "    \}",
      "    i = i + 1",
      "  \}",
      "  return found",
      "\}",
      "",
      "/// The extension of the last part without the dot (\"\" when there is none; a leading dot is not one).",
      "/// >>> assert extension(\"photos/cat.JPG\") == \"JPG\"",
      "/// >>> assert extension(\"archive.tar.gz\") == \"gz\"",
      "/// >>> assert extension(\".bashrc\") == \"\"",
      "pub fn extension(p: Str) -> Str \{",
      "  let b = basename(p)",
      "  return match last_dot(b) \{",
      "    Some(i) => b.slice(i + 1, b.len()),",
      "    None => \"\",",
      "  \}",
      "\}",
      "",
      "/// The last part without its extension.",
      "/// >>> assert stem(\"photos/cat.jpg\") == \"cat\"",
      "/// >>> assert stem(\"archive.tar.gz\") == \"archive.tar\"",
      "pub fn stem(p: Str) -> Str \{",
      "  let b = basename(p)",
      "  return match last_dot(b) \{",
      "    Some(i) => b.slice(0, i),",
      "    None => b,",
      "  \}",
      "\}",
      "",
      "/// The path with another extension (`ext` without the dot; \"\" removes it).",
      "/// >>> assert with_extension(\"a/b.txt\", \"md\") == \"a/b.md\"",
      "/// >>> assert with_extension(\"a/b\", \"md\") == \"a/b.md\"",
      "/// >>> assert with_extension(\"a/b.txt\", \"\") == \"a/b\"",
      "pub fn with_extension(p: Str, ext: Str) -> Str \{",
      "  let dir = match last_slash(p) \{",
      "    Some(i) => p.slice(0, i + 1),",
      "    None => \"\",",
      "  \}",
      "  return match ext.is_empty() \{",
      "    true => dir + stem(p),",
      "    false => dir + stem(p) + \".\" + ext,",
      "  \}",
      "\}",
      "",
      "/// `p` relative to the directory `base` (both normalized; `..` where `p` is outside it).",
      "/// >>> assert relative_to(\"/a/b/c.txt\", \"/a\") == \"b/c.txt\"",
      "/// >>> assert relative_to(\"/a/x\", \"/a/b\") == \"../x\"",
      "/// >>> assert relative_to(\"/a\", \"/a\") == \".\"",
      "pub fn relative_to(p: Str, base: Str) -> Str \{",
      "  let ps = parts(normalize(p))",
      "  let bs = parts(normalize(base))",
      "  var common = 0",
      "  while common < ps.len() and common < bs.len() and ps.get(common) == bs.get(common) \{",
      "    common = common + 1",
      "  \}",
      "  let up = range(0, bs.len() - common).map(fn(_i) => \"..\")",
      "  let rest = up.concat(ps.drop(common))",
      "  return match rest.is_empty() \{",
      "    true => \".\",",
      "    false => rest.join(\"/\"),",
      "  \}",
      "\}",
      "",
      "test \"paths round trip\" \{",
      "  let p = \"/data/2026/report.final.csv\"",
      "  assert join(dirname(p), basename(p)) == p",
      "  assert with_extension(p, extension(p)) == p",
      "  assert normalize(join(\"/data\", \"../data/./2026\")) == \"/data/2026\"",
      "\}",
      "",
      "property \"normalize is idempotent\" (xs: List[Int]) \{",
      "  let p = xs.map(fn(x) => match x.abs() % 4 \{",
      "    0 => \"..\",",
      "    1 => \".\",",
      "    2 => \"a\",",
      "    _ => \"\",",
      "  \}).join(\"/\")",
      "  assert normalize(normalize(p)) == normalize(p)",
      "\}",
      "",
    ],
    "std/regex.klar" => [
      "// std.regex — regular expressions: literals, `.`, classes `[a-z]` `[^0-9]`, `\\d \\w \\s` (and `\\D \\W \\S`), groups",
      "// `( )`, alternatives `|`, repetition `* + ?` and `\{n\}` `\{n,\}` `\{n,m\}`, anchors `^ $`. Matching is greedy and",
      "// backtracking; a pattern that is not valid is `Err` with the reason.",
      "// use std.regex.\{is_match, find, find_all, replace_all\}",
      "",
      "/// A parsed regular expression.",
      "pub enum Rx \{",
      "  Lit(c: Str),",
      "  AnyChar,",
      "  Class(ranges: List[Pair[Str, Str]], negated: Bool),",
      "  Start,",
      "  Finish,",
      "  Seq(items: List[Rx]),",
      "  Alt(options: List[Rx]),",
      "  Rep(item: Rx, min: Int, max: Int),",
      "\}",
      "",
      "/// A parsed piece and the position after it.",
      "type Parsed \{ rx: Rx, next: Int \}",
      "",
      "fn digit_ranges() -> List[Pair[Str, Str]] \{",
      "  return [Pair \{ first: \"0\", second: \"9\" \}]",
      "\}",
      "",
      "fn word_ranges() -> List[Pair[Str, Str]] \{",
      "  return [Pair \{ first: \"a\", second: \"z\" \}, Pair \{ first: \"A\", second: \"Z\" \}, Pair \{ first: \"0\", second: \"9\" \},",
      "    Pair \{ first: \"_\", second: \"_\" \}]",
      "\}",
      "",
      "fn space_ranges() -> List[Pair[Str, Str]] \{",
      "  return [\" \", \"\\t\", \"\\n\", \"\\r\"].map(fn(c) => Pair \{ first: c, second: c \})",
      "\}",
      "",
      "/// The class of an escape (`\\d`, `\\W`, ...), or None for an escaped literal.",
      "fn escape_class(c: Str) -> Option[Rx] \{",
      "  return match c \{",
      "    \"d\" => Some(Rx.Class(ranges: digit_ranges(), negated: false)),",
      "    \"D\" => Some(Rx.Class(ranges: digit_ranges(), negated: true)),",
      "    \"w\" => Some(Rx.Class(ranges: word_ranges(), negated: false)),",
      "    \"W\" => Some(Rx.Class(ranges: word_ranges(), negated: true)),",
      "    \"s\" => Some(Rx.Class(ranges: space_ranges(), negated: false)),",
      "    \"S\" => Some(Rx.Class(ranges: space_ranges(), negated: true)),",
      "    _ => None,",
      "  \}",
      "\}",
      "",
      "fn escaped(c: Str) -> Str \{",
      "  return match c \{",
      "    \"n\" => \"\\n\",",
      "    \"t\" => \"\\t\",",
      "    \"r\" => \"\\r\",",
      "    _ => c,",
      "  \}",
      "\}",
      "",
      "fn parse_alt(cs: List[Str], at: Int) -> Result[Parsed, Str] \{",
      "  let first = parse_seq(cs, at)?",
      "  var options = [first.rx]",
      "  var i = first.next",
      "  while cs.get(i) == Some(\"|\") \{",
      "    let more = parse_seq(cs, i + 1)?",
      "    options = options.push(more.rx)",
      "    i = more.next",
      "  \}",
      "  if options.len() == 1 \{",
      "    return Ok(Parsed \{ rx: first.rx, next: i \})",
      "  \}",
      "  return Ok(Parsed \{ rx: Rx.Alt(options: options), next: i \})",
      "\}",
      "",
      "fn parse_seq(cs: List[Str], at: Int) -> Result[Parsed, Str] \{",
      "  var items: List[Rx] = []",
      "  var i = at",
      "  while i < cs.len() and cs.get(i) != Some(\"|\") and cs.get(i) != Some(\")\") \{",
      "    let atom = parse_atom(cs, i)?",
      "    let q = parse_quantifier(cs: cs, at: atom.next, item: atom.rx)?",
      "    items = items.push(q.rx)",
      "    i = q.next",
      "  \}",
      "  return Ok(Parsed \{ rx: Rx.Seq(items: items), next: i \})",
      "\}",
      "",
      "fn parse_atom(cs: List[Str], i: Int) -> Result[Parsed, Str] \{",
      "  let c = cs.get_or(i, \"\")",
      "  if c == \"(\" \{",
      "    let inner = parse_alt(cs, i + 1)?",
      "    if cs.get(inner.next) != Some(\")\") \{",
      "      return Err(\"missing `)` for the group at \{i\}\")",
      "    \}",
      "    return Ok(Parsed \{ rx: inner.rx, next: inner.next + 1 \})",
      "  \}",
      "  if c == \"[\" \{",
      "    return parse_class(cs, i + 1)",
      "  \}",
      "  if c == \".\" \{",
      "    return Ok(Parsed \{ rx: Rx.AnyChar, next: i + 1 \})",
      "  \}",
      "  if c == \"^\" \{",
      "    return Ok(Parsed \{ rx: Rx.Start, next: i + 1 \})",
      "  \}",
      "  if c == \"$\" \{",
      "    return Ok(Parsed \{ rx: Rx.Finish, next: i + 1 \})",
      "  \}",
      "  if c == \"*\" or c == \"+\" or c == \"?\" or c == \"\\\{\" \{",
      "    return Err(\"`\{c\}` at \{i\} has nothing to repeat\")",
      "  \}",
      "  if c == \"\\\\\" \{",
      "    if i + 1 >= cs.len() \{",
      "      return Err(\"the pattern ends with `\\\\`\")",
      "    \}",
      "    let e = cs.get_or(i + 1, \"\")",
      "    return Ok(Parsed \{ rx: escape_class(e).unwrap_or(Rx.Lit(c: escaped(e))), next: i + 2 \})",
      "  \}",
      "  return Ok(Parsed \{ rx: Rx.Lit(c: c), next: i + 1 \})",
      "\}",
      "",
      "fn parse_class(cs: List[Str], at: Int) -> Result[Parsed, Str] \{",
      "  var i = at",
      "  var negated = false",
      "  if cs.get(i) == Some(\"^\") \{",
      "    negated = true",
      "    i = i + 1",
      "  \}",
      "  var ranges: List[Pair[Str, Str]] = []",
      "  var first = true",
      "  while i < cs.len() and (cs.get(i) != Some(\"]\") or first) \{",
      "    first = false",
      "    var c = cs.get_or(i, \"\")",
      "    if c == \"\\\\\" \{",
      "      let e = cs.get_or(i + 1, \"\")",
      "      match escape_class(e) \{",
      "        Some(Rx.Class(rs, false)) => \{",
      "          ranges = ranges.concat(rs)",
      "          i = i + 2",
      "          continue",
      "        \},",
      "        _ => \{\},",
      "      \}",
      "      c = escaped(e)",
      "      i = i + 1",
      "    \}",
      "    if cs.get(i + 1) == Some(\"-\") and i + 2 < cs.len() and cs.get(i + 2) != Some(\"]\") \{",
      "      let hi = cs.get_or(i + 2, \"\")",
      "      if hi < c \{",
      "        return Err(\"the range `\{c\}-\{hi\}` goes backwards\")",
      "      \}",
      "      ranges = ranges.push(Pair \{ first: c, second: hi \})",
      "      i = i + 3",
      "    \} else \{",
      "      ranges = ranges.push(Pair \{ first: c, second: c \})",
      "      i = i + 1",
      "    \}",
      "  \}",
      "  if i >= cs.len() \{",
      "    return Err(\"missing `]` for the class at \{at - 1\}\")",
      "  \}",
      "  return Ok(Parsed \{ rx: Rx.Class(ranges: ranges, negated: negated), next: i + 1 \})",
      "\}",
      "",
      "fn digits_at(cs: List[Str], at: Int) -> Pair[Option[Int], Int] \{",
      "  var i = at",
      "  var text = \"\"",
      "  while i < cs.len() and cs.get_or(i, \"\").is_numeric() \{",
      "    text = text + cs.get_or(i, \"\")",
      "    i = i + 1",
      "  \}",
      "  return Pair \{ first: text.to_int(), second: i \}",
      "\}",
      "",
      "fn parse_quantifier(cs: List[Str], at: Int, item: Rx) -> Result[Parsed, Str] \{",
      "  let c = cs.get_or(at, \"\")",
      "  if c == \"*\" \{",
      "    return Ok(Parsed \{ rx: Rx.Rep(item: item, min: 0, max: -1), next: at + 1 \})",
      "  \}",
      "  if c == \"+\" \{",
      "    return Ok(Parsed \{ rx: Rx.Rep(item: item, min: 1, max: -1), next: at + 1 \})",
      "  \}",
      "  if c == \"?\" \{",
      "    return Ok(Parsed \{ rx: Rx.Rep(item: item, min: 0, max: 1), next: at + 1 \})",
      "  \}",
      "  if c != \"\\\{\" \{",
      "    return Ok(Parsed \{ rx: item, next: at \})",
      "  \}",
      "  let lo = digits_at(cs, at + 1)",
      "  let min = match lo.first \{",
      "    Some(n) => n,",
      "    None => \{",
      "      return Err(\"`\\\{` at \{at\} needs a number\")",
      "    \},",
      "  \}",
      "  var max = min",
      "  var i = lo.second",
      "  if cs.get(i) == Some(\",\") \{",
      "    let hi = digits_at(cs, i + 1)",
      "    max = hi.first.unwrap_or(-1)",
      "    i = hi.second",
      "  \}",
      "  if cs.get(i) != Some(\"\\\}\") \{",
      "    return Err(\"missing `\\\}` for the repetition at \{at\}\")",
      "  \}",
      "  if max != -1 and max < min \{",
      "    return Err(\"the repetition at \{at\} has a maximum below its minimum\")",
      "  \}",
      "  return Ok(Parsed \{ rx: Rx.Rep(item: item, min: min, max: max), next: i + 1 \})",
      "\}",
      "",
      "/// The parsed pattern, or why it is not valid.",
      "/// >>> assert parse_regex(\"a(b\").is_err()",
      "/// >>> assert parse_regex(\"[a-z]+\\\\d?\").is_ok()",
      "pub fn parse_regex(pattern: Str) -> Result[Rx, Str] \{",
      "  let cs = pattern.chars()",
      "  let p = parse_alt(cs, 0)?",
      "  if p.next < cs.len() \{",
      "    return Err(\"unexpected `)` at \{p.next\}\")",
      "  \}",
      "  return Ok(p.rx)",
      "\}",
      "",
      "// ---- matching ------------------------------------------------------------------------------------------------",
      "",
      "fn in_class(c: Str, ranges: List[Pair[Str, Str]]) -> Bool \{",
      "  return ranges.any(fn(r) => c >= r.first and c <= r.second)",
      "\}",
      "",
      "/// Every position where `rx` can end when it starts at `i`, the preferred (greedy) one first.",
      "fn ends(rx: Rx, cs: List[Str], i: Int) -> List[Int] \{",
      "  return match rx \{",
      "    Rx.Lit(c) => match cs.get(i) == Some(c) \{",
      "      true => [i + 1],",
      "      false => [],",
      "    \},",
      "    Rx.AnyChar => match i < cs.len() and cs.get(i) != Some(\"\\n\") \{",
      "      true => [i + 1],",
      "      false => [],",
      "    \},",
      "    Rx.Class(ranges, negated) => match cs.get(i) \{",
      "      Some(c) => match in_class(c, ranges) != negated \{",
      "        true => [i + 1],",
      "        false => [],",
      "      \},",
      "      None => [],",
      "    \},",
      "    Rx.Start => match i == 0 \{",
      "      true => [i],",
      "      false => [],",
      "    \},",
      "    Rx.Finish => match i == cs.len() \{",
      "      true => [i],",
      "      false => [],",
      "    \},",
      "    Rx.Seq(items) => items.fold([i], fn(ps, item) => ps.flat_map(fn(p) => ends(rx: item, cs: cs, i: p)).unique()),",
      "    Rx.Alt(options) => options.flat_map(fn(o) => ends(rx: o, cs: cs, i: i)).unique(),",
      "    Rx.Rep(item, min, max) => repeat_ends(rx: item, cs: cs, i: i, bounds: Pair \{ first: min, second: max \}, count: 0),",
      "  \}",
      "\}",
      "",
      "fn repeat_ends(rx: Rx, cs: List[Str], i: Int, bounds: Pair[Int, Int], count: Int) -> List[Int] \{",
      "  var out: List[Int] = []",
      "  if bounds.second == -1 or count < bounds.second \{",
      "    for p in ends(rx: rx, cs: cs, i: i) \{",
      "      if p != i \{",
      "        out = out.concat(repeat_ends(rx: rx, cs: cs, i: p, bounds: bounds, count: count + 1))",
      "      \}",
      "    \}",
      "  \}",
      "  if count >= bounds.first \{",
      "    out = out.push(i)",
      "  \}",
      "  return out.unique()",
      "\}",
      "",
      "/// The first match at or after position `from`: (start, end), or None.",
      "fn search(rx: Rx, cs: List[Str], from: Int) -> Option[Pair[Int, Int]] \{",
      "  var start = from",
      "  while start <= cs.len() \{",
      "    match ends(rx: rx, cs: cs, i: start).first() \{",
      "      Some(e) => \{",
      "        return Some(Pair \{ first: start, second: e \})",
      "      \},",
      "      None => \{\},",
      "    \}",
      "    start = start + 1",
      "  \}",
      "  return None",
      "\}",
      "",
      "/// The non-overlapping matches, left to right.",
      "fn all_matches(rx: Rx, cs: List[Str]) -> List[Pair[Int, Int]] \{",
      "  var out: List[Pair[Int, Int]] = []",
      "  var at = 0",
      "  while at <= cs.len() \{",
      "    match search(rx: rx, cs: cs, from: at) \{",
      "      Some(m) => \{",
      "        out = out.push(m)",
      "        at = match m.second > m.first \{",
      "          true => m.second,",
      "          false => m.second + 1,",
      "        \}",
      "      \},",
      "      None => \{",
      "        at = cs.len() + 1",
      "      \},",
      "    \}",
      "  \}",
      "  return out",
      "\}",
      "",
      "fn piece(cs: List[Str], m: Pair[Int, Int]) -> Str \{",
      "  return cs.drop(m.first).take(m.second - m.first).join(\"\")",
      "\}",
      "",
      "/// Whether the whole text matches the pattern.",
      "/// >>> assert is_match(\"\\\\d\\\{4\\\}-\\\\d\\\{2\\\}-\\\\d\\\{2\\\}\", \"2026-10-25\") == Ok(true)",
      "/// >>> assert is_match(\"a|b\", \"ab\") == Ok(false)",
      "/// >>> assert is_match(\"(\", \"x\").is_err()",
      "pub fn is_match(pattern: Str, text: Str) -> Result[Bool, Str] \{",
      "  let rx = parse_regex(pattern)?",
      "  let cs = text.chars()",
      "  return Ok(ends(rx: rx, cs: cs, i: 0).contains(cs.len()))",
      "\}",
      "",
      "/// Whether some part of the text matches.",
      "/// >>> assert contains_match(\"[0-9]+\", \"room 42\") == Ok(true)",
      "pub fn contains_match(pattern: Str, text: Str) -> Result[Bool, Str] \{",
      "  let rx = parse_regex(pattern)?",
      "  return Ok(search(rx: rx, cs: text.chars(), from: 0) != None)",
      "\}",
      "",
      "/// The first part of the text that matches.",
      "/// >>> assert find(\"\\\\w+@\\\\w+\\\\.com\", \"mail ann@site.com now\") == Ok(Some(\"ann@site.com\"))",
      "/// >>> assert find(\"x+\", \"abc\") == Ok(None)",
      "pub fn find(pattern: Str, text: Str) -> Result[Option[Str], Str] \{",
      "  let rx = parse_regex(pattern)?",
      "  let cs = text.chars()",
      "  return Ok(search(rx: rx, cs: cs, from: 0).map(fn(m) => piece(cs, m)))",
      "\}",
      "",
      "/// Every non-overlapping part of the text that matches, left to right.",
      "/// >>> assert find_all(\"\\\\d+\", \"a1 b22 c333\") == Ok([\"1\", \"22\", \"333\"])",
      "pub fn find_all(pattern: Str, text: Str) -> Result[List[Str], Str] \{",
      "  let rx = parse_regex(pattern)?",
      "  let cs = text.chars()",
      "  return Ok(all_matches(rx, cs).map(fn(m) => piece(cs, m)))",
      "\}",
      "",
      "/// The text with every match replaced by `by`.",
      "/// >>> assert replace_all(pattern: \"\\\\s+\", text: \"a   b \\t c\", by: \" \") == Ok(\"a b c\")",
      "pub fn replace_all(pattern: Str, text: Str, by: Str) -> Result[Str, Str] \{",
      "  let rx = parse_regex(pattern)?",
      "  let cs = text.chars()",
      "  var out = \"\"",
      "  var at = 0",
      "  for m in all_matches(rx, cs) \{",
      "    out = out + piece(cs, Pair \{ first: at, second: m.first \}) + by",
      "    at = m.second",
      "  \}",
      "  return Ok(out + piece(cs, Pair \{ first: at, second: cs.len() \}))",
      "\}",
      "",
      "/// The parts of the text between the matches.",
      "/// >>> assert split_by(\"[,;] *\", \"a, b;c\") == Ok([\"a\", \"b\", \"c\"])",
      "pub fn split_by(pattern: Str, text: Str) -> Result[List[Str], Str] \{",
      "  let rx = parse_regex(pattern)?",
      "  let cs = text.chars()",
      "  var out: List[Str] = []",
      "  var at = 0",
      "  for m in all_matches(rx, cs) \{",
      "    if m.second > m.first \{",
      "      out = out.push(piece(cs, Pair \{ first: at, second: m.first \}))",
      "      at = m.second",
      "    \}",
      "  \}",
      "  return Ok(out.push(piece(cs, Pair \{ first: at, second: cs.len() \})))",
      "\}",
      "",
      "test \"regular expressions\" \{",
      "  assert is_match(\"colou?r\", \"color\") == Ok(true)",
      "  assert is_match(\"colou?r\", \"colour\") == Ok(true)",
      "  assert is_match(\"^[A-Z][a-z]*$\", \"Klar\") == Ok(true)",
      "  assert is_match(\"[^0-9]+\", \"abc\") == Ok(true)",
      "  assert is_match(\"[^0-9]+\", \"ab1\") == Ok(false)",
      "  assert is_match(\"(ab)+\", \"ababab\") == Ok(true)",
      "  assert is_match(\"a\\\{2,3\\\}\", \"aaaa\") == Ok(false)",
      "  assert is_match(\"a\\\{2,\\\}\", \"aaaa\") == Ok(true)",
      "  assert is_match(\"\\\\.\", \".\") == Ok(true)",
      "  assert is_match(\".*x\", \"a\\nx\") == Ok(false)",
      "  assert find(\"a.*b\", \"xaxbxb\") == Ok(Some(\"axbxb\"))",
      "  assert find_all(\"\", \"ab\") == Ok([\"\", \"\", \"\"])",
      "  assert find_all(\"(cat|dog)s?\", \"cats and a dog\") == Ok([\"cats\", \"dog\"])",
      "  assert replace_all(pattern: \"(\\\\d+)\", text: \"x1y22\", by: \"#\") == Ok(\"x#y#\")",
      "  assert parse_regex(\"a\\\{3,1\\\}\") == Err(\"the repetition at 1 has a maximum below its minimum\")",
      "  assert parse_regex(\"[z-a]\") == Err(\"the range `z-a` goes backwards\")",
      "  assert parse_regex(\"*a\") == Err(\"`*` at 0 has nothing to repeat\")",
      "\}",
      "",
      "property \"a literal text matches itself\" (s: Str) \{",
      "  let safe = s.chars().filter(fn(c) => c.is_numeric() or (c >= \"a\" and c <= \"z\")).join(\"\")",
      "  assert is_match(safe, safe) == Ok(true)",
      "\}",
      "",
    ],
    "std/result.klar" => [
      "// std.result — working with many Option/Result values at once.  use std.result.\{collect, values\}",
      "",
      "/// All Ok values, or the first Err.",
      "/// >>> assert collect([Ok(1), Ok(2)]) == Ok([1, 2])",
      "pub fn collect[T, E](items: List[Result[T, E]]) -> Result[List[T], E] \{",
      "  var out: List[T] = []",
      "  for r in items \{",
      "    let v = r?",
      "    out = out.push(v)",
      "  \}",
      "  return Ok(out)",
      "\}",
      "",
      "/// All Some values, or None if any is missing.",
      "/// >>> assert collect_options([Some(1), None]) == None",
      "pub fn collect_options[T](items: List[Option[T]]) -> Option[List[T]] \{",
      "  var out: List[T] = []",
      "  for o in items \{",
      "    let v = o?",
      "    out = out.push(v)",
      "  \}",
      "  return Some(out)",
      "\}",
      "",
      "/// Just the Ok values; errors are dropped.",
      "/// >>> assert oks([Ok(1), Err(\"x\"), Ok(3)]) == [1, 3]",
      "pub fn oks[T, E](items: List[Result[T, E]]) -> List[T] \{",
      "  return items.flat_map(fn(r) => match r \{",
      "    Ok(v) => [v],",
      "    Err(_) => [],",
      "  \})",
      "\}",
      "",
      "/// Just the errors.",
      "/// >>> assert errs([Ok(1), Err(\"x\")]) == [\"x\"]",
      "pub fn errs[T, E](items: List[Result[T, E]]) -> List[E] \{",
      "  return items.flat_map(fn(r) => match r \{",
      "    Ok(_) => [],",
      "    Err(e) => [e],",
      "  \})",
      "\}",
      "",
      "/// Just the Some values.",
      "/// >>> assert values([Some(1), None, Some(2)]) == [1, 2]",
      "pub fn values[T](items: List[Option[T]]) -> List[T] \{",
      "  return items.flat_map(fn(o) => match o \{",
      "    Some(v) => [v],",
      "    None => [],",
      "  \})",
      "\}",
      "",
      "/// First Some, if any.",
      "/// >>> assert first_some([None, Some(2), Some(3)]) == Some(2)",
      "pub fn first_some[T](items: List[Option[T]]) -> Option[T] \{",
      "  for o in items \{",
      "    if o.is_some() \{",
      "      return o",
      "    \}",
      "  \}",
      "  return None",
      "\}",
      "",
      "/// Turns a Bool into a Result with the given error.",
      "/// >>> assert ensure(1 < 2, \"bad\") == Ok(())",
      "pub fn ensure[E](condition: Bool, error: E) -> Result[Unit, E] \{",
      "  return match condition \{",
      "    true => Ok(()),",
      "    false => Err(error),",
      "  \}",
      "\}",
      "",
      "test \"collect stops at first error\" \{",
      "  let r: Result[List[Int], Str] = collect([Ok(1), Err(\"a\"), Err(\"b\")])",
      "  assert r == Err(\"a\")",
      "\}",
      "",
      "test \"collect options all present\" \{",
      "  assert collect_options([Some(\"a\"), Some(\"b\")]) == Some([\"a\", \"b\"])",
      "\}",
      "",
      "property \"oks and errs partition the list\" (xs: List[Result[Int, Str]]) \{",
      "  assert oks(xs).len() + errs(xs).len() == xs.len()",
      "\}",
      "",
      "property \"collect succeeds iff no errors\" (xs: List[Result[Int, Bool]]) \{",
      "  assert collect(xs).is_ok() == errs(xs).is_empty()",
      "\}",
      "",
    ],
    "std/set.klar" => [
      "// std.set — a set of Int, Str or Bool values (insertion-ordered).  use std.set.\{Set, set_of, ...\}",
      "// Every operation returns a new set; methods work through UFCS: `s.add(4).has(4)`.",
      "",
      "/// A set: each value at most once, in insertion order.",
      "pub type Set[T] \{ items: Map[T, Bool] \}",
      "",
      "/// Builds a set from a list (duplicates are dropped).",
      "/// >>> assert set_of([3, 1, 3, 2]).values() == [3, 1, 2]",
      "pub fn set_of[T](xs: List[T]) -> Set[T] \{",
      "  var m: Map[T, Bool] = Map \{\}",
      "  for x in xs \{",
      "    m = m.set(x, true)",
      "  \}",
      "  return Set \{ items: m \}",
      "\}",
      "",
      "/// The empty set of a given element type: `let s: Set[Int] = empty_set()`.",
      "pub fn empty_set[T]() -> Set[T] \{",
      "  let m: Map[T, Bool] = Map \{\}",
      "  return Set \{ items: m \}",
      "\}",
      "",
      "/// >>> assert set_of([1]).add(2).values() == [1, 2]",
      "pub fn add[T](s: Set[T], x: T) -> Set[T] \{",
      "  return Set \{ items: s.items.set(x, true) \}",
      "\}",
      "",
      "/// >>> assert set_of([1, 2]).remove(1).values() == [2]",
      "pub fn remove[T](s: Set[T], x: T) -> Set[T] \{",
      "  return Set \{ items: s.items.remove(x) \}",
      "\}",
      "",
      "/// >>> assert set_of([\"a\"]).has(\"a\")",
      "pub fn has[T](s: Set[T], x: T) -> Bool \{",
      "  return s.items.has(x)",
      "\}",
      "",
      "/// >>> assert set_of([1, 1, 2]).size() == 2",
      "pub fn size[T](s: Set[T]) -> Int \{",
      "  return s.items.len()",
      "\}",
      "",
      "/// The elements in insertion order.",
      "pub fn values[T](s: Set[T]) -> List[T] \{",
      "  return s.items.keys()",
      "\}",
      "",
      "/// >>> assert set_of([1, 2]).union(set_of([2, 3])).values() == [1, 2, 3]",
      "pub fn union[T](a: Set[T], b: Set[T]) -> Set[T] \{",
      "  return Set \{ items: a.items.merge(b.items) \}",
      "\}",
      "",
      "/// >>> assert set_of([1, 2, 3]).intersect(set_of([3, 2, 9])).values() == [2, 3]",
      "pub fn intersect[T](a: Set[T], b: Set[T]) -> Set[T] \{",
      "  return Set \{ items: a.items.filter(fn(k, _v) => b.items.has(k)) \}",
      "\}",
      "",
      "/// >>> assert set_of([1, 2, 3]).minus(set_of([2])).values() == [1, 3]",
      "pub fn minus[T](a: Set[T], b: Set[T]) -> Set[T] \{",
      "  return Set \{ items: a.items.filter(fn(k, _v) => not b.items.has(k)) \}",
      "\}",
      "",
      "/// >>> assert set_of([1, 2]).is_subset(set_of([2, 1, 5]))",
      "pub fn is_subset[T](a: Set[T], b: Set[T]) -> Bool \{",
      "  return a.values().all(fn(x) => b.items.has(x))",
      "\}",
      "",
      "/// Same elements, in any order.",
      "/// >>> assert set_of([1, 2]).same_as(set_of([2, 1]))",
      "pub fn same_as[T](a: Set[T], b: Set[T]) -> Bool \{",
      "  return a.size() == b.size() and a.is_subset(b)",
      "\}",
      "",
      "property \"union contains both sides\" (xs: List[Int], ys: List[Int]) \{",
      "  let u = set_of(xs).union(set_of(ys))",
      "  assert xs.all(fn(x) => u.has(x)) and ys.all(fn(y) => u.has(y))",
      "\}",
      "",
      "property \"intersect and minus split a set\" (xs: List[Int], ys: List[Int]) \{",
      "  let a = set_of(xs)",
      "  let b = set_of(ys)",
      "  assert a.intersect(b).size() + a.minus(b).size() == a.size()",
      "\}",
      "",
    ],
    "std/text.klar" => [
      "// std.text — string helpers.  use std.text.\{capitalize, words, is_palindrome\}",
      "",
      "/// Upper-cases the first character.",
      "/// >>> assert capitalize(\"hello\") == \"Hello\"",
      "/// >>> assert capitalize(\"\") == \"\"",
      "pub fn capitalize(s: Str) -> Str \{",
      "  return s.slice(0, 1).upper() + s.slice(1, s.len())",
      "\}",
      "",
      "/// Capitalizes every word separated by single spaces.",
      "/// >>> assert title_case(\"the quick fox\") == \"The Quick Fox\"",
      "pub fn title_case(s: Str) -> Str \{",
      "  return s.split(\" \").map(fn(w) => capitalize(w)).join(\" \")",
      "\}",
      "",
      "/// Non-empty words separated by any amount of whitespace.",
      "/// >>> assert words(\"  a  b\\tc \") == [\"a\", \"b\", \"c\"]",
      "pub fn words(s: Str) -> List[Str] \{",
      "  return s.replace(\"\\t\", \" \").replace(\"\\n\", \" \").split(\" \").filter(fn(w) => not w.is_empty())",
      "\}",
      "",
      "/// True for strings that read the same backwards, ignoring case and spaces.",
      "/// >>> assert is_palindrome(\"Never odd or even\")",
      "pub fn is_palindrome(s: Str) -> Bool \{",
      "  let clean = s.lower().replace(\" \", \"\")",
      "  return clean == clean.reverse()",
      "\}",
      "",
      "/// True if the string is empty or only whitespace.",
      "/// >>> assert is_blank(\"  \")",
      "pub fn is_blank(s: Str) -> Bool \{",
      "  return s.trim().is_empty()",
      "\}",
      "",
      "/// Number of occurrences of every word (case-insensitive).",
      "/// >>> assert word_frequencies(\"a b A\").get(\"a\") == Some(2)",
      "pub fn word_frequencies(s: Str) -> Map[Str, Int] \{",
      "  var counts: Map[Str, Int] = Map \{\}",
      "  for w in words(s.lower()) \{",
      "    counts = counts.update(w, 0, fn(n) => n + 1)",
      "  \}",
      "  return counts",
      "\}",
      "",
      "/// Centers `s` in a field of `width` characters.",
      "/// >>> assert center(s: \"ab\", width: 6, fill: \"*\") == \"**ab**\"",
      "pub fn center(s: Str, width: Int, fill: Str) -> Str \{",
      "  let total = width - s.len()",
      "  if total <= 0 \{",
      "    return s",
      "  \}",
      "  let left = total / 2",
      "  return s.pad_left(s.len() + left, fill).pad_right(width, fill)",
      "\}",
      "",
      "/// Shortens `s` to at most `max` characters, ending with \"...\".",
      "/// >>> assert truncate(\"hello world\", 8) == \"hello...\"",
      "pub fn truncate(s: Str, max: Int) -> Str",
      "  requires max >= 3",
      "\{",
      "  if s.len() <= max \{",
      "    return s",
      "  \}",
      "  return s.slice(0, max - 3) + \"...\"",
      "\}",
      "",
      "/// Breaks text into lines of at most `width` characters (words longer than width stay whole).",
      "/// >>> assert wrap(\"aa bb cc dd\", 5) == [\"aa bb\", \"cc dd\"]",
      "pub fn wrap(text: Str, width: Int) -> List[Str]",
      "  requires width > 0",
      "\{",
      "  var lines: List[Str] = []",
      "  var current = \"\"",
      "  for w in words(text) \{",
      "    if current.is_empty() \{",
      "      current = w",
      "    \} else if current.len() + 1 + w.len() <= width \{",
      "      current = current + \" \" + w",
      "    \} else \{",
      "      lines = lines.push(current)",
      "      current = w",
      "    \}",
      "  \}",
      "  if not current.is_empty() \{",
      "    lines = lines.push(current)",
      "  \}",
      "  return lines",
      "\}",
      "",
      "/// Converts snake_case to camelCase.",
      "/// >>> assert snake_to_camel(\"max_user_count\") == \"maxUserCount\"",
      "pub fn snake_to_camel(s: Str) -> Str \{",
      "  let parts = s.split(\"_\")",
      "  let head = parts.first().unwrap_or(\"\")",
      "  let rest = parts.drop(1).map(fn(p) => capitalize(p)).join(\"\")",
      "  return head + rest",
      "\}",
      "",
      "/// Joins items as \"a, b and c\".",
      "/// >>> assert join_human([\"a\", \"b\", \"c\"]) == \"a, b and c\"",
      "pub fn join_human(items: List[Str]) -> Str \{",
      "  let n = items.len()",
      "  if n == 0 \{",
      "    return \"\"",
      "  \}",
      "  if n == 1 \{",
      "    return items.first().unwrap_or(\"\")",
      "  \}",
      "  return items.take(n - 1).join(\", \") + \" and \" + items.last().unwrap_or(\"\")",
      "\}",
      "",
      "test \"capitalize and title\" \{",
      "  assert capitalize(\"é\") == \"É\"",
      "  assert title_case(\"\") == \"\"",
      "\}",
      "",
      "test \"wrap edge cases\" \{",
      "  assert wrap(\"\", 10) == []",
      "  assert wrap(\"supercalifragilistic word\", 5) == [\"supercalifragilistic\", \"word\"]",
      "\}",
      "",
      "test \"truncate keeps short strings\" \{",
      "  assert truncate(\"abc\", 3) == \"abc\"",
      "\}",
      "",
      "property \"words never contain spaces\" (s: Str) \{",
      "  assert words(s).all(fn(w) => not w.contains(\" \") and not w.is_empty())",
      "\}",
      "",
      "property \"wrapped lines respect width or are single words\" (s: Str) \{",
      "  for line in wrap(s, 4) \{",
      "    assert line.len() <= 4 or not line.contains(\" \")",
      "  \}",
      "\}",
      "",
      "property \"center has requested width\" (s: Str) \{",
      "  let r = center(s: s, width: 12, fill: \".\")",
      "  assert r.len() == s.len().max(12)",
      "\}",
      "",
    ],
    "std/time.klar" => [
      "// Dates and times in UTC: calendar arithmetic, ISO 8601 text, Unix timestamps.",
      "// All functions are pure except `now_utc` (effect `time`). There are no time zones: store UTC, show UTC.",
      "",
      "/// A moment in UTC: a calendar date and a time of day (milliseconds included).",
      "pub type DateTime \{ year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int, millis: Int \}",
      "",
      "const MS_PER_DAY: Int = 86400000",
      "",
      "/// Floor division (rounds towards minus infinity, unlike `/`): correct for dates before 1970.",
      "fn floor_div(a: Int, b: Int) -> Int",
      "  requires b > 0",
      "\{",
      "  let q = a / b",
      "  if a % b < 0 \{",
      "    return q - 1",
      "  \}",
      "  return q",
      "\}",
      "",
      "/// >>> assert is_leap_year(2024)",
      "/// >>> assert not is_leap_year(1900)",
      "/// >>> assert is_leap_year(2000)",
      "pub fn is_leap_year(year: Int) -> Bool \{",
      "  return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)",
      "\}",
      "",
      "/// >>> assert days_in_month(2024, 2) == 29",
      "/// >>> assert days_in_month(2023, 2) == 28",
      "/// >>> assert days_in_month(2023, 11) == 30",
      "pub fn days_in_month(year: Int, month: Int) -> Int",
      "  requires month >= 1 and month <= 12",
      "\{",
      "  if month == 2 \{",
      "    return match is_leap_year(year) \{",
      "      true => 29,",
      "      false => 28,",
      "    \}",
      "  \}",
      "  if month == 4 or month == 6 or month == 9 or month == 11 \{",
      "    return 30",
      "  \}",
      "  return 31",
      "\}",
      "",
      "/// Days since 1970-01-01 (negative before it).",
      "/// >>> assert days_from_civil(year: 1970, month: 1, day: 1) == 0",
      "/// >>> assert days_from_civil(year: 2000, month: 3, day: 1) == 11017",
      "pub fn days_from_civil(year: Int, month: Int, day: Int) -> Int",
      "  requires month >= 1 and month <= 12",
      "\{",
      "  var y = year",
      "  if month <= 2 \{",
      "    y = y - 1",
      "  \}",
      "  let era = floor_div(y, 400)",
      "  let yoe = y - era * 400",
      "  var mp = month - 3",
      "  if month <= 2 \{",
      "    mp = month + 9",
      "  \}",
      "  let doy = (153 * mp + 2) / 5 + day - 1",
      "  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy",
      "  return era * 146097 + doe - 719468",
      "\}",
      "",
      "/// The calendar date `days` days after 1970-01-01, at midnight.",
      "pub fn date_from_days(days: Int) -> DateTime \{",
      "  let z = days + 719468",
      "  let era = floor_div(z, 146097)",
      "  let doe = z - era * 146097",
      "  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365",
      "  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)",
      "  let mp = (5 * doy + 2) / 153",
      "  let day = doy - (153 * mp + 2) / 5 + 1",
      "  var month = mp + 3",
      "  if mp >= 10 \{",
      "    month = mp - 9",
      "  \}",
      "  var year = yoe + era * 400",
      "  if month <= 2 \{",
      "    year = year + 1",
      "  \}",
      "  return DateTime \{ year: year, month: month, day: day, hour: 0, minute: 0, second: 0, millis: 0 \}",
      "\}",
      "",
      "/// Midnight of a calendar date; `Err` for dates that do not exist.",
      "/// >>> assert date(year: 2024, month: 2, day: 30).is_err()",
      "pub fn date(year: Int, month: Int, day: Int) -> Result[DateTime, Str] \{",
      "  if month < 1 or month > 12 \{",
      "    return Err(\"month \{month\} is not in 1..12\")",
      "  \}",
      "  if day < 1 or day > days_in_month(year, month) \{",
      "    return Err(\"\{year\}-\{month\} has no day \{day\}\")",
      "  \}",
      "  return Ok(DateTime \{ year: year, month: month, day: day, hour: 0, minute: 0, second: 0, millis: 0 \})",
      "\}",
      "",
      "/// The moment `ms` milliseconds after 1970-01-01T00:00:00Z (a Unix timestamp in ms).",
      "/// >>> assert format_iso(from_unix_ms(0)) == \"1970-01-01T00:00:00Z\"",
      "/// >>> assert format_iso(from_unix_ms(1700000000123)) == \"2023-11-14T22:13:20.123Z\"",
      "pub fn from_unix_ms(ms: Int) -> DateTime \{",
      "  let days = floor_div(ms, MS_PER_DAY)",
      "  let rest = ms - days * MS_PER_DAY",
      "  let d = date_from_days(days)",
      "  return d with \{ hour: rest / 3600000, minute: rest / 60000 % 60, second: rest / 1000 % 60, millis: rest % 1000 \}",
      "\}",
      "",
      "/// >>> assert to_unix_ms(from_unix_ms(-86400001)) == -86400001",
      "pub fn to_unix_ms(t: DateTime) -> Int \{",
      "  let days = days_from_civil(year: t.year, month: t.month, day: t.day)",
      "  return days * MS_PER_DAY + t.hour * 3600000 + t.minute * 60000 + t.second * 1000 + t.millis",
      "\}",
      "",
      "/// Seconds since 1970-01-01T00:00:00Z (rounded down).",
      "pub fn to_unix_seconds(t: DateTime) -> Int \{",
      "  return floor_div(to_unix_ms(t), 1000)",
      "\}",
      "",
      "/// The current moment, from the system clock.",
      "pub fn now_utc() -> DateTime uses time \{",
      "  return from_unix_ms(now_ms())",
      "\}",
      "",
      "fn two(n: Int) -> Str \{",
      "  return n.to_str().pad_left(2, \"0\")",
      "\}",
      "",
      "/// `2026-10-21`",
      "pub fn format_date(t: DateTime) -> Str \{",
      "  let year = t.year.to_str().pad_left(4, \"0\")",
      "  return \"\{year\}-\{two(t.month)\}-\{two(t.day)\}\"",
      "\}",
      "",
      "/// `2026-10-21T18:05:09Z`, with `.123` milliseconds when they are not zero.",
      "pub fn format_iso(t: DateTime) -> Str \{",
      "  let base = \"\{format_date(t)\}T\{two(t.hour)\}:\{two(t.minute)\}:\{two(t.second)\}\"",
      "  if t.millis == 0 \{",
      "    return base + \"Z\"",
      "  \}",
      "  return base + \".\" + t.millis.to_str().pad_left(3, \"0\") + \"Z\"",
      "\}",
      "",
      "fn number(s: Str, start: Int, len: Int, what: Str) -> Result[Int, Str] \{",
      "  let part = s.slice(start, start + len)",
      "  if part.len() != len or not part.is_numeric() \{",
      "    return Err(\"expected \{len\} digits for the \{what\} at position \{start\} of \\\"\{s\}\\\"\")",
      "  \}",
      "  return Ok(part.to_int().unwrap_or(0))",
      "\}",
      "",
      "/// Parses `YYYY-MM-DD`, `YYYY-MM-DDTHH:MM`, `YYYY-MM-DDTHH:MM:SS` with optional `.sss` milliseconds and",
      "/// an optional `Z` (a space may replace the `T`).",
      "/// >>> assert parse_iso(\"2024-02-29T12:30:05.5Z\").map(format_iso) == Ok(\"2024-02-29T12:30:05.500Z\")",
      "/// >>> assert parse_iso(\"2023-02-29\").is_err()",
      "pub fn parse_iso(text: Str) -> Result[DateTime, Str] \{",
      "  var s = text.trim()",
      "  if s.ends_with(\"Z\") \{",
      "    s = s.slice(0, s.len() - 1)",
      "  \}",
      "  if s.slice(4, 5) != \"-\" or s.slice(7, 8) != \"-\" \{",
      "    return Err(\"expected a date like 2026-10-21, got \\\"\{text\}\\\"\")",
      "  \}",
      "  let year = number(s: s, start: 0, len: 4, what: \"year\")?",
      "  let month = number(s: s, start: 5, len: 2, what: \"month\")?",
      "  let day = number(s: s, start: 8, len: 2, what: \"day\")?",
      "  var t = date(year: year, month: month, day: day)?",
      "  if s.len() == 10 \{",
      "    return Ok(t)",
      "  \}",
      "  let sep = s.slice(10, 11)",
      "  if (sep != \"T\" and sep != \" \") or s.slice(13, 14) != \":\" \{",
      "    return Err(\"expected `T` and a time like 18:05:09 after the date in \\\"\{text\}\\\"\")",
      "  \}",
      "  let hour = number(s: s, start: 11, len: 2, what: \"hour\")?",
      "  let minute = number(s: s, start: 14, len: 2, what: \"minute\")?",
      "  var second = 0",
      "  var millis = 0",
      "  if s.len() > 16 \{",
      "    if s.slice(16, 17) != \":\" \{",
      "      return Err(\"expected `:` before the seconds in \\\"\{text\}\\\"\")",
      "    \}",
      "    second = number(s: s, start: 17, len: 2, what: \"second\")?",
      "    if s.len() > 19 \{",
      "      let frac = s.slice(20, s.len())",
      "      if s.slice(19, 20) != \".\" or frac.is_empty() or not frac.is_numeric() \{",
      "        return Err(\"expected `.` and milliseconds after the seconds in \\\"\{text\}\\\"\")",
      "      \}",
      "      millis = (frac + \"00\").slice(0, 3).to_int().unwrap_or(0)",
      "    \}",
      "  \}",
      "  if hour > 23 or minute > 59 or second > 59 \{",
      "    return Err(\"time \{two(hour)\}:\{two(minute)\}:\{two(second)\} is out of range\")",
      "  \}",
      "  t = t with \{ hour: hour, minute: minute, second: second, millis: millis \}",
      "  return Ok(t)",
      "\}",
      "",
      "// ---- time zones (fixed offsets from UTC) ---------------------------------------------------------------",
      "",
      "/// The wall-clock time at an offset of `minutes` from UTC (Omsk: 360, New York in winter: -300).",
      "/// >>> assert format_iso(at_offset(t: from_unix_ms(0), minutes: 360)) == \"1970-01-01T06:00:00Z\"",
      "pub fn at_offset(t: DateTime, minutes: Int) -> DateTime \{",
      "  return from_unix_ms(to_unix_ms(t) + minutes * 60000)",
      "\}",
      "",
      "/// `+06:00`, `-05:30` or `Z` for an offset in minutes.",
      "/// >>> assert offset_text(360) == \"+06:00\"",
      "/// >>> assert offset_text(-330) == \"-05:30\"",
      "/// >>> assert offset_text(0) == \"Z\"",
      "pub fn offset_text(minutes: Int) -> Str \{",
      "  if minutes == 0 \{",
      "    return \"Z\"",
      "  \}",
      "  let sign = match minutes < 0 \{",
      "    true => \"-\",",
      "    false => \"+\",",
      "  \}",
      "  let m = minutes.abs()",
      "  return sign + two(m / 60) + \":\" + two(m % 60)",
      "\}",
      "",
      "/// The moment as local ISO text at an offset: `2026-10-25T06:00:00+06:00`.",
      "/// >>> assert format_iso_offset(t: from_unix_ms(0), minutes: 360) == \"1970-01-01T06:00:00+06:00\"",
      "pub fn format_iso_offset(t: DateTime, minutes: Int) -> Str \{",
      "  let local = format_iso(at_offset(t: t, minutes: minutes))",
      "  return local.slice(0, local.len() - 1) + offset_text(minutes)",
      "\}",
      "",
      "/// Parses ISO text that may end with an offset (`+06:00`, `-0530`, `Z`): the moment in UTC.",
      "/// >>> assert parse_iso_offset(\"1970-01-01T06:00:00+06:00\").map(format_iso) == Ok(\"1970-01-01T00:00:00Z\")",
      "/// >>> assert parse_iso_offset(\"2026-10-25T10:00-05:30\").map(format_iso) == Ok(\"2026-10-25T15:30:00Z\")",
      "/// >>> assert parse_iso_offset(\"2026-10-25T10:00+25:00\").is_err()",
      "pub fn parse_iso_offset(text: Str) -> Result[DateTime, Str] \{",
      "  let s = text.trim()",
      "  let n = s.len()",
      "  if n <= 16 or s.ends_with(\"Z\") \{",
      "    return parse_iso(s)",
      "  \}",
      "  var cut = -1",
      "  if s.slice(n - 6, n - 5) == \"+\" or s.slice(n - 6, n - 5) == \"-\" \{",
      "    cut = n - 6",
      "  \} else if s.slice(n - 5, n - 4) == \"+\" or s.slice(n - 5, n - 4) == \"-\" \{",
      "    cut = n - 5",
      "  \}",
      "  if cut < 0 \{",
      "    return parse_iso(s)",
      "  \}",
      "  let off = s.slice(cut + 1, n).replace(\":\", \"\")",
      "  if off.len() != 4 or not off.is_numeric() \{",
      "    return Err(\"expected an offset like +06:00 at the end of \\\"\{text\}\\\"\")",
      "  \}",
      "  let hours = off.slice(0, 2).to_int().unwrap_or(0)",
      "  let mins = off.slice(2, 4).to_int().unwrap_or(0)",
      "  if hours > 23 or mins > 59 \{",
      "    return Err(\"the offset \{s.slice(cut, n)\} is out of range\")",
      "  \}",
      "  let sign = match s.slice(cut, cut + 1) == \"-\" \{",
      "    true => -1,",
      "    false => 1,",
      "  \}",
      "  let local = parse_iso(s.slice(0, cut))?",
      "  return Ok(at_offset(t: local, minutes: -sign * (hours * 60 + mins)))",
      "\}",
      "",
      "/// ISO weekday: 1 = Monday ... 7 = Sunday.",
      "/// >>> assert weekday(from_unix_ms(0)) == 4",
      "pub fn weekday(t: DateTime) -> Int \{",
      "  let days = days_from_civil(year: t.year, month: t.month, day: t.day)",
      "  return days + 3 - floor_div(days + 3, 7) * 7 + 1",
      "\}",
      "",
      "/// `Monday` ... `Sunday`",
      "pub fn weekday_name(t: DateTime) -> Str \{",
      "  return [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"]",
      "    .get(weekday(t) - 1)",
      "    .unwrap_or(\"?\")",
      "\}",
      "",
      "/// 1 for January 1st ... 365 or 366.",
      "/// >>> assert day_of_year(from_unix_ms(0) with \{ year: 2024, month: 12, day: 31 \}) == 366",
      "pub fn day_of_year(t: DateTime) -> Int \{",
      "  return days_from_civil(year: t.year, month: t.month, day: t.day) -",
      "    days_from_civil(year: t.year, month: 1, day: 1) + 1",
      "\}",
      "",
      "/// >>> assert format_date(add_days(from_unix_ms(0), -1)) == \"1969-12-31\"",
      "pub fn add_days(t: DateTime, days: Int) -> DateTime \{",
      "  return from_unix_ms(to_unix_ms(t) + days * MS_PER_DAY)",
      "\}",
      "",
      "pub fn add_seconds(t: DateTime, seconds: Int) -> DateTime \{",
      "  return from_unix_ms(to_unix_ms(t) + seconds * 1000)",
      "\}",
      "",
      "/// Whole calendar days from `a` to `b` (negative when `b` is earlier); the time of day is ignored.",
      "pub fn days_between(a: DateTime, b: DateTime) -> Int \{",
      "  return days_from_civil(year: b.year, month: b.month, day: b.day) -",
      "    days_from_civil(year: a.year, month: a.month, day: a.day)",
      "\}",
      "",
      "/// Milliseconds from `a` to `b`.",
      "pub fn millis_between(a: DateTime, b: DateTime) -> Int \{",
      "  return to_unix_ms(b) - to_unix_ms(a)",
      "\}",
      "",
      "test \"round trip through days\" \{",
      "  for d in [-719468, -1, 0, 1, 59, 365, 10957, 11016, 20747, 2932896] \{",
      "    let t = date_from_days(d)",
      "    assert days_from_civil(year: t.year, month: t.month, day: t.day) == d",
      "  \}",
      "\}",
      "",
      "test \"known dates\" \{",
      "  assert format_iso(from_unix_ms(951782400000)) == \"2000-02-29T00:00:00Z\"",
      "  assert weekday_name(parse_iso(\"2026-10-21\").unwrap_or(from_unix_ms(0))) == \"Wednesday\"",
      "  assert days_between(from_unix_ms(0), parse_iso(\"2000-01-01\").unwrap_or(from_unix_ms(0))) == 10957",
      "  assert format_iso(add_seconds(from_unix_ms(0), -1)) == \"1969-12-31T23:59:59Z\"",
      "\}",
      "",
      "property \"unix milliseconds round trip\" (ms: Int) \{",
      "  let t = from_unix_ms(ms)",
      "  assert to_unix_ms(t) == ms",
      "  assert t.month >= 1 and t.month <= 12",
      "  assert t.day >= 1 and t.day <= days_in_month(t.year, t.month)",
      "\}",
      "",
      "property \"ISO text with an offset round trip\" (ms: Int, offset: Int) \{",
      "  let t = from_unix_ms(ms.abs() % 250000000000000)",
      "  let minutes = offset % (14 * 60)",
      "  assert parse_iso_offset(format_iso_offset(t: t, minutes: minutes)) == Ok(t)",
      "\}",
      "",
      "property \"ISO text round trip\" (ms: Int) \{",
      "  let t = from_unix_ms(ms.abs() % 253402300800000)",
      "  assert parse_iso(format_iso(t)) == Ok(t)",
      "\}",
      "",
    ],
    "tools/view_template.html" => [
      "<!doctype html>",
      "<html lang=\"en\">",
      "<head>",
      "<meta charset=\"utf-8\">",
      "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "<title>__TITLE__ — Klar view</title>",
      "<style>",
      ":root \{",
      "  --bg: #f7f7f5; --panel: #ffffff; --ink: #1d1f23; --muted: #6b7078; --line: #e2e3e0;",
      "  --accent: #2f6fdd; --accent-soft: #e6eefc; --pure: #2e8b57; --pure-soft: #e6f4ec;",
      "  --effect: #c96a12; --effect-soft: #fbefe2; --err: #c0392b; --err-soft: #fbe9e7;",
      "  --code-bg: #f3f4f1; --shadow: 0 1px 2px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);",
      "\}",
      "@media (prefers-color-scheme: dark) \{",
      "  :root \{",
      "    --bg: #15171a; --panel: #1d2024; --ink: #e8e9ea; --muted: #9aa0a8; --line: #2e3238;",
      "    --accent: #78a6ff; --accent-soft: #1f2b44; --pure: #6cc78f; --pure-soft: #1c2e24;",
      "    --effect: #f0a35a; --effect-soft: #33261a; --err: #ff8a7a; --err-soft: #3a211e;",
      "    --code-bg: #24282d; --shadow: none;",
      "  \}",
      "\}",
      "* \{ box-sizing: border-box; \}",
      "body \{ margin: 0; background: var(--bg); color: var(--ink);",
      "  font: 14px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; \}",
      "header \{ display: flex; align-items: center; gap: 16px; padding: 12px 20px; border-bottom: 1px solid var(--line);",
      "  background: var(--panel); position: sticky; top: 0; z-index: 5; \}",
      "header h1 \{ font-size: 16px; margin: 0; font-weight: 650; \}",
      "header .file \{ color: var(--muted); font-family: ui-monospace, Consolas, monospace; \}",
      "header .spacer \{ flex: 1; \}",
      "button, .seg button \{ font: inherit; border: 1px solid var(--line); background: var(--panel); color: var(--ink);",
      "  padding: 4px 10px; border-radius: 6px; cursor: pointer; \}",
      "button:hover \{ border-color: var(--accent); \}",
      "button.on \{ background: var(--accent-soft); border-color: var(--accent); color: var(--accent); \}",
      ".layout \{ display: grid; grid-template-columns: 280px 1fr; min-height: calc(100vh - 53px); \}",
      "aside \{ border-right: 1px solid var(--line); padding: 16px; background: var(--panel); overflow: auto;",
      "  height: calc(100vh - 53px); position: sticky; top: 53px; \}",
      "aside h3 \{ font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 18px 0 6px; \}",
      "aside h3:first-child \{ margin-top: 0; \}",
      ".fnlink \{ display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 6px; cursor: pointer;",
      "  font-family: ui-monospace, Consolas, monospace; font-size: 13px; \}",
      ".fnlink:hover \{ background: var(--accent-soft); \}",
      ".fnlink.sel \{ background: var(--accent-soft); color: var(--accent); \}",
      ".fnlink .count \{ margin-left: auto; color: var(--muted); font-size: 11px; \}",
      ".dot \{ width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--pure); \}",
      ".dot.effect \{ background: var(--effect); \}",
      ".dot.ext \{ background: var(--muted); \}",
      "main \{ padding: 20px; overflow: auto; \}",
      ".card \{ background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px;",
      "  margin-bottom: 16px; box-shadow: var(--shadow); \}",
      ".card h2 \{ margin: 0 0 8px; font-size: 18px; \}",
      ".muted \{ color: var(--muted); \}",
      ".stats \{ display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; \}",
      ".stat \{ background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; \}",
      ".stat b \{ font-size: 18px; display: block; \}",
      "code, .mono \{ font-family: ui-monospace, Consolas, monospace; font-size: 13px; \}",
      "code \{ background: var(--code-bg); padding: 1px 5px; border-radius: 4px; \}",
      "svg text \{ font-family: ui-monospace, Consolas, monospace; font-size: 12px; fill: var(--ink); \}",
      ".node rect \{ fill: var(--pure-soft); stroke: var(--pure); stroke-width: 1.4; rx: 8; cursor: pointer; \}",
      ".node.effect rect \{ fill: var(--effect-soft); stroke: var(--effect); \}",
      ".node.ext rect \{ fill: var(--bg); stroke: var(--muted); stroke-dasharray: 4 3; \}",
      ".node.cold rect \{ opacity: .45; \}",
      ".node.sel rect \{ stroke: var(--accent); stroke-width: 2.6; \}",
      ".node .badge \{ font-size: 10px; fill: var(--muted); \}",
      ".edge \{ fill: none; stroke: var(--muted); stroke-width: 1.2; opacity: .55; \}",
      ".edge.hot \{ stroke: var(--accent); opacity: 1; stroke-width: 2; \}",
      ".legend \{ display: flex; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--muted); margin-top: 6px; \}",
      ".legend span \{ display: inline-flex; align-items: center; gap: 6px; \}",
      ".graph-wrap \{ overflow: auto; \}",
      ".graph-wrap svg \{ display: block; margin: 8px auto 0; \}",
      ".sig \{ font-family: ui-monospace, Consolas, monospace; background: var(--code-bg); padding: 8px 10px;",
      "  border-radius: 6px; overflow-x: auto; white-space: pre-wrap; \}",
      ".facts \{ display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin-top: 10px; \}",
      ".facts dt \{ color: var(--muted); \}",
      ".facts dd \{ margin: 0; \}",
      ".chip \{ display: inline-block; padding: 0 8px; border-radius: 10px; font-size: 12px; margin: 0 4px 4px 0;",
      "  border: 1px solid var(--line); cursor: default; \}",
      ".chip.link \{ cursor: pointer; color: var(--accent); border-color: var(--accent); \}",
      ".chip.effect \{ background: var(--effect-soft); color: var(--effect); border-color: var(--effect); \}",
      ".chip.pure \{ background: var(--pure-soft); color: var(--pure); border-color: var(--pure); \}",
      ".chip.err \{ background: var(--err-soft); color: var(--err); border-color: var(--err); \}",
      ".toolbar \{ display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin: 6px 0 10px; \}",
      ".blk \{ border-left: 3px solid var(--line); margin: 4px 0 4px 6px; padding: 2px 0 2px 10px; \}",
      ".blk > .hd \{ display: flex; gap: 8px; align-items: baseline; cursor: default; \}",
      ".blk > .hd.tog \{ cursor: pointer; \}",
      ".blk > .hd .ln \{ margin-left: auto; color: var(--muted); font-size: 11px; cursor: pointer; \}",
      ".blk .kw \{ font-weight: 650; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; min-width: 54px; \}",
      ".blk.k-if \{ border-color: #8e6ccf; \} .blk.k-if > .hd .kw \{ color: #8e6ccf; \}",
      ".blk.k-loop \{ border-color: #2a9d8f; \} .blk.k-loop > .hd .kw \{ color: #2a9d8f; \}",
      ".blk.k-match \{ border-color: #d17a22; \} .blk.k-match > .hd .kw \{ color: #d17a22; \}",
      ".blk.k-return > .hd .kw \{ color: var(--accent); \}",
      ".blk.k-assert > .hd .kw \{ color: var(--err); \}",
      ".blk.k-step > .hd .kw \{ color: var(--muted); \}",
      ".blk .arm \{ margin: 4px 0 4px 4px; \}",
      ".blk .arm > .lbl \{ font-size: 12px; color: var(--muted); \}",
      ".blk.closed > .kids \{ display: none; \}",
      ".blk > .hd .caret \{ width: 10px; color: var(--muted); \}",
      "pre.src \{ background: var(--code-bg); padding: 10px 0; border-radius: 6px; overflow-x: auto; margin: 0;",
      "  counter-reset: ln; \}",
      "pre.src span.l \{ display: block; padding: 0 12px; \}",
      "pre.src span.l::before \{ content: attr(data-n); display: inline-block; width: 3em; color: var(--muted);",
      "  text-align: right; margin-right: 12px; user-select: none; \}",
      "pre.src span.l.hl \{ background: var(--accent-soft); \}",
      ".sk \{ color: #8e6ccf; \} .ss \{ color: #2a9d8f; \} .sc \{ color: var(--muted); font-style: italic; \} .sn \{ color: #d17a22; \}",
      "details summary \{ cursor: pointer; color: var(--muted); margin: 8px 0; \}",
      ".types \{ display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; \}",
      ".type \{ border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; \}",
      ".type .nm \{ font-family: ui-monospace, Consolas, monospace; font-weight: 650; \}",
      ".out \{ white-space: pre-wrap; font-family: ui-monospace, Consolas, monospace; background: var(--code-bg);",
      "  padding: 8px 10px; border-radius: 6px; max-height: 220px; overflow: auto; \}",
      "@media (max-width: 800px) \{ .layout \{ grid-template-columns: 1fr; \} aside \{ position: static; height: auto; \} \}",
      "</style>",
      "</head>",
      "<body>",
      "<header>",
      "  <h1>Klar view</h1><span class=\"file\" id=\"file\"></span>",
      "  <span class=\"spacer\"></span>",
      "  <span class=\"seg\" id=\"langsel\"><button data-l=\"en\">EN</button> <button data-l=\"ru\">RU</button></span>",
      "</header>",
      "<div class=\"layout\">",
      "  <aside id=\"side\"></aside>",
      "  <main id=\"main\"></main>",
      "</div>",
      "<script>",
      "const DATA = /*__DATA__*/null;",
      "const T = \{",
      "  en: \{",
      "    overview: \"Overview\", functions: \"Functions\", types: \"Data types\", tests: \"Tests\", consts: \"Constants\",",
      "    implementedBy: \"implemented by\", noImpls: \"no implementations yet\",",
      "    entry: \"Entry point\", graph: \"Who calls whom\", graphHint: \"Click a function to see what it does. Arrows point from caller to callee.\",",
      "    pure: \"pure (no side effects)\", effect: \"has side effects (io, files, time…)\", ext: \"from another module\", cold: \"never ran\",",
      "    takes: \"Takes\", nothing: \"no arguments\", returns: \"Returns\", requires: \"Requires\", guarantees: \"Guarantees\",",
      "    sideEffects: \"Side effects\", pureFn: \"Pure: the same input always gives the same output.\", canReturn: \"Can return\", propagates: \"errors of the functions it calls (via ?)\",",
      "    calls: \"Calls\", calledBy: \"Called by\", testedBy: \"Tested by\", examples: \"Examples\", builtins: \"Uses built-ins\",",
      "    flow: \"What it does, step by step\", depth: \"Detail level\", all: \"all\", source: \"Source code\",",
      "    noCallers: \"nobody (entry point or unused)\", none: \"—\", ranTimes: \"Called %d× in the run\", run: \"Run\",",
      "    output: \"Output of the run\", runError: \"The run stopped with an error\", back: \"← Overview\",",
      "    eff: \{ io: \"console input/output\", fs: \"files\", time: \"the clock\", rand: \"random numbers\", net: \"network\" \},",
      "    k: \{ let: \"let\", var: \"var\", set: \"set\", if: \"if\", then: \"yes\", else: \"otherwise\", while: \"repeat while\",",
      "         for: \"for each\", in: \"in\", match: \"depending on\", ret: \"return\", assert: \"check\", do: \"do\",",
      "         brk: \"stop loop\", cont: \"next iteration\" \},",
      "    statements: \"statements\", program: \"Program\", progDesc: \"No description: add a `///` doc comment to `main`.\",",
      "    noMain: \"This file has no main(): it is a library.\", fnCount: \"functions\", typeCount: \"types\", testCount: \"tests\",",
      "    effectFns: \"with side effects\", lines: \"line\",",
      "  \},",
      "  ru: \{",
      "    overview: \"Обзор\", functions: \"Функции\", types: \"Типы данных\", tests: \"Тесты\", consts: \"Константы\",",
      "    implementedBy: \"реализуют\", noImpls: \"реализаций пока нет\",",
      "    entry: \"Точка входа\", graph: \"Кто кого вызывает\", graphHint: \"Нажмите на функцию, чтобы увидеть, что она делает. Стрелки идут от вызывающей к вызываемой.\",",
      "    pure: \"чистая (без побочных эффектов)\", effect: \"с побочными эффектами (ввод-вывод, файлы, время…)\", ext: \"из другого модуля\", cold: \"не выполнялась\",",
      "    takes: \"Принимает\", nothing: \"ничего\", returns: \"Возвращает\", requires: \"Требует\", guarantees: \"Гарантирует\",",
      "    sideEffects: \"Побочные эффекты\", pureFn: \"Чистая: при одних и тех же входных данных всегда один результат.\", canReturn: \"Может вернуть\", propagates: \"ошибки вызываемых функций (через ?)\",",
      "    calls: \"Вызывает\", calledBy: \"Кем вызывается\", testedBy: \"Проверяется тестами\", examples: \"Примеры\", builtins: \"Встроенные функции\",",
      "    flow: \"Что делает, по шагам\", depth: \"Уровень детализации\", all: \"всё\", source: \"Исходный код\",",
      "    noCallers: \"никем (точка входа или не используется)\", none: \"—\", ranTimes: \"Вызовов при запуске: %d\", run: \"Запуск\",",
      "    output: \"Вывод программы при запуске\", runError: \"Запуск остановился с ошибкой\", back: \"← Обзор\",",
      "    eff: \{ io: \"консольный ввод-вывод\", fs: \"файлы\", time: \"часы\", rand: \"случайные числа\", net: \"сеть\" \},",
      "    k: \{ let: \"пусть\", var: \"перем.\", set: \"присвоить\", if: \"если\", then: \"да\", else: \"иначе\", while: \"пока\", for: \"для каждого\",",
      "         in: \"из\", match: \"в зависимости от\", ret: \"вернуть\", assert: \"проверить\", do: \"выполнить\",",
      "         brk: \"выйти из цикла\", cont: \"следующий шаг\" \},",
      "    statements: \"инструкций\", program: \"Программа\", progDesc: \"Описания нет: добавьте `///` комментарий к `main`.\",",
      "    noMain: \"В файле нет main(): это библиотека.\", fnCount: \"функций\", typeCount: \"типов\", testCount: \"тестов\",",
      "    effectFns: \"с побочными эффектами\", lines: \"строка\",",
      "  \}",
      "\};",
      "let stored = null;",
      "try \{ stored = localStorage.getItem(\"klar-view-lang\"); \} catch (e) \{\}",
      "let lang = (stored || navigator.language || \"en\").startsWith(\"ru\") ? \"ru\" : \"en\";",
      "let selected = null, depth = 2;",
      "const fns = DATA.functions, trace = DATA.trace;",
      "const $ = (s, el = document) => el.querySelector(s);",
      "const esc = s => String(s).replace(/[&<>\"]/g, c => (\{ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" \}[c]));",
      "const t = () => T[lang];",
      "const calls = name => trace && trace.calls[name] ? trace.calls[name].calls : 0;",
      "",
      "function highlight(code) \{",
      "  return esc(code)",
      "    .replace(/(\\/\\/.*)$/gm, '<span class=\"sc\">$1</span>')",
      "    .replace(/(&quot;(?:[^&]|&(?!quot;))*?&quot;)/g, '<span class=\"ss\">$1</span>')",
      "    .replace(/\\b(fn|let|var|return|if|else|while|for|in|match|requires|ensures|uses|and|or|not|with|test|assert|type|enum|const|use|property|true|false)\\b/g, '<span class=\"sk\">$1</span>')",
      "    .replace(/\\b(\\d[\\d_]*(?:\\.\\d+)?)\\b/g, '<span class=\"sn\">$1</span>');",
      "\}",
      "",
      "// ---- sidebar ------------------------------------------------------------------------------------",
      "function side() \{",
      "  const own = Object.values(fns).filter(f => f.own), ext = Object.values(fns).filter(f => !f.own);",
      "  const link = f => `<div class=\"fnlink $\{selected === f.name ? \"sel\" : \"\"\}\" data-fn=\"$\{esc(f.name)\}\">",
      "      <span class=\"dot $\{f.effects.length ? \"effect\" : \"\"\} $\{f.own ? \"\" : \"ext\"\}\"></span>$\{esc(f.name)\}",
      "      $\{trace ? `<span class=\"count\">$\{calls(f.name) ? calls(f.name) + \"×\" : \"\"\}</span>` : \"\"\}</div>`;",
      "  let h = `<div class=\"fnlink $\{selected ? \"\" : \"sel\"\}\" data-fn=\"\">$\{t().overview\}</div>`;",
      "  h += `<h3>$\{t().functions\} ($\{own.length\})</h3>` + own.map(link).join(\"\");",
      "  if (ext.length) h += `<h3>$\{t().ext\}</h3>` + ext.map(link).join(\"\");",
      "  if (DATA.types.length) h += `<h3>$\{t().types\}</h3>` + DATA.types.map(x => `<div class=\"mono muted\" style=\"padding:2px 8px\">$\{esc(x.name)\}</div>`).join(\"\");",
      "  if (DATA.tests.length) h += `<h3>$\{t().tests\} ($\{DATA.tests.length\})</h3>` + DATA.tests.map(x => `<div class=\"muted\" style=\"padding:2px 8px;font-size:12px\">$\{esc(x.name)\}</div>`).join(\"\");",
      "  $(\"#side\").innerHTML = h;",
      "  document.querySelectorAll(\".fnlink\").forEach(el => el.onclick = () => select(el.dataset.fn || null));",
      "\}",
      "",
      "// ---- call graph ---------------------------------------------------------------------------------",
      "function graph() \{",
      "  const names = Object.keys(fns);",
      "  if (!names.length) return \"\";",
      "  const layer = \{\};",
      "  const roots = names.filter(n => n === DATA.entry).concat(names.filter(n => n !== DATA.entry && !fns[n].called_by.filter(c => c !== n).length));",
      "  const queue = roots.map(r => [r, 0]);",
      "  while (queue.length) \{",
      "    const [n, d] = queue.shift();",
      "    if (layer[n] !== undefined && layer[n] >= d) continue;",
      "    if (d > names.length) continue;",
      "    layer[n] = d;",
      "    for (const c of fns[n].calls) if (c !== n && fns[c]) queue.push([c, d + 1]);",
      "  \}",
      "  names.forEach(n => \{ if (layer[n] === undefined) layer[n] = 0; \});",
      "  const layers = [];",
      "  names.forEach(n => (layers[layer[n]] = layers[layer[n]] || []).push(n));",
      "  const W = 150, H = 40, GX = 26, GY = 56;",
      "  const avail = Math.max(($(\"#main\") ? $(\"#main\").clientWidth : 1000) - 80, 4 * (W + GX));",
      "  const perRow = Math.max(3, Math.floor(avail / (W + GX)));",
      "  const rows = [];",
      "  layers.filter(Boolean).forEach(l => \{",
      "    l.sort((a, b) => (fns[b].own - fns[a].own) || a.localeCompare(b));",
      "    for (let i = 0; i < l.length; i += perRow) rows.push(l.slice(i, i + perRow));",
      "  \});",
      "  const width = Math.max(...rows.map(r => r.length)) * (W + GX) + GX;",
      "  const pos = \{\};",
      "  rows.forEach((r, i) => \{",
      "    const off = (width - r.length * (W + GX) + GX) / 2;",
      "    r.forEach((n, j) => pos[n] = \{ x: off + j * (W + GX), y: 16 + i * (H + GY) \});",
      "  \});",
      "  const height = rows.length * (H + GY) + 10;",
      "  let s = `<svg width=\"$\{width\}\" height=\"$\{height\}\" viewBox=\"0 0 $\{width\} $\{height\}\">`;",
      "  s += `<defs><marker id=\"arr\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"currentColor\" opacity=\".6\"/></marker></defs>`;",
      "  for (const n of names) for (const c of fns[n].calls) \{",
      "    if (!fns[c]) continue;",
      "    const a = pos[n], b = pos[c];",
      "    const hot = selected && (selected === n || selected === c);",
      "    if (n === c) \{",
      "      s += `<path class=\"edge $\{hot ? \"hot\" : \"\"\}\" d=\"M$\{a.x + W - 18\},$\{a.y\} c 20,-26 40,0 18,14\" marker-end=\"url(#arr)\"/>`;",
      "      continue;",
      "    \}",
      "    const x1 = a.x + W / 2, y1 = a.y + H, x2 = b.x + W / 2, y2 = b.y;",
      "    const up = y2 <= y1;",
      "    const d = up ? `M$\{x1\},$\{y1\} C$\{x1\},$\{y1 + 40\} $\{x2\},$\{y2 - 40\} $\{x2\},$\{y2\}`",
      "                 : `M$\{x1\},$\{y1\} C$\{x1\},$\{(y1 + y2) / 2\} $\{x2\},$\{(y1 + y2) / 2\} $\{x2\},$\{y2\}`;",
      "    s += `<path class=\"edge $\{hot ? \"hot\" : \"\"\}\" style=\"color:var(--muted)\" d=\"$\{d\}\" marker-end=\"url(#arr)\"/>`;",
      "  \}",
      "  for (const n of names) \{",
      "    const f = fns[n], p = pos[n];",
      "    const cls = [\"node\", f.effects.length ? \"effect\" : \"\", f.own ? \"\" : \"ext\", trace && !calls(n) ? \"cold\" : \"\", selected === n ? \"sel\" : \"\"].join(\" \");",
      "    const label = n.length > 18 ? n.slice(0, 17) + \"…\" : n;",
      "    const badge = trace ? (calls(n) ? calls(n) + \"×\" : \"0×\") : (f.effects.length ? f.effects.join(\",\") : \"\");",
      "    s += `<g class=\"$\{cls\}\" data-fn=\"$\{esc(n)\}\"><title>$\{esc(f.signature)\}</title><rect x=\"$\{p.x\}\" y=\"$\{p.y\}\" width=\"$\{W\}\" height=\"$\{H\}\"/>",
      "      <text x=\"$\{p.x + 10\}\" y=\"$\{p.y + 17\}\">$\{esc(label)\}</text>",
      "      <text class=\"badge\" x=\"$\{p.x + 10\}\" y=\"$\{p.y + 32\}\">$\{esc(badge)\}</text></g>`;",
      "  \}",
      "  return s + \"</svg>\";",
      "\}",
      "",
      "// ---- overview ------------------------------------------------------------------------------------",
      "function overview() \{",
      "  const own = Object.values(fns).filter(f => f.own);",
      "  const eff = own.filter(f => f.effects.length).length;",
      "  let h = `<div class=\"card\"><h2>$\{t().program\}: $\{esc(DATA.file)\}</h2>",
      "    <div>$\{DATA.description ? esc(DATA.description) : `<span class=\"muted\">$\{t().progDesc\}</span>`\}</div>",
      "    <div class=\"stats\">",
      "      <div class=\"stat\"><b>$\{own.length\}</b>$\{t().fnCount\}</div>",
      "      <div class=\"stat\"><b>$\{eff\}</b>$\{t().effectFns\}</div>",
      "      <div class=\"stat\"><b>$\{DATA.types.length\}</b>$\{t().typeCount\}</div>",
      "      <div class=\"stat\"><b>$\{DATA.tests.length\}</b>$\{t().testCount\}</div>",
      "      $\{trace ? `<div class=\"stat\"><b>$\{trace.total_ms\} ms</b>$\{t().run\}</div>` : \"\"\}",
      "    </div>",
      "    $\{DATA.entry ? `<p>$\{t().entry\}: <span class=\"chip link\" data-fn=\"main\">main</span></p>` : `<p class=\"muted\">$\{t().noMain\}</p>`\}",
      "  </div>`;",
      "  if (DATA.entry && fns.main) \{",
      "    h += `<div class=\"card\"><h2>main — $\{t().flow\}</h2>$\{flowHtml(fns.main.flow, 1, 1)\}</div>`;",
      "  \}",
      "  h += `<div class=\"card\"><h2>$\{t().graph\}</h2><div class=\"muted\">$\{t().graphHint\}</div>",
      "    <div class=\"legend\"><span><span class=\"dot\"></span>$\{t().pure\}</span><span><span class=\"dot effect\"></span>$\{t().effect\}</span>",
      "    <span><span class=\"dot ext\"></span>$\{t().ext\}</span>$\{trace ? `<span style=\"opacity:.5\">▭ $\{t().cold\}</span>` : \"\"\}</div>",
      "    <div class=\"graph-wrap\">$\{graph()\}</div></div>`;",
      "  if (trace) \{",
      "    h += `<div class=\"card\"><h2>$\{t().run\}</h2>`;",
      "    if (trace.error) h += `<p class=\"chip err\">$\{t().runError\}: [$\{esc(trace.error.code)\}] $\{esc(trace.error.message)\} ($\{t().lines\} $\{trace.error.line\})</p>`;",
      "    h += `<div class=\"muted\">$\{t().output\}</div><div class=\"out\">$\{esc(trace.output || \"\")\}</div></div>`;",
      "  \}",
      "  if (DATA.types.length) \{",
      "    h += `<div class=\"card\"><h2>$\{t().types\}</h2><div class=\"types\">` + DATA.types.map(x => `<div class=\"type\">",
      "      <div class=\"nm\">$\{esc(x.kind)\} $\{esc(x.name)\}</div>$\{x.doc ? `<div class=\"muted\">$\{esc(x.doc)\}</div>` : \"\"\}",
      "      $\{x.fields.map(f => `<div class=\"mono\">$\{esc(f)\}</div>`).join(\"\")\}",
      "      $\{x.kind === \"trait\" ? `<div class=\"muted\">$\{x.impls.length ? t().implementedBy + \": \" + x.impls.map(esc).join(\", \") : t().noImpls\}</div>` : \"\"\}</div>`).join(\"\") + `</div></div>`;",
      "  \}",
      "  if (DATA.consts.length) \{",
      "    h += `<div class=\"card\"><h2>$\{t().consts\}</h2>` + DATA.consts.map(c => `<div class=\"mono\">$\{esc(c.name)\} = $\{esc(c.value)\}</div>`).join(\"\") + `</div>`;",
      "  \}",
      "  return h;",
      "\}",
      "",
      "// ---- control flow blocks ---------------------------------------------------------------------------",
      "function flowHtml(list, level, maxLevel) \{",
      "  return list.map(n => blk(n, level, maxLevel)).join(\"\");",
      "\}",
      "function blk(n, level, maxLevel) \{",
      "  const K = t().k, open = maxLevel === 0 || level < maxLevel;",
      "  const ln = `<span class=\"ln\" data-line=\"$\{n.line\}\">$\{n.line\}</span>`;",
      "  const box = (cls, kw, text, kids) => \{",
      "    const tog = kids ? \"tog\" : \"\";",
      "    return `<div class=\"blk $\{cls\} $\{kids && !open ? \"closed\" : \"\"\}\"><div class=\"hd $\{tog\}\">",
      "      <span class=\"caret\">$\{kids ? (open ? \"▾\" : \"▸\") : \"\"\}</span><span class=\"kw\">$\{kw\}</span><span class=\"mono\">$\{text\}</span>$\{ln\}</div>",
      "      $\{kids ? `<div class=\"kids\">$\{kids\}</div>` : \"\"\}</div>`;",
      "  \};",
      "  const sub = (v) => v ? blk(v, level + 1, maxLevel) : \"\";",
      "  switch (n.kind) \{",
      "    case \"let\": return n.value ? box(\"k-step\", n.mutable ? K.var : K.let, esc(n.name) + \" =\", sub(n.value))",
      "                               : box(\"k-step\", n.mutable ? K.var : K.let, `$\{esc(n.name)\} = $\{esc(n.text)\}`);",
      "    case \"assign\": return n.value ? box(\"k-step\", K.set, esc(n.name) + \" =\", sub(n.value))",
      "                                  : box(\"k-step\", K.set, `$\{esc(n.name)\} = $\{esc(n.text)\}`);",
      "    case \"return\": return n.value ? box(\"k-return\", K.ret, \"\", sub(n.value)) : box(\"k-return\", K.ret, esc(n.text));",
      "    case \"if\": \{",
      "      let kids = `<div class=\"arm\"><div class=\"lbl\">$\{K.then\}</div>$\{flowHtml(n.then, level + 1, maxLevel)\}</div>`;",
      "      if (n.else) kids += `<div class=\"arm\"><div class=\"lbl\">$\{K.else\}</div>$\{flowHtml(n.else, level + 1, maxLevel)\}</div>`;",
      "      return box(\"k-if\", K.if, esc(n.cond), kids);",
      "    \}",
      "    case \"while\": return box(\"k-loop\", K.while, esc(n.cond), flowHtml(n.body, level + 1, maxLevel));",
      "    case \"for\": return box(\"k-loop\", K.for, `$\{esc(n.var)\} $\{K.in\} $\{esc(n.iter)\}`, flowHtml(n.body, level + 1, maxLevel));",
      "    case \"match\": return box(\"k-match\", K.match, esc(n.subject),",
      "      n.arms.map(a => `<div class=\"arm\"><div class=\"lbl mono\">$\{esc(a.pattern)\} →</div>$\{flowHtml(a.body, level + 1, maxLevel)\}</div>`).join(\"\"));",
      "    case \"assert\": return box(\"k-assert\", K.assert, esc(n.text));",
      "    case \"break\": return box(\"k-step\", K.brk, \"\");",
      "    case \"continue\": return box(\"k-step\", K.cont, \"\");",
      "    default: return box(\"k-step\", K.do, esc(n.text));",
      "  \}",
      "\}",
      "",
      "// ---- one function ----------------------------------------------------------------------------------------",
      "function describe(f) \{",
      "  const L = t(), parts = [];",
      "  if (f.doc) parts.push(esc(f.doc.split(\"\\n\")[0]));",
      "  parts.push(`$\{L.takes\} $\{f.params.length ? f.params.map(p => `<code>$\{esc(p.name)\}</code> ($\{esc(p.type)\})`).join(\", \") : L.nothing\}.`);",
      "  parts.push(`$\{L.returns\} <code>$\{esc(f.returns)\}</code>.`);",
      "  return parts.join(\" \");",
      "\}",
      "function fnView(name) \{",
      "  const f = fns[name], L = t();",
      "  const chips = (arr, cls) => arr.length ? arr.map(x => `<span class=\"chip $\{cls\}\" $\{cls === \"link\" ? `data-fn=\"$\{esc(x)\}\"` : \"\"\}>$\{esc(x)\}</span>`).join(\"\") : L.none;",
      "  let h = `<div class=\"toolbar\"><button data-fn=\"\">$\{L.back\}</button></div>",
      "  <div class=\"card\"><h2 class=\"mono\">$\{esc(f.name)\} <span class=\"muted\" style=\"font-size:13px\">$\{esc(f.module)\}:$\{f.line\}</span></h2>",
      "    <div class=\"sig\">$\{esc(f.signature)\}</div>",
      "    <p>$\{describe(f)\}</p>",
      "    <dl class=\"facts\">",
      "      $\{f.requires.length ? `<dt>$\{L.requires\}</dt><dd>$\{f.requires.map(r => `<code>$\{esc(r)\}</code>`).join(\" \")\}</dd>` : \"\"\}",
      "      $\{f.ensures.length ? `<dt>$\{L.guarantees\}</dt><dd>$\{f.ensures.map(r => `<code>$\{esc(r)\}</code>`).join(\" \")\}</dd>` : \"\"\}",
      "      <dt>$\{L.sideEffects\}</dt><dd>$\{f.effects.length ? f.effects.map(e => `<span class=\"chip effect\">$\{esc(L.eff[e] || e)\}</span>`).join(\"\") : `<span class=\"chip pure\">$\{L.pureFn\}</span>`\}</dd>",
      "      $\{f.errors.length ? `<dt>$\{L.canReturn\}</dt><dd>$\{chips(f.errors.map(e => e === \"?\" ? L.propagates : e), \"err\")\}</dd>` : \"\"\}",
      "      <dt>$\{L.calls\}</dt><dd>$\{chips(f.calls.filter(c => fns[c]), \"link\")\}</dd>",
      "      <dt>$\{L.calledBy\}</dt><dd>$\{f.called_by.length ? chips(f.called_by, \"link\") : L.noCallers\}</dd>",
      "      $\{f.builtins.length ? `<dt>$\{L.builtins\}</dt><dd>$\{f.builtins.map(b => `<code>$\{esc(b)\}</code>`).join(\" \")\}</dd>` : \"\"\}",
      "      <dt>$\{L.testedBy\}</dt><dd>$\{f.tests.length ? f.tests.map(x => `<span class=\"chip\">$\{esc(x)\}</span>`).join(\"\") : L.none\}</dd>",
      "      $\{trace ? `<dt>$\{L.run\}</dt><dd>$\{L.ranTimes.replace(\"%d\", calls(name))\}$\{trace.calls[name] ? `, $\{trace.calls[name].ms\} ms` : \"\"\}</dd>` : \"\"\}",
      "    </dl>",
      "    $\{f.examples.length ? `<p class=\"muted\">$\{L.examples\}:</p>` + f.examples.map(e => `<div class=\"mono\">$\{highlight(e)\}</div>`).join(\"\") : \"\"\}",
      "  </div>",
      "  <div class=\"card\"><h2>$\{L.flow\}</h2>",
      "    <div class=\"toolbar\">$\{L.depth\}: $\{[1, 2, 3, 0].map(d => `<button class=\"depth $\{depth === d ? \"on\" : \"\"\}\" data-d=\"$\{d\}\">$\{d || L.all\}</button>`).join(\"\")\}</div>",
      "    <div id=\"flow\">$\{flowHtml(f.flow, 1, depth)\}</div></div>",
      "  <div class=\"card\"><h2>$\{L.source\}</h2><pre class=\"src\" id=\"src\">$\{f.source.split(\"\\n\").map((l, i) =>",
      "      `<span class=\"l\" data-n=\"$\{f.line + i\}\">$\{highlight(l) || \" \"\}</span>`).join(\"\")\}</pre></div>`;",
      "  return h;",
      "\}",
      "",
      "// ---- wiring ------------------------------------------------------------------------------------------------",
      "function select(name) \{",
      "  selected = name && fns[name] ? name : null;",
      "  render();",
      "  window.scrollTo(0, 0);",
      "  history.replaceState(null, \"\", selected ? \"#\" + encodeURIComponent(selected) : \"#\");",
      "\}",
      "function render() \{",
      "  document.documentElement.lang = lang;",
      "  $(\"#file\").textContent = DATA.file;",
      "  document.querySelectorAll(\"#langsel button\").forEach(b => b.classList.toggle(\"on\", b.dataset.l === lang));",
      "  side();",
      "  $(\"#main\").innerHTML = selected ? fnView(selected) : overview();",
      "  document.querySelectorAll(\"#main [data-fn]\").forEach(el => el.addEventListener(\"click\", () => select(el.dataset.fn || null)));",
      "  document.querySelectorAll(\".blk > .hd.tog\").forEach(el => el.addEventListener(\"click\", ev => \{",
      "    if (ev.target.classList.contains(\"ln\")) return;",
      "    const b = el.parentElement;",
      "    b.classList.toggle(\"closed\");",
      "    el.querySelector(\".caret\").textContent = b.classList.contains(\"closed\") ? \"▸\" : \"▾\";",
      "  \}));",
      "  document.querySelectorAll(\".ln\").forEach(el => el.addEventListener(\"click\", () => \{",
      "    const n = el.dataset.line;",
      "    document.querySelectorAll(\"pre.src span.l\").forEach(l => l.classList.toggle(\"hl\", l.dataset.n === n));",
      "    const target = document.querySelector(`pre.src span.l[data-n=\"$\{n\}\"]`);",
      "    if (target) target.scrollIntoView(\{ block: \"center\", behavior: \"smooth\" \});",
      "  \}));",
      "  document.querySelectorAll(\"button.depth\").forEach(b => b.addEventListener(\"click\", () => \{ depth = +b.dataset.d; render(); \}));",
      "\}",
      "document.querySelectorAll(\"#langsel button\").forEach(b => b.onclick = () => \{",
      "  lang = b.dataset.l; try \{ localStorage.setItem(\"klar-view-lang\", lang); \} catch (e) \{\} render();",
      "\});",
      "selected = decodeURIComponent(location.hash.slice(1)) || null;",
      "if (selected && !fns[selected]) selected = null;",
      "render();",
      "</script>",
      "</body>",
      "</html>",
      "",
    ],
    _ => [],
  }
}
