// std.list — extra list algorithms.  use std.list.{frequencies, transpose, windows}

/// Integers from `start` (inclusive) to `end` (exclusive) with a step.
/// >>> assert range_step(start: 0, end: 10, step: 3) == [0, 3, 6, 9]
/// >>> assert range_step(start: 5, end: 0, step: -2) == [5, 3, 1]
pub fn range_step(start: Int, end: Int, step: Int) -> List[Int]
  requires step != 0
{
  var out: List[Int] = []
  var i = start
  while (step > 0 and i < end) or (step < 0 and i > end) {
    out = out.push(i)
    i = i + step
  }
  return out
}

/// How many times each element occurs.
/// >>> assert frequencies(["a", "b", "a"]).get("a") == Some(2)
pub fn frequencies[T](xs: List[T]) -> Map[T, Int] {
  return xs.fold(Map {}, fn(acc, x) => acc.update(x, 0, fn(n) => n + 1))
}

/// Sliding windows of `size` consecutive elements.
/// >>> assert windows([1, 2, 3, 4], 3) == [[1, 2, 3], [2, 3, 4]]
pub fn windows[T](xs: List[T], size: Int) -> List[List[T]]
  requires size > 0
{
  var out: List[List[T]] = []
  for i in range(0, xs.len() - size + 1) {
    out = out.push(xs.slice(i, i + size))
  }
  return out
}

/// Swaps rows and columns; rows shorter than the first are padded by skipping.
/// >>> assert transpose([[1, 2, 3], [4, 5, 6]]) == [[1, 4], [2, 5], [3, 6]]
pub fn transpose[T](rows: List[List[T]]) -> List[List[T]] {
  let width = rows.first().map(fn(r) => r.len()).unwrap_or(0)
  return range(0, width).map(fn(c) => rows.flat_map(fn(r) => match r.get(c) {
    Some(v) => [v],
    None => [],
  }))
}

/// Puts `sep` between elements.
/// >>> assert intersperse([1, 2, 3], 0) == [1, 0, 2, 0, 3]
pub fn intersperse[T](xs: List[T], sep: T) -> List[T] {
  var out: List[T] = []
  for e in xs.enumerate() {
    if e.index > 0 {
      out = out.push(sep)
    }
    out = out.push(e.value)
  }
  return out
}

/// Rotates left by `n` positions (negative rotates right).
/// >>> assert rotate([1, 2, 3, 4], 1) == [2, 3, 4, 1]
pub fn rotate[T](xs: List[T], n: Int) -> List[T] {
  if xs.is_empty() {
    return xs
  }
  let k = ((n % xs.len()) + xs.len()) % xs.len()
  return xs.drop(k).concat(xs.take(k))
}

/// Elements present in both lists (order of the first list, no duplicates).
/// >>> assert intersection([1, 2, 2, 3], [2, 3, 4]) == [2, 3]
pub fn intersection[T](a: List[T], b: List[T]) -> List[T] {
  return a.filter(fn(x) => b.contains(x)).unique()
}

/// Elements of `a` that are not in `b`.
/// >>> assert difference([1, 2, 3], [2]) == [1, 3]
pub fn difference[T](a: List[T], b: List[T]) -> List[T] {
  return a.filter(fn(x) => not b.contains(x))
}

/// Binary search in a sorted list of Ints; returns the index if found.
/// >>> assert binary_search([1, 3, 5, 7], 5) == Some(2)
/// >>> assert binary_search([1, 3, 5, 7], 4) == None
pub fn binary_search(sorted: List[Int], target: Int) -> Option[Int] {
  var lo = 0
  var hi = sorted.len() - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let v = sorted.get(mid)?
    if v == target {
      return Some(mid)
    }
    if v < target {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  return None
}

/// Cumulative sums.
/// >>> assert running_sum([1, 2, 3]) == [1, 3, 6]
pub fn running_sum(xs: List[Int]) -> List[Int] {
  var total = 0
  var out: List[Int] = []
  for x in xs {
    total = total + x
    out = out.push(total)
  }
  return out
}

test "windows edge cases" {
  assert windows([1, 2], 3) == []
  assert windows([1], 1) == [[1]]
}

test "rotate negative" {
  assert rotate([1, 2, 3], -1) == [3, 1, 2]
  assert rotate([], 5) == []
}

property "rotate keeps elements" (xs: List[Int], n: Int) {
  assert rotate(xs, n).sort() == xs.sort()
}

property "running_sum last equals sum" (xs: List[Int]) {
  assert running_sum(xs).last().unwrap_or(0) == xs.sum()
}

property "binary_search finds present elements" (xs: List[Int], x: Int) {
  let sorted = xs.push(x).sort().unique()
  match binary_search(sorted, x) {
    Some(i) => { assert sorted.get(i) == Some(x) },
    None => { assert false, "element not found" },
  }
}

property "transpose twice restores rectangular grids" (n: Int) {
  let size = n.abs() % 5 + 1
  let grid = range(0, size).map(fn(r) => range(0, 3).map(fn(c) => r * 10 + c))
  assert transpose(transpose(grid)) == grid
}

property "frequencies sum to length" (xs: List[Str]) {
  assert frequencies(xs).values().sum() == xs.len()
}
