// Klar runtime: global built-in functions (print, range, time, ...). Names: b_<builtin>.

fn b_print(v: Word, td_T: Word) {
  if peek(td_T) == K_STR {
    out_bytes(v + 32, peek(v + 16))
  } else {
    let b = sb_new()
    show_into(b, v, td_T, true)
    out_bytes(peek(b + 32), peek(b + 16))
    rc_dec(b)
  }
  out_byte(10)
}

// print_raw(text): the text as it is, without a line break
fn b_print_raw(s: Word) {
  out_bytes(s + 32, peek(s + 16))
}

// print to stderr (stdout is flushed first, so the two streams stay in order)
fn b_eprint(v: Word, td_T: Word) {
  flush_out()
  let b = sb_new()
  show_into(b, v, td_T, true)
  sb_add_byte(b, 10)
  err_bytes(peek(b + 32), peek(b + 16))
  rc_dec(b)
}

fn b_range(lo: Int, hi: Int, rtd: Word) -> Word {
  if not is_small(lo) or not is_small(hi) {
    fail_msg("R0009", "range: bounds too large", current_span())
  }
  return list_from_range(rtd, untag(lo), untag(hi))
}

fn b_now_ns() -> Int {
  return tag(os_time_ns())
}

fn b_now_ms() -> Int {
  return tag(os_wall_ns() / 1000000)
}

fn b_fail(msg: Word, sp: Word) -> Word {
  let b = sb_new()
  sb_add_cstr(b, "fail: ")
  sb_add_str(b, msg)
  return fail_with(bits("R0004"), sb_finish(b), sp, 0, bits(""))
}

fn b_todo(what: Word, sp: Word) -> Word {
  let b = sb_new()
  sb_add_cstr(b, "reached unfinished code: todo(\"")
  sb_add_str(b, what)
  sb_add_cstr(b, "\")")
  return fail_with(bits("R0012"), sb_finish(b), sp, 0, bits(""))
}

fn b_random_int(lo: Int, hi: Int, sp: Word) -> Int {
  if lo > hi {
    let b = sb_new()
    sb_add_cstr(b, "random_int: min (")
    int_show(b, bits(lo))
    sb_add_cstr(b, ") > max (")
    int_show(b, bits(hi))
    sb_add_cstr(b, ")")
    fail_simple("R0009", sb_finish(b), sp)
  }
  let gp = g()
  var x = peek(gp + G_RAND)
  if x == 0 {
    x = w_or(os_time_ns(), 1)
  }
  x = w_xor(x, w_shl(x, 13))
  x = w_xor(x, w_shr(x, 7))
  x = w_xor(x, w_shl(x, 17))
  poke(gp + G_RAND, x)
  let r: Int = tag(w_shr(x, 3))
  return lo + r % (hi - lo + 1)
}

fn b_read_line(rtd: Word) -> Word {
  let gp = g()
  let buf = static_addr("g_inbuf")
  let b = sb_new()
  var got = false
  var reading = true
  while reading {
    if peek(gp + G_INPOS) >= peek(gp + G_INLEN) {
      if peek(gp + G_INEOF) == 1 {
        reading = false
      } else {
        flush_out()
        let n = os_read(0, buf, 65536)
        if n <= 0 {
          poke(gp + G_INEOF, 1)
          reading = false
        } else {
          poke(gp + G_INPOS, 0)
          poke(gp + G_INLEN, n)
        }
      }
    }
    if reading {
      let pos = peek(gp + G_INPOS)
      let c = peek8(buf + pos)
      poke(gp + G_INPOS, pos + 1)
      got = true
      if c == 10 {
        reading = false
      } else {
        sb_add_byte(b, c)
      }
    }
  }
  if not got {
    rc_dec(b)
    return none()
  }
  var n2 = sb_len(b)
  if n2 > 0 and peek8(peek(b + 32) + n2 - 1) == 13 {
    poke(b + 16, n2 - 1)
  }
  return some_new(rtd, sb_finish(b))
}

fn cstr_len(p: Word) -> Word {
  var n: Word = 0
  while peek8(p + n) != 0 {
    n = n + 1
  }
  return n
}

fn b_cli_args(rtd: Word) -> Word {
  var out = list_with_cap(rtd, 4)
  if os_platform() == 0 {
    let argc = os_argc()
    var i: Word = 1
    while i < argc {
      let p = os_argv(i)
      out = list_push_owned_raw(out, str_from(p, cstr_len(p)))
      i = i + 1
    }
    return out
  }
  // Windows: split GetCommandLineA, honouring double quotes; skip the program name
  let cl = os_cmdline()
  let n = cstr_len(cl)
  var i2: Word = 0
  var index: Word = 0
  while i2 < n {
    while i2 < n and peek8(cl + i2) == 32 {
      i2 = i2 + 1
    }
    if i2 < n {
      let b = sb_new()
      var quoted = false
      while i2 < n and (quoted or peek8(cl + i2) != 32) {
        let c = peek8(cl + i2)
        if c == 34 {
          quoted = not quoted
        } else {
          sb_add_byte(b, c)
        }
        i2 = i2 + 1
      }
      if index > 0 {
        out = list_push_owned_raw(out, sb_finish(b))
      } else {
        rc_dec(b)
      }
      index = index + 1
    }
  }
  return out
}

fn io_error_text(b: Word, code: Word) {
  if code == -2 or os_platform() == 1 {
    sb_add_cstr(b, "No such file or directory")
  } else if code == -13 {
    sb_add_cstr(b, "Permission denied")
  } else if code == -21 {
    sb_add_cstr(b, "Is a directory")
  } else if code == -20 {
    sb_add_cstr(b, "Not a directory")
  } else if code == -17 {
    sb_add_cstr(b, "File exists")
  } else {
    sb_add_cstr(b, "I/O error")
  }
}

fn b_read_file(path: Word, rtd: Word) -> Word {
  let fd = os_open(path + 32, 0)
  if fd < 0 {
    let b = sb_new()
    sb_add_cstr(b, "cannot read '")
    sb_add_str(b, path)
    sb_add_cstr(b, "': ")
    io_error_text(b, fd)
    return err_new(rtd, sb_finish(b))
  }
  let content = sb_new()
  let chunk = alloc(65536)
  var reading = true
  while reading {
    let n = os_read(fd, chunk, 65536)
    if n <= 0 {
      reading = false
    } else {
      sb_add_bytes(content, chunk, n)
    }
  }
  block_free(chunk)
  os_close(fd)
  let s = sb_finish(content)
  if not valid_utf8(s) {
    rc_dec(s)
    let b2 = sb_new()
    sb_add_cstr(b2, "cannot read '")
    sb_add_str(b2, path)
    sb_add_cstr(b2, "': not valid UTF-8 text")
    return err_new(rtd, sb_finish(b2))
  }
  return ok_new(rtd, s)
}

fn valid_utf8(s: Word) -> Bool {
  let n = peek(s + 16)
  var i: Word = 0
  while i < n {
    let c = peek8(s + 32 + i)
    var need: Word = 0
    if c < 128 {
      need = 0
    } else if c >= 194 and c < 224 {
      need = 1
    } else if c >= 224 and c < 240 {
      need = 2
    } else if c >= 240 and c < 245 {
      need = 3
    } else {
      return false
    }
    var k: Word = 1
    while k <= need {
      if i + k >= n or w_and(peek8(s + 32 + i + k), 192) != 128 {
        return false
      }
      k = k + 1
    }
    i = i + 1 + need
  }
  return true
}

fn b_write_file(path: Word, content: Word, rtd: Word) -> Word {
  let fd = os_open(path + 32, 1)
  if fd < 0 {
    let b = sb_new()
    sb_add_cstr(b, "cannot write '")
    sb_add_str(b, path)
    sb_add_cstr(b, "': ")
    io_error_text(b, fd)
    return err_new(rtd, sb_finish(b))
  }
  var done: Word = 0
  let n = peek(content + 16)
  while done < n {
    let w = os_write(fd, content + 32 + done, n - done)
    if w <= 0 {
      done = n
    } else {
      done = done + w
    }
  }
  os_close(fd)
  return ok_new(rtd, 0)
}

fn b_file_exists(path: Word) -> Bool {
  return os_file_exists(path + 32)
}

fn b_dbg(v: Word, td: Word, text: Word, sp: Word) {
  flush_out()
  let b = sb_new()
  sb_add_cstr(b, "[dbg ")
  span_short(b, sp)
  sb_add_cstr(b, "] ")
  sb_add_str(b, text)
  sb_add_cstr(b, " = ")
  show_into(b, v, td, false)
  sb_add_byte(b, 10)
  err_bytes(peek(b + 32), peek(b + 16))
  rc_dec(b)
}

fn b_exit(code: Int) -> Word {
  var c: Word = 0
  if is_small(code) {
    c = untag(code)
  } else if code > 0 {
    c = 255
  }
  if c < 0 {
    c = 0
  }
  if c > 255 {
    c = 255
  }
  flush_out()
  os_exit(c)
  return 0
}

// environment variable: Linux walks envp (after argv on the initial stack), Windows asks kernel32
fn b_env_var(name: Word, rtd: Word) -> Word {
  let n = peek(name + 16)
  if os_platform() == 0 {
    var i = os_argc() + 1
    var p = os_argv(i)
    while p != 0 {
      if bytes_eq(p, name + 32, n) and peek8(p + n) == 61 {
        return some_new(rtd, str_from(p + n + 1, cstr_len(p + n + 1)))
      }
      i = i + 1
      p = os_argv(i)
    }
    return none()
  }
  let cap: Word = 32768
  let buf = alloc(cap)
  let len = os_getenv(name + 32, buf, cap)
  if len <= 0 or len >= cap {
    block_free(buf)
    return none()
  }
  let s = str_from(buf, len)
  block_free(buf)
  return some_new(rtd, s)
}

// ---- processes --------------------------------------------------------------------------------------------------

fn spawn_error(prog: Word, code: Word, rtd: Word) -> Word {
  let b = sb_new()
  sb_add_cstr(b, "cannot run '")
  sb_add_str(b, prog)
  sb_add_cstr(b, "': ")
  io_error_text(b, code)
  return err_new(rtd, sb_finish(b))
}

fn has_byte(s: Word, c: Word) -> Bool {
  var i: Word = 0
  let n = peek(s + 16)
  while i < n {
    if peek8(s + 32 + i) == c {
      return true
    }
    i = i + 1
  }
  return false
}

// Linux: the program file for a name: itself when it contains '/', else the first match in PATH (0: none)
fn find_program(prog: Word) -> Word {
  if has_byte(prog, 47) {
    if not os_file_exists(prog + 32) {
      return 0
    }
    rc_inc(prog)
    return prog
  }
  let name = bits("PATH")
  var i = os_argc() + 1
  var p = os_argv(i)
  while p != 0 {
    if bytes_eq(p, name + 32, 4) and peek8(p + 4) == 61 {
      var start = p + 5
      var q = start
      var going = true
      while going {
        let c = peek8(q)
        if c == 58 or c == 0 {
          if q > start {
            let b = sb_new()
            sb_add_bytes(b, start, q - start)
            sb_add_byte(b, 47)
            sb_add_str(b, prog)
            let cand = sb_finish(b)
            if os_file_exists(cand + 32) {
              return cand
            }
            rc_dec(cand)
          }
          if c == 0 {
            going = false
          }
          start = q + 1
        }
        q = q + 1
      }
      return 0
    }
    i = i + 1
    p = os_argv(i)
  }
  return 0
}

// Windows: one argument of a command line, quoted when it is empty or has spaces, tabs or quotes
fn add_win_arg(b: Word, s: Word) {
  let n = peek(s + 16)
  let quote = n == 0 or has_byte(s, 32) or has_byte(s, 9) or has_byte(s, 34)
  if not quote {
    sb_add_str(b, s)
    return
  }
  sb_add_byte(b, 34)
  var i: Word = 0
  var slashes: Word = 0
  while i < n {
    let c = peek8(s + 32 + i)
    if c == 92 {
      slashes = slashes + 1
    } else {
      if c == 34 {
        var k: Word = 0
        while k < slashes + 1 {
          sb_add_byte(b, 92)
          k = k + 1
        }
      }
      slashes = 0
    }
    sb_add_byte(b, c)
    i = i + 1
  }
  var k2: Word = 0
  while k2 < slashes {
    sb_add_byte(b, 92)
    k2 = k2 + 1
  }
  sb_add_byte(b, 34)
}

fn b_run_command(args: Word, rtd: Word) -> Word {
  let n = peek(args + 16)
  if n == 0 {
    return err_new(rtd, bits("run_command: no program given"))
  }
  flush_out()
  let prog = list_at(args, 0)
  if os_platform() == 0 {
    let path = find_program(prog)
    if path == 0 {
      return spawn_error(prog, -2, rtd)
    }
    let argv = alloc(8 * (n + 1))
    poke(argv, path + 32)
    var i: Word = 1
    while i < n {
      poke(argv + 8 * i, list_at(args, i) + 32)
      i = i + 1
    }
    poke(argv + 8 * n, 0)
    let st = os_spawn(argv)
    block_free(argv)
    rc_dec(path)
    if st < 0 {
      return spawn_error(prog, st, rtd)
    }
    var code = w_and(w_shr(st, 8), 255)
    if w_and(st, 127) != 0 {
      code = 128 + w_and(st, 127)
    }
    return ok_new(rtd, bits(tag(code)))
  }
  let b = sb_new()
  var j: Word = 0
  while j < n {
    if j > 0 {
      sb_add_byte(b, 32)
    }
    add_win_arg(b, list_at(args, j))
    j = j + 1
  }
  let cl = sb_finish(b)
  let r = os_spawn(cl + 32)
  rc_dec(cl)
  if r < 0 {
    return spawn_error(prog, -2, rtd)
  }
  return ok_new(rtd, bits(tag(r)))
}

fn b_set_executable(path: Word, rtd: Word) -> Word {
  if os_platform() != 0 {
    return ok_new(rtd, 0)
  }
  let r = os_chmod(path + 32, 493)
  if r < 0 {
    let b = sb_new()
    sb_add_cstr(b, "cannot change '")
    sb_add_str(b, path)
    sb_add_cstr(b, "': ")
    io_error_text(b, r)
    return err_new(rtd, sb_finish(b))
  }
  return ok_new(rtd, 0)
}

// ---------------------------------------------------------------------------
// directories
// ---------------------------------------------------------------------------
fn b_is_dir(path: Word) -> Bool {
  return os_is_dir(path + 32)
}

fn list_dir_error(path: Word, code: Word, rtd: Word) -> Word {
  let b = sb_new()
  sb_add_cstr(b, "cannot list '")
  sb_add_str(b, path)
  sb_add_cstr(b, "': ")
  io_error_text(b, code)
  return err_new(rtd, sb_finish(b))
}

// adds the entry name at p (a C string) unless it is "." or ".."
fn add_entry(names: Word, p: Word) -> Word {
  let n = cstr_len(p)
  if peek8(p) == 46 and (n == 1 or (n == 2 and peek8(p + 1) == 46)) {
    return names
  }
  return list_push_owned_raw(names, str_from(p, n))
}

fn b_list_dir(path: Word, rtd: Word) -> Word {
  var names = list_new_str()
  if os_platform() == 1 {
    let b = sb_new()
    sb_add_str(b, path)
    sb_add_cstr(b, "\\*")
    let pattern = sb_finish(b)
    let data = alloc(320)
    let h = os_find_first(pattern + 32, data)
    rc_dec(pattern)
    if h == -1 {
      block_free(data)
      rc_dec(names)
      return list_dir_error(path, -2, rtd)
    }
    var more = true
    while more {
      names = add_entry(names, data + 44)
      more = os_find_next(h, data) != 0
    }
    os_find_close(h)
    block_free(data)
  } else {
    let fd = os_open(path + 32, 0)
    if fd < 0 {
      rc_dec(names)
      return list_dir_error(path, fd, rtd)
    }
    let buf = alloc(32768)
    var failed: Word = 0
    var reading = true
    while reading {
      let n = os_getdents(fd, buf, 32768)
      if n <= 0 {
        failed = n
        reading = false
      } else {
        // struct linux_dirent64: ino, off, reclen (16 bits), type (8 bits), name
        var off: Word = 0
        while off < n {
          names = add_entry(names, buf + off + 19)
          off = off + w_and(peek32(buf + off + 16), 65535)
        }
      }
    }
    os_close(fd)
    block_free(buf)
    if failed < 0 {
      rc_dec(names)
      return list_dir_error(path, failed, rtd)
    }
  }
  let sorted = List_sort(names, 0)
  rc_dec(names)
  return ok_new(rtd, sorted)
}

// make_dir(path): creates the directory and the missing ones above it (like Python's os.makedirs(exist_ok=True))
fn b_make_dir(path: Word, rtd: Word) -> Word {
  let n = peek(path + 16)
  let buf = alloc(n + 1)
  copy_bytes(buf, path + 32, n)
  var last: Word = 0
  var i: Word = 1
  while i <= n {
    let c = peek8(path + 32 + i)
    if i == n or c == 47 or c == 92 {
      poke8(buf + i, 0)
      if not os_is_dir(buf) {
        last = os_mkdir(buf)
      }
      poke8(buf + i, c)
    }
    i = i + 1
  }
  poke8(buf + n, 0)
  let ok = os_is_dir(buf)
  block_free(buf)
  if ok {
    return ok_new(rtd, 0)
  }
  let b = sb_new()
  sb_add_cstr(b, "cannot create '")
  sb_add_str(b, path)
  sb_add_cstr(b, "': ")
  if last == 0 or last == -1 {
    last = -17
  }
  io_error_text(b, last)
  return err_new(rtd, sb_finish(b))
}

// current_dir(): the working directory
fn b_current_dir() -> Word {
  let buf = alloc(4096)
  let r = os_getcwd(buf, 4096)
  var n: Word = 0
  if r > 0 {
    n = r
    if os_platform() == 0 {
      n = r - 1
    }
  }
  let s = str_from(buf, n)
  block_free(buf)
  return s
}

// remove_file(path): deletes a file
fn b_remove_file(path: Word, rtd: Word) -> Word {
  let r = os_unlink(path + 32)
  if r >= 0 {
    return ok_new(rtd, 0)
  }
  let b = sb_new()
  sb_add_cstr(b, "cannot remove '")
  sb_add_str(b, path)
  sb_add_cstr(b, "': ")
  io_error_text(b, r)
  return err_new(rtd, sb_finish(b))
}

// run_capture(args, dir, input): runs a program (searched in PATH) in `dir` ("" = here) with `input` as its stdin
// and returns [exit code, stdout, stderr]; both streams are read together (poll), so neither can fill up and block
// the child. The input goes into the pipe before the child starts (so at most one pipe buffer: 64 KB).
fn b_run_capture(args: Word, dir: Word, input: Word, rtd: Word) -> Word {
  let n = peek(args + 16)
  if n == 0 {
    return err_new(rtd, bits("run_capture: no program given"))
  }
  if peek(input + 16) > 65536 {
    return err_new(rtd, bits("run_capture: the input is limited to 64 KB"))
  }
  if os_platform() != 0 {
    return err_new(rtd, bits("run_capture: not supported on Windows yet"))
  }
  flush_out()
  let prog = list_at(args, 0)
  let path = find_program(prog)
  if path == 0 {
    return spawn_error(prog, -2, rtd)
  }
  let argv = alloc(8 * (n + 1))
  poke(argv, path + 32)
  var i: Word = 1
  while i < n {
    poke(argv + 8 * i, list_at(args, i) + 32)
    i = i + 1
  }
  poke(argv + 8 * n, 0)
  // the environment: the strings after argv's terminating null
  var ne: Word = 0
  while os_argv(os_argc() + 1 + ne) != 0 {
    ne = ne + 1
  }
  let envp = alloc(8 * (ne + 1))
  var e: Word = 0
  while e <= ne {
    poke(envp + 8 * e, os_argv(os_argc() + 1 + e))
    e = e + 1
  }
  let fds = alloc(24)
  os_pipe(fds)
  os_pipe(fds + 8)
  os_pipe(fds + 16)
  if peek(input + 16) > 0 {
    os_write(peek32(fds + 20), input + 32, peek(input + 16))
  }
  os_close(peek32(fds + 20))
  let pid = os_fork()
  if pid == 0 {
    os_dup2(peek32(fds + 16), 0)
    os_dup2(peek32(fds + 4), 1)
    os_dup2(peek32(fds + 12), 2)
    os_close(peek32(fds))
    os_close(peek32(fds + 4))
    os_close(peek32(fds + 8))
    os_close(peek32(fds + 12))
    os_close(peek32(fds + 16))
    if peek(dir + 16) > 0 and os_chdir(dir + 32) < 0 {
      os_exit(127)
    }
    os_execve(path + 32, argv, envp)
    os_exit(127)
  }
  os_close(peek32(fds + 4))
  os_close(peek32(fds + 12))
  os_close(peek32(fds + 16))
  let out = sb_new()
  let err = sb_new()
  let buf = alloc(65536)
  let pfd = alloc(16)
  var fd_out = peek32(fds)
  var fd_err = peek32(fds + 8)
  while fd_out >= 0 or fd_err >= 0 {
    poke32(pfd, fd_out)
    poke32(pfd + 4, 1)
    poke32(pfd + 8, fd_err)
    poke32(pfd + 12, 1)
    os_poll(pfd, 2)
    if fd_out >= 0 and w_and(w_shr(peek32(pfd + 4), 16), 65535) != 0 {
      let r = os_read(fd_out, buf, 65536)
      if r <= 0 {
        os_close(fd_out)
        fd_out = -1
      } else {
        sb_add_bytes(out, buf, r)
      }
    }
    if fd_err >= 0 and w_and(w_shr(peek32(pfd + 12), 16), 65535) != 0 {
      let r = os_read(fd_err, buf, 65536)
      if r <= 0 {
        os_close(fd_err)
        fd_err = -1
      } else {
        sb_add_bytes(err, buf, r)
      }
    }
  }
  block_free(buf)
  block_free(pfd)
  block_free(fds)
  block_free(argv)
  block_free(envp)
  rc_dec(path)
  let st = os_wait(pid)
  var code = w_and(w_shr(st, 8), 255)
  if w_and(st, 127) != 0 {
    code = 128 + w_and(st, 127)
  }
  let cs = sb_new()
  sb_add_word(cs, code)
  var res = list_new_str()
  res = list_push_owned_raw(res, sb_finish(cs))
  res = list_push_owned_raw(res, sb_finish(out))
  res = list_push_owned_raw(res, sb_finish(err))
  return ok_new(rtd, res)
}
