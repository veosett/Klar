// Klar runtime: property-based testing in native code, with the inputs `klar test` generates.
//
// The interpreter (klar/interpreter.py) draws inputs from Python's `random.Random(f"{seed}:{name}")`; to report the
// same counterexamples, this file reproduces that generator exactly: the seed string is hashed with SHA-512 and fed to
// a Mersenne Twister (init_by_array), and random() / getrandbits / randbelow / randint / choice / uniform / round(x, 3)
// follow CPython. Each run of a property happens in a child process (fork), so a runtime error ends only that run;
// the child reports the error through a pipe and the parent shrinks the inputs like the interpreter does.

// ---- SHA-512 -------------------------------------------------------------------------------------------------

fn sha_k() -> Word {
  let k = alloc(640)
  poke(k + 0, 4794697086780616226)
  poke(k + 8, 8158064640168781261)
  poke(k + 16, -5349999486874862801)
  poke(k + 24, -1606136188198331460)
  poke(k + 32, 4131703408338449720)
  poke(k + 40, 6480981068601479193)
  poke(k + 48, -7908458776815382629)
  poke(k + 56, -6116909921290321640)
  poke(k + 64, -2880145864133508542)
  poke(k + 72, 1334009975649890238)
  poke(k + 80, 2608012711638119052)
  poke(k + 88, 6128411473006802146)
  poke(k + 96, 8268148722764581231)
  poke(k + 104, -9160688886553864527)
  poke(k + 112, -7215885187991268811)
  poke(k + 120, -4495734319001033068)
  poke(k + 128, -1973867731355612462)
  poke(k + 136, -1171420211273849373)
  poke(k + 144, 1135362057144423861)
  poke(k + 152, 2597628984639134821)
  poke(k + 160, 3308224258029322869)
  poke(k + 168, 5365058923640841347)
  poke(k + 176, 6679025012923562964)
  poke(k + 184, 8573033837759648693)
  poke(k + 192, -7476448914759557205)
  poke(k + 200, -6327057829258317296)
  poke(k + 208, -5763719355590565569)
  poke(k + 216, -4658551843659510044)
  poke(k + 224, -4116276920077217854)
  poke(k + 232, -3051310485924567259)
  poke(k + 240, 489312712824947311)
  poke(k + 248, 1452737877330783856)
  poke(k + 256, 2861767655752347644)
  poke(k + 264, 3322285676063803686)
  poke(k + 272, 5560940570517711597)
  poke(k + 280, 5996557281743188959)
  poke(k + 288, 7280758554555802590)
  poke(k + 296, 8532644243296465576)
  poke(k + 304, -9096487096722542874)
  poke(k + 312, -7894198246740708037)
  poke(k + 320, -6719396339535248540)
  poke(k + 328, -6333637450476146687)
  poke(k + 336, -4446306890439682159)
  poke(k + 344, -4076793802049405392)
  poke(k + 352, -3345356375505022440)
  poke(k + 360, -2983346525034927856)
  poke(k + 368, -860691631967231958)
  poke(k + 376, 1182934255886127544)
  poke(k + 384, 1847814050463011016)
  poke(k + 392, 2177327727835720531)
  poke(k + 400, 2830643537854262169)
  poke(k + 408, 3796741975233480872)
  poke(k + 416, 4115178125766777443)
  poke(k + 424, 5681478168544905931)
  poke(k + 432, 6601373596472566643)
  poke(k + 440, 7507060721942968483)
  poke(k + 448, 8399075790359081724)
  poke(k + 456, 8693463985226723168)
  poke(k + 464, -8878714635349349518)
  poke(k + 472, -8302665154208450068)
  poke(k + 480, -8016688836872298968)
  poke(k + 488, -6606660893046293015)
  poke(k + 496, -4685533653050689259)
  poke(k + 504, -4147400797238176981)
  poke(k + 512, -3880063495543823972)
  poke(k + 520, -3348786107499101689)
  poke(k + 528, -1523767162380948706)
  poke(k + 536, -757361751448694408)
  poke(k + 544, 500013540394364858)
  poke(k + 552, 748580250866718886)
  poke(k + 560, 1242879168328830382)
  poke(k + 568, 1977374033974150939)
  poke(k + 576, 2944078676154940804)
  poke(k + 584, 3659926193048069267)
  poke(k + 592, 4368137639120453308)
  poke(k + 600, 4836135668995329356)
  poke(k + 608, 5532061633213252278)
  poke(k + 616, 6448918945643986474)
  poke(k + 624, 6902733635092675308)
  poke(k + 632, 7801388544844847127)
  return k
}

fn sha_h0(h: Word) {
  poke(h + 0, 7640891576956012808)
  poke(h + 8, -4942790177534073029)
  poke(h + 16, 4354685564936845355)
  poke(h + 24, -6534734903238641935)
  poke(h + 32, 5840696475078001361)
  poke(h + 40, -7276294671716946913)
  poke(h + 48, 2270897969802886507)
  poke(h + 56, 6620516959819538809)
}

fn rotr(x: Word, n: Word) -> Word {
  return w_or(w_shr(x, n), w_shl(x, 64 - n))
}

fn be64(p: Word) -> Word {
  var v: Word = 0
  var i: Word = 0
  while i < 8 {
    v = w_or(w_shl(v, 8), peek8(p + i))
    i = i + 1
  }
  return v
}

// SHA-512 of n bytes at p: the 64-byte digest is written to out
fn sha512(p: Word, n: Word, out: Word) {
  let k = sha_k()
  let h = alloc(64)
  sha_h0(h)
  // the padded message: data, 0x80, zeros, the length in bits (128-bit big-endian)
  var total = n + 17
  total = total + w_and(128 - w_and(total, 127), 127)
  let msg = alloc(total)
  var i: Word = 0
  while i < total {
    poke8(msg + i, 0)
    i = i + 1
  }
  copy_bytes(msg, p, n)
  poke8(msg + n, 128)
  let bitlen = n * 8
  i = 0
  while i < 8 {
    poke8(msg + total - 1 - i, w_and(w_shr(bitlen, i * 8), 255))
    i = i + 1
  }
  let w = alloc(640)
  var blk: Word = 0
  while blk < total {
    var t: Word = 0
    while t < 16 {
      poke(w + t * 8, be64(msg + blk + t * 8))
      t = t + 1
    }
    while t < 80 {
      let w15 = peek(w + (t - 15) * 8)
      let w2 = peek(w + (t - 2) * 8)
      let s0 = w_xor(w_xor(rotr(w15, 1), rotr(w15, 8)), w_shr(w15, 7))
      let s1 = w_xor(w_xor(rotr(w2, 19), rotr(w2, 61)), w_shr(w2, 6))
      poke(w + t * 8, peek(w + (t - 16) * 8) + s0 + peek(w + (t - 7) * 8) + s1)
      t = t + 1
    }
    var a = peek(h)
    var b = peek(h + 8)
    var c = peek(h + 16)
    var d = peek(h + 24)
    var e = peek(h + 32)
    var f = peek(h + 40)
    var g2 = peek(h + 48)
    var hh = peek(h + 56)
    t = 0
    while t < 80 {
      let s1 = w_xor(w_xor(rotr(e, 14), rotr(e, 18)), rotr(e, 41))
      let ch = w_xor(w_and(e, f), w_and(w_xor(e, -1), g2))
      let t1 = hh + s1 + ch + peek(k + t * 8) + peek(w + t * 8)
      let s0 = w_xor(w_xor(rotr(a, 28), rotr(a, 34)), rotr(a, 39))
      let maj = w_xor(w_xor(w_and(a, b), w_and(a, c)), w_and(b, c))
      let t2 = s0 + maj
      hh = g2
      g2 = f
      f = e
      e = d + t1
      d = c
      c = b
      b = a
      a = t1 + t2
      t = t + 1
    }
    poke(h, peek(h) + a)
    poke(h + 8, peek(h + 8) + b)
    poke(h + 16, peek(h + 16) + c)
    poke(h + 24, peek(h + 24) + d)
    poke(h + 32, peek(h + 32) + e)
    poke(h + 40, peek(h + 40) + f)
    poke(h + 48, peek(h + 48) + g2)
    poke(h + 56, peek(h + 56) + hh)
    blk = blk + 128
  }
  i = 0
  while i < 64 {
    poke8(out + i, w_and(w_shr(peek(h + w_and(i, -8)), 56 - 8 * w_and(i, 7)), 255))
    i = i + 1
  }
  block_free(msg)
  block_free(w)
  block_free(h)
  block_free(k)
}

// ---- Python's random.Random -----------------------------------------------------------------------------------
// state: 624 words of the Mersenne Twister (32-bit values) and the index at +4992

const MT_N: Word = 624

fn mt_init(st: Word, s: Word) {
  poke(st, w_and(s, 4294967295))
  var i: Word = 1
  while i < MT_N {
    let prev = peek(st + (i - 1) * 8)
    poke(st + i * 8, w_and(1812433253 * w_xor(prev, w_shr(prev, 30)) + i, 4294967295))
    i = i + 1
  }
  poke(st + MT_N * 8, MT_N)
}

// init_by_array with the key words (32-bit) at key
fn mt_init_array(st: Word, key: Word, klen: Word) {
  mt_init(st, 19650218)
  var i: Word = 1
  var j: Word = 0
  var k = MT_N
  if klen > k {
    k = klen
  }
  while k > 0 {
    let prev = peek(st + (i - 1) * 8)
    let x = w_xor(peek(st + i * 8), w_xor(prev, w_shr(prev, 30)) * 1664525)
    poke(st + i * 8, w_and(x + peek(key + j * 8) + j, 4294967295))
    i = i + 1
    j = j + 1
    if i >= MT_N {
      poke(st, peek(st + (MT_N - 1) * 8))
      i = 1
    }
    if j >= klen {
      j = 0
    }
    k = k - 1
  }
  k = MT_N - 1
  while k > 0 {
    let prev = peek(st + (i - 1) * 8)
    let x = w_xor(peek(st + i * 8), w_xor(prev, w_shr(prev, 30)) * 1566083941)
    poke(st + i * 8, w_and(x - i, 4294967295))
    i = i + 1
    if i >= MT_N {
      poke(st, peek(st + (MT_N - 1) * 8))
      i = 1
    }
    k = k - 1
  }
  poke(st, 2147483648)
}

fn mt_next(st: Word) -> Word {
  if peek(st + MT_N * 8) >= MT_N {
    var kk: Word = 0
    while kk < MT_N {
      let y = w_or(w_and(peek(st + kk * 8), 2147483648), w_and(peek(st + w_urem(kk + 1, MT_N) * 8), 2147483647))
      var v = w_xor(peek(st + w_urem(kk + 397, MT_N) * 8), w_shr(y, 1))
      if w_and(y, 1) == 1 {
        v = w_xor(v, 2567483615)
      }
      poke(st + kk * 8, v)
      kk = kk + 1
    }
    poke(st + MT_N * 8, 0)
  }
  let idx = peek(st + MT_N * 8)
  var y = peek(st + idx * 8)
  poke(st + MT_N * 8, idx + 1)
  y = w_xor(y, w_shr(y, 11))
  y = w_xor(y, w_and(w_shl(y, 7), 2636928640))
  y = w_xor(y, w_and(w_shl(y, 15), 4022730752))
  y = w_xor(y, w_shr(y, 18))
  return w_and(y, 4294967295)
}

// random.Random(text): SHA-512 of the text appended to it, as one big integer, gives the key words
fn rng_new(text: Word) -> Word {
  let n = peek(text + 16)
  let bytes = alloc(n + 64)
  copy_bytes(bytes, text + 32, n)
  sha512(text + 32, n, bytes + n)
  let total = n + 64
  let klen = w_udiv(total + 3, 4)
  let key = alloc(klen * 8)
  var i: Word = 0
  while i < klen {
    var v: Word = 0
    var b: Word = 0
    while b < 4 {
      // byte b of word i, counted from the end of the big-endian string
      let at = total - 1 - (i * 4 + b)
      if at >= 0 {
        v = w_or(v, w_shl(peek8(bytes + at), 8 * b))
      }
      b = b + 1
    }
    poke(key + i * 8, v)
    i = i + 1
  }
  let st = alloc((MT_N + 1) * 8)
  mt_init_array(st, key, klen)
  block_free(key)
  block_free(bytes)
  return st
}

fn rng_random(st: Word) -> Float {
  let a = w_shr(mt_next(st), 5)
  let b = w_shr(mt_next(st), 6)
  return w2f(a * 67108864 + b) / 9007199254740992.0
}

fn bit_length(n: Word) -> Word {
  var k: Word = 0
  var v = n
  while v > 0 {
    k = k + 1
    v = w_shr(v, 1)
  }
  return k
}

// getrandbits(k) for k <= 62
fn rng_bits(st: Word, k: Word) -> Word {
  if k <= 32 {
    return w_shr(mt_next(st), 32 - k)
  }
  let lo = mt_next(st)
  let hi = w_shr(mt_next(st), 64 - k)
  return w_or(lo, w_shl(hi, 32))
}

// _randbelow(n), n >= 1
fn rng_below(st: Word, n: Word) -> Word {
  let k = bit_length(n)
  var r = rng_bits(st, k)
  while r >= n {
    r = rng_bits(st, k)
  }
  return r
}

fn rng_randint(st: Word, a: Word, b: Word) -> Word {
  return a + rng_below(st, b - a + 1)
}

fn rng_uniform(st: Word, a: Float, b: Float) -> Float {
  return a + (b - a) * rng_random(st)
}

// Python's round(x, 3): x * 1000 rounded exactly (ties to even), then divided back
fn round3(x: Float) -> Float {
  let raw = fbits(x)
  let neg = raw < 0
  let ex = w_and(w_shr(raw, 52), 2047)
  var m = w_and(raw, 4503599627370495)
  if ex == 0 {
    if m == 0 {
      return x
    }
  } else {
    m = w_or(m, 4503599627370496)
  }
  var e = ex - 1075
  if ex == 0 {
    e = -1074
  }
  // |x| = m * 2^e; |x| * 1000 = m * 1000 * 2^e
  let p = m * 1000
  var q: Word = 0
  if e >= 0 {
    q = w_shl(p, e)
  } else if -e < 63 {
    let s = -e
    q = w_shr(p, s)
    let rem = w_and(p, w_shl(1, s) - 1)
    let half = w_shl(1, s - 1)
    if rem > half or (rem == half and w_and(q, 1) == 1) {
      q = q + 1
    }
  }
  let r = w2f(q) / 1000.0
  if neg {
    return ffrom(w_or(fbits(r), w_shl(1, 63)))
  }
  return r
}

// ---- generating inputs (Interpreter.gen) ---------------------------------------------------------------------

const ALPHABET: Str = "abcxyzAB01 -_é"

fn td_is(td: Word, name: Str) -> Bool {
  return Str_eq(peek(td + 8), bits(name))
}

fn int_value(w: Word) -> Word {
  return bits(tag(w))
}

fn enum_obj(td: Word, tagv: Word, nf: Word) -> Word {
  let o = obj_new(24 + nf * 8, td)
  poke(o + 16, tagv)
  return o
}

// the n-th character of ALPHABET, as UTF-8 bytes appended to b
fn add_alpha(b: Word, i: Word) {
  let s = bits(ALPHABET)
  var at: Word = 0
  var k: Word = 0
  while k < i {
    at = at + utf8_len(peek8(s + 32 + at))
    k = k + 1
  }
  sb_add_bytes(b, s + 32 + at, utf8_len(peek8(s + 32 + at)))
}

fn utf8_len(c: Word) -> Word {
  if c < 128 {
    return 1
  }
  if c < 224 {
    return 2
  }
  if c < 240 {
    return 3
  }
  return 4
}

// the variants an enum value may take at this depth (deep down, only the non-recursive ones)
fn enum_choices(td: Word, depth: Word, out: Word) -> Word {
  let nv = peek(td + 16)
  var n: Word = 0
  if depth > 3 and peek(td + 40) != 0 {
    let flags = peek(td + 40)
    var i: Word = 0
    while i < nv {
      if peek(flags + i * 8) == 0 {
        poke(out + n * 8, i)
        n = n + 1
      }
      i = i + 1
    }
    if n == 0 {
      // all recursive: the one with the fewest fields (the first of them)
      var best: Word = 0
      var j: Word = 1
      while j < nv {
        if peek(peek(td + 24) + j * 32 + 8) < peek(peek(td + 24) + best * 32 + 8) {
          best = j
        }
        j = j + 1
      }
      poke(out, best)
      n = 1
    }
    return n
  }
  var i: Word = 0
  while i < nv {
    poke(out + i * 8, i)
    i = i + 1
  }
  return nv
}

fn gen(st: Word, td: Word, size: Word, depth: Word) -> Word {
  let k = peek(td)
  if k == K_INT {
    let r = rng_random(st)
    if r < 0.3 {
      let c = rng_below(st, 8)
      if c == 0 {
        return int_value(0)
      } else if c == 1 {
        return int_value(1)
      } else if c == 2 {
        return int_value(-1)
      } else if c == 3 {
        return int_value(2)
      } else if c == 4 {
        return int_value(-2)
      } else if c == 5 {
        return int_value(10)
      } else if c == 6 {
        return int_value(-10)
      }
      return int_value(100)
    }
    if r < 0.35 {
      return int_value(rng_randint(st, -1000000000000, 1000000000000))
    }
    return int_value(rng_randint(st, 0 - size * 10, size * 10))
  }
  if k == K_FLOAT {
    if rng_random(st) < 0.25 {
      let c = rng_below(st, 5)
      if c == 0 {
        return fbits(0.0)
      } else if c == 1 {
        return fbits(1.0)
      } else if c == 2 {
        return fbits(-1.0)
      } else if c == 3 {
        return fbits(0.5)
      }
      return fbits(-0.5)
    }
    let lim = w2f(size * 10)
    return fbits(round3(rng_uniform(st, 0.0 - lim, lim)))
  }
  if k == K_BOOL {
    if rng_random(st) < 0.5 {
      return 1
    }
    return 0
  }
  if k == K_STR {
    let n = rng_randint(st, 0, size)
    let b = sb_new()
    var i: Word = 0
    while i < n {
      add_alpha(b, rng_below(st, 14))
      i = i + 1
    }
    return sb_finish(b)
  }
  if k == K_BYTES {
    let n = rng_randint(st, 0, size)
    let buf = alloc(n + 1)
    var i: Word = 0
    while i < n {
      let x = rng_randint(st, 0, 255)
      let c = rng_below(st, 6)
      var v = x
      if c == 0 {
        v = 0
      } else if c == 1 {
        v = 1
      } else if c == 2 {
        v = 127
      } else if c == 3 {
        v = 128
      } else if c == 4 {
        v = 255
      }
      poke8(buf + i, v)
      i = i + 1
    }
    let out = bytes_from(buf, n)
    block_free(buf)
    return out
  }
  if k == K_LIST {
    let n = rng_randint(st, 0, size)
    let l = list_with_cap(td, n)
    var i: Word = 0
    while i < n {
      append_owned(l, gen(st, peek(td + 16), size, depth + 1))
      i = i + 1
    }
    return l
  }
  if k == K_MAP {
    let n = rng_randint(st, 0, size)
    var m = map_new(td)
    var i: Word = 0
    while i < n {
      let key = gen(st, peek(td + 16), size, depth + 1)
      m = Map_set_owned(m, key, gen(st, peek(td + 24), size, depth + 1))
      i = i + 1
    }
    return m
  }
  if k == K_RECORD {
    let nf = peek(td + 16)
    let o = obj_new(16 + nf * 8, td)
    var i: Word = 0
    while i < nf {
      poke(o + 16 + i * 8, gen(st, peek(peek(td + 24) + i * 8), size, depth + 1))
      i = i + 1
    }
    return o
  }
  if k == K_ENUM {
    let vtab = peek(td + 24)
    if td_is(td, "Option") and peek(td + 32) == 1 {
      if rng_random(st) < 0.25 {
        return enum_obj(td, 0, 0)
      }
      let o = enum_obj(td, 1, 1)
      poke(o + 24, gen(st, peek(peek(vtab + 32 + 16)), size, depth + 1))
      return o
    }
    if td_is(td, "Result") and peek(td + 32) == 1 {
      var tagv: Word = 1
      if rng_random(st) < 0.5 {
        tagv = 0
      }
      let o = enum_obj(td, tagv, 1)
      poke(o + 24, gen(st, peek(peek(vtab + tagv * 32 + 16)), size, depth + 1))
      return o
    }
    let choices = alloc(peek(td + 16) * 8 + 8)
    let n = enum_choices(td, depth, choices)
    let tagv = peek(choices + rng_below(st, n) * 8)
    block_free(choices)
    let row = vtab + tagv * 32
    let nf = peek(row + 8)
    let o = enum_obj(td, tagv, nf)
    var i: Word = 0
    while i < nf {
      poke(o + 24 + i * 8, gen(st, peek(peek(row + 16) + i * 8), size, depth + 1))
      i = i + 1
    }
    return o
  }
  return 0
}

// ---- shrinking (Interpreter.shrink_value) -----------------------------------------------------------------------
// a vector of words: [len][cap][data]

fn vec_new() -> Word {
  let v = alloc(24)
  poke(v, 0)
  poke(v + 8, 8)
  poke(v + 16, alloc(64))
  return v
}

fn vec_push(v: Word, x: Word) {
  let n = peek(v)
  if n == peek(v + 8) {
    let data = alloc(n * 16)
    copy_words(data, peek(v + 16), n)
    poke(v + 16, data)
    poke(v + 8, n * 2)
  }
  poke(peek(v + 16) + n * 8, x)
  poke(v, n + 1)
}

fn vec_at(v: Word, i: Word) -> Word {
  return peek(peek(v + 16) + i * 8)
}

// byte offset of character ci in a string
fn char_at(s: Word, ci: Word) -> Word {
  var at: Word = 0
  var k: Word = 0
  let n = peek(s + 16)
  while k < ci and at < n {
    at = at + utf8_len(peek8(s + 32 + at))
    k = k + 1
  }
  return at
}

fn str_part(s: Word, a: Word, b: Word) -> Word {
  let pa = char_at(s, a)
  let pb = char_at(s, b)
  return str_from(s + 32 + pa, pb - pa)
}

fn list_part(l: Word, td: Word, a: Word, b: Word) -> Word {
  let out = list_with_cap(td, b - a + 1)
  var i = a
  while i < b {
    let x = list_at(l, i)
    retain_v(x, peek(td + 16))
    append_owned(out, x)
    i = i + 1
  }
  return out
}

// copy of a list without element `skip`
fn list_without(l: Word, td: Word, skip: Word) -> Word {
  let n = peek(l + 16)
  let out = list_with_cap(td, n)
  var i: Word = 0
  while i < n {
    if i != skip {
      let x = list_at(l, i)
      retain_v(x, peek(td + 16))
      append_owned(out, x)
    }
    i = i + 1
  }
  return out
}

fn list_with(l: Word, td: Word, at: Word, c: Word) -> Word {
  let n = peek(l + 16)
  let out = list_with_cap(td, n)
  var i: Word = 0
  while i < n {
    if i == at {
      append_owned(out, c)
    } else {
      let x = list_at(l, i)
      retain_v(x, peek(td + 16))
      append_owned(out, x)
    }
    i = i + 1
  }
  return out
}

fn map_without(m: Word, td: Word, skip: Word) -> Word {
  var out = map_new(td)
  let n = peek(m + 16)
  var i: Word = 0
  while i < n {
    if i != skip {
      let key = peek(peek(m + 32) + i * 8)
      let val = peek(peek(m + 40) + i * 8)
      retain_v(key, peek(td + 16))
      retain_v(val, peek(td + 24))
      out = Map_set_owned(out, key, val)
    }
    i = i + 1
  }
  return out
}

// copy of a record / enum object (header `hdr` words before the fields) with field i replaced by c (owned)
fn obj_with(o: Word, td: Word, hdr: Word, nf: Word, ftab: Word, i: Word, c: Word) -> Word {
  let r = obj_new(hdr + nf * 8, td)
  if hdr == 24 {
    poke(r + 16, peek(o + 16))
  }
  var j: Word = 0
  while j < nf {
    if j == i {
      poke(r + hdr + j * 8, c)
    } else {
      let x = peek(o + hdr + j * 8)
      retain_v(x, peek(ftab + j * 8))
      poke(r + hdr + j * 8, x)
    }
    j = j + 1
  }
  return r
}

fn shrink(v: Word, td: Word) -> Word {
  let out = vec_new()
  let k = peek(td)
  if k == K_BOOL {
    if v == 1 {
      vec_push(out, 0)
    }
  } else if k == K_INT {
    if w_and(v, 1) == 1 and v != 1 {
      let x = w_sar(v, 1)
      var step: Word = 1
      if x < 0 {
        step = -1
      }
      vec_push(out, int_value(0))
      vec_push(out, int_value(x / 2))
      vec_push(out, int_value(x - step))
    }
  } else if k == K_FLOAT {
    let x = ffrom(v)
    if x != 0.0 {
      vec_push(out, fbits(0.0))
      vec_push(out, fbits(w2f(f2w(x))))
      vec_push(out, fbits(x / 2.0))
    }
  } else if k == K_STR {
    let n = str_nchars(v)
    if n > 0 {
      vec_push(out, str_part(v, 0, 0))
      vec_push(out, str_part(v, 0, n / 2))
      vec_push(out, str_part(v, 1, n))
      vec_push(out, str_part(v, 0, n - 1))
    }
  } else if k == K_BYTES {
    let n = peek(v + 16)
    if n > 0 {
      let p = peek(v + 32)
      vec_push(out, bytes_from(p, 0))
      vec_push(out, bytes_from(p, n / 2))
      vec_push(out, bytes_from(p + 1, n - 1))
      vec_push(out, bytes_from(p, n - 1))
    }
  } else if k == K_LIST {
    let n = peek(v + 16)
    if n > 0 {
      vec_push(out, list_part(v, td, 0, 0))
      vec_push(out, list_part(v, td, 0, n / 2))
      vec_push(out, list_part(v, td, n / 2, n))
      var i: Word = 0
      while i < n and i < 8 {
        vec_push(out, list_without(v, td, i))
        i = i + 1
      }
      i = 0
      while i < n and i < 8 {
        let sub = shrink(list_at(v, i), peek(td + 16))
        var j: Word = 0
        while j < peek(sub) and j < 3 {
          vec_push(out, list_with(v, td, i, vec_at(sub, j)))
          j = j + 1
        }
        i = i + 1
      }
    }
  } else if k == K_MAP {
    let n = peek(v + 16)
    if n > 0 {
      vec_push(out, map_new(td))
      var i: Word = 0
      while i < n and i < 8 {
        vec_push(out, map_without(v, td, i))
        i = i + 1
      }
    }
  } else if k == K_ENUM {
    let tagv = peek(v + 16)
    let row = peek(td + 24) + tagv * 32
    let nf = peek(row + 8)
    let special = peek(td + 32) == 1
    if special and td_is(td, "Option") and tagv == 1 {
      vec_push(out, enum_obj(td, 0, 0))
    }
    var i: Word = 0
    while i < nf {
      let sub = shrink(peek(v + 24 + i * 8), peek(peek(row + 16) + i * 8))
      var j: Word = 0
      while j < peek(sub) and j < 3 {
        vec_push(out, obj_with(v, td, 24, nf, peek(row + 16), i, vec_at(sub, j)))
        j = j + 1
      }
      i = i + 1
    }
    if not special {
      // simpler values of a recursive enum: a payload of the same enum
      i = 0
      while i < nf {
        let ftd = peek(peek(row + 16) + i * 8)
        if peek(ftd) == K_ENUM and Str_eq(peek(ftd + 8), peek(td + 8)) {
          vec_push(out, peek(v + 24 + i * 8))
        }
        i = i + 1
      }
    }
  } else if k == K_RECORD {
    let nf = peek(td + 16)
    var i: Word = 0
    while i < nf {
      let sub = shrink(peek(v + 16 + i * 8), peek(peek(td + 24) + i * 8))
      var j: Word = 0
      while j < peek(sub) and j < 3 {
        vec_push(out, obj_with(v, td, 16, nf, peek(td + 24), i, vec_at(sub, j)))
        j = j + 1
      }
      i = i + 1
    }
  }
  // only candidates that differ from the value
  let kept = vec_new()
  var i: Word = 0
  while i < peek(out) {
    if not eq_v(vec_at(out, i), v, td) {
      vec_push(kept, vec_at(out, i))
    }
    i = i + 1
  }
  return kept
}

// ---- running a property ------------------------------------------------------------------------------------------
// One run happens in a child process; a runtime error there (fail_with with G_PROP set) is sent back through a pipe as
// [code][message][span][details...][stack note][hint] (strings as length + bytes) and the child exits. Without fork
// (Windows) the run happens in this process: G_PROPJB holds the os_setjmp buffer, and the report goes back there by
// os_longjmp (the memory the failed run held is not freed).

fn put_str(b: Word, s: Word) {
  put_word(b, peek(s + 16))
  sb_add_bytes(b, s + 32, peek(s + 16))
}

// in the child: the report of a runtime error, written to the parent (or kept for try_prop_here)
fn prop_failure(code: Word, msg: Word, sp: Word, details: Word, hint: Word) {
  let b = sb_new()
  put_str(b, code)
  put_str(b, msg)
  put_word(b, sp)
  var n: Word = 0
  if details != 0 {
    n = peek(details + 16)
  }
  put_word(b, n)
  var i: Word = 0
  while i < n {
    put_str(b, list_at(details, i))
    i = i + 1
  }
  let note = sb_new()
  stack_note(note)
  let stack = sb_finish(note)
  put_str(b, stack)
  put_str(b, hint)
  let s = sb_finish(b)
  let jb = peek(g() + G_PROPJB)
  if jb != 0 {
    poke(jb + 64, s)
    os_longjmp(jb, 1)
  }
  write_all(peek(g() + G_PROP), s + 32, peek(s + 16))
  os_exit(1)
}

fn get_str(st: Word) -> Word {
  let n = get_word(st)
  return str_from(get_bytes(st, n), n)
}

// [code][msg][span][details list][stack text][hint]
fn read_failure(text: Word) -> Word {
  let st = alloc(16)
  poke(st, text + 32)
  poke(st + 8, text + 32 + peek(text + 16))
  let f = alloc(48)
  poke(f, get_str(st))
  poke(f + 8, get_str(st))
  poke(f + 16, get_word(st))
  let n = get_word(st)
  let details = list_new_str()
  var i: Word = 0
  while i < n {
    append_owned(details, get_str(st))
    i = i + 1
  }
  poke(f + 24, details)
  poke(f + 32, get_str(st))
  poke(f + 40, get_str(st))
  block_free(st)
  return f
}

// the run in this process (no fork): 0 when it holds, else its failure
fn try_prop_here(clo: Word, args: Word) -> Word {
  flush_out()
  let gp = g()
  let jb = alloc(72)
  poke(jb + 64, 0)
  poke(gp + G_PROP, 1)
  poke(gp + G_PROPJB, jb)
  if os_setjmp(jb) == 0 {
    call1(clo, args)
  }
  // (back here after the run, or from prop_failure)
  poke(gp + G_OUTLEN, 0)
  poke(gp + G_PROP, 0)
  poke(gp + G_PROPJB, 0)
  let text = peek(jb + 64)
  block_free(jb)
  if text == 0 {
    return 0
  }
  return read_failure(text)
}

// runs the property once with these arguments: 0 when it holds, else its failure
fn try_prop(clo: Word, args: Word) -> Word {
  if os_platform() == 1 {
    return try_prop_here(clo, args)
  }
  flush_out()
  let fds = alloc(8)
  os_pipe(fds)
  let rfd = peek32(fds)
  let wfd = peek32(fds + 4)
  let pid = os_fork()
  if pid == 0 {
    os_close(rfd)
    poke(g() + G_PROP, wfd)
    call1(clo, args)
    poke(g() + G_OUTLEN, 0)
    os_exit(0)
  }
  os_close(wfd)
  let b = sb_new()
  let buf = alloc(4096)
  var reading = true
  while reading {
    let r = os_read(rfd, buf, 4096)
    if r <= 0 {
      reading = false
    } else {
      sb_add_bytes(b, buf, r)
    }
  }
  block_free(buf)
  os_close(rfd)
  block_free(fds)
  let status = os_wait(pid)
  let text = sb_finish(b)
  if peek(text + 16) > 0 {
    return read_failure(text)
  }
  if status == 0 {
    return 0
  }
  // the child died without a report
  let f = alloc(48)
  poke(f, bits("R0000"))
  poke(f + 8, bits("the property's process ended unexpectedly"))
  poke(f + 16, 0)
  poke(f + 24, list_new_str())
  poke(f + 32, bits(""))
  poke(f + 40, bits(""))
  return f
}

// Windows: the k-th word from the end of the command line (1 = the last), when it has 4 words or more; else 0
fn cmdline_word(k: Word) -> Word {
  let cl = os_cmdline()
  let n = cstr_len(cl)
  let starts = alloc(8 * 64)
  var count: Word = 0
  var quoted = false
  var in_word = false
  var i: Word = 0
  while i < n {
    let c = peek8(cl + i)
    if c == 34 {
      quoted = not quoted
    }
    if c == 32 and not quoted {
      in_word = false
    } else if not in_word {
      in_word = true
      if count < 64 {
        poke(starts + count * 8, cl + i)
      }
      count = count + 1
    }
    i = i + 1
  }
  var p: Word = 0
  if count >= 4 and count <= 64 and k <= count {
    p = peek(starts + (count - k) * 8)
  }
  block_free(starts)
  return p
}

// word i of `exe runs seed index` (Windows: counted from the end of the command line)
fn arg_word(i: Word, default: Word) -> Word {
  var p: Word = 0
  if os_platform() == 1 {
    p = cmdline_word(4 - i)
  } else if os_argc() == 4 {
    p = os_argv(i)
  }
  if p == 0 {
    return default
  }
  var v: Word = 0
  var neg = false
  var j: Word = 0
  if peek8(p) == 45 {
    neg = true
    j = 1
  }
  while peek8(p + j) >= 48 and peek8(p + j) <= 57 {
    v = v * 10 + peek8(p + j) - 48
    j = j + 1
  }
  if neg {
    return 0 - v
  }
  return v
}

// the property `name` (span: its declaration): `clo` runs its body with an array of `n` arguments of the types `tds`
// (names `names`); the executable takes `runs seed index` (default 100 runs, seed 0)
fn prop_run(clo: Word, tds: Word, n: Word, names: Word, name: Word, sp: Word) -> Word {
  let runs = arg_word(1, 100)
  let seed = arg_word(2, 0)
  let sb = sb_new()
  sb_add_word(sb, seed)
  sb_add_byte(sb, 58)
  sb_add_str(sb, name)
  let st = rng_new(sb_finish(sb))
  var i: Word = 0
  while i < runs {
    var div = runs
    if div < 1 {
      div = 1
    }
    let size = 1 + (i * 10) / div
    let args = alloc(n * 8 + 8)
    var j: Word = 0
    while j < n {
      poke(args + j * 8, gen(st, peek(tds + j * 8), size, 0))
      j = j + 1
    }
    let failure = try_prop(clo, args)
    if failure != 0 {
      prop_falsified(clo, tds, n, names, args, failure, i + 1, seed, sp)
    }
    i = i + 1
  }
  return 0
}

fn prop_falsified(clo: Word, tds: Word, n: Word, names: Word, args0: Word, failure: Word, run: Word, seed: Word,
  sp: Word) {
    var best = args0
    var best_err = failure
    var attempts: Word = 0
    var improved = true
    while improved and attempts < 1000 {
      improved = false
      var i: Word = 0
      while i < n and not improved and attempts < 1000 {
        let cands = shrink(peek(best + i * 8), peek(tds + i * 8))
        var j: Word = 0
        while j < peek(cands) and not improved and attempts < 1000 {
          attempts = attempts + 1
          let trial = alloc(n * 8 + 8)
          copy_words(trial, best, n)
          poke(trial + i * 8, vec_at(cands, j))
          let e = try_prop(clo, trial)
          if e != 0 {
            best = trial
            best_err = e
            improved = true
          }
          j = j + 1
        }
        i = i + 1
      }
    }
    // the report: the inputs, then the failure's own values
    let inputs = list_new_str()
    let hint = sb_new()
    sb_add_cstr(hint, "minimal counterexample: ")
    var i: Word = 0
    while i < n {
      let b = sb_new()
      sb_add_str(b, peek(names + i * 8))
      sb_add_cstr(b, " = ")
      show_into(b, peek(best + i * 8), peek(tds + i * 8), false)
      let s = sb_finish(b)
      if i > 0 {
        sb_add_cstr(hint, ", ")
      }
      sb_add_str(hint, s)
      append_owned(inputs, s)
      i = i + 1
    }
    sb_add_cstr(hint, "; reproduce with `--seed ")
    sb_add_word(hint, seed)
    sb_add_cstr(hint, "`")
    let details = peek(best_err + 24)
    i = 0
    while i < peek(details + 16) {
      let d = list_at(details, i)
      rc_inc(d)
      append_owned(inputs, d)
      i = i + 1
    }
    let msg = sb_new()
    sb_add_cstr(msg, "property falsified after ")
    sb_add_word(msg, run)
    sb_add_cstr(msg, " run(s) (seed ")
    sb_add_word(msg, seed)
    sb_add_cstr(msg, "): ")
    sb_add_str(msg, peek(best_err + 8))
    report_error(bits("R0010"), sb_finish(msg), peek(best_err + 16), inputs, sb_finish(hint), peek(best_err + 32))
  }
